; RUN: opt -passes='print<access-info>' -disable-output %s 2>&1 | FileCheck %s

; Tests with multiple stores through the same pointer in different blocks. If
; different iterations may write the same location, the order of the stores
; across iterations must be preserved.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"

; Iterations i < j with idx[i] == idx[j] write the same element, and the final
; value must be the one stored by iteration j.
define void @stores_indirect_different_blocks(ptr noalias %p, ptr noalias %idx, ptr noalias %c, i64 %n) {
; CHECK-LABEL: 'stores_indirect_different_blocks'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Report: unsafe dependent memory operations in loop. Use #pragma clang loop distribute(enable) to allow loop distribution to attempt to isolate the offending operations into a separate loop
; CHECK-NEXT:  Unsafe indirect dependence.
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:        IndirectUnsafe:
; CHECK-NEXT:            store i32 2, ptr %gep.p, align 4 ->
; CHECK-NEXT:            store i32 1, ptr %gep.p, align 4
; CHECK-EMPTY:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %gep.idx = getelementptr inbounds i32, ptr %idx, i64 %iv
  %l.idx = load i32, ptr %gep.idx, align 4
  %idx.ext = sext i32 %l.idx to i64
  %gep.p = getelementptr inbounds i32, ptr %p, i64 %idx.ext
  %gep.c = getelementptr inbounds i8, ptr %c, i64 %iv
  %l.c = load i8, ptr %gep.c, align 1
  %cmp = icmp eq i8 %l.c, 0
  br i1 %cmp, label %then, label %else

then:
  store i32 1, ptr %gep.p, align 4
  br label %latch

else:
  store i32 2, ptr %gep.p, align 4
  br label %latch

latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

