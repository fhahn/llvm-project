; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 5
; RUN: opt -passes='print<access-info>' -disable-output < %s 2>&1 | FileCheck %s

; Tests for dependence distances that are symbolic in the IR, but which a loop
; guard pins to a constant.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"
target triple = "arm64-apple-macosx"

; for (i = 0; i < n; ++i)
;   a[2*i + k] = a[2*i] + 1;      // guarded by k == 1
;
; The store writes only odd elements (2*i + 1) and the load reads only even
; elements (2*i), so the accesses can never overlap. With k == 1 applied, the
; dependence distance is the constant 1 element (4 bytes) against a stride of 2
; elements (8 bytes).
define void @interleave_distance_constant_via_guard(ptr %A, i32 %n, i32 %k) {
; CHECK-LABEL: 'interleave_distance_constant_via_guard'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: %A High: (4 + (4 * (zext i32 %k to i64))<nuw><nsw> + (8 * (zext i32 (-1 + %n) to i64))<nuw><nsw> + %A))
; CHECK-NEXT:            Member: {%A,+,8}<nuw><%loop>
; CHECK-NEXT:            Member: {((4 * (zext i32 %k to i64))<nuw><nsw> + %A),+,8}<nw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-NEXT:      {%k,+,2}<nw><%loop> Added Flags: <nusw>
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
; CHECK-NEXT:      [PSE] %gep.store = getelementptr inbounds i32, ptr %A, i64 %store.idx:
; CHECK-NEXT:        ((4 * (zext i32 {%k,+,2}<nw><%loop> to i64))<nuw><nsw> + %A)<nuw>
; CHECK-NEXT:        --> {((4 * (zext i32 %k to i64))<nuw><nsw> + %A),+,8}<nw><%loop>
;
entry:
  %g = icmp eq i32 %k, 1
  br i1 %g, label %ph, label %exit

ph:
  %ne = icmp sgt i32 %n, 0
  br i1 %ne, label %loop, label %exit

loop:
  %iv = phi i32 [ 0, %ph ], [ %iv.next, %loop ]
  %two.i = shl i32 %iv, 1
  %load.idx = zext i32 %two.i to i64
  %gep.load = getelementptr inbounds i32, ptr %A, i64 %load.idx
  %v = load i32, ptr %gep.load, align 4
  %add = add i32 %v, 1
  %store.i = add i32 %two.i, %k
  %store.idx = zext i32 %store.i to i64
  %gep.store = getelementptr inbounds i32, ptr %A, i64 %store.idx
  store i32 %add, ptr %gep.store, align 4
  %iv.next = add nuw nsw i32 %iv, 1
  %ec = icmp eq i32 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; for (i = 0; i < n; ++i)
;   a[i + k] = a[i] + 1;          // guarded by k == 4
;
; A backward read-after-write dependence with a constant distance of 4 elements
; (16 bytes) once k == 4 is applied. This is safe to vectorize with a maximum
; safe vector width of 128 bits (4 x i32). (Non-constant distances are compared
; against the target's maximum vector width, hence the target triple.)
define void @backward_distance_constant_via_guard(ptr %A, i32 %n, i32 %k) {
; CHECK-LABEL: 'backward_distance_constant_via_guard'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with a maximum safe vector width of 128 bits, with a maximum safe store-load forward width of 128 bits
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:        BackwardVectorizable:
; CHECK-NEXT:            %v = load i32, ptr %gep.load, align 4 ->
; CHECK-NEXT:            store i32 %add, ptr %gep.store, align 4
; CHECK-EMPTY:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: %A High: (4 + (4 * (zext i32 (-1 + %n) to i64))<nuw><nsw> + (4 * (zext i32 %k to i64))<nuw><nsw> + %A))
; CHECK-NEXT:            Member: {%A,+,4}<nuw><%loop>
; CHECK-NEXT:            Member: {((4 * (zext i32 %k to i64))<nuw><nsw> + %A),+,4}<nw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-NEXT:      {%k,+,1}<nw><%loop> Added Flags: <nusw>
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
; CHECK-NEXT:      [PSE] %gep.store = getelementptr inbounds i32, ptr %A, i64 %ik64:
; CHECK-NEXT:        ((4 * (zext i32 {%k,+,1}<nw><%loop> to i64))<nuw><nsw> + %A)<nuw>
; CHECK-NEXT:        --> {((4 * (zext i32 %k to i64))<nuw><nsw> + %A),+,4}<nw><%loop>
;
entry:
  %g = icmp eq i32 %k, 4
  br i1 %g, label %ph, label %exit

ph:
  %ne = icmp sgt i32 %n, 0
  br i1 %ne, label %loop, label %exit

loop:
  %iv = phi i32 [ 0, %ph ], [ %iv.next, %loop ]
  %i64 = zext i32 %iv to i64
  %gep.load = getelementptr inbounds i32, ptr %A, i64 %i64
  %v = load i32, ptr %gep.load, align 4
  %add = add i32 %v, 1
  %ik = add i32 %iv, %k
  %ik64 = zext i32 %ik to i64
  %gep.store = getelementptr inbounds i32, ptr %A, i64 %ik64
  store i32 %add, ptr %gep.store, align 4
  %iv.next = add nuw nsw i32 %iv, 1
  %ec = icmp eq i32 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

