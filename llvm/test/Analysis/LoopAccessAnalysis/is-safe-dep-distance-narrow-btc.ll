; RUN: opt -passes='print<access-info>' -disable-output %s 2>&1 | FileCheck %s

; Tests for the strong SIV independence check in isSafeDependenceDistance with a
; backedge-taken count type narrower than the dependence distance.

target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"

%big = type { [256 x i8] }
%big255 = type { [255 x i8] }

; Backward dependence with a distance of 1 iteration. The 256-byte stride does
; not fit in the i8 backedge-taken count type.
define void @backward_dep_narrow_btc_stride_256(ptr %A) {
; CHECK-LABEL: 'backward_dep_narrow_btc_stride_256'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Report: unsafe dependent memory operations in loop. Use #pragma clang loop distribute(enable) to allow loop distribution to attempt to isolate the offending operations into a separate loop
; CHECK-NEXT:  Backward loop carried data dependence.
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:        Backward:
; CHECK-NEXT:            %l = load i8, ptr %gep.ld, align 1 ->
; CHECK-NEXT:            store i8 %add, ptr %gep.st, align 1
; CHECK-EMPTY:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  br label %loop

loop:
  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.ld = getelementptr %big, ptr %A, i8 %iv
  %l = load i8, ptr %gep.ld, align 1
  %add = add i8 %l, 1
  %iv.next = add i8 %iv, 1
  %gep.st = getelementptr %big, ptr %A, i8 %iv.next
  store i8 %add, ptr %gep.st, align 1
  %ec = icmp ult i8 %iv.next, 100
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}

