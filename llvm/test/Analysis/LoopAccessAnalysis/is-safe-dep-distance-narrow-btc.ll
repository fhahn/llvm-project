; The store is to A[iv + n + 1], i.e. A[iv + 1] if 8 * n wraps to 0 (e.g.
; n == 2^61), with the loop exiting early via the load-dependent exit.
; FIXME: MaxBTC * 8 = 8 * (n - 1) wraps in i64 and the accesses are incorrectly
; reported as independent.
define void @backward_dep_i64_btc_product_wraps(ptr %A, i64 %n) {
; CHECK-LABEL: 'backward_dep_i64_btc_product_wraps'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %n.1 = add i64 %n, 1
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %gep.ld = getelementptr i64, ptr %A, i64 %iv
  %l = load i64, ptr %gep.ld, align 8
  %idx.st = add i64 %iv, %n.1
  %gep.st = getelementptr i64, ptr %A, i64 %idx.st
  %add = add i64 %l, 1
  store i64 %add, ptr %gep.st, align 8
  %c = icmp eq i64 %l, 0
  br i1 %c, label %exit, label %latch

latch:
  %iv.next = add nuw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
