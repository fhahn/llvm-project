  %l = load i8, ptr %gep.lut, align 1
  %gep.lut.iv = getelementptr inbounds nuw i8, ptr %lut, i64 %iv
  %l.iv = load i8, ptr %gep.lut.iv, align 1
  %add = add i8 %l, %l.iv
  %gep.dst = getelementptr inbounds nuw i8, ptr %dst, i64 %iv
  store i8 %add, ptr %gep.dst, align 1
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 256
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; Two loads from the same table with different index ranges, [0, 255] and
; [0, 127].
define void @lut_two_loads_different_ranges(ptr %dst, ptr %src, ptr %lut, i64 %n) {
; CHECK-LABEL: 'lut_two_loads_different_ranges'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Report: cannot identify array bounds
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.src = getelementptr inbounds nuw i8, ptr %src, i64 %iv
  %b = load i8, ptr %gep.src, align 1
  %idx.0 = zext i8 %b to i64
  %idx.1 = lshr i64 %idx.0, 1
  %gep.lut.0 = getelementptr inbounds nuw i8, ptr %lut, i64 %idx.0
  %l.0 = load i8, ptr %gep.lut.0, align 1
  %gep.lut.1 = getelementptr inbounds nuw i8, ptr %lut, i64 %idx.1
  %l.1 = load i8, ptr %gep.lut.1, align 1
  %add = add i8 %l.0, %l.1
  %gep.dst = getelementptr inbounds nuw i8, ptr %dst, i64 %iv
  store i8 %add, ptr %gep.dst, align 1
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; The offset %iv /u 2 is monotonic, but the exact trip count is unknown because
; of the early exit, so its value at the last iteration cannot be computed. Its
; unsigned range is [0, 499].
define void @monotonic_offset_unknown_last_value(ptr %dst, ptr %src, ptr %lut) {
; CHECK-LABEL: 'monotonic_offset_unknown_last_value'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Report: cannot identify array bounds
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %div = lshr i64 %iv, 1
  %gep.lut = getelementptr inbounds nuw i8, ptr %lut, i64 %div
  %l = load i8, ptr %gep.lut, align 1
  %gep.dst = getelementptr inbounds nuw i8, ptr %dst, i64 %iv
  store i8 %l, ptr %gep.dst, align 1
  %gep.src = getelementptr inbounds nuw i8, ptr %src, i64 %iv
  %b = load i8, ptr %gep.src, align 1
  %early = icmp eq i8 %b, 0
  br i1 %early, label %exit, label %latch

latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 1000
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; The table is in a non-integral address space, so its address is unknown.
define void @lut_non_integral(ptr %dst, ptr %src, ptr addrspace(1) %lut, i64 %n) {
; CHECK-LABEL: 'lut_non_integral'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Report: cannot identify array bounds
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
