  %iv.2 = shl nuw nsw i64 %iv, 1
  %iv.2.1 = or disjoint i64 %iv.2, 1
  %gep.ld = getelementptr inbounds i32, ptr %A, i64 %iv.2.1
  %l = load i32, ptr %gep.ld, align 4
