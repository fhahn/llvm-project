; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 4
; RUN: opt -passes='print<access-info>' -disable-output %s 2>&1 | FileCheck %s

; Regression test for a miscompile in isSafeDependenceDistance: the absolute
; byte stride (MaxStride) used to be materialised via
; getConstant(MaxBTC.getType(), MaxStride), which silently truncated MaxStride
; to the (possibly narrow) backedge-taken-count type. With an i8 induction
; variable and a 256-byte element stride, getConstant(i8, 256) wraps to 0, so
; the MaxBTC * Step product collapsed to 0 and the genuine backward
; loop-carried dependence was wrongly proven "safe", letting the loop vectorize
; without a runtime check.

target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"

%big = type { [256 x i8] }

; The element size (256 bytes) equals the byte stride, which does not fit in the
; i8 IV type. Iteration i writes %A + 256*(i+1) and iteration i+1 reads it: a
; real backward dependence with distance 1 iteration (256 bytes == one stride).
define void @backward_dep_narrow_iv_large_stride(ptr %A) {
; CHECK-LABEL: 'backward_dep_narrow_iv_large_stride'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Report: unsafe dependent memory operations in loop. Use #pragma clang loop distribute(enable) to allow loop distribution to attempt to isolate the offending operations into a separate loop
; CHECK-NEXT:  Backward loop carried data dependence.
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:        Backward:
; CHECK-NEXT:            %v = load i8, ptr %rd, align 1 ->
; CHECK-NEXT:            store i8 %v2, ptr %wr, align 1
; CHECK-EMPTY:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  br label %loop

loop:
  %i = phi i8 [ 0, %entry ], [ %i.next, %loop ]
  %rd = getelementptr %big, ptr %A, i8 %i
  %v = load i8, ptr %rd
  %v2 = add i8 %v, 1
  %i1 = add i8 %i, 1
  %wr = getelementptr %big, ptr %A, i8 %i1
  store i8 %v2, ptr %wr
  %i.next = add i8 %i, 1
  %c = icmp ult i8 %i.next, 100
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

; Control: identical 256-byte stride and distance, but with an i32 IV (no
; truncation). This always reported the dependence correctly; it must keep
; doing so after the fix.
define void @backward_dep_wide_iv_large_stride(ptr %A) {
; CHECK-LABEL: 'backward_dep_wide_iv_large_stride'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Report: unsafe dependent memory operations in loop. Use #pragma clang loop distribute(enable) to allow loop distribution to attempt to isolate the offending operations into a separate loop
; CHECK-NEXT:  Backward loop carried data dependence.
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:        Backward:
; CHECK-NEXT:            %v = load i8, ptr %rd, align 1 ->
; CHECK-NEXT:            store i8 %v2, ptr %wr, align 1
; CHECK-EMPTY:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %rd = getelementptr %big, ptr %A, i32 %i
  %v = load i8, ptr %rd
  %v2 = add i8 %v, 1
  %i1 = add i32 %i, 1
  %wr = getelementptr %big, ptr %A, i32 %i1
  store i8 %v2, ptr %wr
  %i.next = add i32 %i, 1
  %c = icmp ult i32 %i.next, 100
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

; The same narrow-IV truncation also corrupts non-power-of-two strides: a
; 255-byte stride yields getConstant(i8, 255) == -1, so the product was
; (99 * -1) reduced modulo 2^8 == a small positive value. Confirm the backward
; dependence is detected here too.
%big255 = type { [255 x i8] }

define void @backward_dep_narrow_iv_stride_255(ptr %A) {
; CHECK-LABEL: 'backward_dep_narrow_iv_stride_255'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Report: unsafe dependent memory operations in loop. Use #pragma clang loop distribute(enable) to allow loop distribution to attempt to isolate the offending operations into a separate loop
; CHECK-NEXT:  Backward loop carried data dependence.
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:        Backward:
; CHECK-NEXT:            %v = load i8, ptr %rd, align 1 ->
; CHECK-NEXT:            store i8 %v2, ptr %wr, align 1
; CHECK-EMPTY:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  br label %loop

loop:
  %i = phi i8 [ 0, %entry ], [ %i.next, %loop ]
  %rd = getelementptr %big255, ptr %A, i8 %i
  %v = load i8, ptr %rd
  %v2 = add i8 %v, 1
  %i1 = add i8 %i, 1
  %wr = getelementptr %big255, ptr %A, i8 %i1
  store i8 %v2, ptr %wr
  %i.next = add i8 %i, 1
  %c = icmp ult i8 %i.next, 100
  br i1 %c, label %loop, label %exit

exit:
