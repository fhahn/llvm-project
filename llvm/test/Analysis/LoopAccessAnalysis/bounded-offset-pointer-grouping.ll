; RUN: opt -passes='print<access-info>' -disable-output < %s 2>&1 | FileCheck %s

; Tests for runtime-check grouping of accesses to the same object at symbolic
; offsets ordered by a loop guard.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"
target triple = "arm64-apple-macosx"

; for (i = 0; i < n; ++i)
;   b[i] = a[i] + a[i + o];        // o in [0, 8]
;
; With o in [0, 8], a[i] <= a[i + o], so the two reads of %a can share the
; group [a, a + 4*n + 4*o], which needs a single check against %b.
define void @bounded_offset_reads(ptr %a, ptr %b, i64 %n, i64 %o) {
; CHECK-LABEL: 'bounded_offset_reads'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gb = getelementptr inbounds i32, ptr %b, i64 %iv
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %ga1 = getelementptr inbounds i32, ptr %a, i64 %io
; CHECK-NEXT:      Check 1:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gb = getelementptr inbounds i32, ptr %b, i64 %iv
; CHECK-NEXT:        Against group GRP2:
; CHECK-NEXT:          %ga0 = getelementptr inbounds i32, ptr %a, i64 %iv
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: %b High: ((4 * %n) + %b))
; CHECK-NEXT:            Member: {%b,+,4}<nuw><%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: ((4 * %o) + %a) High: ((4 * %n) + (4 * %o) + %a))
; CHECK-NEXT:            Member: {((4 * %o) + %a),+,4}<%loop>
; CHECK-NEXT:        Group GRP2:
; CHECK-NEXT:          (Low: %a High: ((4 * %n) + %a))
; CHECK-NEXT:            Member: {%a,+,4}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %g = icmp ule i64 %o, 8
  br i1 %g, label %ph, label %exit

ph:
  %pos = icmp sgt i64 %n, 0
  br i1 %pos, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %ph ], [ %iv.next, %loop ]
  %ga0 = getelementptr inbounds i32, ptr %a, i64 %iv
  %v0 = load i32, ptr %ga0, align 4
  %io = add nuw nsw i64 %iv, %o
  %ga1 = getelementptr inbounds i32, ptr %a, i64 %io
  %v1 = load i32, ptr %ga1, align 4
  %sum = add i32 %v0, %v1
  %gb = getelementptr inbounds i32, ptr %b, i64 %iv
  store i32 %sum, ptr %gb, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; for (i = 0; i < n; ++i)
;   b[i] = a[i] + (i < k ? a[i - o] : 0);   // o >= 2^40
;
; a[i - o] may not be accessed, so its bounds may wrap relative to the bounds
; of a[i], even though the guard orders them. The reads of %a must stay in
; separate groups.
define void @ordered_offset_conditional_read(ptr %a, ptr %b, i64 %n, i64 %o, i64 %k) {
; CHECK-LABEL: 'ordered_offset_conditional_read'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gb = getelementptr inbounds i32, ptr %b, i64 %iv
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %ga1 = getelementptr inbounds i32, ptr %a, i64 %io
; CHECK-NEXT:      Check 1:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gb = getelementptr inbounds i32, ptr %b, i64 %iv
; CHECK-NEXT:        Against group GRP2:
; CHECK-NEXT:          %ga0 = getelementptr inbounds i32, ptr %a, i64 %iv
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: %b High: ((4 * %n) + %b))
; CHECK-NEXT:            Member: {%b,+,4}<%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: ((-4 * %o) + %a) High: ((4 * %n) + (-4 * %o) + %a))
; CHECK-NEXT:            Member: {((-4 * %o) + %a),+,4}<%loop>
; CHECK-NEXT:        Group GRP2:
; CHECK-NEXT:          (Low: %a High: ((4 * %n) + %a))
; CHECK-NEXT:            Member: {%a,+,4}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %g = icmp uge i64 %o, 1099511627776
  br i1 %g, label %ph, label %exit

ph:
  %pos = icmp sgt i64 %n, 0
  br i1 %pos, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %ph ], [ %iv.next, %latch ]
  %ga0 = getelementptr inbounds i32, ptr %a, i64 %iv
  %v0 = load i32, ptr %ga0, align 4
  %c = icmp slt i64 %iv, %k
  br i1 %c, label %then, label %latch

then:
  %io = sub i64 %iv, %o
  %ga1 = getelementptr inbounds i32, ptr %a, i64 %io
  %v1 = load i32, ptr %ga1, align 4
  br label %latch

latch:
  %v = phi i32 [ 0, %loop ], [ %v1, %then ]
  %sum = add i32 %v0, %v
  %gb = getelementptr inbounds i32, ptr %b, i64 %iv
  store i32 %sum, ptr %gb, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
