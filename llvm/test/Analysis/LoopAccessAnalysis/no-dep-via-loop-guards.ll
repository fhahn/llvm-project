; CHECK-NEXT:      Expressions re-written:
;
entry:
  %pre.0 = icmp sgt i32 %index, 0
  %pre.1 = icmp slt i32 %index, %n
  %and.pre = select i1 %pre.1, i1 %pre.0, i1 false
  br i1 %and.pre, label %ph, label %exit

