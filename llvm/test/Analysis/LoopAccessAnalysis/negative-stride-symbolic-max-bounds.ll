; A negative-stride store {%p,+,-4} in a loop whose exact backedge-taken count
; is uncomputable (the data-dependent early exit makes the exact BTC
; SCEVCouldNotCompute) and whose no-wrap cannot be proven. This takes the
; symbolic-max "unsigned-max" sentinel path in getStartAndEndForAccess.
;
; The sentinel is a conservative *upper* bound, so for a negative step the
; lower bound must be the minimum address (null), not the sentinel. Check the
; group bounds are sound: Low is null (the minimum) and Low <u High, so a
; runtime overlap check built from them can still fire. Previously the swap
; moved the unsigned-max sentinel into the lower bound, producing an inverted
; range (Low ~= UINT_MAX-4 > High) that could never report a conflict.
define void @negative_stride_uncomputable_btc(ptr %p, i64 %n, ptr %cond, ptr %inv) {
; CHECK-LABEL: 'negative_stride_uncomputable_btc'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %addr = getelementptr i32, ptr %p, i64 %neg
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:        ptr %cond
; CHECK-NEXT:      Check 1:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %addr = getelementptr i32, ptr %p, i64 %neg
; CHECK-NEXT:        Against group GRP2:
; CHECK-NEXT:        ptr %inv
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: null High: (4 + %p))
; CHECK-NEXT:            Member: {%p,+,-4}<%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: %cond High: (4 + %cond))
; CHECK-NEXT:            Member: %cond
; CHECK-NEXT:        Group GRP2:
; CHECK-NEXT:          (Low: %inv High: (4 + %inv))
; CHECK-NEXT:            Member: %inv
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %c = load i32, ptr %cond, align 4
  %z = icmp eq i32 %c, 0
  br i1 %z, label %exit, label %latch

latch:
  %neg = sub i64 0, %iv
  %addr = getelementptr i32, ptr %p, i64 %neg
  %v = load i32, ptr %inv, align 4
  %w = add i32 %v, 1
  store i32 %w, ptr %addr, align 4
  %iv.next = add i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

