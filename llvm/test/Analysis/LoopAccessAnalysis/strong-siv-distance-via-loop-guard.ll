; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 5
; RUN: opt -passes='print<access-info>' -disable-output < %s 2>&1 | FileCheck %s

; Tests for the strong-SIV independence test (isSafeDependenceDistance:
; |Dist| >= MaxBTC * Step + TypeByteSize) when a loop guard bounds the symbolic
; dependence distance from below.
;
; for (i = 0; i < 100; ++i) {
;   a[i + m] = 0;                 // guarded by m >= 100
;   b[i] = a[i];
; }
;
; With m >= 100 and exactly 100 iterations, the stores to a[m..m+99] never
; overlap the loads from a[0..99], so no runtime check is required.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"
target triple = "arm64-apple-macosx"

; Byte-granular (i8) accesses: there is no element-size scaling between the
; element distance and the byte distance, so the guard directly bounds the byte
; distance.
define void @strong_siv_distance_via_guard_i8(ptr %a, ptr noalias %b, i64 %m) {
; CHECK-LABEL: 'strong_siv_distance_via_guard_i8'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gep.store = getelementptr inbounds i8, ptr %a, i64 %im
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %gep.load = getelementptr inbounds i8, ptr %a, i64 %iv
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: (%m + %a) High: (100 + %m + %a))
; CHECK-NEXT:            Member: {(%m + %a),+,1}<nw><%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: %a High: (100 + %a))
; CHECK-NEXT:            Member: {%a,+,1}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %g = icmp sge i64 %m, 100
  br i1 %g, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %im = add nuw nsw i64 %iv, %m
  %gep.store = getelementptr inbounds i8, ptr %a, i64 %im
  store i8 0, ptr %gep.store, align 1
  %gep.load = getelementptr inbounds i8, ptr %a, i64 %iv
  %v = load i8, ptr %gep.load, align 1
  %gep.b = getelementptr inbounds i8, ptr %b, i64 %iv
  store i8 %v, ptr %gep.b, align 1
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 100
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; Same with i32 accesses. The byte distance 4 * m may wrap, so the guard on m
; does not bound it from below.
define void @strong_siv_distance_via_guard_i32(ptr %a, ptr noalias %b, i64 %m) {
; CHECK-LABEL: 'strong_siv_distance_via_guard_i32'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gep.store = getelementptr inbounds i32, ptr %a, i64 %im
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %gep.load = getelementptr inbounds i32, ptr %a, i64 %iv
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: ((4 * %m) + %a) High: (400 + (4 * %m) + %a))
; CHECK-NEXT:            Member: {((4 * %m) + %a),+,4}<%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: %a High: (400 + %a))
; CHECK-NEXT:            Member: {%a,+,4}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %g = icmp sge i64 %m, 100
  br i1 %g, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %im = add nuw nsw i64 %iv, %m
  %gep.store = getelementptr inbounds i32, ptr %a, i64 %im
  store i32 0, ptr %gep.store, align 4
  %gep.load = getelementptr inbounds i32, ptr %a, i64 %iv
  %v = load i32, ptr %gep.load, align 4
  %gep.b = getelementptr inbounds i32, ptr %b, i64 %iv
  store i32 %v, ptr %gep.b, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 100
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; The trip count is symbolic and only bounded by a guard, so the guards are
; needed for both the distance and the maximum backedge-taken count.
define void @strong_siv_distance_and_trip_count_via_guard_i8(ptr %a, ptr noalias %b, i64 %m, i64 %n) {
; CHECK-LABEL: 'strong_siv_distance_and_trip_count_via_guard_i8'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gep.store = getelementptr inbounds i8, ptr %a, i64 %im
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %gep.load = getelementptr inbounds i8, ptr %a, i64 %iv
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: (%m + %a) High: ((1 umax %n) + %m + %a))
; CHECK-NEXT:            Member: {(%m + %a),+,1}<nw><%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: %a High: ((1 umax %n) + %a))
; CHECK-NEXT:            Member: {%a,+,1}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %g.m = icmp sge i64 %m, 100
  %g.n = icmp ule i64 %n, 100
  %g = and i1 %g.m, %g.n
  br i1 %g, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %im = add nuw nsw i64 %iv, %m
  %gep.store = getelementptr inbounds i8, ptr %a, i64 %im
  store i8 0, ptr %gep.store, align 1
  %gep.load = getelementptr inbounds i8, ptr %a, i64 %iv
  %v = load i8, ptr %gep.load, align 1
  %gep.b = getelementptr inbounds i8, ptr %b, i64 %iv
  store i8 %v, ptr %gep.b, align 1
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp uge i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; The guard m >= 99 is not enough for 100 iterations: the store in the first
; iteration writes a[99], which is loaded in the last iteration.
define void @strong_siv_distance_via_guard_too_small_i8(ptr %a, ptr noalias %b, i64 %m) {
; CHECK-LABEL: 'strong_siv_distance_via_guard_too_small_i8'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gep.store = getelementptr inbounds i8, ptr %a, i64 %im
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %gep.load = getelementptr inbounds i8, ptr %a, i64 %iv
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: (%m + %a) High: (100 + %m + %a))
; CHECK-NEXT:            Member: {(%m + %a),+,1}<nw><%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: %a High: (100 + %a))
; CHECK-NEXT:            Member: {%a,+,1}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %g = icmp sge i64 %m, 99
  br i1 %g, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %im = add nuw nsw i64 %iv, %m
  %gep.store = getelementptr inbounds i8, ptr %a, i64 %im
  store i8 0, ptr %gep.store, align 1
  %gep.load = getelementptr inbounds i8, ptr %a, i64 %iv
  %v = load i8, ptr %gep.load, align 1
  %gep.b = getelementptr inbounds i8, ptr %b, i64 %iv
  store i8 %v, ptr %gep.b, align 1
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 100
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
