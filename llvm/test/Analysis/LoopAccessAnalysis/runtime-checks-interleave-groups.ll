entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %idx.0 = shl nuw nsw i64 %iv, 1
  %idx.1 = or disjoint i64 %idx.0, 1
  %gep.a.0 = getelementptr inbounds i32, ptr %a, i64 %idx.0
  %re = load i32, ptr %gep.a.0, align 4
  %gep.a.1 = getelementptr inbounds i32, ptr %a, i64 %idx.1
  %im = load i32, ptr %gep.a.1, align 4
  %mul = mul i32 %re, 3
  %sub = sub i32 %mul, %im
  %add = add i32 %re, %im
  %gep.b.0 = getelementptr inbounds i32, ptr %b, i64 %idx.0
  store i32 %sub, ptr %gep.b.0, align 4
  %gep.b.1 = getelementptr inbounds i32, ptr %b, i64 %idx.1
  store i32 %add, ptr %gep.b.1, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

