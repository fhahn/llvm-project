; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 5
; RUN: opt -passes='print<access-info>' -disable-output < %s 2>&1 | FileCheck %s

; Tests for accesses with a common stride and a symbolic distance, whose residue
; modulo the stride is known from a loop guard.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"
target triple = "arm64-apple-macosx"

; for (i = 0; i < n; ++i)
;   a[2*i + off] = a[2*i] + 1;    // guarded by (off & 1) == 1  =>  off is odd
;
; The load touches only even elements (2*i) and, because off is odd, the store
; touches only odd elements (2*i + off), so the accesses never overlap. The
; byte distance 4*off is 4 modulo the common stride of 8 bytes.
define void @common_stride_odd_offset(ptr %a, i64 %n, i64 %off) {
; CHECK-LABEL: 'common_stride_odd_offset'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gs = getelementptr inbounds i32, ptr %a, i64 %si
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %gl = getelementptr inbounds i32, ptr %a, i64 %two.i
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: ((4 * %off) + %a) High: (-4 + (4 * %off) + (8 * %n) + %a))
; CHECK-NEXT:            Member: {((4 * %off) + %a),+,8}<%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: %a High: (-4 + (8 * %n) + %a))
; CHECK-NEXT:            Member: {%a,+,8}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %odd = and i64 %off, 1
  %g = icmp eq i64 %odd, 1
  br i1 %g, label %ph, label %exit

ph:
  %pos = icmp sgt i64 %n, 0
  br i1 %pos, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %ph ], [ %iv.next, %loop ]
  %two.i = shl nuw nsw i64 %iv, 1
  %gl = getelementptr inbounds i32, ptr %a, i64 %two.i
  %v = load i32, ptr %gl, align 4
  %add = add i32 %v, 1
  %si = add nuw nsw i64 %two.i, %off
  %gs = getelementptr inbounds i32, ptr %a, i64 %si
  store i32 %add, ptr %gs, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; A stride-8-byte access pair over i32 elements (element size 4 < stride 8),
; with the load at byte 8*i and the store at byte 8*i + off, where off is
; guarded to be 6 (mod 8). The byte distance is not a multiple of the 8-byte
; stride (residue 6), but it is also not a multiple of the 4-byte element size:
; the store at [8*i + 6, 8*i + 10) overlaps the load at [8*(i+1), 8*(i+1) + 4)
; of the next iteration. This is a genuine cross-iteration dependence, so a
; nonzero residue alone must not be used to prove independence here.
define void @common_stride_residue_within_element(ptr %a, i64 %n, i64 %off) {
; CHECK-LABEL: 'common_stride_residue_within_element'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gs = getelementptr inbounds i8, ptr %a, i64 %sb
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %gl = getelementptr inbounds i8, ptr %a, i64 %lb
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: (%off + %a) High: (-4 + (8 * %n) + %off + %a))
; CHECK-NEXT:            Member: {(%off + %a),+,8}<nw><%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: %a High: (-4 + (8 * %n) + %a))
; CHECK-NEXT:            Member: {%a,+,8}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %r = urem i64 %off, 8
  %g = icmp eq i64 %r, 6
  br i1 %g, label %ph, label %exit

ph:
  %pos = icmp sgt i64 %n, 0
  br i1 %pos, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %ph ], [ %iv.next, %loop ]
  %lb = shl nuw nsw i64 %iv, 3
  %gl = getelementptr inbounds i8, ptr %a, i64 %lb
  %v = load i32, ptr %gl, align 1
  %add = add i32 %v, 1
  %sb = add nuw nsw i64 %lb, %off
  %gs = getelementptr inbounds i8, ptr %a, i64 %sb
  store i32 %add, ptr %gs, align 1
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; As above, but with off guarded to be 4 (mod 8). The store at
; [8*i + 4, 8*i + 8) falls between the loads at [8*i, 8*i + 4) and
; [8*(i+1), 8*(i+1) + 4), so the accesses are independent.
define void @common_stride_residue_between_elements(ptr %a, i64 %n, i64 %off) {
; CHECK-LABEL: 'common_stride_residue_between_elements'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gs = getelementptr inbounds i8, ptr %a, i64 %sb
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %gl = getelementptr inbounds i8, ptr %a, i64 %lb
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: (%off + %a) High: (-4 + (8 * %n) + %off + %a))
; CHECK-NEXT:            Member: {(%off + %a),+,8}<nw><%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: %a High: (-4 + (8 * %n) + %a))
; CHECK-NEXT:            Member: {%a,+,8}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %r = urem i64 %off, 8
  %g = icmp eq i64 %r, 4
  br i1 %g, label %ph, label %exit

ph:
  %pos = icmp sgt i64 %n, 0
  br i1 %pos, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %ph ], [ %iv.next, %loop ]
  %lb = shl nuw nsw i64 %iv, 3
  %gl = getelementptr inbounds i8, ptr %a, i64 %lb
  %v = load i32, ptr %gl, align 1
  %add = add i32 %v, 1
  %sb = add nuw nsw i64 %lb, %off
  %gs = getelementptr inbounds i8, ptr %a, i64 %sb
  store i32 %add, ptr %gs, align 1
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
