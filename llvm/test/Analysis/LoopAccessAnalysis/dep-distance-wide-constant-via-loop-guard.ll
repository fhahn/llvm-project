; On a target with a >64-bit pointer-index type, a loop guard can collapse the
; dependence distance to a constant whose magnitude does not fit in 64 bits.
; Reasoning about the guarded constant distance must not assume it fits in 64
; bits.

target datalayout = "e-m:o-p:128:128-i64:64-i128:128-n32:64-S128"
target triple = "arm64-apple-macosx"

; for (i = 0; i < ~2^63; ++i)
;   a[2*i + k] = a[2*i] + 1;     // guarded by k == 2^62 + 1 (a >64-bit byte distance)
;
; The guard pins the element distance to the odd constant 2^62 + 1; with a
; common stride of 2 elements (8 bytes) the load (even indices) and store (odd
; indices) fall in disjoint residue classes, so the accesses are independent.
; The byte distance 4 * (2^62 + 1) exceeds 64 bits.
define void @guarded_wide_constant_distance(ptr %A, i128 %k) {
; CHECK-LABEL: 'guarded_wide_constant_distance'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gep.store = getelementptr inbounds i32, ptr %A, i128 %store.i
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %gep.load = getelementptr inbounds i32, ptr %A, i128 %two.i
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: ((4 * %k) + %A) High: (73786976294838206460 + (4 * %k) + %A))
; CHECK-NEXT:            Member: {((4 * %k) + %A),+,8}<%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: %A High: (73786976294838206460 + %A))
; CHECK-NEXT:            Member: {%A,+,8}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %g = icmp eq i128 %k, 4611686018427387905  ; 2^62 + 1
  br i1 %g, label %loop, label %exit

loop:
  %iv = phi i128 [ 0, %entry ], [ %iv.next, %loop ]
  %two.i = shl nsw nuw i128 %iv, 1
  %gep.load = getelementptr inbounds i32, ptr %A, i128 %two.i
  %v = load i32, ptr %gep.load, align 4
  %add = add i32 %v, 1
  %store.i = add nsw nuw i128 %two.i, %k
  %gep.store = getelementptr inbounds i32, ptr %A, i128 %store.i
  store i32 %add, ptr %gep.store, align 4
  %iv.next = add nuw nsw i128 %iv, 1
  %ec = icmp eq i128 %iv.next, 9223372036854775808  ; ~2^63 iters
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
