; The step %d of %j is zero, but only cancels in the canonical form, where the
; use flag on the scaled start is dropped. The canonical of the quadratic
; recurrence %k is the affine recurrence %i.
define void @cancelled_step_quadratic(ptr %dst, i32 %a, i32 %b, i32 %n) {
; CHECK-LABEL: 'cancelled_step_quadratic'
; CHECK-NEXT:  Classifying expressions for: @cancelled_step_quadratic
