; CHECK-NEXT:    %k.next = add i64 %k, %j
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%inner> U: [1,101) S: [1,101) Exits: 100 LoopDispositions: { %inner: Computable, %outer: Uniform }
; CHECK-NEXT:    %i.next = add nuw nsw i64 %i, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%inner> U: [1,101) S: [1,101) Exits: 100 LoopDispositions: { %inner: Computable, %outer: Uniform }
; CHECK-NEXT:    %outer.iv.next = add nuw i32 %outer.iv, 1
; CHECK-NEXT:    --> {(1 + %a),+,1}<nuw><%outer> U: full-set S: full-set Exits: %n LoopDispositions: { %outer: Computable, %inner: Invariant }
; CHECK-NEXT:  Determining loop execution counts for: @cancelled_step_quadratic
; CHECK-NEXT:  Loop %inner: backedge-taken count is i64 99
; CHECK-NEXT:  Loop %inner: constant max backedge-taken count is i64 99
