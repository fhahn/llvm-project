; CHECK-NEXT:    %next = add nuw i32 %iv, 1
; CHECK-NEXT:    --> {(1 + %a),+,1}<nuw><%loop> U: full-set S: full-set Exits: %n LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %bare = mul i32 %a, %b
; CHECK-NEXT:    --> (%a * %b) U: full-set S: full-set
; CHECK-NEXT:  Determining loop execution counts for: @scaled_nuw
; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (-1 * %a) + %n)
