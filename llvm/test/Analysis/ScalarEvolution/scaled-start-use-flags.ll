; CHECK-NEXT:    %inner.gep = getelementptr i8, ptr %dst, i64 %inner.iv.next
; CHECK-NEXT:    --> {(%x + %dst),+,1}<nw><%outer> U: full-set S: full-set Exits: {(%x + %dst),+,1}<nw><%outer> LoopDispositions: { %inner: Invariant, %outer: Computable }
