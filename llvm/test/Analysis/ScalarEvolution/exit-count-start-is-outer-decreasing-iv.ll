; Negative test: %loop1's maximum backedge-taken count comes from %c, which is
; unrelated to %i, so it can exceed the number of steps %i takes and %i's value
; at that iteration count is not a value %i ever holds. The clamp must be kept.
define void @outer_max_btc_exceeds_iv_trajectory(ptr %p, i32 %s, i32 %k) {
; CHECK-LABEL: 'outer_max_btc_exceeds_iv_trajectory'
; CHECK-NEXT:  Determining loop execution counts for: @outer_max_btc_exceeds_iv_trajectory
; CHECK-NEXT:  Loop %loop2: backedge-taken count is ((-1 * (1 umin {%s,+,-1}<nsw><%loop1>))<nuw><nsw> + {%s,+,-1}<nsw><%loop1>)
; CHECK-NEXT:  Loop %loop2: constant max backedge-taken count is i32 -2
; CHECK-NEXT:  Loop %loop2: symbolic max backedge-taken count is ((-1 * (1 umin {%s,+,-1}<nsw><%loop1>))<nuw><nsw> + {%s,+,-1}<nsw><%loop1>)
; CHECK-NEXT:  Loop %loop2: Trip multiple is 1
; CHECK-NEXT:  Loop %loop1: backedge-taken count is (-1 + %k)
; CHECK-NEXT:  Loop %loop1: constant max backedge-taken count is i32 -2
; CHECK-NEXT:  Loop %loop1: symbolic max backedge-taken count is (-1 + %k)
; CHECK-NEXT:  Loop %loop1: Trip multiple is 1
;
entry:
  %kz = icmp eq i32 %k, 0
  br i1 %kz, label %exit, label %loop1

loop1:
  %i = phi i32 [ %s, %entry ], [ %i.dec, %loop1.latch ]
  %c = phi i32 [ 0, %entry ], [ %c.inc, %loop1.latch ]
  br label %loop2

loop2:
  %j = phi i32 [ %i, %loop1 ], [ %j.dec, %loop2 ]
  %j.dec = add nsw i32 %j, -1
  store i8 0, ptr %p, align 1
  %cont = icmp ugt i32 %j, 1
  br i1 %cont, label %loop2, label %loop1.latch

loop1.latch:
  %i.dec = add nsw i32 %i, -1
  %c.inc = add nsw i32 %c, 1
  %done = icmp eq i32 %c.inc, %k
  br i1 %done, label %exit, label %loop1

exit:
  ret void
}
