; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 9223372036854775807
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-2 + (-1 * %start)<nsw> + (4 smin %n)) /u 2)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %S = call i64 @llvm.smin.i64(i64 %n, i64 4)
  %g = icmp slt i64 %start, %S
  br i1 %g, label %loop, label %exit

loop:
  %iv = phi i64 [ %start, %entry ], [ %iv.next, %loop ]
  %gep = getelementptr i64, ptr %A, i64 %iv
  store i64 %iv, ptr %gep
  %iv.next = add nsw i64 %iv, 2
  %c = icmp ne i64 %iv.next, %S
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

; Pointer IV compared against a pointer bound: not handled yet, the guard is
; on the pointers while the exit count is computed on their addresses.
define void @ne_ptr_guarded(ptr %A, i64 %n) {
;
; CHECK-LABEL: 'ne_ptr_guarded'
; CHECK-NEXT:  Determining loop execution counts for: @ne_ptr_guarded
; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (4 umin %n))<nsw>
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 -1
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (4 umin %n))<nsw>
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %len = call i64 @llvm.umin.i64(i64 %n, i64 4)
  %end = getelementptr i8, ptr %A, i64 %len
  %g = icmp ult ptr %A, %end
  br i1 %g, label %loop, label %exit

loop:
  %p = phi ptr [ %A, %entry ], [ %p.next, %loop ]
  store i8 0, ptr %p
  %p.next = getelementptr i8, ptr %p, i64 1
  %c = icmp ne ptr %p.next, %end
  br i1 %c, label %loop, label %exit

exit:
  ret void
}
