; RUN: opt -passes='print<scalar-evolution>' -disable-output %s 2>&1 | FileCheck %s

; Monotonic but non-AddRec recurrences. %idx stays the same or increments by 1
; each iteration (depending on %v), and the containing loop has a computable
; backedge-taken count on %iv. Hence the range of %idx is bounded: at the k-th
; iteration, idx <= k. At loop exit, idx <= trip_count.
;
; SCEV sees %idx as SCEVUnknown with a full-set range and drops exits to
; <<Unknown>>. A targeted pattern match in createNodeForPHI for monotonic PHIs
; whose step is a non-negative loop-invariant or zero (via select/PHI) could
; bound %idx via the enclosing loop trip count.

define i32 @conditional_increment(i32 %n, ptr %p) {
; CHECK-LABEL: 'conditional_increment'
; CHECK-NEXT:  Classifying expressions for: @conditional_increment
; CHECK-NEXT:    %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop.latch ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%loop> U: [0,2147483647) S: [0,2147483647) Exits: (-1 + (1 smax %n))<nsw> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %idx = phi i32 [ 0, %entry ], [ %idx.next, %loop.latch ]
; CHECK-NEXT:    --> %idx U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Variant }
; CHECK-NEXT:    %gep = getelementptr i32, ptr %p, i32 %idx
; CHECK-NEXT:    --> ((4 * (sext i32 %idx to i64))<nsw> + %p) U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Variant }
; CHECK-NEXT:    %v = load i32, ptr %gep, align 4
; CHECK-NEXT:    --> %v U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Variant }
; CHECK-NEXT:    %bumped = add nuw i32 %idx, 1
; CHECK-NEXT:    --> (1 + %idx) U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Variant }
; CHECK-NEXT:    %idx.next = select i1 %c, i32 %idx, i32 %bumped
; CHECK-NEXT:    --> %idx.next U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Variant }
; CHECK-NEXT:    %iv.next = add nuw nsw i32 %iv, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%loop> U: [1,-2147483648) S: [1,-2147483648) Exits: (1 smax %n) LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %r = phi i32 [ %idx, %loop.latch ]
; CHECK-NEXT:    --> %idx U: full-set S: full-set
; CHECK-NEXT:  Determining loop execution counts for: @conditional_increment
; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (1 smax %n))<nsw>
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 2147483646
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (1 smax %n))<nsw>
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %idx = phi i32 [ 0, %entry ], [ %idx.next, %loop.latch ]
  %gep = getelementptr i32, ptr %p, i32 %idx
  %v = load i32, ptr %gep
  %c = icmp eq i32 %v, 0
  %bumped = add nuw i32 %idx, 1
  %idx.next = select i1 %c, i32 %idx, i32 %bumped
  br label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i32 %iv, 1
  %cmp = icmp slt i32 %iv.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  %r = phi i32 [ %idx, %loop.latch ]
  ret i32 %r
}
