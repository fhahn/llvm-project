; Inner loop %inner starts at the outer IV %j and runs while %i.next <s %n.
; %n >= %j follows by induction from the outer latch, so the BTC does not need
; an smax.
define void @slt_guard_n_pos(ptr %p, i32 %n) {
;
;
; CHECK-LABEL: 'slt_guard_n_pos'
; CHECK-NEXT:  Determining loop execution counts for: @slt_guard_n_pos
; CHECK-NEXT:  Loop %inner: backedge-taken count is {(-1 + %n),+,-1}<nw><%outer>
; CHECK-NEXT:  Loop %inner: constant max backedge-taken count is i32 2147483646
; CHECK-NEXT:  Loop %inner: symbolic max backedge-taken count is {(-1 + %n),+,-1}<nw><%outer>
; CHECK-NEXT:  Loop %inner: Trip multiple is 1
; CHECK-NEXT:  Loop %outer: backedge-taken count is (-1 + %n)
; CHECK-NEXT:  Loop %outer: constant max backedge-taken count is i32 2147483646
; CHECK-NEXT:  Loop %outer: symbolic max backedge-taken count is (-1 + %n)
; CHECK-NEXT:  Loop %outer: Trip multiple is 1
;
entry:
  %pos = icmp sgt i32 %n, 0
  br i1 %pos, label %outer, label %exit

outer:
  %j = phi i32 [ 0, %entry ], [ %j.next, %outer.latch ]
  br label %inner

inner:
  %i = phi i32 [ %j, %outer ], [ %i.next, %inner ]
  %gep = getelementptr inbounds i32, ptr %p, i32 %i
  store i32 %i, ptr %gep, align 4
  %i.next = add nuw nsw i32 %i, 1
  %ec = icmp slt i32 %i.next, %n
  br i1 %ec, label %inner, label %outer.latch

outer.latch:
  %j.next = add nuw nsw i32 %j, 1
  %ec.outer = icmp slt i32 %j.next, %n
  br i1 %ec.outer, label %outer, label %exit

exit:
  ret void
}

