; RUN: opt -passes='print<scalar-evolution>' -disable-output %s 2>&1 | FileCheck %s

; Adding a loop-invariant to an AddRec loses precision on wrap flags. The
; IR `add nsw i32 %iv, %c` looks like it should let the resulting AddRec
; inherit <nsw>, but SCEV does not propagate the flag because doing so
; safely in general requires proving the post-inc expression is never poison
; (and the result of %off here is not weaponized into UB).

define i32 @add_nsw_iv_plus_invariant(i32 %c) {
; CHECK-LABEL: 'add_nsw_iv_plus_invariant'
; CHECK-NEXT:  Classifying expressions for: @add_nsw_iv_plus_invariant
; CHECK-NEXT:    %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%loop> U: [0,100) S: [0,100) Exits: 99 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %off = add nsw i32 %iv, %c
; CHECK-NEXT:    --> {%c,+,1}<nw><%loop> U: full-set S: full-set Exits: (99 + %c) LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %iv.next = add nuw nsw i32 %iv, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%loop> U: [1,101) S: [1,101) Exits: 100 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %r = phi i32 [ %off, %loop ]
; CHECK-NEXT:    --> {%c,+,1}<nw><%loop> U: full-set S: full-set --> (99 + %c) U: full-set S: full-set
; CHECK-NEXT:  Determining loop execution counts for: @add_nsw_iv_plus_invariant
; CHECK-NEXT:  Loop %loop: backedge-taken count is i32 99
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 99
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 99
; CHECK-NEXT:  Loop %loop: Trip multiple is 100
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %off = add nsw i32 %iv, %c
  %iv.next = add nuw nsw i32 %iv, 1
  %cmp = icmp slt i32 %iv.next, 100
  br i1 %cmp, label %loop, label %exit

exit:
  %r = phi i32 [ %off, %loop ]
  ret i32 %r
}

