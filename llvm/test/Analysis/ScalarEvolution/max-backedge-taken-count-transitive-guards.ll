define void @guards_on_incoming_values(i8 %choose, i8 range(i8 1, 0) %a, i8 range(i8 1, 0) %b) {
; CHECK-LABEL: 'guards_on_incoming_values'
; CHECK-NEXT:  Determining loop execution counts for: @guards_on_incoming_values
; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + %end)<nsw>
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 11
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + %end)<nsw>
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %c = icmp eq i8 %choose, 0
  br i1 %c, label %left, label %right

left:
  %guard.a = icmp ult i8 %a, 13
  br i1 %guard.a, label %loop.ph, label %exit

right:
  %guard.b = icmp ult i8 %b, 9
  br i1 %guard.b, label %loop.ph, label %exit

loop.ph:
  %end = phi i8 [ %a, %left ], [ %b, %right ]
  br label %loop

loop:
  %iv = phi i8 [ 0, %loop.ph ], [ %iv.next, %loop ]
  %iv.next = add nuw i8 %iv, 1
  %ec = icmp ult i8 %iv.next, %end
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}

