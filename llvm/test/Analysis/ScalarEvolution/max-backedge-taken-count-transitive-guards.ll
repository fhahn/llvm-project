; Incoming computations need not dominate the loop header.
define void @incoming_expressions(i8 %choose, i8 range(i8 1, 0) %a, ptr %out) {
; CHECK-LABEL: 'incoming_expressions'
; CHECK-NEXT:  Determining loop execution counts for: @incoming_expressions
; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (1 umax %merged))<nsw>
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 11
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (1 umax %merged))<nsw>
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %select = icmp eq i8 %choose, 0
  br i1 %select, label %left, label %right
left:
  %la = add i8 %a, 0
  %ga = icmp ult i8 %la, 13
  br i1 %ga, label %join, label %exit
right:
  %ra = xor i8 %a, 0
  %gb = icmp ult i8 %ra, 9
  br i1 %gb, label %join, label %exit
join:
  %merged = phi i8 [ %la, %left ], [ %ra, %right ]
  br label %loop
loop:
  %iv = phi i8 [ 0, %join ], [ %next, %loop ]
  store volatile i8 %iv, ptr %out
  %next = add nuw i8 %iv, 1
  %more = icmp ult i8 %next, %merged
  br i1 %more, label %loop, label %exit
exit:
  ret void
}
