; Guards can reach a loop bound through arithmetic chains or through incoming
; PHI values, including PHIs that SCEV folds away.

define void @guard_on_arith_chain(i8 range(i8 1, 64) %n) {
; CHECK-LABEL: 'guard_on_arith_chain'
; CHECK-NEXT:  Determining loop execution counts for: @guard_on_arith_chain
; CHECK-NEXT:  Loop %loop: backedge-taken count is (2 * %n)<nuw><nsw>
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 14
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (2 * %n)<nuw><nsw>
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %twice = shl nuw i8 %n, 1
  %end = add nuw i8 %twice, 1
  %guard = icmp ult i8 %end, 16
  br i1 %guard, label %loop, label %exit

loop:
  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop ]
  %iv.next = add nuw i8 %iv, 1
  %ec = icmp ult i8 %iv.next, %end
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}

