; Test that the rewrites of collected guard expressions are finalized after
; the rewrites of the expressions they contain. Here, the guard on
; umin(%n, zext(64 - %k)) also rewrites its operand zext(64 - %k), whose operand
; %k is bounded by the assume.

define void @umin_uge_16(i64 %n, i8 %k) {
; CHECK-LABEL: 'umin_uge_16'
; CHECK-NEXT:  Determining loop execution counts for: @umin_uge_16
; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-16 + (16 * (zext i3 (trunc i64 (((zext i8 (64 + (-1 * %k)) to i64) umin %n) /u 16) to i3) to i64))<nuw><nsw>)<nsw> /u 16)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 3
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-16 + (16 * (zext i3 (trunc i64 (((zext i8 (64 + (-1 * %k)) to i64) umin %n) /u 16) to i3) to i64))<nuw><nsw>)<nsw> /u 16)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %k.ule.64 = icmp ule i8 %k, 64
  call void @llvm.assume(i1 %k.ule.64)
  %sub = sub i8 64, %k
  %sub.ext = zext i8 %sub to i64
  %tc = call i64 @llvm.umin.i64(i64 %n, i64 %sub.ext)
  %tc.ult.16 = icmp ult i64 %tc, 16
  br i1 %tc.ult.16, label %exit, label %ph

ph:
  %n.vec = and i64 %tc, 112
  br label %loop

loop:
  %iv = phi i64 [ 0, %ph ], [ %iv.next, %loop ]
  %iv.next = add i64 %iv, 16
  %ec = icmp eq i64 %iv.next, %n.vec
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

