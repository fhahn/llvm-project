; smin(%a, %c) <=s %x, then smin(%a, %c) >=s 4. The first guard rewrites
; smin(%a, %c) to smin(%a, %c, %x), so the second also gives %x >= 4 and the
; max BTC is 15.
define void @smin_sle_x_then_sge_4(ptr %p, i32 %a, i32 %c, i32 %y) {
; CHECK-LABEL: 'smin_sle_x_then_sge_4'
; CHECK-NEXT:  Determining loop execution counts for: @smin_sle_x_then_sge_4
; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-4 + (4 * (zext i5 (trunc i32 ((64 smin (1 + %y)<nsw>) /u 4) to i5) to i32))<nuw><nsw>)<nsw> /u 4)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 15
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-4 + (4 * (zext i5 (trunc i32 ((64 smin (1 + %y)<nsw>) /u 4) to i5) to i32))<nuw><nsw>)<nsw> /u 4)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %x = add nsw i32 %y, 1
  %m = call i32 @llvm.smin.i32(i32 %a, i32 %c)
  %c.1 = icmp sle i32 %m, %x
  br i1 %c.1, label %guard.2, label %exit

guard.2:
  %c.2 = icmp sge i32 %m, 4
  br i1 %c.2, label %ph, label %exit

ph:
  %x.min = call i32 @llvm.smin.i32(i32 %x, i32 64)
  %n = and i32 %x.min, 124
  br label %loop

loop:
  %iv = phi i32 [ 0, %ph ], [ %iv.next, %loop ]
  %gep = getelementptr i32, ptr %p, i32 %iv
  store i32 0, ptr %gep, align 4
  %iv.next = add i32 %iv, 4
  %ec = icmp eq i32 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

