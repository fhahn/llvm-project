; A guard on a min/max expression is also applied to its operands
; ('min(a, b) >= c' -> 'a >= c' and 'b >= c'). Test that this also happens
; when an earlier guard already rewrote the expression.

; smin(%a, %b) >s 0, then smin(%a, %b) >=s 4: %b >= 4, max BTC is 15.
define void @smin_sgt_0_then_sge_4(ptr %p, i32 %a, i32 %b) {
;
;
; CHECK-LABEL: 'smin_sgt_0_then_sge_4'
; CHECK-NEXT:  Determining loop execution counts for: @smin_sgt_0_then_sge_4
; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-4 + (4 * (zext i5 (trunc i32 ((64 smin %b) /u 4) to i5) to i32))<nuw><nsw>)<nsw> /u 4)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 15
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-4 + (4 * (zext i5 (trunc i32 ((64 smin %b) /u 4) to i5) to i32))<nuw><nsw>)<nsw> /u 4)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %m = call i32 @llvm.smin.i32(i32 %a, i32 %b)
  %c.1 = icmp sgt i32 %m, 0
  br i1 %c.1, label %guard.2, label %exit

guard.2:
  %c.2 = icmp sge i32 %m, 4
  br i1 %c.2, label %ph, label %exit

ph:
  %b.min = call i32 @llvm.smin.i32(i32 %b, i32 64)
  %n = and i32 %b.min, 124
  br label %loop

loop:
  %iv = phi i32 [ 0, %ph ], [ %iv.next, %loop ]
  %gep = getelementptr i32, ptr %p, i32 %iv
  store i32 0, ptr %gep
  %iv.next = add i32 %iv, 4
  %ec = icmp eq i32 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

