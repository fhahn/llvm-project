; A guard LHS pred RHS also bounds RHS by the range of LHS: %a >=s 4 and
; %a <=s %x imply %x >=s 4. The loops below run to (smin(%x, 64) & 124) in
; steps of 4, so their max BTC is 15 if %x >=s 4 is known.

define void @a_sge_4_then_a_sle_x(ptr %p, i32 %a, i32 %y) {
; CHECK-LABEL: 'a_sge_4_then_a_sle_x'
; CHECK-NEXT:  Determining loop execution counts for: @a_sge_4_then_a_sle_x
; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-4 + (4 * (zext i5 (trunc i32 ((64 smin (1 + %y)) /u 4) to i5) to i32))<nuw><nsw>)<nsw> /u 4)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 15
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-4 + (4 * (zext i5 (trunc i32 ((64 smin (1 + %y)) /u 4) to i5) to i32))<nuw><nsw>)<nsw> /u 4)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %x = add nsw i32 %y, 1
  %c.1 = icmp sge i32 %a, 4
  br i1 %c.1, label %guard.2, label %exit

guard.2:
  %c.2 = icmp sle i32 %a, %x
  br i1 %c.2, label %ph, label %exit

ph:
  %x.min = call i32 @llvm.smin.i32(i32 %x, i32 64)
  %n = and i32 %x.min, 124
  br label %loop

loop:
  %iv = phi i32 [ 0, %ph ], [ %iv.next, %loop ]
  %gep = getelementptr i32, ptr %p, i32 %iv
  store i32 0, ptr %gep, align 4
  %iv.next = add i32 %iv, 4
  %ec = icmp eq i32 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

