; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 5
; RUN: opt -passes='print<scalar-evolution>' -disable-output %s 2>&1 | FileCheck %s

; `or` on a value whose low bits are known zero is equivalent to `add`
; (or more specifically, to `or disjoint`). ScalarEvolution handles
; `or disjoint` by forming an AddRec, but for a plain `or` it falls through to
; SCEVUnknown even when the IR-level known-bits analysis would prove the or
; acts as an add.
;
; @or_plain: %iv steps by 4 starting at 0, so the low 2 bits are always zero.
; `or %iv, 3` is therefore equivalent to `%iv + 3`. SCEV could produce
; `{3,+,4}<nuw><nsw>` but only does so when the IR carries the explicit
; `disjoint` flag (@or_disjoint).

define i32 @or_plain() {
; CHECK-LABEL: 'or_plain'
; CHECK-NEXT:  Classifying expressions for: @or_plain
; CHECK-NEXT:    %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
; CHECK-NEXT:    --> {0,+,4}<nuw><nsw><%loop> U: [0,97) S: [0,97) Exits: 96 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %or = or i32 %iv, 3
; CHECK-NEXT:    --> %or U: [3,-2147483648) S: [3,-2147483648) Exits: 99 LoopDispositions: { %loop: Variant }
; CHECK-NEXT:    %iv.next = add nuw nsw i32 %iv, 4
; CHECK-NEXT:    --> {4,+,4}<nuw><nsw><%loop> U: [4,101) S: [4,101) Exits: 100 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %r = phi i32 [ %or, %loop ]
; CHECK-NEXT:    --> %or U: [3,-2147483648) S: [3,-2147483648) --> 99 U: [99,100) S: [99,100)
; CHECK-NEXT:  Determining loop execution counts for: @or_plain
; CHECK-NEXT:  Loop %loop: backedge-taken count is i32 24
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 24
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 24
; CHECK-NEXT:  Loop %loop: Trip multiple is 25
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %or = or i32 %iv, 3
  %iv.next = add nuw nsw i32 %iv, 4
  %cmp = icmp slt i32 %iv.next, 100
  br i1 %cmp, label %loop, label %exit

exit:
  %r = phi i32 [ %or, %loop ]
  ret i32 %r
}

