; CHECK-NEXT:    --> (-1 + (zext i32 %n to i64))<nsw> U: [-1,4294967295) S: [-1,4294967295)
; CHECK-NEXT:    %j = phi i64 [ 0, %outer.ph ], [ %j.next, %outer.latch ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%outer> U: [0,2147483647) S: [0,2147483647) Exits: <<Unknown>> LoopDispositions: { %outer: Computable }
; CHECK-NEXT:    %pos = call i1 @cond()
; CHECK-NEXT:    --> %pos U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %outer: Variant }
; CHECK-NEXT:    %j.next = add nuw nsw i64 %j, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%outer> U: [1,2147483648) S: [1,2147483648) Exits: <<Unknown>> LoopDispositions: { %outer: Computable }
; CHECK-NEXT:    %k = phi i64 [ %k.next, %countdown ], [ %s, %outer ]
; CHECK-NEXT:    --> {%s,+,-1}<nsw><%countdown> U: full-set S: full-set Exits: {0,+,1}<nuw><nsw><%outer> LoopDispositions: { %countdown: Computable }
; CHECK-NEXT:    %k.next = add nsw i64 %k, -1
; CHECK-NEXT:    --> {(-1 + %s),+,-1}<nw><%countdown> U: full-set S: full-set Exits: {-1,+,1}<nsw><%outer> LoopDispositions: { %countdown: Computable }
; CHECK-NEXT:  Determining loop execution counts for: @guard_ge_recurrence_max
; CHECK-NEXT:  Loop %countdown: backedge-taken count is {%s,+,-1}<nw><%outer>
; CHECK-NEXT:  Loop %countdown: constant max backedge-taken count is i64 9223372036854775807
; CHECK-NEXT:  Loop %countdown: symbolic max backedge-taken count is {%s,+,-1}<nw><%outer>
; CHECK-NEXT:  Loop %countdown: Trip multiple is 1
; CHECK-NEXT:  Loop %outer: <multiple exits> Unpredictable backedge-taken count.
; CHECK-NEXT:    exit count for outer: ***COULDNOTCOMPUTE***
; CHECK-NEXT:    exit count for outer.latch: (-1 + (zext i32 %n to i64))<nsw>
; CHECK-NEXT:  Loop %outer: constant max backedge-taken count is i64 2147483646
; CHECK-NEXT:  Loop %outer: symbolic max backedge-taken count is (-1 + (zext i32 %n to i64))<nsw>
; CHECK-NEXT:    symbolic max exit count for outer: ***COULDNOTCOMPUTE***
; CHECK-NEXT:    symbolic max exit count for outer.latch: (-1 + (zext i32 %n to i64))<nsw>
;
entry:
  %c = icmp sgt i32 %n, 0
  br i1 %c, label %guard, label %exit

guard:
  %wtc = zext nneg i32 %n to i64
  %bound = add i64 %wtc, -1
  %g = icmp sge i64 %s, %bound
  br i1 %g, label %outer.ph, label %exit

outer.ph:
  br label %outer

outer:
  %j = phi i64 [ 0, %outer.ph ], [ %j.next, %outer.latch ]
  %pos = call i1 @cond()
  br i1 %pos, label %outer.latch, label %countdown

outer.latch:
  %j.next = add nuw nsw i64 %j, 1
  %done = icmp eq i64 %j.next, %wtc
  br i1 %done, label %exit, label %outer

countdown:
  %k = phi i64 [ %k.next, %countdown ], [ %s, %outer ]
  %k.next = add nsw i64 %k, -1
  store i64 %k.next, ptr %p, align 8
  %gt = icmp sgt i64 %k, %j
  br i1 %gt, label %countdown, label %exit

exit:
  ret void
}

; Negative: the surrounding loop's backedge-taken count is expressed in a type
; (i64, from the %cnt counter) wider than the surrounding IV %j (i32). Extending
; the count could underestimate the recurrence's last value, so the TooWide
; guard bails and the clamp is preserved.
define void @outer_count_wider_than_iv(i64 %m, i32 %s, ptr %p) {
; CHECK-LABEL: 'outer_count_wider_than_iv'
; CHECK-NEXT:  Classifying expressions for: @outer_count_wider_than_iv
; CHECK-NEXT:    %j = phi i32 [ 0, %outer.ph ], [ %j.next, %outer.latch ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%outer> U: [0,-2147483648) S: [0,-2147483648) Exits: (-1 + (trunc i64 %m to i32)) LoopDispositions: { %outer: Computable, %countdown: Invariant }
; CHECK-NEXT:    %cnt = phi i64 [ 0, %outer.ph ], [ %cnt.next, %outer.latch ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%outer> U: [0,-9223372036854775808) S: [0,-9223372036854775808) Exits: (-1 + %m) LoopDispositions: { %outer: Computable, %countdown: Invariant }
; CHECK-NEXT:    %k = phi i32 [ %s, %outer ], [ %k.next, %countdown ]
; CHECK-NEXT:    --> {%s,+,-1}<nsw><%countdown> U: full-set S: full-set Exits: ({0,+,1}<nuw><nsw><%outer> smin %s) LoopDispositions: { %countdown: Computable, %outer: Uniform }
; CHECK-NEXT:    %k.next = add nsw i32 %k, -1
; CHECK-NEXT:    --> {(-1 + %s),+,-1}<nw><%countdown> U: full-set S: full-set Exits: (-1 + ({0,+,1}<nuw><nsw><%outer> smin %s)) LoopDispositions: { %countdown: Computable, %outer: Uniform }
; CHECK-NEXT:    %j.next = add nsw i32 %j, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><%outer> U: [1,0) S: [1,0) Exits: (trunc i64 %m to i32) LoopDispositions: { %outer: Computable, %countdown: Invariant }
; CHECK-NEXT:    %cnt.next = add nsw i64 %cnt, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%outer> U: [1,-9223372036854775808) S: [1,-9223372036854775808) Exits: %m LoopDispositions: { %outer: Computable, %countdown: Invariant }
; CHECK-NEXT:  Determining loop execution counts for: @outer_count_wider_than_iv
; CHECK-NEXT:  Loop %countdown: backedge-taken count is ((-1 * ({0,+,1}<nuw><nsw><%outer> smin %s)) + %s)
; CHECK-NEXT:  Loop %countdown: constant max backedge-taken count is i32 2147483647
; CHECK-NEXT:  Loop %countdown: symbolic max backedge-taken count is ((-1 * ({0,+,1}<nuw><nsw><%outer> smin %s)) + %s)
; CHECK-NEXT:  Loop %countdown: Trip multiple is 1
; CHECK-NEXT:  Loop %outer: backedge-taken count is (-1 + %m)
; CHECK-NEXT:  Loop %outer: constant max backedge-taken count is i64 -2
; CHECK-NEXT:  Loop %outer: symbolic max backedge-taken count is (-1 + %m)
; CHECK-NEXT:  Loop %outer: Trip multiple is 1
;
entry:
  %pos = icmp ugt i64 %m, 0
  br i1 %pos, label %guard, label %exit

guard:
  %g = icmp sge i32 %s, 2000000000
  br i1 %g, label %outer.ph, label %exit

outer.ph:
  br label %outer

outer:
  %j = phi i32 [ 0, %outer.ph ], [ %j.next, %outer.latch ]
  %cnt = phi i64 [ 0, %outer.ph ], [ %cnt.next, %outer.latch ]
  br label %countdown

countdown:
  %k = phi i32 [ %s, %outer ], [ %k.next, %countdown ]
  %k.next = add nsw i32 %k, -1
  store i32 %k.next, ptr %p, align 4
  %gt = icmp sgt i32 %k, %j
  br i1 %gt, label %countdown, label %outer.latch

outer.latch:
  %j.next = add nsw i32 %j, 1
  %cnt.next = add nsw i64 %cnt, 1
  %done = icmp eq i64 %cnt.next, %m
  br i1 %done, label %exit, label %outer

exit:
  ret void
}

; Negative: the surrounding loop has a single, symbolic-trip latch exit, so its
; constant max backedge-taken count is the full type range (-1). The no-wrap
; endpoint check then compares Start(RHS) against RHS-at-(2^64-1), which is
; Start-1, so it cannot prove no-wrap and the clamp is preserved even though the
; guard would otherwise supply Start >= RHS-max.
define void @outer_full_range_const_max(i64 %b, i64 %s, ptr %p) {
; CHECK-LABEL: 'outer_full_range_const_max'
; CHECK-NEXT:  Classifying expressions for: @outer_full_range_const_max
; CHECK-NEXT:    %j = phi i64 [ 0, %outer.ph ], [ %j.next, %outer.latch ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%outer> U: [0,-9223372036854775808) S: [0,-9223372036854775808) Exits: (-1 + %b) LoopDispositions: { %outer: Computable, %countdown: Invariant }
; CHECK-NEXT:    %k = phi i64 [ %s, %outer ], [ %k.next, %countdown ]
; CHECK-NEXT:    --> {%s,+,-1}<nsw><%countdown> U: full-set S: full-set Exits: ({0,+,1}<nuw><nsw><%outer> smin %s) LoopDispositions: { %countdown: Computable, %outer: Uniform }
; CHECK-NEXT:    %k.next = add nsw i64 %k, -1
; CHECK-NEXT:    --> {(-1 + %s),+,-1}<nw><%countdown> U: full-set S: full-set Exits: (-1 + ({0,+,1}<nuw><nsw><%outer> smin %s)) LoopDispositions: { %countdown: Computable, %outer: Uniform }
; CHECK-NEXT:    %j.next = add nuw nsw i64 %j, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%outer> U: [1,-9223372036854775808) S: [1,-9223372036854775808) Exits: %b LoopDispositions: { %outer: Computable, %countdown: Invariant }
; CHECK-NEXT:  Determining loop execution counts for: @outer_full_range_const_max
; CHECK-NEXT:  Loop %countdown: backedge-taken count is ((-1 * ({0,+,1}<nuw><nsw><%outer> smin %s)) + %s)
; CHECK-NEXT:  Loop %countdown: constant max backedge-taken count is i64 9223372036854775807
; CHECK-NEXT:  Loop %countdown: symbolic max backedge-taken count is ((-1 * ({0,+,1}<nuw><nsw><%outer> smin %s)) + %s)
; CHECK-NEXT:  Loop %countdown: Trip multiple is 1
; CHECK-NEXT:  Loop %outer: backedge-taken count is (-1 + %b)
; CHECK-NEXT:  Loop %outer: constant max backedge-taken count is i64 -1
; CHECK-NEXT:  Loop %outer: symbolic max backedge-taken count is (-1 + %b)
; CHECK-NEXT:  Loop %outer: Trip multiple is 1
;
entry:
  %g = icmp sge i64 %s, %b
  br i1 %g, label %outer.ph, label %exit

outer.ph:
  br label %outer

outer:
  %j = phi i64 [ 0, %outer.ph ], [ %j.next, %outer.latch ]
  br label %countdown

countdown:
  %k = phi i64 [ %s, %outer ], [ %k.next, %countdown ]
  %k.next = add nsw i64 %k, -1
  store i64 %k.next, ptr %p, align 8
  %gt = icmp sgt i64 %k, %j
  br i1 %gt, label %countdown, label %outer.latch

outer.latch:
  %j.next = add nuw nsw i64 %j, 1
  %done = icmp eq i64 %j.next, %b
  br i1 %done, label %exit, label %outer

exit:
  ret void
}

declare i1 @cond()
