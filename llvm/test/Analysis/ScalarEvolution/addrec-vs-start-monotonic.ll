; RUN: opt -disable-output -passes='loop-simplify,print<scalar-evolution>' %s 2>&1 | FileCheck %s

; The %up loop has no computable exit count, so its recurrence stays an operand
; of the exit count of %down rather than being evaluated to a closed form. The
; recurrence has nuw, so it cannot be unsigned-below the %start it began at, and
; the umin against %start folds away.
define void @dec_to_start_of_nuw_ptr_addrec(ptr %start, i32 %n) {
; CHECK-LABEL: 'dec_to_start_of_nuw_ptr_addrec'
; CHECK-NEXT:  Classifying expressions for: @dec_to_start_of_nuw_ptr_addrec
; CHECK-NEXT:    %p = phi ptr [ %start, %entry ], [ %p.next, %up.latch ]
; CHECK-NEXT:    --> {%start,+,1}<nuw><%up> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %up: Computable }
; CHECK-NEXT:    %v = phi i32 [ %n, %entry ], [ %v.next, %up.latch ]
; CHECK-NEXT:    --> %v U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %up: Variant }
; CHECK-NEXT:    %p.next = getelementptr nuw i8, ptr %p, i64 1
; CHECK-NEXT:    --> {(1 + %start),+,1}<nw><%up> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %up: Computable }
; CHECK-NEXT:    %v.next = mul i32 %v, 10
; CHECK-NEXT:    --> (10 * %v) U: [0,-1) S: [-2147483648,2147483647) Exits: <<Unknown>> LoopDispositions: { %up: Variant }
; CHECK-NEXT:    %q = phi ptr [ %q.next, %down.latch ], [ %p, %down.preheader ]
; CHECK-NEXT:    --> {{\{\{}}%start,+,1}<nuw><%up>,+,-1}<%down> U: full-set S: full-set Exits: %start LoopDispositions: { %down: Computable }
; CHECK-NEXT:    %q.next = getelementptr i8, ptr %q, i64 -1
; CHECK-NEXT:    --> {{\{\{}}(-1 + %start),+,1}<nw><%up>,+,-1}<%down> U: full-set S: full-set Exits: (-1 + %start) LoopDispositions: { %down: Computable }
; CHECK-NEXT:  Determining loop execution counts for: @dec_to_start_of_nuw_ptr_addrec
; CHECK-NEXT:  Loop %down: backedge-taken count is {0,+,1}<nuw><%up>
; CHECK-NEXT:  Loop %down: constant max backedge-taken count is i64 -1
; CHECK-NEXT:  Loop %down: symbolic max backedge-taken count is {0,+,1}<nuw><%up>
; CHECK-NEXT:  Loop %down: Trip multiple is 1
; CHECK-NEXT:  Loop %up: Unpredictable backedge-taken count.
; CHECK-NEXT:  Loop %up: Unpredictable constant max backedge-taken count.
; CHECK-NEXT:  Loop %up: Unpredictable symbolic max backedge-taken count.
;
entry:
  br label %up

up:
  %p = phi ptr [ %start, %entry ], [ %p.next, %up.latch ]
  %v = phi i32 [ %n, %entry ], [ %v.next, %up.latch ]
  %pos = icmp sgt i32 %v, 0
  br i1 %pos, label %up.latch, label %down

up.latch:
  %p.next = getelementptr nuw i8, ptr %p, i64 1
  %v.next = mul i32 %v, 10
  br label %up

down:
  %q = phi ptr [ %p, %up ], [ %q.next, %down.latch ]
  %in.range = icmp ugt ptr %q, %start
  br i1 %in.range, label %down.latch, label %exit

down.latch:
  %q.next = getelementptr i8, ptr %q, i64 -1
  br label %down

exit:
  ret void
}

