; Test that SCEVLoopInvariantLoad is computed correctly for various loop
; patterns with invariant-address loads in the exit condition.

; Basic: iv.next < load(ptr), signed
define void @load_exit_slt(ptr %ptr, ptr %dst) {
; CHECK-LABEL: 'load_exit_slt'
; CHECK-NEXT:  Classifying expressions for: @load_exit_slt
; CHECK-NEXT:    %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%loop> U: [0,2147483647) S: [0,2147483647) Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %p = getelementptr i8, ptr %dst, i32 %iv
; CHECK-NEXT:    --> {%dst,+,1}<nw><%loop> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %iv.next = add nuw nsw i32 %iv, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%loop> U: [1,-2147483648) S: [1,-2147483648) Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %limit = load i32, ptr %ptr, align 4
; CHECK-NEXT:    --> %limit U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Variant }
; CHECK-NEXT:  Determining loop execution counts for: @load_exit_slt
; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 2147483646
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 2147483646
; CHECK-NEXT:  Loop %loop: Predicated backedge-taken count is (-1 + (1 smax invariant.load(%ptr, i32)))<nsw>
; CHECK-NEXT:   Predicates:
; CHECK-NEXT:  Loop %loop: Predicated symbolic max backedge-taken count is (-1 + (1 smax invariant.load(%ptr, i32)))<nsw>
; CHECK-NEXT:   Predicates:
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %p = getelementptr i8, ptr %dst, i32 %iv
  store i8 0, ptr %p
  %iv.next = add nuw nsw i32 %iv, 1
  %limit = load i32, ptr %ptr
  %cmp = icmp slt i32 %iv.next, %limit
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

