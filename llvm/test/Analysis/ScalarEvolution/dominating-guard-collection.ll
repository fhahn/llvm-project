; RUN: opt -disable-output "-passes=print<scalar-evolution>" < %s 2>&1 | FileCheck %s
;
; The useful guard is beyond an unrelated branch and a merge. Collecting loop
; guards must still find it when implication proofs use only the nearest
; dominating branch condition. The backedge-taken count should not contain umax.
;
define void @farther_loop_guard(ptr %p, i1 %c, i1 %flag) {
; CHECK-LABEL: 'farther_loop_guard'
; CHECK-NEXT:  Classifying expressions for: @farther_loop_guard
; CHECK-NEXT:    %n = load i32, ptr %p, align 4
; CHECK-NEXT:    --> %n U: full-set S: full-set
; CHECK-NEXT:    %m = add i32 %n, -1
; CHECK-NEXT:    --> (-1 + %n) U: full-set S: full-set
; CHECK-NEXT:    %i = phi i32 [ 0, %ph ], [ %inc, %loop ]
; CHECK-NEXT:    --> {0,+,1}<nuw><%loop> U: [0,-1) S: [0,-1) Exits: (-2 + %n) LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %inc = add nuw i32 %i, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><%loop> U: [1,0) S: [1,0) Exits: (-1 + %n) LoopDispositions: { %loop: Computable }
; CHECK-NEXT:  Determining loop execution counts for: @farther_loop_guard
; CHECK-NEXT:  Loop %loop: backedge-taken count is (-2 + %n)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -2
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-2 + %n)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %n = load i32, ptr %p
  %big = icmp ugt i32 %n, 1
  br i1 %big, label %near, label %exit

near:
  br i1 %flag, label %split, label %exit

split:
  br i1 %c, label %a, label %b

a:
  br label %ph

b:
  br label %ph

ph:
  %m = add i32 %n, -1
  br label %loop

loop:
  %i = phi i32 [ 0, %ph ], [ %inc, %loop ]
  store volatile i32 %i, ptr %p
  %inc = add nuw i32 %i, 1
  %cmp = icmp ult i32 %inc, %m
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}
