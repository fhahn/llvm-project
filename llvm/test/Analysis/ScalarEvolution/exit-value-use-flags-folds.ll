  %i.3.next = add i64 %i.3, 1
  %c.3 = icmp eq i64 %i.3, %n
  br i1 %c.3, label %exit, label %loop.3

exit:
  %a = add i64 %q1, %q2
  %b = add i64 %a, %q3
  ret void
}

