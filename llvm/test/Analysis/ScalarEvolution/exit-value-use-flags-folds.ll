  %q2 = udiv i64 %iv.2, 3
  %iv.2.next = add nuw i64 %iv.2, %step
  %i.2.next = add i64 %i.2, 1
  %c.2 = icmp eq i64 %i.2, %n
  br i1 %c.2, label %loop.3, label %loop.2

loop.3:
  %i.3 = phi i64 [ 0, %loop.2 ], [ %i.3.next, %loop.3 ]
