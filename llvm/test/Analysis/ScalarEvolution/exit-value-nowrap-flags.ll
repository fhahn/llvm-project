; CHECK-NEXT:  Loop %loop.2: backedge-taken count is ((9 + (-1 * ((9 + (ptrtoaddr ptr %start to i64)) umin (ptrtoaddr ptr %m to i64))) + (ptrtoaddr ptr %m to i64)) /u 10)
