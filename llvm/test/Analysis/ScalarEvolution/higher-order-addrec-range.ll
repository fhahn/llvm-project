; Negative test: the i8 quadratic recurrence `{0,+,0,+,2}` wraps around 256
; mid-loop. Both step operands are non-negative, the trip count is constant
; (21 iterations -> BE count 20), and the modular start/exit values are
; 0/124. Without checking the no-wrap flag, the [start, exit] bound would
; (wrongly) be reported as `[0, 125)` even though intermediate values reach
; 240. The AddRec does not carry <nuw>, so the range stays full-set.

define i8 @quadratic_wraps_no_nuw() {
; CHECK-LABEL: 'quadratic_wraps_no_nuw'
; CHECK-NEXT:  Classifying expressions for: @quadratic_wraps_no_nuw
; CHECK-NEXT:    %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%loop> U: [0,21) S: [0,21) Exits: 20 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %step = phi i8 [ 0, %entry ], [ %step.next, %loop ]
; CHECK-NEXT:    --> {0,+,2}<nuw><nsw><%loop> U: [0,41) S: [0,41) Exits: 40 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %acc = phi i8 [ 0, %entry ], [ %acc.next, %loop ]
; CHECK-NEXT:    --> {0,+,0,+,2}<%loop> U: [0,-1) S: [-128,127) Exits: 124 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %acc.next = add i8 %acc, %step
; CHECK-NEXT:    --> {0,+,2,+,2}<%loop> U: [0,-1) S: [-128,127) Exits: -92 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %step.next = add i8 %step, 2
; CHECK-NEXT:    --> {2,+,2}<nuw><nsw><%loop> U: [2,43) S: [2,43) Exits: 42 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %iv.next = add nuw nsw i8 %iv, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%loop> U: [1,22) S: [1,22) Exits: 21 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %r = phi i8 [ %acc, %loop ]
; CHECK-NEXT:    --> {0,+,0,+,2}<%loop> U: [0,-1) S: [-128,127) --> 124 U: [124,125) S: [124,125)
; CHECK-NEXT:  Determining loop execution counts for: @quadratic_wraps_no_nuw
; CHECK-NEXT:  Loop %loop: backedge-taken count is i8 20
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 20
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i8 20
; CHECK-NEXT:  Loop %loop: Trip multiple is 21
;
entry:
  br label %loop

loop:
  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop ]
  %step = phi i8 [ 0, %entry ], [ %step.next, %loop ]
  %acc = phi i8 [ 0, %entry ], [ %acc.next, %loop ]
  %acc.next = add i8 %acc, %step
  %step.next = add i8 %step, 2
  %iv.next = add nuw nsw i8 %iv, 1
  %cmp = icmp ult i8 %iv.next, 21
  br i1 %cmp, label %loop, label %exit

exit:
  %r = phi i8 [ %acc, %loop ]
  ret i8 %r
}
