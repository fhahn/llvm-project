; RUN: opt -passes='print<scalar-evolution>' -disable-output %s 2>&1 | FileCheck %s

; For higher-order AddRecs (quadratic and cubic here) with a known trip
; count, ScalarEvolution evaluates the start and exit iteration and takes
; the union of those two ranges when the recurrence is monotonic (all
; operands after the start are known non-negative or all non-positive)
; AND the AddRec carries the matching no-wrap flag. The wrap flag is
; required: without it, the recurrence may overflow mid-loop and reach
; values outside the [start, exit] interval (see @quadratic_wraps_no_nuw).

define i32 @quadratic_exit_value() {
; CHECK-LABEL: 'quadratic_exit_value'
; CHECK-NEXT:  Classifying expressions for: @quadratic_exit_value
; CHECK-NEXT:    %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%loop> U: [0,100) S: [0,100) Exits: 99 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %sq = mul i32 %iv, %iv
; CHECK-NEXT:    --> {0,+,1,+,2}<%loop> U: full-set S: full-set Exits: 9801 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %iv.next = add nuw nsw i32 %iv, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%loop> U: [1,101) S: [1,101) Exits: 100 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %r = phi i32 [ %sq, %loop ]
; CHECK-NEXT:    --> {0,+,1,+,2}<%loop> U: full-set S: full-set --> 9801 U: [9801,9802) S: [9801,9802)
; CHECK-NEXT:  Determining loop execution counts for: @quadratic_exit_value
; CHECK-NEXT:  Loop %loop: backedge-taken count is i32 99
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 99
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 99
; CHECK-NEXT:  Loop %loop: Trip multiple is 100
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %sq = mul i32 %iv, %iv
  %iv.next = add nuw nsw i32 %iv, 1
  %cmp = icmp slt i32 %iv.next, 100
  br i1 %cmp, label %loop, label %exit

exit:
  %r = phi i32 [ %sq, %loop ]
  ret i32 %r
}

