; `ashr` is equivalent to `lshr` when the shifted value is known to be
; non-negative. ScalarEvolution recognizes this and routes a non-negative
; `ashr X, C` through the same UDiv path as `lshr X, C`, preserving AddRec
; structure and allowing downstream range/trip-count computations.

define i32 @shifts_bounded() {
; CHECK-LABEL: 'shifts_bounded'
; CHECK-NEXT:  Classifying expressions for: @shifts_bounded
; CHECK-NEXT:    %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
; CHECK-NEXT:    --> {0,+,2}<nuw><nsw><%loop> U: [0,99) S: [0,99) Exits: 98 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %shifted_a = ashr i32 %iv, 1
; CHECK-NEXT:    --> {0,+,1}<nuw><%loop> U: [0,50) S: [0,50) Exits: 49 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %shifted_l = lshr i32 %iv, 1
; CHECK-NEXT:    --> {0,+,1}<nuw><%loop> U: [0,50) S: [0,50) Exits: 49 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %iv.next = add nuw nsw i32 %iv, 2
; CHECK-NEXT:    --> {2,+,2}<nuw><nsw><%loop> U: [2,101) S: [2,101) Exits: 100 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %r1 = phi i32 [ %shifted_a, %loop ]
; CHECK-NEXT:    --> {0,+,1}<nuw><%loop> U: [0,50) S: [0,50) --> 49 U: [49,50) S: [49,50)
; CHECK-NEXT:    %r2 = phi i32 [ %shifted_l, %loop ]
; CHECK-NEXT:    --> {0,+,1}<nuw><%loop> U: [0,50) S: [0,50) --> 49 U: [49,50) S: [49,50)
; CHECK-NEXT:    %sum = add i32 %r1, %r2
; CHECK-NEXT:    --> {0,+,2}<nuw><nsw><%loop> U: [0,99) S: [0,99) --> 98 U: [98,99) S: [98,99)
; CHECK-NEXT:  Determining loop execution counts for: @shifts_bounded
; CHECK-NEXT:  Loop %loop: backedge-taken count is i32 49
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 49
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 49
; CHECK-NEXT:  Loop %loop: Trip multiple is 50
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %shifted_a = ashr i32 %iv, 1
  %shifted_l = lshr i32 %iv, 1
  %iv.next = add nuw nsw i32 %iv, 2
  %cmp = icmp slt i32 %iv.next, 100
  br i1 %cmp, label %loop, label %exit

exit:
  %r1 = phi i32 [ %shifted_a, %loop ]
  %r2 = phi i32 [ %shifted_l, %loop ]
  %sum = add i32 %r1, %r2
  ret i32 %sum
}

; A non-AddRec value with a signed-nonneg assume: the ashr becomes a
; SCEVUDivExpr rather than remaining SCEVUnknown.

declare void @llvm.assume(i1)

define i32 @ashr_nonneg_nonaddrec(i32 %x) {
; CHECK-LABEL: 'ashr_nonneg_nonaddrec'
; CHECK-NEXT:  Classifying expressions for: @ashr_nonneg_nonaddrec
; CHECK-NEXT:    %s = ashr i32 %x, 1
; CHECK-NEXT:    --> (%x /u 2) U: [0,1073741824) S: [0,1073741824)
; CHECK-NEXT:  Determining loop execution counts for: @ashr_nonneg_nonaddrec
;
  %c = icmp sge i32 %x, 0
  call void @llvm.assume(i1 %c)
  %s = ashr i32 %x, 1
  ret i32 %s
}

; Negative test: %x has unknown sign, so ashr must stay a SCEVUnknown
; rather than being routed through the UDiv path.

define i32 @ashr_unknown_sign(i32 %x) {
; CHECK-LABEL: 'ashr_unknown_sign'
