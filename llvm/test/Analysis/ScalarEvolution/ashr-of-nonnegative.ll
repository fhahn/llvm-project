; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 5
; RUN: opt -passes='print<scalar-evolution>' -disable-output %s 2>&1 | FileCheck %s

; `ashr` and `lshr` are equivalent when the shifted value is known to be
; non-negative. ScalarEvolution handles `lshr X, C` by producing a SCEV UDiv
; expression (and distributes it through AddRecs), but `ashr` falls through to
; the generic SCEVUnknown path even when SCEV can prove the operand is
; non-negative.
;
; @shifts_bounded shows the asymmetry: lshr becomes an AddRec `{0,+,1}<nuw>`
; while ashr is SCEVUnknown -- even though range analysis (via computeKnownBits
; and the AddRec's <nuw> flag) is strong enough that ashr's range is shown as
; [0, 2^30). Because %shifted_a is not an AddRec, SCEV cannot distribute it
; into surrounding expressions: see `%sum` which stays `(AddRec + unknown)`
; instead of collapsing to a single AddRec.

define i32 @shifts_bounded() {
; CHECK-LABEL: 'shifts_bounded'
; CHECK-NEXT:  Classifying expressions for: @shifts_bounded
; CHECK-NEXT:    %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
; CHECK-NEXT:    --> {0,+,2}<nuw><nsw><%loop> U: [0,99) S: [0,99) Exits: 98 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %shifted_a = ashr i32 %iv, 1
; CHECK-NEXT:    --> %shifted_a U: [0,1073741824) S: [0,1073741824) Exits: 49 LoopDispositions: { %loop: Variant }
; CHECK-NEXT:    %shifted_l = lshr i32 %iv, 1
; CHECK-NEXT:    --> {0,+,1}<nuw><%loop> U: [0,50) S: [0,50) Exits: 49 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %iv.next = add nuw nsw i32 %iv, 2
; CHECK-NEXT:    --> {2,+,2}<nuw><nsw><%loop> U: [2,101) S: [2,101) Exits: 100 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %r1 = phi i32 [ %shifted_a, %loop ]
; CHECK-NEXT:    --> %shifted_a U: [0,1073741824) S: [0,1073741824) --> 49 U: [49,50) S: [49,50)
; CHECK-NEXT:    %r2 = phi i32 [ %shifted_l, %loop ]
; CHECK-NEXT:    --> {0,+,1}<nuw><%loop> U: [0,50) S: [0,50) --> 49 U: [49,50) S: [49,50)
; CHECK-NEXT:    %sum = add i32 %r1, %r2
; CHECK-NEXT:    --> ({0,+,1}<nuw><%loop> + %shifted_a) U: [0,1073741873) S: [0,1073741873) --> 98 U: [98,99) S: [98,99)
; CHECK-NEXT:  Determining loop execution counts for: @shifts_bounded
; CHECK-NEXT:  Loop %loop: backedge-taken count is i32 49
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 49
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 49
; CHECK-NEXT:  Loop %loop: Trip multiple is 50
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %shifted_a = ashr i32 %iv, 1
  %shifted_l = lshr i32 %iv, 1
  %iv.next = add nuw nsw i32 %iv, 2
  %cmp = icmp slt i32 %iv.next, 100
  br i1 %cmp, label %loop, label %exit

exit:
  %r1 = phi i32 [ %shifted_a, %loop ]
  %r2 = phi i32 [ %shifted_l, %loop ]
  %sum = add i32 %r1, %r2
  ret i32 %sum
}

; A non-AddRec value is also affected. Here %x is constrained to non-negative
; by an assume, which getRangeRef can see (computeKnownBits consumes the
; assume since the bit-level fact is consulted directly), so the range of
; the ashr is [0, 2^30). But the ashr is still a SCEVUnknown rather than a
; SCEVUDivExpr, so it does not participate in further SCEV folding.

declare void @llvm.assume(i1)

define i32 @ashr_nonneg_nonaddrec(i32 %x) {
; CHECK-LABEL: 'ashr_nonneg_nonaddrec'
; CHECK-NEXT:  Classifying expressions for: @ashr_nonneg_nonaddrec
; CHECK-NEXT:    %s = ashr i32 %x, 1
; CHECK-NEXT:    --> %s U: [0,1073741824) S: [0,1073741824)
; CHECK-NEXT:  Determining loop execution counts for: @ashr_nonneg_nonaddrec
;
  %c = icmp sge i32 %x, 0
  call void @llvm.assume(i1 %c)
  %s = ashr i32 %x, 1
  ret i32 %s
}
