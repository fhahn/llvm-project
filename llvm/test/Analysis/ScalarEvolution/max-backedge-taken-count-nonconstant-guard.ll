; A useful opposite operand need not occur in the trip-count expression.
; n = 11 and bound = 12 attain ten backedges.
define void @bounded_variable_guard(i8 range(i8 1, 0) %n,
; CHECK-LABEL: 'bounded_variable_guard'
; CHECK-NEXT:  Determining loop execution counts for: @bounded_variable_guard
; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + %n)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 10
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + %n)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
                             i8 range(i8 1, 13) %bound, ptr %out) {
entry:
  %guard = icmp ult i8 %n, %bound
  br i1 %guard, label %loop, label %exit
loop:
  %i = phi i8 [ 0, %entry ], [ %next, %loop ]
  store volatile i8 %i, ptr %out
  %next = add nuw i8 %i, 1
  %more = icmp ult i8 %next, %n
  br i1 %more, label %loop, label %exit
exit:
  ret void
}

