; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -disable-output -passes="print<scalar-evolution>" \
; RUN:   -scalar-evolution-classify-expressions=0 2>&1 | FileCheck %s

; (n s> 0) ===> (11 - n s< 11), via 11 - n == ~(n - 12).
define void @guard_sub_from_constant(i32 %n) {
; CHECK-LABEL: 'guard_sub_from_constant'
; CHECK-NEXT:  Determining loop execution counts for: @guard_sub_from_constant
; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 + (sext i32 %n to i64))<nsw> /u 4)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 536870911
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-1 + (sext i32 %n to i64))<nsw> /u 4)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %guard = icmp sgt i32 %n, 0
  br i1 %guard, label %ph, label %exit

ph:
  %sub = sub nsw i32 15, %n
  %start = sext i32 %sub to i64
  br label %loop

loop:
  %iv = phi i64 [ %start, %ph ], [ %iv.next, %loop ]
  %iv.next = add i64 %iv, 4
  %cmp = icmp slt i64 %iv, 11
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; (sext x s< 0) ===> (8 - sext x s> -1) holds, since sext x != INT_MIN. The
; negation check only uses the guard's range, which includes INT_MIN, so the
; smin is not removed.
define void @guard_sext_negative(i16 %x) {
; CHECK-LABEL: 'guard_sext_negative'
; CHECK-NEXT:  Determining loop execution counts for: @guard_sext_negative
; CHECK-NEXT:  Loop %loop: backedge-taken count is (8 + (-1 * (sext i16 %x to i32))<nsw> + (-1 * (-1 smin (8 + (-1 * (sext i16 %x to i32))<nsw>)<nsw>))<nsw>)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 32777
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (8 + (-1 * (sext i16 %x to i32))<nsw> + (-1 * (-1 smin (8 + (-1 * (sext i16 %x to i32))<nsw>)<nsw>))<nsw>)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %s = sext i16 %x to i32
  %guard = icmp slt i32 %s, 0
  br i1 %guard, label %ph, label %exit

ph:
  %start = sub nsw i32 8, %s
  br label %loop

loop:
  %iv = phi i32 [ %start, %ph ], [ %iv.next, %loop ]
  %iv.next = add nsw i32 %iv, -1
  %cmp = icmp sgt i32 %iv, -1
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; (x s< 0) does not imply (8 - x s> -1): for x == INT_MIN,
; 8 - x wraps to a negative value. Keep the smin so this case has zero
; backedges.
define void @guard_negative_wrapping(i32 %x) {
; CHECK-LABEL: 'guard_negative_wrapping'
; CHECK-NEXT:  Determining loop execution counts for: @guard_negative_wrapping
; CHECK-NEXT:  Loop %loop: backedge-taken count is (8 + (-1 * (-1 smin (8 + (-1 * %x)))) + (-1 * %x))
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -2147483648
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (8 + (-1 * (-1 smin (8 + (-1 * %x)))) + (-1 * %x))
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %guard = icmp slt i32 %x, 0
  br i1 %guard, label %ph, label %exit

ph:
  %start = sub i32 8, %x
  br label %loop

loop:
  %iv = phi i32 [ %start, %ph ], [ %iv.next, %loop ]
  %iv.next = add i32 %iv, -1
  %cmp = icmp sgt i32 %iv, -1
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}
