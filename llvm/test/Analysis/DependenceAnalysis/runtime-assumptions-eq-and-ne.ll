; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py
; RUN: opt < %s -disable-output -passes="print<da>" 2>&1 | FileCheck %s

target datalayout = "e-m:e-i64:64-n32:64-S128"

; The dependence analysis records two runtime assumptions on the same SCEV here:
; "(%k & 3) % 4 == 0" from isKnownMultipleOf, and "(%k & 3) != 0" from
; strongSIVtest, which needs a non-zero coefficient to conclude that only
; same-iteration dependences exist. Both have to be printed: they are
; contradictory, so the recorded conclusions can never be used, and dropping
; either of them would leave a satisfiable assumption set.
define void @eq_and_ne_assumption_on_same_scev(ptr %A, i64 %k, i64 %n) {
; CHECK-LABEL: 'eq_and_ne_assumption_on_same_scev'
; CHECK-NEXT:  Src: %v = load i32, ptr %p, align 4 --> Dst: %v = load i32, ptr %p, align 4
; CHECK-NEXT:    da analyze - input [0]!
; CHECK-NEXT:    Runtime Assumptions:
; CHECK-NEXT:    Equal predicate: (zext i2 (trunc i64 %k to i2) to i64) == 0
; CHECK-NEXT:    Compare predicate: (zext i2 (trunc i64 %k to i2) to i64) ne) 0
; CHECK-NEXT:  Src: %v = load i32, ptr %p, align 4 --> Dst: store i32 %w, ptr %p, align 4
; CHECK-NEXT:    da analyze - anti [0|<]!
; CHECK-NEXT:    Runtime Assumptions:
; CHECK-NEXT:    Equal predicate: (zext i2 (trunc i64 %k to i2) to i64) == 0
; CHECK-NEXT:    Compare predicate: (zext i2 (trunc i64 %k to i2) to i64) ne) 0
; CHECK-NEXT:  Src: store i32 %w, ptr %p, align 4 --> Dst: store i32 %w, ptr %p, align 4
; CHECK-NEXT:    da analyze - output [0]!
; CHECK-NEXT:    Runtime Assumptions:
; CHECK-NEXT:    Equal predicate: (zext i2 (trunc i64 %k to i2) to i64) == 0
; CHECK-NEXT:    Compare predicate: (zext i2 (trunc i64 %k to i2) to i64) ne) 0
;
entry:
  %kk = and i64 %k, 3
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %off = phi i64 [ 0, %entry ], [ %off.next, %loop ]
  %p = getelementptr i8, ptr %A, i64 %off
  %v = load i32, ptr %p, align 4
  %w = add i32 %v, 1
  store i32 %w, ptr %p, align 4
  %off.next = add nsw i64 %off, %kk
  %i.next = add nsw i64 %i, 1
  %ec = icmp slt i64 %i.next, %n
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}
