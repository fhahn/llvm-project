@c = global [4 x i8] [i8 3, i8 0, i8 2, i8 0]

define void @main() {
  ; Elements between columns are skipped.
  %load_stride = call <4 x i32> @llvm.matrix.column.major.load.v4i32.i32(ptr align 4 @a, i32 5, i1 false, i32 2, i32 2)

  ; Only the first column is accessed, so the stride may point out of bounds.
  ; Poison elements are loaded as poison.
  %load_one_col = call <2 x i32> @llvm.matrix.column.major.load.v2i32.i64(ptr align 4 @a, i64 1000, i1 false, i32 2, i32 1)

  ; Each column is loaded as a <Rows x i1> vector.
  %load_i1 = call <4 x i1> @llvm.matrix.column.major.load.v4i1.i64(ptr @c, i64 2, i1 false, i32 2, i32 2)
  ret void
}
