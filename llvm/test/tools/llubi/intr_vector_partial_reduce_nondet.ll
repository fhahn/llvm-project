  ; chosen result lane, so the result lanes always sum up to 1111.
  %add_1 = call <2 x i32> @llvm.vector.partial.reduce.add.v2i32.v4i32(<2 x i32> <i32 1000, i32 0>, <4 x i32> <i32 1, i32 10, i32 100, i32 0>)
