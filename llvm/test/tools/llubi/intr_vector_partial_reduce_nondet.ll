  %add_3 = call <2 x i32> @llvm.vector.partial.reduce.add.v2i32.v4i32(<2 x i32> <i32 1000, i32 0>, <4 x i32> <i32 1, i32 10, i32 100, i32 0>)
  %add_4 = call <2 x i32> @llvm.vector.partial.reduce.add.v2i32.v4i32(<2 x i32> <i32 1000, i32 0>, <4 x i32> <i32 1, i32 10, i32 100, i32 0>)

  ; Poison only affects the lane it is reduced into.
  %add_poison_1 = call <2 x i32> @llvm.vector.partial.reduce.add.v2i32.v4i32(<2 x i32> <i32 1000, i32 0>, <4 x i32> <i32 1, i32 10, i32 100, i32 poison>)
  %add_poison_2 = call <2 x i32> @llvm.vector.partial.reduce.add.v2i32.v4i32(<2 x i32> <i32 1000, i32 0>, <4 x i32> <i32 1, i32 10, i32 100, i32 poison>)
  %add_poison_3 = call <2 x i32> @llvm.vector.partial.reduce.add.v2i32.v4i32(<2 x i32> <i32 1000, i32 0>, <4 x i32> <i32 1, i32 10, i32 100, i32 poison>)
  %add_poison_4 = call <2 x i32> @llvm.vector.partial.reduce.add.v2i32.v4i32(<2 x i32> <i32 1000, i32 0>, <4 x i32> <i32 1, i32 10, i32 100, i32 poison>)

  ; With many input lanes, the result lanes still sum up to 96.
  %add_many_lanes = call <3 x i32> @llvm.vector.partial.reduce.add.v3i32.v96i32(<3 x i32> zeroinitializer, <96 x i32> splat (i32 1))

  ret void
}

