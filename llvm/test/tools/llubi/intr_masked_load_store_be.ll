target datalayout = "E-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64"

define void @main() {
  %a = alloca i32, align 4
  store i32 66051, ptr %a, align 4
  %load_i8 = call <4 x i8> @llvm.masked.load.v4i8.p0(ptr align 1 %a, <4 x i1> <i1 false, i1 true, i1 false, i1 true>, <4 x i8> splat (i8 -1))
  call void @llvm.masked.store.v4i8.p0(<4 x i8> <i8 4, i8 5, i8 6, i8 7>, ptr align 1 %a, <4 x i1> <i1 true, i1 false, i1 false, i1 false>)
  %after_i8_store = load i32, ptr %a, align 4

  ; Lane 0 of a vector of sub-byte elements is in the most significant bits.
  %load_i4 = call <8 x i4> @llvm.masked.load.v8i4.p0(ptr align 1 %a, <8 x i1> <i1 true, i1 true, i1 false, i1 false, i1 false, i1 false, i1 false, i1 true>, <8 x i4> zeroinitializer)
  %load_i4_plain = load <8 x i4>, ptr %a, align 1
  call void @llvm.masked.store.v8i4.p0(<8 x i4> splat (i4 -1), ptr align 1 %a, <8 x i1> <i1 false, i1 true, i1 false, i1 false, i1 false, i1 false, i1 true, i1 false>)
  %after_i4_store = load i32, ptr %a, align 4

  ; The padding bits of <3 x i4> are the high bits of byte 0, which also
  ; contains lane 0. They are written if any lane is enabled.
  store i32 -1, ptr %a, align 4
  call void @llvm.masked.store.v3i4.p0(<3 x i4> zeroinitializer, ptr align 1 %a, <3 x i1> <i1 false, i1 true, i1 true>)
  %after_i4_store_lanes_1_2 = load i16, ptr %a, align 2
  call void @llvm.masked.store.v3i4.p0(<3 x i4> zeroinitializer, ptr align 1 %a, <3 x i1> <i1 true, i1 false, i1 false>)
  %after_i4_store_lane_0 = load i16, ptr %a, align 2

  ; Padding bits out of bounds of the object are not accessed.
  %b = alloca i8, align 1
  store i8 -1, ptr %b, align 1
  %b_before = getelementptr i8, ptr %b, i64 -1
  call void @llvm.masked.store.v3i4.p0(<3 x i4> <i4 1, i4 2, i4 3>, ptr align 1 %b_before, <3 x i1> <i1 false, i1 true, i1 true>)
  %after_i4_store_padding_oob = load i8, ptr %b, align 1
  %load_i4_padding_oob = call <3 x i4> @llvm.masked.load.v3i4.p0(ptr align 1 %b_before, <3 x i1> <i1 false, i1 true, i1 true>, <3 x i4> splat (i4 7))

  ; Lane 1 of <3 x i65> is bits 65 to 129 (bytes 16 to 8), the padding bits are
  ; bits 195 to 199 (byte 0), before the bytes with bits of enabled lanes.
  %c = alloca [25 x i8], align 1
  store <25 x i8> splat (i8 -1), ptr %c, align 1
  call void @llvm.masked.store.v3i65.p0(<3 x i65> zeroinitializer, ptr align 1 %c, <3 x i1> <i1 false, i1 true, i1 false>)
  %after_i65_store = load <25 x i8>, ptr %c, align 1
  ret void
}

