  %fadd_poison = call <2 x float> @llvm.vector.partial.reduce.fadd.v2f32.v4f32(<2 x float> <float 1.000000e+00, float 2.000000e+00>, <4 x float> <float 1.000000e+01, float 2.000000e+01, float poison, float 2.000000e+02>)
  %fadd_nan = call <2 x float> @llvm.vector.partial.reduce.fadd.v2f32.v4f32(<2 x float> <float 1.000000e+00, float 2.000000e+00>, <4 x float> <float 1.000000e+01, float 2.000000e+01, float 1.000000e+02, float +qnan>)
  %fadd_nnan = call nnan <2 x float> @llvm.vector.partial.reduce.fadd.v2f32.v4f32(<2 x float> <float 1.000000e+00, float 2.000000e+00>, <4 x float> <float 1.000000e+01, float 2.000000e+01, float 1.000000e+02, float +qnan>)
  %fadd_ninf = call ninf <2 x float> @llvm.vector.partial.reduce.fadd.v2f32.v4f32(<2 x float> <float f0x7F7FFFFF, float 2.000000e+00>, <4 x float> <float f0x7F7FFFFF, float 2.000000e+01, float 1.000000e+00, float 2.000000e+02>)

