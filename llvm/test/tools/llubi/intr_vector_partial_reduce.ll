  %add_fixed_acc = call <2 x i32> @llvm.vector.partial.reduce.add.v2i32.nxv4i32(<2 x i32> <i32 100, i32 200>, <vscale x 4 x i32> %step)
  %add_many_lanes = call <3 x i32> @llvm.vector.partial.reduce.add.v3i32.nxv300i32(<3 x i32> <i32 0, i32 1000, i32 2000>, <vscale x 300 x i32> splat (i32 1))

