  %add_scalable_poison = call <vscale x 2 x i32> @llvm.vector.partial.reduce.add.nxv2i32.nxv4i32(<vscale x 2 x i32> splat (i32 100), <vscale x 4 x i32> %step_poison)
  %fstep = uitofp <vscale x 4 x i32> %step to <vscale x 4 x float>
  %fadd_scalable = call <vscale x 2 x float> @llvm.vector.partial.reduce.fadd.nxv2f32.nxv4f32(<vscale x 2 x float> splat (float 5.000000e-01), <vscale x 4 x float> %fstep)

