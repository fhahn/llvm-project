  %fadd_bfloat = call <1 x bfloat> @llvm.vector.partial.reduce.fadd.v1bf16.v2bf16(<1 x bfloat> splat (bfloat f0x4380), <2 x bfloat> splat (bfloat f0x3F80))
  %fadd_fp128 = call <1 x fp128> @llvm.vector.partial.reduce.fadd.v1f128.v2f128(<1 x fp128> splat (fp128 0xL00000000000000003FFF000000000000), <2 x fp128> <fp128 0xL00000000000000003FFF000000000000, fp128 0xL00000000000000004000000000000000>)
  %fadd_x86_fp80 = call <1 x x86_fp80> @llvm.vector.partial.reduce.fadd.v1f80.v2f80(<1 x x86_fp80> splat (x86_fp80 0xK3FFF8000000000000000), <2 x x86_fp80> <x86_fp80 0xK3FFF8000000000000000, x86_fp80 0xK40008000000000000000>)

