  %add_wrap = call <2 x i8> @llvm.vector.partial.reduce.add.v2i8.v4i8(<2 x i8> <i8 127, i8 -128>, <4 x i8> <i8 1, i8 -1, i8 1, i8 0>)

  ; Ratios that are not a power of two, and narrow and wide element types.
  %add_ratio_3 = call <3 x i32> @llvm.vector.partial.reduce.add.v3i32.v9i32(<3 x i32> zeroinitializer, <9 x i32> <i32 1, i32 2, i32 4, i32 8, i32 16, i32 32, i32 64, i32 128, i32 256>)
  %add_i1 = call <2 x i1> @llvm.vector.partial.reduce.add.v2i1.v6i1(<2 x i1> <i1 true, i1 false>, <6 x i1> <i1 true, i1 true, i1 true, i1 false, i1 true, i1 true>)
  %add_i65 = call <1 x i65> @llvm.vector.partial.reduce.add.v1i65.v3i65(<1 x i65> splat (i65 18446744073709551615), <3 x i65> <i65 1, i65 18446744073709551615, i65 -1>)
  %add_i128 = call <2 x i128> @llvm.vector.partial.reduce.add.v2i128.v4i128(<2 x i128> <i128 -1, i128 170141183460469231731687303715884105727>, <4 x i128> <i128 1, i128 1, i128 18446744073709551616, i128 0>)

  ; Poison only affects the result lane it is reduced into.
  %add_poison_acc = call <4 x i32> @llvm.vector.partial.reduce.add.v4i32.v8i32(<4 x i32> <i32 1, i32 poison, i32 3, i32 4>, <8 x i32> <i32 10, i32 20, i32 30, i32 40, i32 100, i32 200, i32 300, i32 400>)
  %add_poison_vec = call <4 x i32> @llvm.vector.partial.reduce.add.v4i32.v8i32(<4 x i32> <i32 1, i32 2, i32 3, i32 4>, <8 x i32> <i32 10, i32 20, i32 30, i32 40, i32 100, i32 200, i32 poison, i32 400>)

  ; Each fadd lane is reduced in order, starting with the accumulator, so
  ; (2^24 + 1) + 1 and ((2^24 + 1) + 1) + 1 both round to 2^24.
  %fadd = call <2 x float> @llvm.vector.partial.reduce.fadd.v2f32.v4f32(<2 x float> <float 1.000000e+00, float 2.000000e+00>, <4 x float> <float 1.000000e+01, float 2.000000e+01, float 1.000000e+02, float 2.000000e+02>)
  %fadd_order = call <1 x float> @llvm.vector.partial.reduce.fadd.v1f32.v2f32(<1 x float> splat (float f0x4B800000), <2 x float> splat (float 1.000000e+00))
