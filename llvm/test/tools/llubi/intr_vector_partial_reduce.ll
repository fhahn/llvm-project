define void @main() {
  ; In deterministic mode, element J of the second operand is added to lane
  ; J % N of the N-element accumulator.
  %add = call <4 x i32> @llvm.vector.partial.reduce.add.v4i32.v8i32(<4 x i32> <i32 1, i32 2, i32 3, i32 4>, <8 x i32> <i32 10, i32 20, i32 30, i32 40, i32 100, i32 200, i32 300, i32 400>)
  %add_ratio_4 = call <2 x i32> @llvm.vector.partial.reduce.add.v2i32.v8i32(<2 x i32> <i32 1000, i32 2000>, <8 x i32> <i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8>)
