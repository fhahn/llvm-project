  %step = call <vscale x 4 x i32> @llvm.stepvector.nxv4i32()
  %add_scalable = call <vscale x 2 x i32> @llvm.vector.partial.reduce.add.nxv2i32.nxv4i32(<vscale x 2 x i32> splat (i32 100), <vscale x 4 x i32> %step)
