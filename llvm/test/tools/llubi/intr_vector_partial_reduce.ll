define void @denormal() denormal_fpenv(positivezero|positivezero) {
  ; Each fadd flushes its denormal result, so 1.5 * 2^-126 - 2^-126 is
  ; flushed to 0 before 2^-126 is added.
  %fadd_denormal = call <1 x float> @llvm.vector.partial.reduce.fadd.v1f32.v2f32(<1 x float> splat (float f0x00C00000), <2 x float> <float f0x80800000, float f0x00800000>)
  ret void
}

