; AArch64 has no reg + (reg << s) + imm addressing mode. Hoist the constant
; offset into the base in the preheader, so the loads/stores can use
; reg + (reg << s).

@tab = hidden constant [128 x i16] zeroinitializer, align 2

define void @global_base(ptr %out, ptr %in, i64 %n) {
; CHECK-LABEL: @global_base(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, [[ENTRY:%.*]] ], [ [[IV_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[GEP_IN:%.*]] = getelementptr inbounds i32, ptr [[IN:%.*]], i64 [[IV]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[GEP_IN]], align 4
; CHECK-NEXT:    [[PROMOTED:%.*]] = zext i32 [[V]] to i64
; CHECK-NEXT:    [[TMP0:%.*]] = and i64 [[PROMOTED]], 255
; CHECK-NEXT:    [[GEP_TAB:%.*]] = getelementptr [2 x i8], ptr @tab, i64 [[TMP0]]
; CHECK-NEXT:    [[GEP_TAB_OFF:%.*]] = getelementptr i8, ptr [[GEP_TAB]], i64 -256
; CHECK-NEXT:    [[T:%.*]] = load i16, ptr [[GEP_TAB_OFF]], align 2
; CHECK-NEXT:    [[GEP_OUT:%.*]] = getelementptr inbounds i16, ptr [[OUT:%.*]], i64 [[IV]]
; CHECK-NEXT:    store i16 [[T]], ptr [[GEP_OUT]], align 2
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[EC]], label [[EXIT:%.*]], label [[LOOP]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.in = getelementptr inbounds i32, ptr %in, i64 %iv
  %v = load i32, ptr %gep.in, align 4
  %m = and i32 %v, 255
  %idx = zext nneg i32 %m to i64
  %gep.tab = getelementptr [2 x i8], ptr @tab, i64 %idx
  %gep.tab.off = getelementptr i8, ptr %gep.tab, i64 -256
  %t = load i16, ptr %gep.tab.off, align 2
  %gep.out = getelementptr inbounds i16, ptr %out, i64 %iv
  store i16 %t, ptr %gep.out, align 2
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

