; CHECK-NEXT:    [[IDX:%.*]] = load i64, ptr [[GEP_IN]], align 8
; CHECK-NEXT:    [[GEP_TAB:%.*]] = getelementptr i8, ptr [[TAB:%.*]], i64 [[IDX]]
; CHECK-NEXT:    [[GEP_TAB_OFF:%.*]] = getelementptr i8, ptr [[GEP_TAB]], i64 -1
