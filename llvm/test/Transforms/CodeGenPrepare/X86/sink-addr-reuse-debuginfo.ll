; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals none --version 6
; RUN: opt -S -passes='require<profile-summary>,function(codegenprepare)' %s | FileCheck --check-prefix=DBG %s
; RUN: opt -S -strip-debug -passes='require<profile-summary>,function(codegenprepare)' %s | FileCheck --check-prefix=NODBG %s

target triple = "x86_64-unknown-linux-gnu"

; Lowering the widenable condition folds %sel and replaces %p with %gep. The
; address sunk for %l.0 should be reused for %l.1, regardless of the
; #dbg_value using %gep.
define void @sunk_addr_reuse_after_phi_simplification(ptr %base, i1 %ec) !dbg !3 {
; DBG-LABEL: define void @sunk_addr_reuse_after_phi_simplification(
; DBG-SAME: ptr [[BASE:%.*]], i1 [[EC:%.*]]) !dbg [[DBG3:![0-9]+]] {
; DBG-NEXT:  [[ENTRY:.*:]]
; DBG-NEXT:    br label %[[LOOP:.*]]
; DBG:       [[LOOP]]:
; DBG-NEXT:      #dbg_value(ptr [[BASE]], [[META6:![0-9]+]], !DIExpression(DW_OP_plus_uconst, 16, DW_OP_stack_value), [[META8:![0-9]+]])
; DBG-NEXT:    [[SUNKADDR:%.*]] = getelementptr i8, ptr [[BASE]], i64 16
; DBG-NEXT:    [[L_0:%.*]] = load i32, ptr [[SUNKADDR]], align 4
; DBG-NEXT:    [[L_1:%.*]] = load i32, ptr [[SUNKADDR]], align 4
; DBG-NEXT:    call void @use(ptr [[BASE]])
; DBG-NEXT:    br i1 [[EC]], label %[[LOOP]], label %[[EXIT:.*]]
; DBG:       [[EXIT]]:
; DBG-NEXT:    ret void
;
; NODBG-LABEL: define void @sunk_addr_reuse_after_phi_simplification(
; NODBG-SAME: ptr [[BASE:%.*]], i1 [[EC:%.*]]) {
; NODBG-NEXT:  [[ENTRY:.*:]]
; NODBG-NEXT:    br label %[[LOOP:.*]]
; NODBG:       [[LOOP]]:
; NODBG-NEXT:    [[SUNKADDR:%.*]] = getelementptr i8, ptr [[BASE]], i64 16
; NODBG-NEXT:    [[L_0:%.*]] = load i32, ptr [[SUNKADDR]], align 4
; NODBG-NEXT:    [[L_1:%.*]] = load i32, ptr [[SUNKADDR]], align 4
; NODBG-NEXT:    call void @use(ptr [[BASE]])
; NODBG-NEXT:    br i1 [[EC]], label %[[LOOP]], label %[[EXIT:.*]]
; NODBG:       [[EXIT]]:
; NODBG-NEXT:    ret void
;
entry:
  %gep = getelementptr i8, ptr %base, i64 16
  br label %loop

loop:
  %p = phi ptr [ %gep, %entry ], [ %sel, %loop ]
    #dbg_value(ptr %gep, !6, !DIExpression(), !7)
  %l.0 = load i32, ptr %p, align 4
  %wc = call i1 @llvm.experimental.widenable.condition()
  %l.1 = load i32, ptr %p, align 4
  %sel = select i1 %wc, ptr %gep, ptr %p
  call void @use(ptr %base)
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}

declare void @use(ptr)

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!2}

!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
!1 = !DIFile(filename: "t.c", directory: "/")
!2 = !{i32 2, !"Debug Info Version", i32 3}
!3 = distinct !DISubprogram(name: "f", scope: !1, file: !1, line: 1, type: !4, spFlags: DISPFlagDefinition, unit: !0)
!4 = !DISubroutineType(types: !5)
!5 = !{}
!6 = !DILocalVariable(name: "p", scope: !3, file: !1, line: 1, type: !8)
!7 = !DILocation(line: 1, scope: !3)
!8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
