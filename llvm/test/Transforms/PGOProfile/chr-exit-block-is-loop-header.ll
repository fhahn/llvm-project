entry:
  %l = load i32, ptr %src, align 4
  %c.0 = icmp eq i32 %l, 0
  br i1 %c.0, label %cond.1, label %then.0, !prof !15

then.0:
  br label %cond.1

cond.1:
  %v = add i32 %l, 1
  %c.1 = icmp eq i32 %l, 1
  br i1 %c.1, label %loop, label %then.1, !prof !15

then.1:
  br label %loop

loop:
  %iv = phi i64 [ 0, %cond.1 ], [ 0, %then.1 ], [ %iv.next, %loop ]
  %iv.next = add i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %v
}

