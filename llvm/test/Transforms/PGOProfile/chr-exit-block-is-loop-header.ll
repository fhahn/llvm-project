; The exit block of the CHR scope is a loop header. Values defined in the scope
; and used after the loop must stay dominated on the loop's backedge.

define i32 @exit_block_is_loop_header(ptr %src, i64 %n) !prof !14 {
; CHECK-LABEL: define i32 @exit_block_is_loop_header(
; CHECK-SAME: ptr [[SRC:%.*]], i64 [[N:%.*]]) {{.*}}{
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[SRC]], align 4
; CHECK-NEXT:    [[C_0:%.*]] = icmp eq i32 [[L]], 0
; CHECK-NEXT:    [[C_1:%.*]] = icmp eq i32 [[L]], 1
; CHECK-NEXT:    [[TMP0:%.*]] = freeze i1 [[C_0]]
; CHECK-NEXT:    [[TMP1:%.*]] = select i1 true, i1 [[TMP0]], i1 false, !prof [[PROF15:![0-9]+]]
; CHECK-NEXT:    [[TMP2:%.*]] = freeze i1 [[C_1]]
; CHECK-NEXT:    [[TMP3:%.*]] = select i1 [[TMP1]], i1 [[TMP2]], i1 false, !prof [[PROF15]]
; CHECK-NEXT:    br i1 [[TMP3]], label %[[ENTRY_SPLIT:.*]], label %[[ENTRY_SPLIT_NONCHR:.*]], !prof [[PROF16:![0-9]+]]
; CHECK:       [[ENTRY_SPLIT]]:
; CHECK-NEXT:    br i1 true, label %[[COND_1:.*]], label %[[THEN_0:.*]], !prof [[PROF16]]
; CHECK:       [[THEN_0]]:
; CHECK-NEXT:    br label %[[COND_1]]
; CHECK:       [[COND_1]]:
; CHECK-NEXT:    [[V:%.*]] = add i32 [[L]], 1
; CHECK-NEXT:    br i1 true, label %[[LOOP:.*]], label %[[THEN_1:.*]], !prof [[PROF16]]
; CHECK:       [[THEN_1]]:
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[ENTRY_SPLIT_NONCHR]]:
; CHECK-NEXT:    br i1 [[C_0]], label %[[COND_1_NONCHR:.*]], label %[[THEN_0_NONCHR:.*]], !prof [[PROF16]]
; CHECK:       [[THEN_0_NONCHR]]:
; CHECK-NEXT:    br label %[[COND_1_NONCHR]]
; CHECK:       [[COND_1_NONCHR]]:
; CHECK-NEXT:    [[V_NONCHR:%.*]] = add i32 [[L]], 1
; CHECK-NEXT:    [[C_1_NONCHR:%.*]] = icmp eq i32 [[L]], 1
; CHECK-NEXT:    br i1 [[C_1_NONCHR]], label %[[LOOP]], label %[[THEN_1_NONCHR:.*]], !prof [[PROF16]]
; CHECK:       [[THEN_1_NONCHR]]:
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[TMP4:%.*]] = phi i32 [ [[TMP4]], %[[LOOP]] ], [ [[V]], %[[THEN_1]] ], [ [[V]], %[[COND_1]] ], [ [[V_NONCHR]], %[[THEN_1_NONCHR]] ], [ [[V_NONCHR]], %[[COND_1_NONCHR]] ]
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[COND_1]] ], [ 0, %[[THEN_1]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ], [ 0, %[[COND_1_NONCHR]] ], [ 0, %[[THEN_1_NONCHR]] ]
; CHECK-NEXT:    [[IV_NEXT]] = add i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[TMP4]]
