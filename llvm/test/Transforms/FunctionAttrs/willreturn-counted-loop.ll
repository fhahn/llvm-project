; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-attributes --check-globals all --version 6
; RUN: opt -passes=function-attrs -S %s | FileCheck %s
;
; functionWillReturn() rejects any function with a backedge, so functions with
; a loop that has a constant trip count are never marked willreturn (and in C,
; without mustprogress from the frontend, not mustprogress either). Read-only
; calls to them can then not be removed when unused.
;
; With early full unrolling these functions are loop-free when FunctionAttrs
; runs. Possible fix: accept loops whose trip count is a known constant, e.g.
; via the counted-loop recognition used for initializes inference.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

; A loop with a constant trip count always terminates. functionWillReturn
; currently gives up on any backedge, so @sum16 is not willreturn, and the
; read-only call in @caller can't be deleted.
define i32 @sum16(ptr %p) {
; CHECK: Function Attrs: nofree norecurse nosync nounwind memory(argmem: read)
; CHECK-LABEL: define i32 @sum16(
; CHECK-SAME: ptr nofree readonly captures(none) [[P:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[SUM_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    [[SUM_NEXT]] = add i32 [[SUM]], [[V]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], 16
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[SUM_NEXT]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %sum = phi i32 [ 0, %entry ], [ %sum.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i64 %iv
  %v = load i32, ptr %gep, align 4
  %sum.next = add i32 %sum, %v
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 16
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %sum.next
}

define void @caller(ptr %p) {
; CHECK: Function Attrs: nofree norecurse nosync nounwind memory(argmem: read)
; CHECK-LABEL: define void @caller(
; CHECK-SAME: ptr nofree readonly captures(none) [[P:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[UNUSED:%.*]] = call i32 @sum16(ptr [[P]])
; CHECK-NEXT:    ret void
;
  %unused = call i32 @sum16(ptr %p)
  ret void
}

; Negative: the IV steps by 3 without wrap flags towards an unknown bound, so
; the exit compare may never be true and willreturn must not be inferred.
define i32 @unknown_bound(ptr %p, i64 %n) {
; CHECK: Function Attrs: nofree norecurse nosync nounwind memory(argmem: read)
; CHECK-LABEL: define i32 @unknown_bound(
; CHECK-SAME: ptr nofree readonly captures(none) [[P:%.*]], i64 [[N:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[SUM_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr i32, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    [[SUM_NEXT]] = add i32 [[SUM]], [[V]]
; CHECK-NEXT:    [[IV_NEXT]] = add i64 [[IV]], 3
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[SUM_NEXT]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %sum = phi i32 [ 0, %entry ], [ %sum.next, %loop ]
  %gep = getelementptr i32, ptr %p, i64 %iv
  %v = load i32, ptr %gep, align 4
  %sum.next = add i32 %sum, %v
  %iv.next = add i64 %iv, 3
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %sum.next
}
;.
; CHECK: attributes #[[ATTR0]] = { nofree norecurse nosync nounwind memory(argmem: read) }
;.
