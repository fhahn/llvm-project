; CHECK-NEXT:    [[R:%.*]] = add i64 [[Z]], [[A]]
; CHECK-NEXT:    ret i64 [[R]]
;
  %i = ptrtoint ptr %p to i32
  %a = ptrtoaddr ptr %p to i64
  %z = zext i32 %i to i64
  %r = add i64 %z, %a
