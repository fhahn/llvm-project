; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[I:%.*]] = ptrtoint ptr [[P]] to i64
; CHECK-NEXT:    [[ADDI:%.*]] = add i64 [[I]], 7
; CHECK-NEXT:    [[R:%.*]] = add i64 [[ADDI]], [[ADDI]]
; CHECK-NEXT:    ret i64 [[R]]
;
