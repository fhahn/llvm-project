; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=gvn -S %s | FileCheck %s
;
; GVN only forwards a memset value to a load at a constant offset from the
; memset's destination. When the memset covers the whole underlying object
; (e.g. a local array) and the load is an inbounds access based on that object
; with no clobber in between, every possible offset is inside the memset, so
; the load yields the memset value even for a variable index.
;
; With early full unrolling, the indices become constants and GVN folds the
; loads; with deferred unrolling the loop (hmmer's MajorityRuleConsensus) keeps
; the loads.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

; The whole local array is zeroed by a memset and never written again, so a
; load at any in-bounds index of it, here a variable %i, reads 0.
define i32 @load_var_index_after_full_memset(i64 %i) {
; CHECK-LABEL: define i32 @load_var_index_after_full_memset(
; CHECK-SAME: i64 [[I:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[COUNT:%.*]] = alloca [27 x i32], align 4
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr align 4 [[COUNT]], i8 0, i64 108, i1 false)
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds [27 x i32], ptr [[COUNT]], i64 0, i64 [[I]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    ret i32 [[L]]
;
entry:
  %count = alloca [27 x i32], align 4
  call void @llvm.memset.p0.i64(ptr align 4 %count, i8 0, i64 108, i1 false)
  %gep = getelementptr inbounds [27 x i32], ptr %count, i64 0, i64 %i
  %l = load i32, ptr %gep, align 4
  ret i32 %l
}

; Same inside a counted loop (reduced from hmmer's MajorityRuleConsensus): an
; argmax over a freshly zeroed array folds to the initial values.
define i32 @argmax_over_zeroed_array() {
; CHECK-LABEL: define i32 @argmax_over_zeroed_array() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[COUNT:%.*]] = alloca [27 x i32], align 4
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr align 4 [[COUNT]], i8 0, i64 108, i1 false)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[BEST:%.*]] = phi i32 [ -1, %[[ENTRY]] ], [ [[BEST_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds [27 x i32], ptr [[COUNT]], i64 0, i64 [[IV]]
; CHECK-NEXT:    [[C:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    [[BEST_NEXT]] = call i32 @llvm.smax.i32(i32 [[C]], i32 [[BEST]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], 26
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[BEST_NEXT]]
;
entry:
  %count = alloca [27 x i32], align 4
  call void @llvm.memset.p0.i64(ptr align 4 %count, i8 0, i64 108, i1 false)
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %best = phi i32 [ -1, %entry ], [ %best.next, %loop ]
  %gep = getelementptr inbounds [27 x i32], ptr %count, i64 0, i64 %iv
  %c = load i32, ptr %gep, align 4
  %best.next = call i32 @llvm.smax.i32(i32 %c, i32 %best)
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 26
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %best.next
}

; Negative: the memset only covers the first 64 bytes, so a variable index may
; read uninitialized memory past it.
define i32 @partial_memset(i64 %i) {
; CHECK-LABEL: define i32 @partial_memset(
; CHECK-SAME: i64 [[I:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[COUNT:%.*]] = alloca [27 x i32], align 4
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr align 4 [[COUNT]], i8 0, i64 64, i1 false)
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds [27 x i32], ptr [[COUNT]], i64 0, i64 [[I]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    ret i32 [[L]]
;
entry:
  %count = alloca [27 x i32], align 4
  call void @llvm.memset.p0.i64(ptr align 4 %count, i8 0, i64 64, i1 false)
  %gep = getelementptr inbounds [27 x i32], ptr %count, i64 0, i64 %i
  %l = load i32, ptr %gep, align 4
  ret i32 %l
}

; Negative: a store at an unknown index after the memset may clobber.
define i32 @clobbered_after_memset(i64 %i, i64 %j) {
; CHECK-LABEL: define i32 @clobbered_after_memset(
; CHECK-SAME: i64 [[I:%.*]], i64 [[J:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[COUNT:%.*]] = alloca [27 x i32], align 4
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr align 4 [[COUNT]], i8 0, i64 108, i1 false)
; CHECK-NEXT:    [[GEP_J:%.*]] = getelementptr inbounds [27 x i32], ptr [[COUNT]], i64 0, i64 [[J]]
; CHECK-NEXT:    store i32 5, ptr [[GEP_J]], align 4
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds [27 x i32], ptr [[COUNT]], i64 0, i64 [[I]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    ret i32 [[L]]
;
entry:
  %count = alloca [27 x i32], align 4
  call void @llvm.memset.p0.i64(ptr align 4 %count, i8 0, i64 108, i1 false)
  %gep.j = getelementptr inbounds [27 x i32], ptr %count, i64 0, i64 %j
  store i32 5, ptr %gep.j, align 4
  %gep = getelementptr inbounds [27 x i32], ptr %count, i64 0, i64 %i
  %l = load i32, ptr %gep, align 4
  ret i32 %l
}

declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)
declare i32 @llvm.smax.i32(i32, i32)
