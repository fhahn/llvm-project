; RUN: opt -passes=gvn -gvn-add-phi-translation -S %s | FileCheck %s

; PHI translation must not reuse existing instructions with poison-generating
; flags the translated instruction does not have. In both tests, the load in
; %merge must not be replaced by the value stored in %then, which writes a
; different address.

; %x.zext.nneg is poison for negative %x, but (base + zext(x)) and
; (base + sext(x)) differ then.
define i8 @no_reuse_zext_nneg(ptr %base, i8 %x, i1 %c) {
; CHECK-LABEL: define i8 @no_reuse_zext_nneg(
; CHECK-SAME: ptr [[BASE:%.*]], i8 [[X:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[X_ZEXT_NNEG:%.*]] = zext nneg i8 [[X]] to i64
; CHECK-NEXT:    [[GEP_ZEXT_NNEG:%.*]] = getelementptr i8, ptr [[BASE]], i64 [[X_ZEXT_NNEG]]
; CHECK-NEXT:    [[X_SEXT:%.*]] = sext i8 [[X]] to i64
; CHECK-NEXT:    [[GEP_SEXT:%.*]] = getelementptr i8, ptr [[BASE]], i64 [[X_SEXT]]
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[ENTRY_MERGE_CRIT_EDGE:.*]]
; CHECK:       [[ENTRY_MERGE_CRIT_EDGE]]:
; CHECK-NEXT:    br label %[[MERGE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    store i8 42, ptr [[GEP_SEXT]], align 1
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[IDX:%.*]] = phi i8 [ [[X]], %[[THEN]] ], [ 0, %[[ENTRY_MERGE_CRIT_EDGE]] ]
; CHECK-NEXT:    [[IDX_ZEXT:%.*]] = zext i8 [[IDX]] to i64
; CHECK-NEXT:    [[GEP_IDX:%.*]] = getelementptr i8, ptr [[BASE]], i64 [[IDX_ZEXT]]
; CHECK-NEXT:    [[L:%.*]] = load i8, ptr [[GEP_IDX]], align 1
; CHECK-NEXT:    ret i8 [[L]]
;
entry:
  %x.zext.nneg = zext nneg i8 %x to i64
  %gep.zext.nneg = getelementptr i8, ptr %base, i64 %x.zext.nneg
  %x.sext = sext i8 %x to i64
  %gep.sext = getelementptr i8, ptr %base, i64 %x.sext
  br i1 %c, label %then, label %merge

then:
  store i8 42, ptr %gep.sext
  br label %merge

merge:
  %idx = phi i8 [ %x, %then ], [ 0, %entry ]
  %idx.zext = zext i8 %idx to i64
  %gep.idx = getelementptr i8, ptr %base, i64 %idx.zext
  %l = load i8, ptr %gep.idx
  ret i8 %l
}

; %x.inc.nuw is poison for %x == 255, but (base + zext(x + 1)) and
; (base + zext(x) + 1) differ then.
define i8 @no_reuse_add_nuw(ptr %base, i8 %x, i1 %c) {
; CHECK-LABEL: define i8 @no_reuse_add_nuw(
; CHECK-SAME: ptr [[BASE:%.*]], i8 [[X:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[X_INC_NUW:%.*]] = add nuw i8 [[X]], 1
; CHECK-NEXT:    [[X_INC_NUW_ZEXT:%.*]] = zext i8 [[X_INC_NUW]] to i64
; CHECK-NEXT:    [[GEP_INC_NUW:%.*]] = getelementptr i8, ptr [[BASE]], i64 [[X_INC_NUW_ZEXT]]
; CHECK-NEXT:    [[X_ZEXT:%.*]] = zext i8 [[X]] to i64
; CHECK-NEXT:    [[X_ZEXT_INC:%.*]] = add i64 [[X_ZEXT]], 1
; CHECK-NEXT:    [[GEP_ZEXT_INC:%.*]] = getelementptr i8, ptr [[BASE]], i64 [[X_ZEXT_INC]]
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[ENTRY_MERGE_CRIT_EDGE:.*]]
; CHECK:       [[ENTRY_MERGE_CRIT_EDGE]]:
; CHECK-NEXT:    br label %[[MERGE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    store i8 42, ptr [[GEP_ZEXT_INC]], align 1
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[IDX:%.*]] = phi i8 [ [[X]], %[[THEN]] ], [ 0, %[[ENTRY_MERGE_CRIT_EDGE]] ]
; CHECK-NEXT:    [[IDX_INC:%.*]] = add i8 [[IDX]], 1
; CHECK-NEXT:    [[IDX_INC_ZEXT:%.*]] = zext i8 [[IDX_INC]] to i64
; CHECK-NEXT:    [[GEP_IDX:%.*]] = getelementptr i8, ptr [[BASE]], i64 [[IDX_INC_ZEXT]]
; CHECK-NEXT:    [[L:%.*]] = load i8, ptr [[GEP_IDX]], align 1
; CHECK-NEXT:    ret i8 [[L]]
;
entry:
  %x.inc.nuw = add nuw i8 %x, 1
  %x.inc.nuw.zext = zext i8 %x.inc.nuw to i64
  %gep.inc.nuw = getelementptr i8, ptr %base, i64 %x.inc.nuw.zext
  %x.zext = zext i8 %x to i64
  %x.zext.inc = add i64 %x.zext, 1
  %gep.zext.inc = getelementptr i8, ptr %base, i64 %x.zext.inc
  br i1 %c, label %then, label %merge

then:
  store i8 42, ptr %gep.zext.inc
  br label %merge

merge:
  %idx = phi i8 [ %x, %then ], [ 0, %entry ]
  %idx.inc = add i8 %idx, 1
  %idx.inc.zext = zext i8 %idx.inc to i64
  %gep.idx = getelementptr i8, ptr %base, i64 %idx.inc.zext
  %l = load i8, ptr %gep.idx
  ret i8 %l
}
