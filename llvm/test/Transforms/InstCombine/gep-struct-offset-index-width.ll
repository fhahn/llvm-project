; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -passes=instcombine -S %s | FileCheck %s

; The offset of the struct's second field does not fit into the 16 bit pointer
; index type. Check that accumulating the offsets does not assert and that the
; offset is truncated to the index type, in which pointer arithmetic wraps.

target datalayout = "e-m:e-p:16:16-i32:16-i64:16-f32:16-f64:16-a:8-n8:16-S16"

%s = type { [65536 x i8], i8 }

define ptr @gep_of_gep_struct_offset_exceeds_index_width(ptr %p, i16 %i) {
; CHECK-LABEL: @gep_of_gep_struct_offset_exceeds_index_width(
; CHECK-NEXT:    [[B:%.*]] = getelementptr inbounds i8, ptr [[P:%.*]], i16 [[I:%.*]]
; CHECK-NEXT:    ret ptr [[B]]
;
  %a = getelementptr inbounds %s, ptr %p, i16 0, i32 1
  %b = getelementptr inbounds i8, ptr %a, i16 %i
  ret ptr %b
}

define ptr @gep_struct_offset_exceeds_index_width_multiple(ptr %p) {
; CHECK-LABEL: @gep_struct_offset_exceeds_index_width_multiple(
; CHECK-NEXT:    ret ptr [[P:%.*]]
;
  %a = getelementptr inbounds %s, ptr %p, i16 0, i32 1
  %b = getelementptr inbounds %s, ptr %a, i16 0, i32 1
  ret ptr %b
}
