; (C - X) - Phi --> (C - Phi) - X if C - Phi folds into the phi.

declare void @use(i16)

; Difference of consecutive values of C - x[i], with a start value of 0.
define void @diff_of_consecutive(ptr %out, ptr %in, i64 %n) {
; CHECK-LABEL: @diff_of_consecutive(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, [[ENTRY:%.*]] ], [ [[IV_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[PREV:%.*]] = phi i16 [ -32768, [[ENTRY]] ], [ [[X:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[GEP_IN:%.*]] = getelementptr inbounds nuw [2 x i8], ptr [[IN:%.*]], i64 [[IV]]
; CHECK-NEXT:    [[X]] = load i16, ptr [[GEP_IN]], align 2
; CHECK-NEXT:    [[D:%.*]] = sub i16 [[PREV]], [[X]]
; CHECK-NEXT:    [[GEP_OUT:%.*]] = getelementptr inbounds nuw [2 x i8], ptr [[OUT:%.*]], i64 [[IV]]
; CHECK-NEXT:    store i16 [[D]], ptr [[GEP_OUT]], align 2
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[EC]], label [[EXIT:%.*]], label [[LOOP]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %prev = phi i16 [ 0, %entry ], [ %cur, %loop ]
  %gep.in = getelementptr inbounds i16, ptr %in, i64 %iv
  %x = load i16, ptr %gep.in, align 2
  %cur = sub i16 -32768, %x
  %d = sub i16 %cur, %prev
  %gep.out = getelementptr inbounds i16, ptr %out, i64 %iv
  store i16 %d, ptr %gep.out, align 2
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

