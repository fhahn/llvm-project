; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -passes=instcombine -S %s | FileCheck %s

declare void @use(i32)

; select (icmp ult X, C), (shl A, C), (shl A, X)  ==  shl A, umax(X, C)
; 36 == 9 << 2, so this is "shl 9, umax(%x, 2)".
define i32 @clamped_shl(i32 %x) {
; CHECK-LABEL: @clamped_shl(
; CHECK-NEXT:    [[X:%.*]] = call i32 @llvm.umax.i32(i32 [[X1:%.*]], i32 2)
; CHECK-NEXT:    [[S:%.*]] = shl i32 9, [[X]]
; CHECK-NEXT:    ret i32 [[S]]
;
  %c = icmp ult i32 %x, 2
  %s = shl i32 9, %x
  %r = select i1 %c, i32 36, i32 %s
  ret i32 %r
}

; The umax form it reaches.
define i32 @umax_form(i32 %x) {
; CHECK-LABEL: @umax_form(
; CHECK-NEXT:    [[M:%.*]] = call i32 @llvm.umax.i32(i32 [[X:%.*]], i32 2)
; CHECK-NEXT:    [[S:%.*]] = shl i32 9, [[M]]
; CHECK-NEXT:    ret i32 [[S]]
;
  %m = call i32 @llvm.umax.i32(i32 %x, i32 2)
  %s = shl i32 9, %m
  ret i32 %s
}

; TODO: a umin-style clamp where the compare is not on the shift amount itself is
; not recognized: in umin form the clamp folds away against a smaller compare
; constant, in select form it does not.
define i1 @clamp_then_compare_umin(i64 %x) {
; CHECK-LABEL: @clamp_then_compare_umin(
; CHECK-NEXT:    [[SH:%.*]] = lshr i64 [[X:%.*]], 32
; CHECK-NEXT:    [[TR:%.*]] = trunc nuw i64 [[SH]] to i32
; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[TR]], 57344
; CHECK-NEXT:    ret i1 [[C]]
;
  %sh = lshr i64 %x, 32
  %tr = trunc i64 %sh to i32
  %m = call i32 @llvm.umin.i32(i32 %tr, i32 65535)
  %c = icmp ult i32 %m, 57344
  ret i1 %c
}

define i1 @clamp_then_compare_select(i64 %x) {
; CHECK-LABEL: @clamp_then_compare_select(
; CHECK-NEXT:    [[SH:%.*]] = lshr i64 [[X:%.*]], 32
; CHECK-NEXT:    [[TR:%.*]] = trunc nuw i64 [[SH]] to i32
; CHECK-NEXT:    [[BIG:%.*]] = icmp ult i64 [[X]], 281474976710656
; CHECK-NEXT:    [[C1:%.*]] = icmp ult i32 [[TR]], 57344
; CHECK-NEXT:    [[C:%.*]] = select i1 [[BIG]], i1 [[C1]], i1 false
; CHECK-NEXT:    ret i1 [[C]]
;
  %sh = lshr i64 %x, 32
  %tr = trunc i64 %sh to i32
  %big = icmp ugt i64 %x, 281474976710655
  %m = select i1 %big, i32 65535, i32 %tr
  %c = icmp ult i32 %m, 57344
  ret i1 %c
}

declare i32 @llvm.umax.i32(i32, i32)
declare i32 @llvm.umin.i32(i32, i32)
