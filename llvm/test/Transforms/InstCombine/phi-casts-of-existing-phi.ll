  %iv.next.int = ptrtoint ptr %iv.next to i64
  call void @use(i64 %iv.next.int)
  %c = call i1 @cond()
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

; Negative: a new ptrtoint of an unstable pointer (ni:1) would be an extra
; dynamic cast, which may observe a different value than %a.int/%b.int.
define void @unstable_ptrtoint(i1 %c, ptr addrspace(1) %a, ptr addrspace(1) %b) {
; CHECK-LABEL: define void @unstable_ptrtoint(
; CHECK-SAME: i1 [[C:%.*]], ptr addrspace(1) [[A:%.*]], ptr addrspace(1) [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[A_INT:%.*]] = ptrtoint ptr addrspace(1) [[A]] to i64
; CHECK-NEXT:    call void @use(i64 [[A_INT]])
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[JOIN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[B_INT:%.*]] = ptrtoint ptr addrspace(1) [[B]] to i64
; CHECK-NEXT:    call void @use(i64 [[B_INT]])
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[X_INT:%.*]] = phi i64 [ [[A_INT]], %[[ENTRY]] ], [ [[B_INT]], %[[THEN]] ]
; CHECK-NEXT:    [[X:%.*]] = phi ptr addrspace(1) [ [[A]], %[[ENTRY]] ], [ [[B]], %[[THEN]] ]
; CHECK-NEXT:    store i8 0, ptr addrspace(1) [[X]], align 1
; CHECK-NEXT:    call void @use(i64 [[X_INT]])
; CHECK-NEXT:    ret void
;
entry:
  %a.int = ptrtoint ptr addrspace(1) %a to i64
  call void @use(i64 %a.int)
  br i1 %c, label %then, label %join

then:
  %b.int = ptrtoint ptr addrspace(1) %b to i64
  call void @use(i64 %b.int)
  br label %join

join:
  %x.int = phi i64 [ %a.int, %entry ], [ %b.int, %then ]
  %x = phi ptr addrspace(1) [ %a, %entry ], [ %b, %then ]
  store i8 0, ptr addrspace(1) %x, align 1
  call void @use(i64 %x.int)
  ret void
}

; Negative: same as @unstable_ptrtoint, with ptrtoaddr.
define void @unstable_ptrtoaddr(i1 %c, ptr addrspace(1) %a, ptr addrspace(1) %b) {
; CHECK-LABEL: define void @unstable_ptrtoaddr(
; CHECK-SAME: i1 [[C:%.*]], ptr addrspace(1) [[A:%.*]], ptr addrspace(1) [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[A_ADDR:%.*]] = ptrtoaddr ptr addrspace(1) [[A]] to i64
; CHECK-NEXT:    call void @use(i64 [[A_ADDR]])
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[JOIN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[B_ADDR:%.*]] = ptrtoaddr ptr addrspace(1) [[B]] to i64
; CHECK-NEXT:    call void @use(i64 [[B_ADDR]])
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[X_ADDR:%.*]] = phi i64 [ [[A_ADDR]], %[[ENTRY]] ], [ [[B_ADDR]], %[[THEN]] ]
; CHECK-NEXT:    [[X:%.*]] = phi ptr addrspace(1) [ [[A]], %[[ENTRY]] ], [ [[B]], %[[THEN]] ]
; CHECK-NEXT:    store i8 0, ptr addrspace(1) [[X]], align 1
; CHECK-NEXT:    call void @use(i64 [[X_ADDR]])
; CHECK-NEXT:    ret void
;
entry:
  %a.addr = ptrtoaddr ptr addrspace(1) %a to i64
  call void @use(i64 %a.addr)
  br i1 %c, label %then, label %join

then:
  %b.addr = ptrtoaddr ptr addrspace(1) %b to i64
  call void @use(i64 %b.addr)
  br label %join

join:
  %x.addr = phi i64 [ %a.addr, %entry ], [ %b.addr, %then ]
  %x = phi ptr addrspace(1) [ %a, %entry ], [ %b, %then ]
  store i8 0, ptr addrspace(1) %x, align 1
  call void @use(i64 %x.addr)
  ret void
}
