; The overflow bit is negated before it is branched on. InstCombine
; canonicalizes that away, and must then still fold the value component in the
; same iteration - only the overflow bit is re-queued on such a change.
define i32 @inverted_guard(i32 %x, i32 %y) {
; CHECK-LABEL: define i32 @inverted_guard(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[OV:%.*]] = icmp ult i32 [[X]], [[Y]]
; CHECK-NEXT:    br i1 [[OV]], label %[[ERR:.*]], label %[[OK:.*]]
; CHECK:       [[OK]]:
; CHECK-NEXT:    [[V:%.*]] = sub nuw i32 [[X]], [[Y]]
; CHECK-NEXT:    ret i32 [[V]]
; CHECK:       [[ERR]]:
; CHECK-NEXT:    ret i32 0
;
entry:
  %wo = call { i32, i1 } @llvm.usub.with.overflow.i32(i32 %x, i32 %y)
  %ov = extractvalue { i32, i1 } %wo, 1
  %v = extractvalue { i32, i1 } %wo, 0
  %not.ov = xor i1 %ov, true
  br i1 %not.ov, label %ok, label %err

ok:
  ret i32 %v

err:
  ret i32 0
}

