; Tests for rewriting the value component of a *.with.overflow intrinsic to a
; plain no-wrap binop, when every use of the value is only reachable when the
; operation did not overflow.

declare void @use(i32)
declare void @use.agg({ i32, i1 })

; The overflow check of a usub folds to icmp ult, so the intrinsic goes away
; and the materialized binop is not a duplicate.
define i32 @usub_value_dominated(i32 %x, i32 %y) {
; CHECK-LABEL: define i32 @usub_value_dominated(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[OV:%.*]] = icmp ult i32 [[X]], [[Y]]
; CHECK-NEXT:    br i1 [[OV]], label %[[ERR:.*]], label %[[OK:.*]]
; CHECK:       [[OK]]:
; CHECK-NEXT:    [[V:%.*]] = sub nuw i32 [[X]], [[Y]]
; CHECK-NEXT:    ret i32 [[V]]
; CHECK:       [[ERR]]:
; CHECK-NEXT:    ret i32 0
;
entry:
  %wo = call { i32, i1 } @llvm.usub.with.overflow.i32(i32 %x, i32 %y)
  %ov = extractvalue { i32, i1 } %wo, 1
  br i1 %ov, label %err, label %ok

ok:
  %v = extractvalue { i32, i1 } %wo, 0
  ret i32 %v

err:
  ret i32 0
}

