; CHECK-NEXT:    [[V:%.*]] = sub nuw i32 [[X]], [[Y]]
; CHECK-NEXT:    br i1 [[OV]], label %[[ERR:.*]], label %[[OK:.*]]
; CHECK:       [[OK]]:
; CHECK-NEXT:    br i1 [[C]], label %[[A:.*]], label %[[B:.*]]
; CHECK:       [[A]]:
