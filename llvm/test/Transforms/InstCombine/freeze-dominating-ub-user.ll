; %p is a store address in a block that dominates the freeze, so it is neither
; undef nor poison there and the freeze can be removed, instead of being pushed
; into the recurrence (which drops inbounds nuw from %p.next).
define void @freeze_icmp_store_addr_recurrence(ptr noundef %base, ptr noundef %end, i1 %c) {
; CHECK-LABEL: define void @freeze_icmp_store_addr_recurrence(
; CHECK-SAME: ptr noundef [[BASE:%.*]], ptr noundef [[END:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[BASE]], %[[ENTRY]] ], [ [[P_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    br i1 [[C]], label %[[BODY:.*]], label %[[EXIT:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    store i8 0, ptr [[P]], align 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult ptr [[P]], [[END]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LATCH]], label %[[EXIT]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[P_NEXT]] = getelementptr i8, ptr [[P]], i64 4
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %p = phi ptr [ %base, %entry ], [ %p.next, %latch ]
  br i1 %c, label %body, label %exit

body:
  store i8 0, ptr %p, align 1
  %cmp = icmp ult ptr %p, %end
  %fr = freeze i1 %cmp
  br i1 %fr, label %latch, label %exit

latch:
  %p.next = getelementptr inbounds nuw i8, ptr %p, i64 4
  br label %loop

exit:
  ret void
}

