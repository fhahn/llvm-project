; RUN: opt -passes=instcombine -S < %s | FileCheck %s

; FIXME: fptrunc (frem double (fpext bfloat A), (fpext half B)) to float is
; narrowed to an frem in half, the operand type with the wider significand.
; bfloat has a much larger exponent range than half, so converting A to half
; overflows to +-inf for |A| > 65504 and the frem returns NaN.
;
; For %a = 65536.0 (0xR4780) and %b = 3.0 (0xH4200) the correct result is
; 65536 mod 3 = 1.0 (0x3f800000); the transformed function computes
; frem(+inf, 3.0) = NaN. LLVM's UB-aware interpreter (llubi) returns 0x3f800000
; on the input and a NaN on the output.

define float @frem_fpext_bfloat_half(bfloat %a, half %b) {
; CHECK-LABEL: define float @frem_fpext_bfloat_half(
; CHECK-SAME: bfloat [[A:%.*]], half [[B:%.*]]) {
; CHECK-NEXT:    [[X:%.*]] = fpext bfloat [[A]] to double
; CHECK-NEXT:    [[TMP1:%.*]] = fptrunc double [[X]] to half
; CHECK-NEXT:    [[TMP2:%.*]] = frem half [[TMP1]], [[B]]
; CHECK-NEXT:    [[R:%.*]] = fpext half [[TMP2]] to float
; CHECK-NEXT:    ret float [[R]]
;
  %x = fpext bfloat %a to double
  %y = fpext half %b to double
  %s = frem double %x, %y
  %r = fptrunc double %s to float
  ret float %r
}
