; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=instcombine -S < %s | FileCheck %s

; fptrunc (frem double (fpext bfloat A), (fpext half B)) to float must not be
; narrowed: neither bfloat nor half can represent all values of the other, so
; there is no source type to evaluate the frem in. E.g. converting A to half
; overflows to +-inf for |A| > 65504, and the frem would return NaN.

define float @frem_fpext_bfloat_half(bfloat %a, half %b) {
; CHECK-LABEL: define float @frem_fpext_bfloat_half(
; CHECK-SAME: bfloat [[A:%.*]], half [[B:%.*]]) {
; CHECK-NEXT:    [[X:%.*]] = fpext bfloat [[A]] to double
; CHECK-NEXT:    [[Y:%.*]] = fpext half [[B]] to double
; CHECK-NEXT:    [[S:%.*]] = frem double [[X]], [[Y]]
; CHECK-NEXT:    [[R:%.*]] = fptrunc double [[S]] to float
; CHECK-NEXT:    ret float [[R]]
;
  %x = fpext bfloat %a to double
  %y = fpext half %b to double
  %s = frem double %x, %y
  %r = fptrunc double %s to float
  ret float %r
}
