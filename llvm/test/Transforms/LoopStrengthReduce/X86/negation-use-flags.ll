; CHECK:       [[PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi i64 [ [[LSR_IV_NEXT:%.*]], %[[LOOP]] ], [ 0, %[[PREHEADER]] ]
; CHECK-NEXT:    [[SCEVGEP1:%.*]] = getelementptr i8, ptr [[DST]], i64 [[LSR_IV]]
; CHECK-NEXT:    store i8 0, ptr [[SCEVGEP1]], align 1
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add nuw nsw i64 [[LSR_IV]], 1
; CHECK-NEXT:    [[TMP:%.*]] = trunc i64 [[LSR_IV_NEXT]] to i32
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[TMP]], 10
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i64 0
; CHECK:       [[BYPASS]]:
; CHECK-NEXT:    [[BARE:%.*]] = sub i32 0, [[RHS]]
; CHECK-NEXT:    [[BARE_WIDE:%.*]] = sext i32 [[BARE]] to i64
; CHECK-NEXT:    ret i64 [[BARE_WIDE]]
;
entry:
  br i1 %enter, label %preheader, label %bypass

preheader:
  %rhs.wide = sext i32 %rhs to i64
  %biased = getelementptr i8, ptr %dst, i64 %rhs.wide
  br label %loop

loop:
  %iv = phi i32 [ 0, %preheader ], [ %next, %loop ]
  %difference = sub nsw i32 %iv, %rhs
  %p = getelementptr i8, ptr %biased, i32 %difference
  store i8 0, ptr %p
  %next = add nuw nsw i32 %iv, 1
  %done = icmp eq i32 %next, 10
