; RUN: opt -passes=loop-reduce -verify-scev -S %s | FileCheck %s

; Folding a loop-invariant scale into a recurrence can retain NUW on the
; initial product's use. The same product may wrap on a path skipping the loop.
target datalayout = "e-p:64:64-i64:64-n8:16:32:64"
target triple = "x86_64-unknown-linux-gnu"

define i32 @scaled_nuw(ptr %dst, i32 %a, i32 %b, i32 %n, i1 %enter) {
; CHECK-LABEL: define i32 @scaled_nuw(
; CHECK-SAME: ptr [[DST:%.*]], i32 [[A:%.*]], i32 [[B:%.*]], i32 [[N:%.*]], i1 [[ENTER:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[ENTER]], label %[[PREHEADER:.*]], label %[[BYPASS:.*]]
; CHECK:       [[PREHEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = sub i32 [[N]], [[A]]
; CHECK-NEXT:    [[TMP1:%.*]] = mul nuw i32 [[B]], [[A]]
; CHECK-NEXT:    [[TMP2:%.*]] = zext i32 [[TMP1]] to i64
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[DST]], i64 [[TMP2]]
; CHECK-NEXT:    [[TMP3:%.*]] = zext i32 [[B]] to i64
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[LSR_IV1:%.*]] = phi ptr [ [[SCEVGEP2:%.*]], %[[LOOP]] ], [ [[SCEVGEP]], %[[PREHEADER]] ]
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi i32 [ [[LSR_IV_NEXT:%.*]], %[[LOOP]] ], [ [[TMP0]], %[[PREHEADER]] ]
; CHECK-NEXT:    store i8 0, ptr [[LSR_IV1]], align 1
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add i32 [[LSR_IV]], -1
; CHECK-NEXT:    [[SCEVGEP2]] = getelementptr i8, ptr [[LSR_IV1]], i64 [[TMP3]]
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[LSR_IV_NEXT]], 0
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 0
; CHECK:       [[BYPASS]]:
; CHECK-NEXT:    [[BARE:%.*]] = mul i32 [[A]], [[B]]
; CHECK-NEXT:    ret i32 [[BARE]]
;
entry:
  br i1 %enter, label %preheader, label %bypass

preheader:
  br label %loop

loop:
  %iv = phi i32 [ %a, %preheader ], [ %next, %loop ]
  %index = mul nuw i32 %iv, %b
  %wide = zext i32 %index to i64
  %p = getelementptr i8, ptr %dst, i64 %wide
  store i8 0, ptr %p
  %next = add nuw i32 %iv, 1
  %done = icmp eq i32 %next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret i32 0

bypass:
  %bare = mul i32 %a, %b
  ret i32 %bare
}

