; The initial product cannot wrap, but Step * Scale need not fit when the
; loop executes only once. Do not apply the start's use flags to the step.
define void @scaled_nuw_variable_step(ptr %dst, i32 %a, i32 %b, i32 %step, i32 %n) {
; CHECK-LABEL: define void @scaled_nuw_variable_step(
; CHECK-SAME: ptr [[DST:%.*]], i32 [[A:%.*]], i32 [[B:%.*]], i32 [[STEP:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = mul nuw i32 [[B]], [[A]]
; CHECK-NEXT:    [[TMP1:%.*]] = zext i32 [[TMP0]] to i64
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[DST]], i64 [[TMP1]]
; CHECK-NEXT:    [[TMP2:%.*]] = mul i32 [[STEP]], [[B]]
; CHECK-NEXT:    [[TMP3:%.*]] = zext i32 [[TMP2]] to i64
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[LSR_IV2:%.*]] = phi i32 [ [[LSR_IV_NEXT:%.*]], %[[LOOP]] ], [ [[N]], %[[ENTRY]] ]
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi ptr [ [[SCEVGEP1:%.*]], %[[LOOP]] ], [ [[SCEVGEP]], %[[ENTRY]] ]
; CHECK-NEXT:    store i8 0, ptr [[LSR_IV]], align 1
; CHECK-NEXT:    [[SCEVGEP1]] = getelementptr i8, ptr [[LSR_IV]], i64 [[TMP3]]
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add i32 [[LSR_IV2]], -1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[LSR_IV_NEXT]], 0
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ %a, %entry ], [ %next, %loop ]
  %count = phi i32 [ 0, %entry ], [ %count.next, %loop ]
  %index = mul nuw i32 %iv, %b
  %wide = zext i32 %index to i64
  %p = getelementptr i8, ptr %dst, i64 %wide
  store i8 0, ptr %p
  %next = add nuw i32 %iv, %step
  %count.next = add i32 %count, 1
  %done = icmp eq i32 %count.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; The start is a wrapping product. Flattening it into the new product loses
; the grouping on which the NUW guarantee depends, so the use flag must drop.
define void @scaled_nuw_wrapping_start(ptr %dst, i32 %a, i32 %b, i32 %c, i32 %n) {
; CHECK-LABEL: define void @scaled_nuw_wrapping_start(
; CHECK-SAME: ptr [[DST:%.*]], i32 [[A:%.*]], i32 [[B:%.*]], i32 [[C:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[START:%.*]] = mul i32 [[A]], [[C]]
; CHECK-NEXT:    [[TMP0:%.*]] = sub i32 [[N]], [[START]]
; CHECK-NEXT:    [[TMP1:%.*]] = mul i32 [[C]], [[B]]
; CHECK-NEXT:    [[TMP2:%.*]] = mul i32 [[TMP1]], [[A]]
; CHECK-NEXT:    [[TMP3:%.*]] = zext i32 [[TMP2]] to i64
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[DST]], i64 [[TMP3]]
; CHECK-NEXT:    [[TMP4:%.*]] = zext i32 [[B]] to i64
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[LSR_IV1:%.*]] = phi ptr [ [[SCEVGEP2:%.*]], %[[LOOP]] ], [ [[SCEVGEP]], %[[ENTRY]] ]
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi i32 [ [[LSR_IV_NEXT:%.*]], %[[LOOP]] ], [ [[TMP0]], %[[ENTRY]] ]
; CHECK-NEXT:    store i8 0, ptr [[LSR_IV1]], align 1
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add i32 [[LSR_IV]], -1
; CHECK-NEXT:    [[SCEVGEP2]] = getelementptr i8, ptr [[LSR_IV1]], i64 [[TMP4]]
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[LSR_IV_NEXT]], 0
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %start = mul i32 %a, %c
  br label %loop

loop:
  %iv = phi i32 [ %start, %entry ], [ %next, %loop ]
  %index = mul nuw i32 %iv, %b
  %wide = zext i32 %index to i64
  %p = getelementptr i8, ptr %dst, i64 %wide
  store i8 0, ptr %p
  %next = add nuw i32 %iv, 1
  %done = icmp eq i32 %next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; The start product can be hoisted above the conditional inner loop. Its NUW
; must not affect the wrapping product used by the outer loop when enter is false.
define i32 @scaled_nuw_nested(ptr %dst, i32 %a, i32 %b, i32 %outer_n, i32 %inner_n, i1 %enter) {
; CHECK-LABEL: define i32 @scaled_nuw_nested(
; CHECK-SAME: ptr [[DST:%.*]], i32 [[A:%.*]], i32 [[B:%.*]], i32 [[OUTER_N:%.*]], i32 [[INNER_N:%.*]], i1 [[ENTER:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = mul nuw i32 [[B]], [[A]]
; CHECK-NEXT:    [[TMP1:%.*]] = zext i32 [[TMP0]] to i64
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[DST]], i64 [[TMP1]]
; CHECK-NEXT:    [[TMP2:%.*]] = zext i32 [[B]] to i64
; CHECK-NEXT:    [[TMP3:%.*]] = mul i32 [[OUTER_N]], [[B]]
; CHECK-NEXT:    [[TMP4:%.*]] = mul i32 [[TMP3]], [[A]]
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[COUNT:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[COUNTNEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    br i1 [[ENTER]], label %[[PREHEADER:.*]], label %[[OUTER_LATCH]]
; CHECK:       [[PREHEADER]]:
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[LSR_IV2:%.*]] = phi i32 [ [[LSR_IV_NEXT:%.*]], %[[INNER]] ], [ [[INNER_N]], %[[PREHEADER]] ]
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi ptr [ [[SCEVGEP1:%.*]], %[[INNER]] ], [ [[SCEVGEP]], %[[PREHEADER]] ]
; CHECK-NEXT:    store i8 0, ptr [[LSR_IV]], align 1
; CHECK-NEXT:    [[SCEVGEP1]] = getelementptr i8, ptr [[LSR_IV]], i64 [[TMP2]]
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add i32 [[LSR_IV2]], -1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[LSR_IV_NEXT]], 0
; CHECK-NEXT:    br i1 [[DONE]], label %[[OUTER_LATCH_LOOPEXIT:.*]], label %[[INNER]]
; CHECK:       [[OUTER_LATCH_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[COUNTNEXT]] = add nuw i32 [[COUNT]], 1
; CHECK-NEXT:    [[OUTER_DONE:%.*]] = icmp eq i32 [[COUNTNEXT]], [[OUTER_N]]
; CHECK-NEXT:    br i1 [[OUTER_DONE]], label %[[EXIT:.*]], label %[[OUTER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[TMP4]]
;
entry:
  br label %outer

outer:
  %count = phi i32 [ 0, %entry ], [ %countnext, %outer_latch ]
  %acc = phi i32 [ 0, %entry ], [ %accnext, %outer_latch ]
  %bare = mul i32 %a, %b
  %accnext = add i32 %acc, %bare
  br i1 %enter, label %preheader, label %outer_latch

preheader:
  br label %inner

inner:
  %j = phi i32 [ %a, %preheader ], [ %jnext, %inner ]
  %k = phi i32 [ 0, %preheader ], [ %knext, %inner ]
  %idx = mul nuw i32 %j, %b
  %wide = zext i32 %idx to i64
  %ptr = getelementptr i8, ptr %dst, i64 %wide
  store i8 0, ptr %ptr
  %jnext = add nuw i32 %j, 1
  %knext = add nuw i32 %k, 1
  %done = icmp eq i32 %knext, %inner_n
  br i1 %done, label %outer_latch, label %inner

outer_latch:
  %countnext = add nuw i32 %count, 1
  %outer_done = icmp eq i32 %countnext, %outer_n
  br i1 %outer_done, label %exit, label %outer

exit:
  ret i32 %accnext
}
