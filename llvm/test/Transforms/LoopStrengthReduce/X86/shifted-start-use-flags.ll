; Widen the non-wrapping start sum to cancel the address bias. The same
; sum on the bypass path can wrap, so its zero extension must not commute.
; The SCEV printer queries both paths, and shifted_start_bypass_first reverses
; their query order. Also requery after invalidating ScalarEvolution.
target datalayout = "e-p:64:64-i64:64-n8:16:32:64"
target triple = "x86_64-unknown-linux-gnu"

define i64 @shifted_start(ptr %dst, i32 %a, i32 %b, i1 %enter) {
; CHECK-LABEL: define i64 @shifted_start(
; CHECK-SAME: ptr [[DST:%.*]], i32 [[A:%.*]], i32 [[B:%.*]], i1 [[ENTER:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[ENTER]], label %[[PREHEADER:.*]], label %[[BYPASS:.*]]
; CHECK:       [[PREHEADER]]:
; CHECK-NEXT:    [[A_WIDE:%.*]] = zext i32 [[A]] to i64
; CHECK-NEXT:    [[B_WIDE:%.*]] = zext i32 [[B]] to i64
; CHECK-NEXT:    [[OFFSET:%.*]] = add i64 [[A_WIDE]], [[B_WIDE]]
; CHECK-NEXT:    [[TMP0:%.*]] = add i32 [[B]], [[A]]
; CHECK-NEXT:    [[TMP1:%.*]] = zext i32 [[TMP0]] to i64
; CHECK-NEXT:    [[TMP2:%.*]] = sub i64 [[TMP1]], [[OFFSET]]
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[DST]], i64 [[TMP2]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi i64 [ [[LSR_IV_NEXT:%.*]], %[[LOOP]] ], [ 0, %[[PREHEADER]] ]
; CHECK-NEXT:    [[SCEVGEP1:%.*]] = getelementptr i8, ptr [[SCEVGEP]], i64 [[LSR_IV]]
; CHECK-NEXT:    store i8 0, ptr [[SCEVGEP1]], align 1
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add nuw nsw i64 [[LSR_IV]], 1
; CHECK-NEXT:    [[TMP:%.*]] = trunc i64 [[LSR_IV_NEXT]] to i32
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[TMP]], 10
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i64 0
; CHECK:       [[BYPASS]]:
; CHECK-NEXT:    [[BARE:%.*]] = add i32 [[A]], [[B]]
; CHECK-NEXT:    [[BARE_WIDE:%.*]] = zext i32 [[BARE]] to i64
; CHECK-NEXT:    ret i64 [[BARE_WIDE]]
;
entry:
  br i1 %enter, label %preheader, label %bypass

preheader:
  %a.wide = zext i32 %a to i64
  %b.wide = zext i32 %b to i64
  %offset = add i64 %a.wide, %b.wide
  %negative = sub i64 0, %offset
  %biased = getelementptr i8, ptr %dst, i64 %negative
  br label %loop

loop:
  %iv = phi i32 [ %a, %preheader ], [ %next, %loop ]
  %count = phi i32 [ 0, %preheader ], [ %count.next, %loop ]
  %index = add nuw i32 %iv, %b
  %wide = zext i32 %index to i64
  %p = getelementptr i8, ptr %biased, i64 %wide
  store i8 0, ptr %p
  %next = add nuw i32 %iv, 1
  %count.next = add i32 %count, 1
  %done = icmp eq i32 %count.next, 10
  br i1 %done, label %exit, label %loop

exit:
  ret i64 0

bypass:
  %bare = add i32 %a, %b
  %bare.wide = zext i32 %bare to i64
  ret i64 %bare.wide
}

