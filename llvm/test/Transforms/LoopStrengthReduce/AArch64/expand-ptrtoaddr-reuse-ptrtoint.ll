; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -passes='loop-reduce' -S %s | FileCheck %s

target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx15.0.0"

; When SCEVExpander materializes the address of %end for the loop trip count and
; an equivalent `ptrtoint ptr %end` already exists (used by %slack), it should
; expand as `ptrtoint` rather than `ptrtoaddr`, so both conversions of %end use
; the same opcode and can be CSE'd. Otherwise %end is converted to an integer
; twice (once via ptrtoaddr, once via ptrtoint), which is pure redundancy.

define i64 @expand_reuses_existing_ptrtoint(ptr %begin, ptr %end, ptr %cap) {
; CHECK-LABEL: @expand_reuses_existing_ptrtoint(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[BEGIN2:%.*]] = ptrtoaddr ptr [[BEGIN:%.*]] to i64
; CHECK-NEXT:    [[END1:%.*]] = ptrtoint ptr [[END:%.*]] to i64
; CHECK-NEXT:    [[C0:%.*]] = icmp eq ptr [[BEGIN]], [[END]]
; CHECK-NEXT:    br i1 [[C0]], label [[DONE:%.*]], label [[COUNT_PH:%.*]]
; CHECK:       count.ph:
; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[END1]], -8
; CHECK-NEXT:    [[TMP1:%.*]] = sub i64 [[TMP0]], [[BEGIN2]]
; CHECK-NEXT:    [[TMP2:%.*]] = lshr i64 [[TMP1]], 3
; CHECK-NEXT:    [[TMP3:%.*]] = shl nuw i64 [[TMP2]], 3
; CHECK-NEXT:    [[TMP4:%.*]] = add i64 [[TMP3]], 8
; CHECK-NEXT:    br label [[COUNT:%.*]]
; CHECK:       count:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[BEGIN]], [[COUNT_PH]] ], [ [[PN:%.*]], [[COUNT]] ]
; CHECK-NEXT:    [[PN]] = getelementptr inbounds nuw i8, ptr [[P]], i64 8
; CHECK-NEXT:    [[D:%.*]] = icmp eq ptr [[PN]], [[END]]
; CHECK-NEXT:    br i1 [[D]], label [[DONE_LOOPEXIT:%.*]], label [[COUNT]]
; CHECK:       done.loopexit:
; CHECK-NEXT:    br label [[DONE]]
; CHECK:       done:
; CHECK-NEXT:    [[USED:%.*]] = phi i64 [ 0, [[ENTRY:%.*]] ], [ [[TMP4]], [[DONE_LOOPEXIT]] ]
; CHECK-NEXT:    [[CAPI:%.*]] = ptrtoint ptr [[CAP:%.*]] to i64
; CHECK-NEXT:    [[ENDI:%.*]] = ptrtoint ptr [[END]] to i64
; CHECK-NEXT:    [[SLACK:%.*]] = sub i64 [[CAPI]], [[ENDI]]
; CHECK-NEXT:    [[TOTAL:%.*]] = add i64 [[USED]], [[SLACK]]
; CHECK-NEXT:    ret i64 [[TOTAL]]
;
entry:
  %c0 = icmp eq ptr %begin, %end
  br i1 %c0, label %done, label %count.ph

count.ph:
  br label %count

count:
  %p = phi ptr [ %begin, %count.ph ], [ %pn, %count ]
  %n = phi i64 [ 0, %count.ph ], [ %nn, %count ]
  %pn = getelementptr inbounds nuw i8, ptr %p, i64 8
  %nn = add i64 %n, 8
  %d = icmp eq ptr %pn, %end
  br i1 %d, label %done, label %count

done:
  %used = phi i64 [ 0, %entry ], [ %nn, %count ]
  %capi = ptrtoint ptr %cap to i64
  %endi = ptrtoint ptr %end to i64
  %slack = sub i64 %capi, %endi
  %total = add i64 %used, %slack
  ret i64 %total
}
