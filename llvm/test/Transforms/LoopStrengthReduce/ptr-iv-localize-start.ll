; CHECK-NEXT:    [[TMP0:%.*]] = load volatile i32, ptr [[LSR_IV]], align 4
; CHECK-NEXT:    [[SCEVGEP1]] = getelementptr i8, ptr [[LSR_IV]], i64 4
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add i64 [[LSR_IV2]], -1
; CHECK-NEXT:    [[C:%.*]] = icmp ne i64 [[LSR_IV_NEXT]], 0
