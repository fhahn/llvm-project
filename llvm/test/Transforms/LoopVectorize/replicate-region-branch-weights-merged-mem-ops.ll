; hoistPredicatedLoads and sinkPredicatedStores merge complementary predicated
; accesses to the same address into a single *unpredicated* recipe. The
; branch_weights the predicated recipes carry describe their guard (see
; VPPredicator::getBlockProbabilityWeights) and must not survive onto the
; merged access, as MD_prof on a plain load or store is
; rejected by the verifier. The complementary arms below are equally likely, so
; both accesses carry the identical, uniqued branch_weights node, which
; intersecting the metadata of the group would otherwise preserve.

define void @hoist_loads_no_prof_on_merged_load(ptr %dst, ptr %src, ptr %cond, i32 %n) {
; CHECK-LABEL: define void @hoist_loads_no_prof_on_merged_load(
; CHECK-SAME: ptr [[DST:%.*]], ptr [[SRC:%.*]], ptr [[COND:%.*]], i32 [[N:%.*]]) {
; CHECK:  [[ENTRY:.*:]]
; CHECK:    br i1 [[MIN_ITERS_CHECK:%.*]], label %[[SCALAR_PH:.*]], label %[[VECTOR_MEMCHECK:.*]], !prof [[PROF0:![0-9]+]]
; CHECK:  [[VECTOR_MEMCHECK]]:
; CHECK:    br i1 [[CONFLICT_RDX:%.*]], label %[[SCALAR_PH]], label %[[VECTOR_PH:.*]], !prof [[PROF0]]
; CHECK:  [[VECTOR_PH]]:
; CHECK:  [[VECTOR_BODY:.*]]:
; CHECK:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP7:%.*]], align 4, !alias.scope [[META1:![0-9]+]]
; CHECK:    [[TMP8:%.*]] = icmp sgt <4 x i32> [[WIDE_LOAD]], zeroinitializer
; CHECK:    [[TMP14:%.*]] = load i32, ptr [[TMP9:%.*]], align 4, !alias.scope [[META4:![0-9]+]]
; CHECK:    [[TMP15:%.*]] = load i32, ptr [[TMP10:%.*]], align 4, !alias.scope [[META4]]
; CHECK:    [[TMP16:%.*]] = load i32, ptr [[TMP11:%.*]], align 4, !alias.scope [[META4]]
; CHECK:    [[TMP17:%.*]] = load i32, ptr [[TMP12:%.*]], align 4, !alias.scope [[META4]]
; CHECK:    store <4 x i32> [[PREDPHI:%.*]], ptr [[TMP13:%.*]], align 4, !alias.scope [[META6:![0-9]+]], !noalias [[META8:![0-9]+]]
; CHECK:    br i1 [[TMP23:%.*]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !prof [[PROF9:![0-9]+]], !llvm.loop [[LOOP10:![0-9]+]]
; CHECK:  [[MIDDLE_BLOCK]]:
; CHECK:    br i1 [[CMP_N:%.*]], label %[[EXIT:.*]], label %[[SCALAR_PH]], !prof [[PROF14:![0-9]+]]
; CHECK:  [[SCALAR_PH]]:
; CHECK:  [[LOOP:.*]]:
; CHECK:    [[C:%.*]] = load i32, ptr [[GEP_COND:%.*]], align 4
; CHECK:    br i1 [[CMP:%.*]], label %[[THEN:.*]], label %[[ELSE:.*]], !prof [[PROF15:![0-9]+]]
; CHECK:  [[THEN]]:
; CHECK:    [[L_THEN:%.*]] = load i32, ptr [[GEP_SRC:%.*]], align 4
; CHECK:  [[ELSE]]:
; CHECK:    [[L_ELSE:%.*]] = load i32, ptr [[GEP_SRC]], align 4
; CHECK:  [[LATCH:.*:]]
; CHECK:    store i32 [[MERGE:%.*]], ptr [[GEP_DST:%.*]], align 4
; CHECK:    br i1 [[EC:%.*]], label %[[EXIT]], label %[[LOOP]], !prof [[PROF16:![0-9]+]], !llvm.loop [[LOOP17:![0-9]+]]
; CHECK:  [[EXIT]]:
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %latch ]
  %gep.cond = getelementptr inbounds i32, ptr %cond, i32 %iv
  %c = load i32, ptr %gep.cond, align 4
  %cmp = icmp sgt i32 %c, 0
  %gep.src = getelementptr inbounds i32, ptr %src, i32 %iv
  %gep.dst = getelementptr inbounds i32, ptr %dst, i32 %iv
  br i1 %cmp, label %then, label %else, !prof !0

then:
  %l.then = load i32, ptr %gep.src, align 4
  br label %latch

else:
  %l.else = load i32, ptr %gep.src, align 4
  %add = add i32 %l.else, 1
  br label %latch

latch:
  %merge = phi i32 [ %l.then, %then ], [ %add, %else ]
  store i32 %merge, ptr %gep.dst, align 4
  %iv.next = add nuw nsw i32 %iv, 1
  %ec = icmp eq i32 %iv.next, %n
  br i1 %ec, label %exit, label %loop, !prof !1

exit:
  ret void
}

