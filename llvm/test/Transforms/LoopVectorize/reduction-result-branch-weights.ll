; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter "rdx.select|= select|!prof" --version 6
; RUN: opt -passes=loop-vectorize -force-vector-width=2 -force-vector-interleave=1 -S %s | FileCheck %s

; The select computing the final value of an any-of reduction asks whether the
; condition of the original select ever held, so with p the probability of a
; single iteration's condition it is taken with probability
; 1 - (1 - p)^TripCount, rather than having no probability at all: for p = 1/4
; over 4 iterations that is 1 - (3/4)^4 = 175/256.
define i32 @anyof_estimated_tc_4(ptr %a, i64 %n) !prof !0 {
; CHECK-LABEL: define i32 @anyof_estimated_tc_4(
; CHECK-SAME: ptr [[A:%.*]], i64 [[N:%.*]]) !prof [[PROF0:![0-9]+]] {
; CHECK:    br i1 [[TMP2:%.*]], [[PRED_LOAD_IF:label %.*]], [[PRED_LOAD_CONTINUE:label %.*]], !prof [[PROF1:![0-9]+]]
; CHECK:    br i1 [[TMP7:%.*]], [[PRED_LOAD_IF1:label %.*]], [[PRED_LOAD_CONTINUE2:label %.*]], !prof [[PROF1]]
; CHECK:    [[TMP14:%.*]] = select <2 x i1> [[TMP1:%.*]], <2 x i1> [[TMP13:%.*]], <2 x i1> zeroinitializer
; CHECK:    br i1 [[TMP16:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF2:![0-9]+]], !llvm.loop [[LOOP3:![0-9]+]]
; CHECK:    [[RDX_SELECT:%.*]] = select i1 [[TMP18:%.*]], i32 1, i32 0, !prof [[PROF7:![0-9]+]]
; CHECK:    ret i32 [[RDX_SELECT]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %res = phi i32 [ 0, %entry ], [ %res.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %a, i64 %iv
  %l = load i32, ptr %gep, align 4
  %c = icmp eq i32 %l, 42
  %res.next = select i1 %c, i32 1, i32 %res, !prof !1
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop, !prof !2

exit:
  ret i32 %res.next
}

; Without weights on the original select there is no p to raise to the trip
; count, so the result select keeps being marked unknown.
define i32 @anyof_unprofiled_select(ptr %a, i64 %n) !prof !0 {
; CHECK-LABEL: define i32 @anyof_unprofiled_select(
; CHECK-SAME: ptr [[A:%.*]], i64 [[N:%.*]]) !prof [[PROF0]] {
; CHECK:    br i1 [[TMP2:%.*]], [[PRED_LOAD_IF:label %.*]], [[PRED_LOAD_CONTINUE:label %.*]], !prof [[PROF1]]
; CHECK:    br i1 [[TMP7:%.*]], [[PRED_LOAD_IF1:label %.*]], [[PRED_LOAD_CONTINUE2:label %.*]], !prof [[PROF1]]
; CHECK:    [[TMP14:%.*]] = select <2 x i1> [[TMP1:%.*]], <2 x i1> [[TMP13:%.*]], <2 x i1> zeroinitializer
; CHECK:    br i1 [[TMP16:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF2]], !llvm.loop [[LOOP8:![0-9]+]]
; CHECK:    [[RDX_SELECT:%.*]] = select i1 [[TMP18:%.*]], i32 1, i32 0, !prof [[PROF9:![0-9]+]]
; CHECK:    ret i32 [[RDX_SELECT]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %res = phi i32 [ 0, %entry ], [ %res.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %a, i64 %iv
  %l = load i32, ptr %gep, align 4
  %c = icmp eq i32 %l, 42
  %res.next = select i1 %c, i32 1, i32 %res
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop, !prof !2

exit:
  ret i32 %res.next
}

!0 = !{!"function_entry_count", i64 1000}
!1 = !{!"branch_weights", i32 1, i32 3}
!2 = !{!"branch_weights", i32 1, i32 3}
