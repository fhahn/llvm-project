; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
; AVX-LABEL: define void @per_row_auto(
; AVX-SAME: ptr noalias [[A:%.*]], ptr noalias [[B:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) #[[ATTR0]] {
; AVX-NEXT:  [[ENTRY:.*:]]
; AVX-NEXT:    [[CMP_OUTER:%.*]] = icmp sgt i64 [[N]], 0
; AVX-NEXT:    br i1 [[CMP_OUTER]], label %[[OUTER_PH:.*]], label %[[EXIT:.*]]
; AVX:       [[OUTER_PH]]:
; AVX-NEXT:    [[CMP_INNER:%.*]] = icmp sgt i64 [[M]], 0
; AVX-NEXT:    br label %[[OUTER_HEADER:.*]]
; AVX:       [[OUTER_HEADER]]:
; AVX-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[OUTER_PH]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; AVX-NEXT:    [[A_PTR:%.*]] = getelementptr inbounds float, ptr [[A]], i64 [[I]]
; AVX-NEXT:    store float 0.000000e+00, ptr [[A_PTR]], align 4
; AVX-NEXT:    br i1 [[CMP_INNER]], label %[[INNER_PH:.*]], label %[[OUTER_LATCH]]
; AVX:       [[INNER_PH]]:
; AVX-NEXT:    br label %[[INNER_BODY:.*]]
; AVX:       [[INNER_BODY]]:
; AVX-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[INNER_PH]] ], [ [[J_NEXT:%.*]], %[[INNER_BODY]] ]
; AVX-NEXT:    [[B_PTR:%.*]] = getelementptr inbounds float, ptr [[B]], i64 [[J]]
; AVX-NEXT:    [[B_VAL:%.*]] = load float, ptr [[B_PTR]], align 4
; AVX-NEXT:    [[PREV:%.*]] = load float, ptr [[A_PTR]], align 4
; AVX-NEXT:    [[SUM:%.*]] = fadd float [[PREV]], [[B_VAL]]
; AVX-NEXT:    store float [[SUM]], ptr [[A_PTR]], align 4
; AVX-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; AVX-NEXT:    [[J_CMP:%.*]] = icmp eq i64 [[J_NEXT]], [[M]]
; AVX-NEXT:    br i1 [[J_CMP]], label %[[OUTER_LATCH_LOOPEXIT:.*]], label %[[INNER_BODY]]
; AVX:       [[OUTER_LATCH_LOOPEXIT]]:
; AVX-NEXT:    br label %[[OUTER_LATCH]]
; AVX:       [[OUTER_LATCH]]:
; AVX-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; AVX-NEXT:    [[I_CMP:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; AVX-NEXT:    br i1 [[I_CMP]], label %[[EXIT_LOOPEXIT:.*]], label %[[OUTER_HEADER]]
; AVX:       [[EXIT_LOOPEXIT]]:
; AVX-NEXT:    br label %[[EXIT]]
; AVX:       [[EXIT]]:
; AVX-NEXT:    ret void
;
entry:
  %cmp.outer = icmp sgt i64 %N, 0
  br i1 %cmp.outer, label %outer.ph, label %exit

outer.ph:
  %cmp.inner = icmp sgt i64 %M, 0
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  %A.ptr = getelementptr inbounds float, ptr %A, i64 %i
  store float 0.0, ptr %A.ptr, align 4
  br i1 %cmp.inner, label %inner.ph, label %outer.latch

inner.ph:
  br label %inner.body

inner.body:
  %j = phi i64 [ 0, %inner.ph ], [ %j.next, %inner.body ]
  %B.ptr = getelementptr inbounds float, ptr %B, i64 %j
  %B.val = load float, ptr %B.ptr, align 4
  %prev = load float, ptr %A.ptr, align 4
  %sum = fadd float %prev, %B.val
  store float %sum, ptr %A.ptr, align 4
  %j.next = add nuw nsw i64 %j, 1
  %j.cmp = icmp eq i64 %j.next, %M
  br i1 %j.cmp, label %outer.latch, label %inner.body

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp eq i64 %i.next, %N
  br i1 %i.cmp, label %exit, label %outer.header

exit:
  ret void
}

