  %gep.A = getelementptr inbounds ptr, ptr %A, i64 %iv
  %l.ptr = load ptr, ptr %gep.A, align 8
  %gep.ptr = getelementptr i8, ptr %l.ptr, i64 8
  %c = icmp eq ptr %l.ptr, null
  br i1 %c, label %then, label %else

then:
  br label %merge

