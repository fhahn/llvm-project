  br label %merge

merge:
  %addr = phi ptr [ %B, %then ], [ %gep.ptr, %else ]
  %v = load i32, ptr %addr, align 4
  %red.next = add i32 %red, %v
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %red.next
}

