; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --filter "LV\(REG\): (VF = 8|RegisterClass)" --filter "LV: (Interleav|The Interleave)" --version 6
; REQUIRES: asserts
; RUN: opt -passes=loop-vectorize -mcpu=prescott -force-vector-width=8 -debug-only=loop-vectorize,vplan -disable-output %s 2>&1 | FileCheck %s

target datalayout = "e-p:32:32:32-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:32:64-f32:32:32-f64:32:64-v64:64:64-v128:128:128-a0:0:64-f80:32:32-n8:16:32-S128"
target triple = "i386-apple-darwin"

; Replicated loads used by widened recipes, whose lanes are packed into vectors.
; Check the estimated register usage and the selected interleave count.
define i32 @replicating_loads_and_reduction(ptr %A, ptr %B) {
; CHECK-LABEL: 'replicating_loads_and_reduction'
; CHECK:  LV(REG): VF = 8
; CHECK:  LV(REG): RegisterClass: Generic::ScalarRC, 2 registers
; CHECK:  LV(REG): RegisterClass: Generic::VectorRC, 6 registers
; CHECK:  LV(REG): RegisterClass: Generic::ScalarRC, 1 registers
; CHECK:  LV: Interleaving because of reductions.
; CHECK:  LV: Interleaving is not beneficial.
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %red = phi i32 [ 0, %entry ], [ %red.next, %loop ]
  %gep.A = getelementptr inbounds nuw i8, ptr %A, i32 %iv
  %l.A = load i8, ptr %gep.A, align 1
  %A.ext = sext i8 %l.A to i32
  %gep.B = getelementptr inbounds i8, ptr %B, i32 %A.ext
  %l.B = load i8, ptr %gep.B, align 1
  %b.ext = sext i8 %l.B to i32
  %add = add i32 %red, %A.ext
  %red.next = add i32 %add, %b.ext
  %iv.next = add nuw nsw i32 %iv, 1
  %ec = icmp eq i32 %iv.next, 100
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %red.next
}
