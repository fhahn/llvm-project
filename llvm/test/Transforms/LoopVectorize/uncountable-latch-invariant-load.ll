; CHECK-NEXT:    store i8 42, ptr [[DST_PTR]], align 1
; CHECK-NEXT:    [[DST_NEXT]] = getelementptr inbounds i8, ptr [[DST_PTR]], i64 1
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 1
; CHECK-NEXT:    [[LIMIT:%.*]] = call i32 @get_limit()
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[IV_NEXT]], [[LIMIT]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT_LOOPEXIT:.*]]
