  %clamp1_hi = call float @llvm.minnum.f32(float %val1, float 2.550000e+02)
  %clamp1 = call float @llvm.maxnum.f32(float %clamp1_hi, float 0.000000e+00)
  %byte1 = fptoui float %clamp1 to i8
  %dst1 = getelementptr inbounds i8, ptr %dst.ptr, i64 1
  store i8 %byte1, ptr %dst1, align 1, !tbaa !9

  ; Channel 2
  %src2 = getelementptr inbounds i8, ptr %src.ptr, i64 8
  %val2 = load float, ptr %src2, align 4, !tbaa !7
  %clamp2_hi = call float @llvm.minnum.f32(float %val2, float 2.550000e+02)
  %clamp2 = call float @llvm.maxnum.f32(float %clamp2_hi, float 0.000000e+00)
  %byte2 = fptoui float %clamp2 to i8
  %dst2 = getelementptr inbounds i8, ptr %dst.ptr, i64 2
  store i8 %byte2, ptr %dst2, align 1, !tbaa !9

  ; Channel 3
  %src3 = getelementptr inbounds i8, ptr %src.ptr, i64 12
  %val3 = load float, ptr %src3, align 4, !tbaa !7
  %clamp3_hi = call float @llvm.minnum.f32(float %val3, float 2.550000e+02)
  %clamp3 = call float @llvm.maxnum.f32(float %clamp3_hi, float 0.000000e+00)
  %byte3 = fptoui float %clamp3 to i8
  %dst3 = getelementptr inbounds i8, ptr %dst.ptr, i64 3
  store i8 %byte3, ptr %dst3, align 1, !tbaa !9

  ; Advance pointers
  %src.next = getelementptr inbounds i8, ptr %src.ptr, i64 16
  %dst.next = getelementptr inbounds i8, ptr %dst.ptr, i64 4
  %iv.next = add nuw nsw i32 %iv, 1

  ; Trip count reloaded every iteration
  %width = load i32, ptr %image_row, align 8, !tbaa !3
  %cmp = icmp slt i32 %iv.next, %width
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

