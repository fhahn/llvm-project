; Negative: no pre-loop load from same address. Legality passes (detects
; invariant-address load), but VPlan transform cannot fire because the
; pre-loop blocks do not contain a load from %limit_ptr.
; The loop still vectorizes using the conservative symbolic max BTC.

define void @no_preloop_load_from_same_addr(ptr %limit_ptr, ptr %other_ptr, ptr %dst) {
; CHECK-LABEL: define void @no_preloop_load_from_same_addr(
; CHECK-SAME: ptr [[LIMIT_PTR:%.*]], ptr [[OTHER_PTR:%.*]], ptr [[DST:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[OTHER_INIT:%.*]] = load i32, ptr [[OTHER_PTR]], align 4
; CHECK-NEXT:    [[CMP_INIT:%.*]] = icmp sgt i32 [[OTHER_INIT]], 0
; CHECK-NEXT:    br i1 [[CMP_INIT]], label %[[VEC_EPILOG_SCALAR_PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[VEC_EPILOG_SCALAR_PH]]:
; CHECK-NEXT:    [[TMP0:%.*]] = load i32, ptr [[LIMIT_PTR]], align 4
; CHECK-NEXT:    [[SMAX:%.*]] = call i32 @llvm.smax.i32(i32 [[TMP0]], i32 1)
; CHECK-NEXT:    [[TMP1:%.*]] = zext nneg i32 [[SMAX]] to i64
; CHECK-NEXT:    [[TMP2:%.*]] = add nsw i32 [[SMAX]], -1
; CHECK-NEXT:    [[TMP3:%.*]] = zext nneg i32 [[TMP2]] to i64
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[TMP1]], 32
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_MEMCHECK:.*]]
; CHECK:       [[VECTOR_MEMCHECK]]:
; CHECK-NEXT:    [[TMP4:%.*]] = add i64 1, [[TMP3]]
; CHECK-NEXT:    [[TMP5:%.*]] = getelementptr i8, ptr [[DST]], i64 [[TMP4]]
; CHECK-NEXT:    [[TMP6:%.*]] = getelementptr i8, ptr [[LIMIT_PTR]], i64 4
; CHECK-NEXT:    [[BOUND0:%.*]] = icmp ult ptr [[DST]], [[TMP6]]
; CHECK-NEXT:    [[BOUND1:%.*]] = icmp ult ptr [[LIMIT_PTR]], [[TMP5]]
; CHECK-NEXT:    [[FOUND_CONFLICT:%.*]] = and i1 [[BOUND0]], [[BOUND1]]
; CHECK-NEXT:    br i1 [[FOUND_CONFLICT]], label %[[SCALAR_PH]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[N_MOD_VF:%.*]] = urem i64 [[TMP1]], 32
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[TMP1]], [[N_MOD_VF]]
; CHECK-NEXT:    [[TMP7:%.*]] = trunc i64 [[N_VEC]] to i32
; CHECK-NEXT:    [[TMP8:%.*]] = getelementptr i8, ptr [[DST]], i64 [[N_VEC]]
; CHECK-NEXT:    br label %[[LOOP1:.*]]
; CHECK:       [[LOOP1]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[LOOP1]] ]
; CHECK-NEXT:    [[NEXT_GEP:%.*]] = getelementptr i8, ptr [[DST]], i64 [[INDEX]]
; CHECK-NEXT:    [[TMP9:%.*]] = getelementptr i8, ptr [[NEXT_GEP]], i64 16
; CHECK-NEXT:    store <16 x i8> splat (i8 42), ptr [[NEXT_GEP]], align 1, !alias.scope [[META32:![0-9]+]], !noalias [[META35:![0-9]+]]
; CHECK-NEXT:    store <16 x i8> splat (i8 42), ptr [[TMP9]], align 1, !alias.scope [[META32]], !noalias [[META35]]
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 32
; CHECK-NEXT:    [[TMP10:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP10]], label %[[MIDDLE_BLOCK:.*]], label %[[LOOP1]], !llvm.loop [[LOOP37:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[TMP1]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], label %[[EXIT_LOOPEXIT:.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
; CHECK-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i32 [ [[TMP7]], %[[MIDDLE_BLOCK]] ], [ 0, %[[VEC_EPILOG_SCALAR_PH]] ], [ 0, %[[VECTOR_MEMCHECK]] ]
; CHECK-NEXT:    [[BC_RESUME_VAL1:%.*]] = phi ptr [ [[TMP8]], %[[MIDDLE_BLOCK]] ], [ [[DST]], %[[VEC_EPILOG_SCALAR_PH]] ], [ [[DST]], %[[VECTOR_MEMCHECK]] ]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[DST_PTR:%.*]] = phi ptr [ [[BC_RESUME_VAL1]], %[[SCALAR_PH]] ], [ [[DST_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    store i8 42, ptr [[DST_PTR]], align 1
; CHECK-NEXT:    [[DST_NEXT]] = getelementptr inbounds i8, ptr [[DST_PTR]], i64 1
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 1
; CHECK-NEXT:    [[LIMIT:%.*]] = load i32, ptr [[LIMIT_PTR]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[IV_NEXT]], [[LIMIT]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT_LOOPEXIT]], !llvm.loop [[LOOP38:![0-9]+]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  ; Pre-loop load from a DIFFERENT address
  %other_init = load i32, ptr %other_ptr, align 4
  %cmp_init = icmp sgt i32 %other_init, 0
  br i1 %cmp_init, label %loop.ph, label %exit

loop.ph:
  br label %loop

loop:
  %iv = phi i32 [ 0, %loop.ph ], [ %iv.next, %loop ]
  %dst.ptr = phi ptr [ %dst, %loop.ph ], [ %dst.next, %loop ]
  store i8 42, ptr %dst.ptr, align 1
  %dst.next = getelementptr inbounds i8, ptr %dst.ptr, i64 1
  %iv.next = add nuw nsw i32 %iv, 1
  %limit = load i32, ptr %limit_ptr, align 4
  %cmp = icmp slt i32 %iv.next, %limit
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; Negative: exit condition uses non-load variant value (function call).

define void @non_load_variant_exit(ptr %dst, i32 %n) {
; CHECK-LABEL: define void @non_load_variant_exit(
; CHECK-SAME: ptr [[DST:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP_INIT:%.*]] = icmp sgt i32 [[N]], 0
; CHECK-NEXT:    br i1 [[CMP_INIT]], label %[[LOOP_PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_PH]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[LOOP_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[DST_PTR:%.*]] = phi ptr [ [[DST]], %[[LOOP_PH]] ], [ [[DST_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    store i8 42, ptr [[DST_PTR]], align 1
; CHECK-NEXT:    [[DST_NEXT]] = getelementptr inbounds i8, ptr [[DST_PTR]], i64 1
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 1
; CHECK-NEXT:    [[LIMIT:%.*]] = call i32 @get_limit()
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[IV_NEXT]], [[LIMIT]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT_LOOPEXIT:.*]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %cmp_init = icmp sgt i32 %n, 0
  br i1 %cmp_init, label %loop.ph, label %exit

loop.ph:
  br label %loop

loop:
  %iv = phi i32 [ 0, %loop.ph ], [ %iv.next, %loop ]
  %dst.ptr = phi ptr [ %dst, %loop.ph ], [ %dst.next, %loop ]
  store i8 42, ptr %dst.ptr, align 1
  %dst.next = getelementptr inbounds i8, ptr %dst.ptr, i64 1
  %iv.next = add nuw nsw i32 %iv, 1
  %limit = call i32 @get_limit()
  %cmp = icmp slt i32 %iv.next, %limit
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

