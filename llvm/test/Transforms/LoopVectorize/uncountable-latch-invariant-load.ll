; Positive: basic loop with invariant-address load in exit condition.
; The pre-loop load of %limit_ptr should be used as the trip count.
;
; CHECK-LABEL: LV: Checking a loop in 'invariant_load_exit_basic'
; CHECK:       LV: Found uncountable latch exit dependent on load:
; CHECK:       VPlan: Making uncountable latch countable using pre-loop load:
; CHECK:       LV: Found a vectorizable loop

define void @invariant_load_exit_basic(ptr %limit_ptr, ptr %dst) {
; CHECK-LABEL: define void @invariant_load_exit_basic(
; CHECK-SAME: ptr [[LIMIT_PTR:%.*]], ptr [[DST:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LIMIT_INIT:%.*]] = load i32, ptr [[LIMIT_PTR]], align 4
; CHECK-NEXT:    [[CMP_INIT:%.*]] = icmp sgt i32 [[LIMIT_INIT]], 0
; CHECK-NEXT:    br i1 [[CMP_INIT]], label %[[LOOP_PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_PH]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[LOOP_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[DST_PTR:%.*]] = phi ptr [ [[DST]], %[[LOOP_PH]] ], [ [[DST_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    store i8 42, ptr [[DST_PTR]], align 1
; CHECK-NEXT:    [[DST_NEXT]] = getelementptr inbounds i8, ptr [[DST_PTR]], i64 1
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 1
; CHECK-NEXT:    [[LIMIT:%.*]] = load i32, ptr [[LIMIT_PTR]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[IV_NEXT]], [[LIMIT]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT_LOOPEXIT:.*]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %limit_init = load i32, ptr %limit_ptr, align 4
  %cmp_init = icmp sgt i32 %limit_init, 0
  br i1 %cmp_init, label %loop.ph, label %exit

loop.ph:
  br label %loop

loop:
  %iv = phi i32 [ 0, %loop.ph ], [ %iv.next, %loop ]
  %dst.ptr = phi ptr [ %dst, %loop.ph ], [ %dst.next, %loop ]
  store i8 42, ptr %dst.ptr, align 1
  %dst.next = getelementptr inbounds i8, ptr %dst.ptr, i64 1
  %iv.next = add nuw nsw i32 %iv, 1
  %limit = load i32, ptr %limit_ptr, align 4
  %cmp = icmp slt i32 %iv.next, %limit
