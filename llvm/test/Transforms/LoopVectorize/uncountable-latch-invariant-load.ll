  ; Channel 1
  %src1 = getelementptr inbounds i8, ptr %src.ptr, i64 4
  %val1 = load float, ptr %src1, align 4, !tbaa !7
  %clamp1_hi = call float @llvm.minnum.f32(float %val1, float 2.550000e+02)
  %clamp1 = call float @llvm.maxnum.f32(float %clamp1_hi, float 0.000000e+00)
  %byte1 = fptoui float %clamp1 to i8
  %dst1 = getelementptr inbounds i8, ptr %dst.ptr, i64 1
  store i8 %byte1, ptr %dst1, align 1, !tbaa !9

  ; Advance pointers
  %src.next = getelementptr inbounds i8, ptr %src.ptr, i64 8
  %dst.next = getelementptr inbounds i8, ptr %dst.ptr, i64 2
  %iv.next = add nuw nsw i32 %iv, 1

  ; Trip count reloaded every iteration
  %width = load i32, ptr %image_row, align 8, !tbaa !3
  %cmp = icmp slt i32 %iv.next, %width
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; Negative: load address is IV-dependent (not loop-invariant).

define void @variant_load_addr_exit(ptr %base, ptr %dst) {
; CHECK-LABEL: define void @variant_load_addr_exit(
; CHECK-SAME: ptr [[BASE:%.*]], ptr [[DST:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LIMIT_INIT:%.*]] = load i32, ptr [[BASE]], align 4
; CHECK-NEXT:    [[CMP_INIT:%.*]] = icmp sgt i32 [[LIMIT_INIT]], 0
; CHECK-NEXT:    br i1 [[CMP_INIT]], label %[[LOOP_PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_PH]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[LOOP_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[DST_PTR:%.*]] = phi ptr [ [[DST]], %[[LOOP_PH]] ], [ [[DST_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    store i8 42, ptr [[DST_PTR]], align 1
; CHECK-NEXT:    [[DST_NEXT]] = getelementptr inbounds i8, ptr [[DST_PTR]], i64 1
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 1
; CHECK-NEXT:    [[IV_EXT:%.*]] = sext i32 [[IV]] to i64
; CHECK-NEXT:    [[ADDR:%.*]] = getelementptr i32, ptr [[BASE]], i64 [[IV_EXT]]
; CHECK-NEXT:    [[LIMIT:%.*]] = load i32, ptr [[ADDR]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[IV_NEXT]], [[LIMIT]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT_LOOPEXIT:.*]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %limit_init = load i32, ptr %base, align 4
  %cmp_init = icmp sgt i32 %limit_init, 0
  br i1 %cmp_init, label %loop.ph, label %exit

loop.ph:
  br label %loop

loop:
  %iv = phi i32 [ 0, %loop.ph ], [ %iv.next, %loop ]
  %dst.ptr = phi ptr [ %dst, %loop.ph ], [ %dst.next, %loop ]
  store i8 42, ptr %dst.ptr, align 1
  %dst.next = getelementptr inbounds i8, ptr %dst.ptr, i64 1
  %iv.next = add nuw nsw i32 %iv, 1
  ; Load from IV-dependent address
  %iv.ext = sext i32 %iv to i64
  %addr = getelementptr i32, ptr %base, i64 %iv.ext
  %limit = load i32, ptr %addr, align 4
  %cmp = icmp slt i32 %iv.next, %limit
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

