; Access wider than the per-lane outer stride: an i8-strided GEP (outer stride
; one byte) feeding a float (4-byte) load/store. Adjacent lanes are one byte
; apart but each touches four bytes, so they overlap; this must not be treated
; as lane-distinct and the loop must not be vectorized via this path.
define void @access_wider_than_outer_stride(ptr noalias %A, i64 %N) {
; CHECK-LABEL: define void @access_wider_than_outer_stride(
; CHECK-SAME: ptr noalias [[A:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP_OUTER:%.*]] = icmp sgt i64 [[N]], 0
; CHECK-NEXT:    br i1 [[CMP_OUTER]], label %[[SCALAR_PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[SCALAR_PH]]:
; CHECK-NEXT:    br label %[[OUTER_HEADER1:.*]]
; CHECK:       [[OUTER_HEADER1]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[SCALAR_PH]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    br label %[[INNER_BODY1:.*]]
; CHECK:       [[INNER_BODY1]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[OUTER_HEADER1]] ], [ [[J_NEXT:%.*]], %[[INNER_BODY1]] ]
; CHECK-NEXT:    [[J_MUL_M:%.*]] = mul nsw i64 [[J]], 4
; CHECK-NEXT:    [[IDX:%.*]] = add nsw i64 [[I]], [[J_MUL_M]]
; CHECK-NEXT:    [[A_PTR:%.*]] = getelementptr inbounds i8, ptr [[A]], i64 [[IDX]]
; CHECK-NEXT:    [[A_VAL:%.*]] = load float, ptr [[A_PTR]], align 1
; CHECK-NEXT:    [[MUL:%.*]] = fmul float [[A_VAL]], 2.000000e+00
; CHECK-NEXT:    store float [[MUL]], ptr [[A_PTR]], align 1
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[J_CMP:%.*]] = icmp eq i64 [[J_NEXT]], 4
; CHECK-NEXT:    br i1 [[J_CMP]], label %[[OUTER_LATCH]], label %[[INNER_BODY1]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[I_CMP:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[I_CMP]], label %[[EXIT_LOOPEXIT:.*]], label %[[OUTER_HEADER1]], !llvm.loop [[LOOP0]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %cmp.outer = icmp sgt i64 %N, 0
  br i1 %cmp.outer, label %outer.ph, label %exit

outer.ph:
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  br label %inner.body

inner.body:
  %j = phi i64 [ 0, %outer.header ], [ %j.next, %inner.body ]
  %j.mul.M = mul nsw i64 %j, 4
  %idx = add nsw i64 %i, %j.mul.M
  %A.ptr = getelementptr inbounds i8, ptr %A, i64 %idx
  %A.val = load float, ptr %A.ptr, align 1
  %mul = fmul float %A.val, 2.000000e+00
  store float %mul, ptr %A.ptr, align 1
  %j.next = add nuw nsw i64 %j, 1
