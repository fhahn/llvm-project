; CHECK-NEXT:    br i1 [[I_CMP]], label %[[EXIT_LOOPEXIT:.*]], label %[[OUTER_HEADER1]], !llvm.loop [[LOOP0]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
