; CHECK-NEXT:    br i1 [[CMP_INNER]], label %[[INNER_PH2:.*]], label %[[OUTER_LATCH6]]
; CHECK:       [[INNER_PH2]]:
; CHECK-NEXT:    br label %[[INNER_BODY3:.*]]
