; CHECK-NEXT:    [[VEC_IND_NEXT]] = add nuw nsw <4 x i64> [[VEC_IND]], splat (i64 4)
; CHECK-NEXT:    [[TMP5:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP5]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP8:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], [[EXIT_LOOPEXIT:label %.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  %cmp.outer = icmp sgt i64 %N, 0
  br i1 %cmp.outer, label %outer.ph, label %exit

outer.ph:
  %cmp.inner = icmp sgt i64 %M, 0
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  %i.f = sitofp i64 %i to float
  br i1 %cmp.inner, label %inner.ph, label %outer.latch

inner.ph:
  br label %inner.body

inner.body:
  %j = phi i64 [ 0, %inner.ph ], [ %j.next, %inner.body ]
  %A.ptr = getelementptr inbounds float, ptr %A, i64 %j
  %B.ptr = getelementptr inbounds float, ptr %B, i64 %j
  %val = load float, ptr %A.ptr, align 4
  %add = fadd float %val, %i.f
  store float %add, ptr %B.ptr, align 4
  %j.next = add nuw nsw i64 %j, 1
  %j.cmp = icmp eq i64 %j.next, %M
  br i1 %j.cmp, label %outer.latch, label %inner.body

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp eq i64 %i.next, %N
  br i1 %i.cmp, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

;------------------------------------------------------------------------------
; Unsafe: cross-iteration RAW in a 2D access with a one-row offset.
;
;   for (i = 0; i < N; i++)
;     for (j = 0; j < M; j++)
;       A[i*M + j] = A[(i+1)*M + j];
;
; The store row A[i*M + j] and the load row A[(i+1)*M + j] are one outer
; iteration apart: iteration i loads from the row iteration i+1 will overwrite.
;------------------------------------------------------------------------------
define void @cross_iter_raw_2d(ptr %A, i64 %N, i64 %M) {
; CHECK-LABEL: define void @cross_iter_raw_2d(
; CHECK-SAME: ptr [[A:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP_OUTER:%.*]] = icmp sgt i64 [[N]], 0
; CHECK-NEXT:    br i1 [[CMP_OUTER]], label %[[OUTER_PH:.*]], [[EXIT:label %.*]]
; CHECK:       [[OUTER_PH]]:
; CHECK-NEXT:    [[CMP_INNER:%.*]] = icmp sgt i64 [[M]], 0
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[N_MOD_VF:%.*]] = urem i64 [[N]], 4
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[N]], [[N_MOD_VF]]
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i64> poison, i64 [[M]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT]], <4 x i64> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[OUTER_LATCH6:.*]] ]
; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <4 x i64> [ <i64 0, i64 1, i64 2, i64 3>, %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[OUTER_LATCH6]] ]
; CHECK-NEXT:    br i1 [[CMP_INNER]], label %[[INNER_PH1:.*]], label %[[OUTER_LATCH6]]
; CHECK:       [[INNER_PH1]]:
; CHECK-NEXT:    [[TMP0:%.*]] = mul nsw <4 x i64> [[VEC_IND]], [[BROADCAST_SPLAT]]
; CHECK-NEXT:    [[TMP1:%.*]] = add nuw nsw <4 x i64> [[VEC_IND]], splat (i64 1)
; CHECK-NEXT:    [[TMP2:%.*]] = mul nsw <4 x i64> [[TMP1]], [[BROADCAST_SPLAT]]
; CHECK-NEXT:    br label %[[INNER_BODY2:.*]]
; CHECK:       [[INNER_BODY2]]:
; CHECK-NEXT:    [[J3:%.*]] = phi <4 x i64> [ zeroinitializer, %[[INNER_PH1]] ], [ [[TMP5:%.*]], %[[INNER_BODY2]] ]
; CHECK-NEXT:    [[TMP3:%.*]] = add nsw <4 x i64> [[TMP2]], [[J3]]
; CHECK-NEXT:    [[WIDE_GEP:%.*]] = getelementptr inbounds float, ptr [[A]], <4 x i64> [[TMP3]]
; CHECK-NEXT:    [[WIDE_MASKED_GATHER:%.*]] = call <4 x float> @llvm.masked.gather.v4f32.v4p0(<4 x ptr> align 4 [[WIDE_GEP]], <4 x i1> splat (i1 true), <4 x float> poison)
; CHECK-NEXT:    [[TMP4:%.*]] = add nsw <4 x i64> [[TMP0]], [[J3]]
; CHECK-NEXT:    [[WIDE_GEP4:%.*]] = getelementptr inbounds float, ptr [[A]], <4 x i64> [[TMP4]]
; CHECK-NEXT:    call void @llvm.masked.scatter.v4f32.v4p0(<4 x float> [[WIDE_MASKED_GATHER]], <4 x ptr> align 4 [[WIDE_GEP4]], <4 x i1> splat (i1 true))
; CHECK-NEXT:    [[TMP5]] = add nuw nsw <4 x i64> [[J3]], splat (i64 1)
; CHECK-NEXT:    [[TMP6:%.*]] = icmp eq <4 x i64> [[TMP5]], [[BROADCAST_SPLAT]]
; CHECK-NEXT:    [[TMP7:%.*]] = extractelement <4 x i1> [[TMP6]], i64 0
; CHECK-NEXT:    br i1 [[TMP7]], label %[[OUTER_LATCH_LOOPEXIT5:.*]], label %[[INNER_BODY2]]
; CHECK:       [[OUTER_LATCH_LOOPEXIT5]]:
; CHECK-NEXT:    br label %[[OUTER_LATCH6]]
; CHECK:       [[OUTER_LATCH6]]:
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[VEC_IND_NEXT]] = add nuw nsw <4 x i64> [[VEC_IND]], splat (i64 4)
; CHECK-NEXT:    [[TMP8:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP8]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP10:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], [[EXIT_LOOPEXIT:label %.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  %cmp.outer = icmp sgt i64 %N, 0
  br i1 %cmp.outer, label %outer.ph, label %exit

outer.ph:
  %cmp.inner = icmp sgt i64 %M, 0
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  br i1 %cmp.inner, label %inner.ph, label %outer.latch

inner.ph:
  %i.mul.M = mul nsw i64 %i, %M
  %i1 = add nuw nsw i64 %i, 1
  %i1.mul.M = mul nsw i64 %i1, %M
  br label %inner.body

inner.body:
  %j = phi i64 [ 0, %inner.ph ], [ %j.next, %inner.body ]
  %load.idx = add nsw i64 %i1.mul.M, %j
  %load.ptr = getelementptr inbounds float, ptr %A, i64 %load.idx
  %val = load float, ptr %load.ptr, align 4
  %store.idx = add nsw i64 %i.mul.M, %j
  %store.ptr = getelementptr inbounds float, ptr %A, i64 %store.idx
  store float %val, ptr %store.ptr, align 4
  %j.next = add nuw nsw i64 %j, 1
  %j.cmp = icmp eq i64 %j.next, %M
  br i1 %j.cmp, label %outer.latch, label %inner.body

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp eq i64 %i.next, %N
  br i1 %i.cmp, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

;------------------------------------------------------------------------------
; Safe: store and load share one per-iteration address.
;
;   for (i = 0; i < N; i++)
;     for (j = 0; j < M; j++)
;       A[i] = A[i] + B[j];
;
; The store and load both have SCEV {A,+,4}<outer> — a same-iteration
; dependency only, so the outer loop is safe to vectorize.
;------------------------------------------------------------------------------
define void @same_addr_safe(ptr %A, ptr noalias %B, i64 %N, i64 %M) {
; CHECK-LABEL: define void @same_addr_safe(
; CHECK-SAME: ptr [[A:%.*]], ptr noalias [[B:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP_OUTER:%.*]] = icmp sgt i64 [[N]], 0
; CHECK-NEXT:    br i1 [[CMP_OUTER]], label %[[OUTER_PH:.*]], [[EXIT:label %.*]]
; CHECK:       [[OUTER_PH]]:
; CHECK-NEXT:    [[CMP_INNER:%.*]] = icmp sgt i64 [[M]], 0
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[N_MOD_VF:%.*]] = urem i64 [[N]], 4
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[N]], [[N_MOD_VF]]
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i64> poison, i64 [[M]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT]], <4 x i64> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[OUTER_LATCH7:.*]] ]
; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <4 x i64> [ <i64 0, i64 1, i64 2, i64 3>, %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[OUTER_LATCH7]] ]
; CHECK-NEXT:    [[WIDE_GEP:%.*]] = getelementptr inbounds float, ptr [[A]], <4 x i64> [[VEC_IND]]
; CHECK-NEXT:    [[WIDE_MASKED_GATHER1:%.*]] = call <4 x float> @llvm.masked.gather.v4f32.v4p0(<4 x ptr> align 4 [[WIDE_GEP]], <4 x i1> splat (i1 true), <4 x float> poison)
; CHECK-NEXT:    br i1 [[CMP_INNER]], label %[[INNER_PH1:.*]], label %[[OUTER_LATCH7]]
; CHECK:       [[INNER_PH1]]:
; CHECK-NEXT:    br label %[[INNER_BODY2:.*]]
; CHECK:       [[INNER_BODY2]]:
; CHECK-NEXT:    [[J3:%.*]] = phi <4 x i64> [ zeroinitializer, %[[INNER_PH1]] ], [ [[TMP2:%.*]], %[[INNER_BODY2]] ]
; CHECK-NEXT:    [[SUM4:%.*]] = phi <4 x float> [ [[WIDE_MASKED_GATHER1]], %[[INNER_PH1]] ], [ [[TMP1:%.*]], %[[INNER_BODY2]] ]
; CHECK-NEXT:    [[WIDE_GEP5:%.*]] = getelementptr inbounds float, ptr [[B]], <4 x i64> [[J3]]
; CHECK-NEXT:    [[WIDE_MASKED_GATHER:%.*]] = call <4 x float> @llvm.masked.gather.v4f32.v4p0(<4 x ptr> align 4 [[WIDE_GEP5]], <4 x i1> splat (i1 true), <4 x float> poison)
; CHECK-NEXT:    [[TMP1]] = fadd <4 x float> [[SUM4]], [[WIDE_MASKED_GATHER]]
; CHECK-NEXT:    [[TMP2]] = add nuw nsw <4 x i64> [[J3]], splat (i64 1)
; CHECK-NEXT:    [[TMP3:%.*]] = icmp eq <4 x i64> [[TMP2]], [[BROADCAST_SPLAT]]
; CHECK-NEXT:    [[TMP4:%.*]] = extractelement <4 x i1> [[TMP3]], i64 0
; CHECK-NEXT:    br i1 [[TMP4]], label %[[INNER_EXIT6:.*]], label %[[INNER_BODY2]]
; CHECK:       [[INNER_EXIT6]]:
; CHECK-NEXT:    call void @llvm.masked.scatter.v4f32.v4p0(<4 x float> [[TMP1]], <4 x ptr> align 4 [[WIDE_GEP]], <4 x i1> splat (i1 true))
; CHECK-NEXT:    br label %[[OUTER_LATCH7]]
; CHECK:       [[OUTER_LATCH7]]:
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[VEC_IND_NEXT]] = add nuw nsw <4 x i64> [[VEC_IND]], splat (i64 4)
; CHECK-NEXT:    [[TMP6:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP6]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP12:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], [[EXIT_LOOPEXIT:label %.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  %cmp.outer = icmp sgt i64 %N, 0
  br i1 %cmp.outer, label %outer.ph, label %exit

outer.ph:
  %cmp.inner = icmp sgt i64 %M, 0
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  %A.ptr = getelementptr inbounds float, ptr %A, i64 %i
  %A.val = load float, ptr %A.ptr, align 4
  br i1 %cmp.inner, label %inner.ph, label %outer.latch

inner.ph:
  br label %inner.body

inner.body:
  %j = phi i64 [ 0, %inner.ph ], [ %j.next, %inner.body ]
  %sum = phi float [ %A.val, %inner.ph ], [ %add, %inner.body ]
  %B.ptr = getelementptr inbounds float, ptr %B, i64 %j
  %B.val = load float, ptr %B.ptr, align 4
  %add = fadd float %sum, %B.val
  %j.next = add nuw nsw i64 %j, 1
  %j.cmp = icmp eq i64 %j.next, %M
  br i1 %j.cmp, label %inner.exit, label %inner.body

inner.exit:
  %sum.lcssa = phi float [ %add, %inner.body ]
  store float %sum.lcssa, ptr %A.ptr, align 4
  br label %outer.latch

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp eq i64 %i.next, %N
  br i1 %i.cmp, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

!0 = distinct !{!0, !1, !2}
!1 = !{!"llvm.loop.vectorize.width", i32 4}
!2 = !{!"llvm.loop.vectorize.enable", i1 true}
