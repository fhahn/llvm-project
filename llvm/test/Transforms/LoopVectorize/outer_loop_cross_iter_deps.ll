; RUN: opt -S -passes=loop-vectorize -enable-vplan-native-path < %s | FileCheck %s

; Cross-iteration memory dependencies in outer-loop vectorization.
;
; Each function is a perfect two-deep nest with a vectorize-enable pragma on
; the outer loop. Under -enable-vplan-native-path the outer loop is offered to
; VPlan. The unsafe shapes below carry a memory dependency between adjacent
; outer-loop iterations, so vectorizing the outer loop reorders conflicting
; accesses and is incorrect. The only safe shape is same_addr_safe, where the
; store and load share an identical per-iteration address.

;------------------------------------------------------------------------------
; Unsafe: cross-iteration RAW via a one-iteration-back load.
;
;   for (i = 1; i < N; i++)
;     for (j = 0; j < M; j++)
;       A[i] = A[i-1] + B[j];
;
; The store SCEV is {A+4,+,4}<outer> and the load SCEV is {A,+,4}<outer>: same
; step (4), starts differing by exactly one step. Iteration i+1 reads what
; iteration i wrote, so the outer loop must not be vectorized.
;------------------------------------------------------------------------------
define void @cross_iter_raw_outer(ptr %A, ptr noalias %B, i64 %N, i64 %M) {
; CHECK-LABEL: define void @cross_iter_raw_outer(
; CHECK-SAME: ptr [[A:%.*]], ptr noalias [[B:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP_OUTER:%.*]] = icmp sgt i64 [[N]], 1
; CHECK-NEXT:    br i1 [[CMP_OUTER]], label %[[OUTER_PH:.*]], [[EXIT:label %.*]]
; CHECK:       [[OUTER_PH]]:
; CHECK-NEXT:    [[CMP_INNER:%.*]] = icmp sgt i64 [[M]], 0
; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[N]], -1
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[TMP0]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[N_MOD_VF:%.*]] = urem i64 [[TMP0]], 4
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[TMP0]], [[N_MOD_VF]]
; CHECK-NEXT:    [[TMP1:%.*]] = add i64 1, [[N_VEC]]
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i64> poison, i64 [[M]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT]], <4 x i64> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[OUTER_LATCH8:.*]] ]
; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <4 x i64> [ <i64 1, i64 2, i64 3, i64 4>, %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[OUTER_LATCH8]] ]
; CHECK-NEXT:    [[TMP2:%.*]] = sub nuw nsw <4 x i64> [[VEC_IND]], splat (i64 1)
; CHECK-NEXT:    [[WIDE_GEP:%.*]] = getelementptr inbounds float, ptr [[A]], <4 x i64> [[TMP2]]
; CHECK-NEXT:    [[WIDE_MASKED_GATHER:%.*]] = call <4 x float> @llvm.masked.gather.v4f32.v4p0(<4 x ptr> align 4 [[WIDE_GEP]], <4 x i1> splat (i1 true), <4 x float> poison)
; CHECK-NEXT:    br i1 [[CMP_INNER]], label %[[INNER_PH1:.*]], label %[[OUTER_LATCH8]]
; CHECK:       [[INNER_PH1]]:
; CHECK-NEXT:    br label %[[INNER_BODY2:.*]]
; CHECK:       [[INNER_BODY2]]:
; CHECK-NEXT:    [[J3:%.*]] = phi <4 x i64> [ zeroinitializer, %[[INNER_PH1]] ], [ [[TMP4:%.*]], %[[INNER_BODY2]] ]
; CHECK-NEXT:    [[SUM4:%.*]] = phi <4 x float> [ [[WIDE_MASKED_GATHER]], %[[INNER_PH1]] ], [ [[TMP3:%.*]], %[[INNER_BODY2]] ]
; CHECK-NEXT:    [[WIDE_GEP5:%.*]] = getelementptr inbounds float, ptr [[B]], <4 x i64> [[J3]]
; CHECK-NEXT:    [[WIDE_MASKED_GATHER6:%.*]] = call <4 x float> @llvm.masked.gather.v4f32.v4p0(<4 x ptr> align 4 [[WIDE_GEP5]], <4 x i1> splat (i1 true), <4 x float> poison)
; CHECK-NEXT:    [[TMP3]] = fadd <4 x float> [[SUM4]], [[WIDE_MASKED_GATHER6]]
; CHECK-NEXT:    [[TMP4]] = add nuw nsw <4 x i64> [[J3]], splat (i64 1)
; CHECK-NEXT:    [[TMP5:%.*]] = icmp eq <4 x i64> [[TMP4]], [[BROADCAST_SPLAT]]
; CHECK-NEXT:    [[TMP7:%.*]] = extractelement <4 x i1> [[TMP5]], i64 0
; CHECK-NEXT:    br i1 [[TMP7]], label %[[INNER_EXIT6:.*]], label %[[INNER_BODY2]]
; CHECK:       [[INNER_EXIT6]]:
; CHECK-NEXT:    [[WIDE_GEP8:%.*]] = getelementptr inbounds float, ptr [[A]], <4 x i64> [[VEC_IND]]
; CHECK-NEXT:    call void @llvm.masked.scatter.v4f32.v4p0(<4 x float> [[TMP3]], <4 x ptr> align 4 [[WIDE_GEP8]], <4 x i1> splat (i1 true))
; CHECK-NEXT:    br label %[[OUTER_LATCH8]]
; CHECK:       [[OUTER_LATCH8]]:
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[VEC_IND_NEXT]] = add nuw nsw <4 x i64> [[VEC_IND]], splat (i64 4)
; CHECK-NEXT:    [[TMP8:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP8]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[TMP0]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], [[EXIT_LOOPEXIT:label %.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  %cmp.outer = icmp sgt i64 %N, 1
  br i1 %cmp.outer, label %outer.ph, label %exit

outer.ph:
  %cmp.inner = icmp sgt i64 %M, 0
  br label %outer.header

outer.header:
  %i = phi i64 [ 1, %outer.ph ], [ %i.next, %outer.latch ]
  %i.prev = sub nuw nsw i64 %i, 1
  %load.ptr = getelementptr inbounds float, ptr %A, i64 %i.prev
  %prev.val = load float, ptr %load.ptr, align 4
  br i1 %cmp.inner, label %inner.ph, label %outer.latch

inner.ph:
  br label %inner.body

inner.body:
  %j = phi i64 [ 0, %inner.ph ], [ %j.next, %inner.body ]
  %sum = phi float [ %prev.val, %inner.ph ], [ %add, %inner.body ]
  %B.ptr = getelementptr inbounds float, ptr %B, i64 %j
  %B.val = load float, ptr %B.ptr, align 4
  %add = fadd float %sum, %B.val
  %j.next = add nuw nsw i64 %j, 1
  %j.cmp = icmp eq i64 %j.next, %M
  br i1 %j.cmp, label %inner.exit, label %inner.body

inner.exit:
  %sum.lcssa = phi float [ %add, %inner.body ]
  %store.ptr = getelementptr inbounds float, ptr %A, i64 %i
  store float %sum.lcssa, ptr %store.ptr, align 4
  br label %outer.latch

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp eq i64 %i.next, %N
  br i1 %i.cmp, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

;------------------------------------------------------------------------------
; Unsafe: cross-iteration WAW via two stores one element apart.
;
;   for (i = 0; i < N; i++)
;     for (j = 0; j < M; j++) {
;       A[i] = ...;
;       A[i+1] = ...;
;     }
;
; Iteration i writes A[i] and A[i+1]; iteration i+1 writes A[i+1] and A[i+2].
; A[i+1] is written by both, a WAW conflict. The store SCEVs {A,+,4}<outer> and
; {A+4,+,4}<outer> have the same step but starts one step apart.
