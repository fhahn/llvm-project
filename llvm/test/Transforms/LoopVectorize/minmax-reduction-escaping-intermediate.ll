; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals none --filter-out-after "scalar.ph:" --version 5
; RUN: opt < %s -passes="loop-vectorize" -force-vector-interleave=1 -force-vector-width=4 -S | FileCheck %s

declare i32 @llvm.smax.i32(i32, i32)

; A same-kind (smax) intermediate op of the reduction phi whose result is NOT on
; the reduction cycle (it does not feed the backedge) and escapes via a store to
; an invariant address. The stored value observes the *per-iteration scalar
; running max*, which the vectorized reduction cannot reproduce (it would extract
; lane 0 of the partial-reduction accumulator in the middle block). Make sure
; this is NOT recognized as a min/max reduction and the loop stays scalar so the
; escaping store is computed correctly on every iteration.
define i32 @max_with_escaping_intermediate_max_use(ptr noalias %a, i64 %n, ptr %sink) {
; CHECK-LABEL: define i32 @max_with_escaping_intermediate_max_use(
; CHECK-SAME: ptr noalias [[A:%.*]], i64 [[N:%.*]], ptr [[SINK:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[M:%.*]] = phi i32 [ -2147483648, %[[ENTRY]] ], [ [[M2:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GA:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IV]]
; CHECK-NEXT:    [[VA:%.*]] = load i32, ptr [[GA]], align 4
; CHECK-NEXT:    [[M2]] = call i32 @llvm.smax.i32(i32 [[VA]], i32 [[M]])
; CHECK-NEXT:    [[OTHER:%.*]] = call i32 @llvm.smax.i32(i32 [[M]], i32 42)
; CHECK-NEXT:    store i32 [[OTHER]], ptr [[SINK]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[M2_LCSSA:%.*]] = phi i32 [ [[M2]], %[[LOOP]] ]
; CHECK-NEXT:    ret i32 [[M2_LCSSA]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %m  = phi i32 [ -2147483648, %entry ], [ %m2, %loop ]
  %ga = getelementptr inbounds i32, ptr %a, i64 %iv
  %va = load i32, ptr %ga, align 4
  %m2 = call i32 @llvm.smax.i32(i32 %va, i32 %m)
  ; same-kind smax of the running max with a constant; NOT in the cycle, escapes
  ; via a store of a derived value.
  %other = call i32 @llvm.smax.i32(i32 %m, i32 42)
  store i32 %other, ptr %sink, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %m2
}

; Legitimate min/max reduction (no escaping derived store) must still vectorize
; as an smax reduction.
define i32 @legit_smax_reduction(ptr noalias %a, i64 %n) {
; CHECK-LABEL: define i32 @legit_smax_reduction(
; CHECK-SAME: ptr noalias [[A:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[N_MOD_VF:%.*]] = and i64 [[N]], 3
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[N]], [[N_MOD_VF]]
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[VEC_PHI:%.*]] = phi <4 x i32> [ splat (i32 -2147483648), %[[VECTOR_PH]] ], [ [[TMP2:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[INDEX]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP0]], align 4
; CHECK-NEXT:    [[TMP2]] = call <4 x i32> @llvm.smax.v4i32(<4 x i32> [[WIDE_LOAD]], <4 x i32> [[VEC_PHI]])
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[TMP3:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP3]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[TMP4:%.*]] = call i32 @llvm.vector.reduce.smax.v4i32(<4 x i32> [[TMP2]])
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], [[EXIT:label %.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %m  = phi i32 [ -2147483648, %entry ], [ %m2, %loop ]
  %ga = getelementptr inbounds i32, ptr %a, i64 %iv
  %va = load i32, ptr %ga, align 4
  %m2 = call i32 @llvm.smax.i32(i32 %va, i32 %m)
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %m2
}

; Legitimate intermediate min/max store: the last store to the invariant address
; stores the reduction value (%red.next == backedge value), so the per-iteration
; stores can be dropped and replaced by a single store of the final reduced value
; in the middle block. This must still vectorize as an smax reduction.
define void @legit_intermediate_store_of_reduction_value(i32 %x, ptr noalias %src, ptr %dst) {
; CHECK-LABEL: define void @legit_intermediate_store_of_reduction_value(
; CHECK-SAME: i32 [[X:%.*]], ptr noalias [[SRC:%.*]], ptr [[DST:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[VEC_PHI:%.*]] = phi <4 x i32> [ zeroinitializer, %[[VECTOR_PH]] ], [ [[TMP1:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr inbounds i32, ptr [[SRC]], i64 [[INDEX]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP0]], align 4
; CHECK-NEXT:    [[TMP1]] = call <4 x i32> @llvm.smax.v4i32(<4 x i32> [[VEC_PHI]], <4 x i32> [[WIDE_LOAD]])
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i64 [[INDEX_NEXT]], 100
; CHECK-NEXT:    br i1 [[TMP2]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP4:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[TMP3:%.*]] = call i32 @llvm.vector.reduce.smax.v4i32(<4 x i32> [[TMP1]])
; CHECK-NEXT:    store i32 [[TMP3]], ptr [[DST]], align 8
; CHECK-NEXT:    br label %[[SCALAR_PH:.*]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %red = phi i32 [ 0, %entry ], [ %red.next, %loop ]
  %gep.src = getelementptr inbounds i32, ptr %src, i64 %iv
  %l = load i32, ptr %gep.src
  %max.0 = tail call i32 @llvm.smax.i32(i32 %red, i32 %x)
  store i32 %max.0, ptr %dst, align 8
  %red.next = tail call i32 @llvm.smax.i32(i32 %red, i32 %l)
  store i32 %red.next, ptr %dst, align 8
  %iv.next = add i64 %iv, 1
  %ec = icmp eq i64 %iv, 100
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
