entry:
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  %gep.dst = getelementptr i20, ptr %dst, i64 %i
  br label %inner

inner:
  %j = phi i64 [ 0, %outer.header ], [ %j.next, %inner ]
  store i20 0, ptr %gep.dst
  %j.next = add i64 %j, 1
  %ec.inner = icmp eq i64 %j.next, %m
  br i1 %ec.inner, label %outer.latch, label %inner

outer.latch:
  %i.next = add i64 %i, 1
  %ec = icmp eq i64 %i.next, %n
  br i1 %ec, label %exit, label %outer.header, !llvm.loop !0

