; CHECK:       [[INNER_PH]]:
; CHECK-NEXT:    br label %[[INNER_BODY1:.*]]
; CHECK:       [[INNER_BODY1]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[INNER_PH]] ], [ [[J_NEXT:%.*]], %[[INNER_BODY1]] ]
; CHECK-NEXT:    [[J_MUL_M:%.*]] = mul nsw i64 [[J]], [[M]]
; CHECK-NEXT:    [[IDX:%.*]] = add nsw i64 [[I]], [[J_MUL_M]]
; CHECK-NEXT:    [[A_PTR:%.*]] = getelementptr inbounds float, ptr [[A]], i64 [[IDX]]
; CHECK-NEXT:    [[A_VAL:%.*]] = load float, ptr [[A_PTR]], align 4
; CHECK-NEXT:    [[MUL1:%.*]] = fmul float [[A_VAL]], 2.000000e+00
; CHECK-NEXT:    store float [[MUL1]], ptr [[A_PTR]], align 4
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[J_CMP:%.*]] = icmp eq i64 [[J_NEXT]], [[M]]
; CHECK-NEXT:    br i1 [[J_CMP]], label %[[OUTER_LATCH_LOOPEXIT:.*]], label %[[INNER_BODY1]]
; CHECK:       [[OUTER_LATCH_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[I_CMP:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[I_CMP]], label %[[EXIT_LOOPEXIT]], label %[[OUTER_HEADER]], !llvm.loop [[LOOP3:![0-9]+]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
