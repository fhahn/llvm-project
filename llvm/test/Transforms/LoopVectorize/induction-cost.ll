}

; Negative test for @fp_and_ptr_induction: the loop is only advanced by a
; pointer induction, whose increment is a GEP that the scalar cost charges
; nothing for, so the canonical IV increment must not be charged either.
define void @ptr_induction_only(ptr %start, ptr %end) {
