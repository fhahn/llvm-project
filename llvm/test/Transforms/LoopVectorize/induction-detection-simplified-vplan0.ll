; CHECK-NEXT:    [[SHL:%.*]] = shl i64 [[IV]], 32
; CHECK-NEXT:    [[ASHR:%.*]] = ashr exact i64 [[SHL]], 32
; CHECK-NEXT:    [[DEAD:%.*]] = add i64 [[SHL]], 1
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i64, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    store i64 [[ASHR]], ptr [[GEP]], align 8
; CHECK-NEXT:    [[IV_NEXT]] = add i64 [[ASHR]], [[STEP]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT]], label %[[LOOP]], !llvm.loop [[LOOP21:![0-9]+]]
