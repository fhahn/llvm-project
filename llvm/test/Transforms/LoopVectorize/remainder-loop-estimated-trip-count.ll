; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter "!prof" --version 6
; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=2 -S %s | FileCheck %s

; Check the estimated trip count assigned to the scalar remainder loop. The
; vector step is 4 x 2 = 8, so the remainder loop runs `TripCount % 8`
; iterations, unless it is only entered when the vector loop is bypassed, in
; which case it runs all iterations.

target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"

@a = global [1027 x i32] zeroinitializer, align 16

; The trip count is a constant, so the remainder loop runs exactly
; 1027 % 8 = 3 iterations.
define void @constant_tc(i64 %n) !prof !0 {
; CHECK-LABEL: define void @constant_tc(
; CHECK-SAME: i64 [[N:%.*]]) !prof [[PROF0:![0-9]+]] {
; CHECK:    br i1 [[TMP4:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF1:![0-9]+]], !llvm.loop [[LOOP2:![0-9]+]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT:label %.*]], [[LOOP:label %.*]], !prof [[PROF6:![0-9]+]], !llvm.loop [[LOOP7:![0-9]+]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep = getelementptr inbounds [1027 x i32], ptr @a, i64 0, i64 %iv
  %l = load i32, ptr %gep, align 4
  %add = add i32 %l, 1
  store i32 %add, ptr %gep, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 1027
  br i1 %ec, label %exit, label %loop, !prof !1

exit:
  ret void
}

; Same as @constant_tc, but the runtime memory checks bypass the vector loop
; into the scalar loop. The bypass is ignored when distributing the iterations,
; hence the remainder loop still runs exactly 1027 % 8 = 3 iterations.
define void @constant_tc_with_memchecks(ptr %a, ptr %b) !prof !0 {
; CHECK-LABEL: define void @constant_tc_with_memchecks(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]]) !prof [[PROF0]] {
; CHECK:    br i1 [[FOUND_CONFLICT:%.*]], [[SCALAR_PH:label %.*]], [[VECTOR_PH:label %.*]], !prof [[PROF9:![0-9]+]]
; CHECK:    br i1 [[TMP6:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF1]], !llvm.loop [[LOOP15:![0-9]+]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT:label %.*]], [[LOOP:label %.*]], !prof [[PROF6]], !llvm.loop [[LOOP16:![0-9]+]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.b = getelementptr inbounds i32, ptr %b, i64 %iv
  %l.b = load i32, ptr %gep.b, align 4
  %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
  %l.a = load i32, ptr %gep.a, align 4
  %add = add i32 %l.a, %l.b
  store i32 %add, ptr %gep.a, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 1027
  br i1 %ec, label %exit, label %loop, !prof !1

exit:
  ret void
}

; The trip count is not known, but it is known to be congruent to 1 modulo the
; vector step, so the remainder loop runs exactly 1 iteration.
define void @tc_multiple_of_step_plus_one(ptr %p, i64 %m) !prof !0 {
; CHECK-LABEL: define void @tc_multiple_of_step_plus_one(
; CHECK-SAME: ptr [[P:%.*]], i64 [[M:%.*]]) !prof [[PROF0]] {
; CHECK:    br i1 [[MIN_ITERS_CHECK:%.*]], [[SCALAR_PH:label %.*]], [[VECTOR_PH:label %.*]], !prof [[PROF9]]
; CHECK:    br i1 [[TMP5:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF1]], !llvm.loop [[LOOP17:![0-9]+]]
; CHECK:    br i1 [[CMP_N:%.*]], [[EXIT:label %.*]], [[SCALAR_PH]], !prof [[PROF18:![0-9]+]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT]], [[LOOP:label %.*]], !prof [[PROF6]], !llvm.loop [[LOOP19:![0-9]+]]
;
entry:
  %mul = mul i64 %m, 64
  %tc = add i64 %mul, 1
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i64 %iv
  %l = load i32, ptr %gep, align 4
  %add = add i32 %l, 1
  store i32 %add, ptr %gep, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %tc
  br i1 %ec, label %exit, label %loop, !prof !1

exit:
  ret void
}

; The trip count is known to be a multiple of the vector step, so the remainder
; loop is never entered.
define void @tc_multiple_of_step(ptr %p, i64 %m) !prof !0 {
; CHECK-LABEL: define void @tc_multiple_of_step(
; CHECK-SAME: ptr [[P:%.*]], i64 [[M:%.*]]) !prof [[PROF0]] {
; CHECK:    br i1 [[MIN_ITERS_CHECK:%.*]], [[SCALAR_PH:label %.*]], [[VECTOR_PH:label %.*]], !prof [[PROF9]]
; CHECK:    br i1 [[TMP5:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF1]], !llvm.loop [[LOOP20:![0-9]+]]
; CHECK:    br i1 [[CMP_N:%.*]], [[EXIT:label %.*]], [[SCALAR_PH]], !prof [[PROF18]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT]], [[LOOP:label %.*]], !prof [[PROF6]], !llvm.loop [[LOOP21:![0-9]+]]
;
entry:
  %tc = mul i64 %m, 64
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i64 %iv
  %l = load i32, ptr %gep, align 4
  %add = add i32 %l, 1
  store i32 %add, ptr %gep, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %tc
  br i1 %ec, label %exit, label %loop, !prof !1

exit:
  ret void
}

; The residue of the trip count is unknown, so assume the remainder loop runs
; half a step (8 / 2 = 4) iterations, whenever it is entered.
define void @unknown_tc(ptr noalias %p, i64 %n) !prof !0 {
; CHECK-LABEL: define void @unknown_tc(
; CHECK-SAME: ptr noalias [[P:%.*]], i64 [[N:%.*]]) !prof [[PROF0]] {
; CHECK:    br i1 [[MIN_ITERS_CHECK:%.*]], [[SCALAR_PH:label %.*]], [[VECTOR_PH:label %.*]], !prof [[PROF9]]
; CHECK:    br i1 [[TMP5:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF1]], !llvm.loop [[LOOP22:![0-9]+]]
; CHECK:    br i1 [[CMP_N:%.*]], [[EXIT:label %.*]], [[SCALAR_PH]], !prof [[PROF18]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT]], [[LOOP:label %.*]], !prof [[PROF6]], !llvm.loop [[LOOP23:![0-9]+]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i64 %iv
  %l = load i32, ptr %gep, align 4
  %add = add i32 %l, 1
  store i32 %add, ptr %gep, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop, !prof !1

exit:
  ret void
}

; The tail is folded, so the scalar loop does not run the iterations left over
; by the vector loop. It is only entered when the runtime memory checks bypass
; the vector loop and then runs all 1000 estimated iterations.
define void @tail_folded_with_memchecks(ptr %a, ptr %b, i64 %n) !prof !0 {
; CHECK-LABEL: define void @tail_folded_with_memchecks(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i64 [[N:%.*]]) !prof [[PROF0]] {
; CHECK:    br i1 [[FOUND_CONFLICT:%.*]], [[SCALAR_PH:label %.*]], [[VECTOR_PH:label %.*]], !prof [[PROF9]]
; CHECK:    br i1 [[TMP93:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF1]], !llvm.loop [[LOOP29:![0-9]+]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT:label %.*]], [[LOOP:label %.*]], !prof [[PROF6]], !llvm.loop [[LOOP30:![0-9]+]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.b = getelementptr inbounds i32, ptr %b, i64 %iv
  %l.b = load i32, ptr %gep.b, align 4
  %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
  %l.a = load i32, ptr %gep.a, align 4
  %add = add i32 %l.a, %l.b
  store i32 %add, ptr %gep.a, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop, !prof !1, !llvm.loop !2

exit:
  ret void
}

!0 = !{!"function_entry_count", i64 1000}
!1 = !{!"branch_weights", i32 1, i32 999}
!2 = distinct !{!2, !3}
