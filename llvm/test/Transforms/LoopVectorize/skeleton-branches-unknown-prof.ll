; CHECK:  [[VECTOR_BODY:.*]]:
; CHECK:    br i1 [[TMP2:%.*]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !prof [[PROF1]], !llvm.loop [[LOOP11:![0-9]+]]
; CHECK:  [[MIDDLE_BLOCK]]:
; CHECK:    br i1 [[CMP_N:%.*]], label %[[EXIT:.*]], label %[[SCALAR_PH]], !prof [[PROF12:![0-9]+]]
; CHECK:  [[SCALAR_PH]]:
; CHECK:  [[LOOP:.*]]:
