; The loop exits from the header, so there is no estimated trip count.
define void @header_exiting(ptr %p, i32 %n) !prof !0 {
; CHECK-LABEL: define void @header_exiting(
; CHECK-SAME: ptr [[P:%.*]], i32 [[N:%.*]]) !prof [[PROF0:![0-9]+]] {
; CHECK:  [[ENTRY:.*:]]
; CHECK:    br i1 [[MIN_ITERS_CHECK:%.*]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]], !prof [[PROF1:![0-9]+]]
; CHECK:  [[VECTOR_PH]]:
; CHECK:    [[TMP4:%.*]] = select i1 [[TMP3:%.*]], i32 4, i32 [[TMP2:%.*]], !prof [[PROF1]]
; CHECK:  [[VECTOR_BODY:.*]]:
; CHECK:    br i1 [[TMP7:%.*]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !prof [[PROF1]], !llvm.loop [[LOOP2:![0-9]+]]
; CHECK:  [[MIDDLE_BLOCK]]:
; CHECK:  [[SCALAR_PH]]:
; CHECK:  [[LOOP_HEADER:.*]]:
; CHECK:    br i1 [[EC:%.*]], label %[[LOOP_LATCH:.*]], label %[[EXIT:.*]]
; CHECK:  [[LOOP_LATCH]]:
; CHECK:    br label %[[LOOP_HEADER]], !llvm.loop [[LOOP5:![0-9]+]]
; CHECK:  [[EXIT]]:
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %ec = icmp slt i32 %iv, %n
  br i1 %ec, label %loop.latch, label %exit

loop.latch:
  %idx = sext i32 %iv to i64
  %gep = getelementptr inbounds i16, ptr %p, i64 %idx
  store i16 0, ptr %gep, align 2
  %iv.next = add nsw i32 %iv, 1
  br label %loop.header

exit:
  ret void
}

