; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter "br i1|!prof" --version 6
; RUN: opt -passes=loop-vectorize -force-partial-aliasing-vectorization -force-target-supports-masked-memory-ops -tail-folding-policy=must-fold-tail -force-vector-width=4 -force-vector-interleave=1 -S %s | FileCheck %s

; An alias mask narrows the lanes a folded tail leaves active further, by a
; fraction that is not known where the guards are scaled, so scaling by the tail's
; fraction alone would over-claim. The guards are left marked unknown instead.
define void @alias_mask_div(ptr noalias %a, ptr %b, ptr %c, i64 %n) !prof !0 {
; CHECK-LABEL: define void @alias_mask_div(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr [[B:%.*]], ptr [[C:%.*]], i64 [[N:%.*]]) !prof [[PROF0:![0-9]+]] {
; CHECK:    br i1 [[TMP6:%.*]], [[SCALAR_PH:label %.*]], [[VECTOR_PH:label %.*]], !prof [[PROF1:![0-9]+]]
; CHECK:    br i1 [[TMP14:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF1]], !llvm.loop [[LOOP2:![0-9]+]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT:label %.*]], [[LOOP:label %.*]], !llvm.loop [[LOOP5:![0-9]+]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.a = getelementptr inbounds i8, ptr %a, i64 %iv
  %load.a = load i8, ptr %gep.a, align 1
  %gep.b = getelementptr inbounds i8, ptr %b, i64 %iv
  %load.b = load i8, ptr %gep.b, align 1
  %div = sdiv i8 %load.b, %load.a
  %gep.c = getelementptr inbounds i8, ptr %c, i64 %iv
  store i8 %div, ptr %gep.c, align 1
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

!0 = !{!"function_entry_count", i64 1000}
;.
