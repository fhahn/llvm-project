; CHECK-NEXT:    [[A_PTR:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IDX]]
; CHECK-NEXT:    [[V:%.*]] = trunc i64 [[I]] to i32
; CHECK-NEXT:    store i32 [[V]], ptr [[A_PTR]], align 4
; CHECK-NEXT:    [[J_NEXT]] = sub nsw i64 [[J]], 1
; CHECK-NEXT:    [[J_CMP:%.*]] = icmp slt i64 [[J_NEXT]], 0
; CHECK-NEXT:    br i1 [[J_CMP]], label %[[OUTER_LATCH_LOOPEXIT:.*]], label %[[INNER_BODY]]
; CHECK:       [[OUTER_LATCH_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
