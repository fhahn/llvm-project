; CHECK-NEXT:    [[SUM_LCSSA:%.*]] = phi i32 [ 0, %[[OUTER]] ], [ [[SUM_NEXT_LCSSA]], %[[INNER_EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    [[RB2:%.*]] = getelementptr inbounds nuw [4 x i8], ptr [[A]], i64 [[OFF]]
; CHECK-NEXT:    [[ST:%.*]] = getelementptr inbounds nuw i8, ptr [[RB2]], i64 384
; CHECK-NEXT:    store i32 [[SUM_LCSSA]], ptr [[ST]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT_LOOPEXIT]], label %[[OUTER]], !llvm.loop [[LOOP0]]
;
  i32 noundef %M) {
  %c0 = icmp sgt i64 %N, 0
  br i1 %c0, label %outer.ph, label %exit

outer.ph:
  %c1 = icmp sgt i32 %M, 0
  br label %outer

outer:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %inner.exit ]
  %off = shl nsw i64 %i, 6
  br i1 %c1, label %inner.ph, label %inner.exit

inner.ph:
  %rowbase = getelementptr inbounds nuw [4 x i8], ptr %A, i64 %off
  br label %inner

inner:
  %j = phi i32 [ 0, %inner.ph ], [ %j.next, %inner ]
  %sum = phi i32 [ 0, %inner.ph ], [ %sum.next, %inner ]
  %masked = and i32 %j, 63
  %idx = zext nneg i32 %masked to i64
  %addr = getelementptr inbounds nuw [4 x i8], ptr %rowbase, i64 %idx
  %v = load i32, ptr %addr, align 4
  %sum.next = add nsw i32 %v, %sum
  %j.next = add nuw nsw i32 %j, 1
  %jdone = icmp eq i32 %j.next, %M
  br i1 %jdone, label %inner.exit, label %inner, !llvm.loop !3

exit:
  ret void

inner.exit:
  %sum.lcssa = phi i32 [ 0, %outer ], [ %sum.next, %inner ]
  %rb2 = getelementptr inbounds nuw [4 x i8], ptr %A, i64 %off
  %st = getelementptr inbounds nuw i8, ptr %rb2, i64 384
  store i32 %sum.lcssa, ptr %st, align 4
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, %N
  br i1 %done, label %exit, label %outer, !llvm.loop !0
}

!0 = distinct !{!0, !1, !2}
!1 = !{!"llvm.loop.vectorize.width", i32 4}
!2 = !{!"llvm.loop.vectorize.enable", i1 true}
!3 = distinct !{!3}
