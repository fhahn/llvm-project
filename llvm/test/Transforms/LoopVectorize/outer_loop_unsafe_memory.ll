; Triangular nest: the inner trip count depends on the outer IV, so a
; single inner-backedge-taken-count does not conservatively bound all
; outer iterations. The memory-safety check's [Start, End) range is
; computed using a single InnerBTC and is therefore unsound.
;
;   for (i = 0; i < N; i++)
;     for (j = 0; j <= i; j++)           // inner BTC = i (outer-IV dep.)
;       A[i * M + j] = 0;

define void @unsafe_triangular_inner(ptr noalias %A, i64 %N, i64 %M) {
; CHECK-LABEL: define void @unsafe_triangular_inner(
; CHECK-SAME: ptr noalias [[A:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP_OUTER:%.*]] = icmp sgt i64 [[N]], 0
; CHECK-NEXT:    br i1 [[CMP_OUTER]], label %[[OUTER_PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[OUTER_PH]]:
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[OUTER_PH]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[I_MUL_M:%.*]] = mul nsw i64 [[I]], [[M]]
; CHECK-NEXT:    [[I_PLUS_1:%.*]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    br label %[[INNER_BODY:.*]]
; CHECK:       [[INNER_BODY]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[OUTER_HEADER]] ], [ [[J_NEXT:%.*]], %[[INNER_BODY]] ]
; CHECK-NEXT:    [[IDX:%.*]] = add nsw i64 [[I_MUL_M]], [[J]]
; CHECK-NEXT:    [[A_PTR:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IDX]]
; CHECK-NEXT:    [[V:%.*]] = trunc i64 [[I]] to i32
; CHECK-NEXT:    store i32 [[V]], ptr [[A_PTR]], align 4
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[J_CMP:%.*]] = icmp eq i64 [[J_NEXT]], [[I_PLUS_1]]
; CHECK-NEXT:    br i1 [[J_CMP]], label %[[OUTER_LATCH]], label %[[INNER_BODY]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[I_CMP:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[I_CMP]], label %[[EXIT_LOOPEXIT:.*]], label %[[OUTER_HEADER]], !llvm.loop [[LOOP0]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %cmp.outer = icmp sgt i64 %N, 0
  br i1 %cmp.outer, label %outer.ph, label %exit

outer.ph:
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  %i.mul.M = mul nsw i64 %i, %M
  %i.plus.1 = add nuw nsw i64 %i, 1
  br label %inner.body

inner.body:
  %j = phi i64 [ 0, %outer.header ], [ %j.next, %inner.body ]
  %idx = add nsw i64 %i.mul.M, %j
  %A.ptr = getelementptr inbounds i32, ptr %A, i64 %idx
  %v = trunc i64 %i to i32
  store i32 %v, ptr %A.ptr, align 4
  %j.next = add nuw nsw i64 %j, 1
  %j.cmp = icmp eq i64 %j.next, %i.plus.1
  br i1 %j.cmp, label %outer.latch, label %inner.body

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp eq i64 %i.next, %N
  br i1 %i.cmp, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

; Decrementing inner IV: the inner-loop AddRec's step is negative, so the
; per-outer-iteration address range computed unsigned would invert
; ([Start, Start + MaxBTC*step + size)) and yield End < Start, which would
; make the subsequent unsigned predicates spuriously hold. The safety
; check must reject non-positive inner steps explicitly.
;
;   for (i = 0; i < N; i++)
;     for (j = M-1; j >= 0; j--)
;       A[i*M + j] = ...

define void @unsafe_decrementing_inner(ptr noalias %A, i64 %N, i64 %M) {
; CHECK-LABEL: define void @unsafe_decrementing_inner(
; CHECK-SAME: ptr noalias [[A:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP_OUTER:%.*]] = icmp sgt i64 [[N]], 0
; CHECK-NEXT:    br i1 [[CMP_OUTER]], label %[[OUTER_PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[OUTER_PH]]:
; CHECK-NEXT:    [[CMP_INNER:%.*]] = icmp sgt i64 [[M]], 0
; CHECK-NEXT:    [[J_START:%.*]] = sub i64 [[M]], 1
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[OUTER_PH]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    br i1 [[CMP_INNER]], label %[[INNER_PH:.*]], label %[[OUTER_LATCH]]
; CHECK:       [[INNER_PH]]:
; CHECK-NEXT:    [[I_MUL_M:%.*]] = mul nsw i64 [[I]], [[M]]
; CHECK-NEXT:    br label %[[INNER_BODY:.*]]
; CHECK:       [[INNER_BODY]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ [[J_START]], %[[INNER_PH]] ], [ [[J_NEXT:%.*]], %[[INNER_BODY]] ]
; CHECK-NEXT:    [[IDX:%.*]] = add nsw i64 [[I_MUL_M]], [[J]]
; CHECK-NEXT:    [[A_PTR:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IDX]]
; CHECK-NEXT:    [[V:%.*]] = trunc i64 [[I]] to i32
; CHECK-NEXT:    store i32 [[V]], ptr [[A_PTR]], align 4
; CHECK-NEXT:    [[J_NEXT]] = sub nsw i64 [[J]], 1
; CHECK-NEXT:    [[J_CMP:%.*]] = icmp slt i64 [[J_NEXT]], 0
; CHECK-NEXT:    br i1 [[J_CMP]], label %[[OUTER_LATCH_LOOPEXIT:.*]], label %[[INNER_BODY]]
; CHECK:       [[OUTER_LATCH_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[I_CMP:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[I_CMP]], label %[[EXIT_LOOPEXIT:.*]], label %[[OUTER_HEADER]], !llvm.loop [[LOOP0]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %cmp.outer = icmp sgt i64 %N, 0
  br i1 %cmp.outer, label %outer.ph, label %exit

outer.ph:
  %cmp.inner = icmp sgt i64 %M, 0
  %j.start = sub i64 %M, 1
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  br i1 %cmp.inner, label %inner.ph, label %outer.latch

inner.ph:
  %i.mul.M = mul nsw i64 %i, %M
  br label %inner.body

inner.body:
  %j = phi i64 [ %j.start, %inner.ph ], [ %j.next, %inner.body ]
  %idx = add nsw i64 %i.mul.M, %j
  %A.ptr = getelementptr inbounds i32, ptr %A, i64 %idx
  %v = trunc i64 %i to i32
  store i32 %v, ptr %A.ptr, align 4
  %j.next = sub nsw i64 %j, 1
  %j.cmp = icmp slt i64 %j.next, 0
  br i1 %j.cmp, label %outer.latch, label %inner.body

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp eq i64 %i.next, %N
  br i1 %i.cmp, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

; Memory-accessing intrinsics like llvm.masked.store are
; isTriviallyVectorizable, but their pointer operand is not analyzed by
; the load/store-only dependency scan. The candidate check must reject
; intrinsics that access memory in addition to checking
; isTriviallyVectorizable.

declare void @llvm.masked.store.v4f32.p0(<4 x float>, ptr, i32 immarg, <4 x i1>)

define void @unsafe_masked_store_intrinsic(ptr noalias %A, ptr %B, i64 %N, i64 %M) {
; CHECK-LABEL: define void @unsafe_masked_store_intrinsic(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr [[B:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP_OUTER:%.*]] = icmp sgt i64 [[N]], 0
; CHECK-NEXT:    br i1 [[CMP_OUTER]], label %[[OUTER_PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[OUTER_PH]]:
; CHECK-NEXT:    [[CMP_INNER:%.*]] = icmp sgt i64 [[M]], 0
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[OUTER_PH]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    call void @llvm.masked.store.v4f32.p0(<4 x float> zeroinitializer, ptr align 4 [[B]], <4 x i1> splat (i1 true))
; CHECK-NEXT:    br i1 [[CMP_INNER]], label %[[INNER_PH:.*]], label %[[OUTER_LATCH]]
; CHECK:       [[INNER_PH]]:
; CHECK-NEXT:    [[I_MUL_M:%.*]] = mul nsw i64 [[I]], [[M]]
; CHECK-NEXT:    br label %[[INNER_BODY:.*]]
