; Loop and address shapes that outer-loop vectorization must reject: pointer
; arithmetic that may wrap, non-monotonic (reverse or decrementing) traversals,
; triangular nests and trip counts too small to be profitable. Instructions
; that cannot be widened live in outer_loop_unsupported_instructions.ll,
; base-object aliasing in outer_loop_base_object_aliasing.ll and
; cross-iteration dependencies in outer_loop_cross_iter_deps.ll.

; Test that outer loop vectorization is rejected when GEPs are not inbounds
; and address monotonicity cannot be proven. Without inbounds, the pointer
; addition may wrap in unsigned arithmetic, meaning adjacent-iteration
; non-overlap does not imply non-overlap at arbitrary distances.
;
; void unsafe_no_inbounds(float *A, float *scale, int N, int M) {
;   for (int i = 0; i < N; i++)
;     for (int j = 0; j < M; j++)
;       A[i * M + j] *= scale[i];
; }
;
; Same pattern as the safe scale_rows test in outer_loop_no_flag.ll, but
; with non-inbounds GEPs, so SCEV cannot prove the address sequence is
; monotonically non-decreasing.

define void @unsafe_no_inbounds(ptr %A, ptr %scale, i64 %N, i64 %M) {
; CHECK-LABEL: define void @unsafe_no_inbounds(
; CHECK-SAME: ptr [[A:%.*]], ptr [[SCALE:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP_OUTER:%.*]] = icmp sgt i64 [[N]], 0
; CHECK-NEXT:    br i1 [[CMP_OUTER]], label %[[OUTER_PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[OUTER_PH]]:
; CHECK-NEXT:    [[CMP_INNER:%.*]] = icmp sgt i64 [[M]], 0
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[OUTER_PH]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[SCALE_PTR:%.*]] = getelementptr float, ptr [[SCALE]], i64 [[I]]
; CHECK-NEXT:    [[SCALE_VAL:%.*]] = load float, ptr [[SCALE_PTR]], align 4
; CHECK-NEXT:    br i1 [[CMP_INNER]], label %[[INNER_PH:.*]], label %[[OUTER_LATCH]]
; CHECK:       [[INNER_PH]]:
; CHECK-NEXT:    [[I_MUL_M:%.*]] = mul i64 [[I]], [[M]]
; CHECK-NEXT:    br label %[[INNER_BODY:.*]]
; CHECK:       [[INNER_BODY]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[INNER_PH]] ], [ [[J_NEXT:%.*]], %[[INNER_BODY]] ]
; CHECK-NEXT:    [[IDX:%.*]] = add i64 [[I_MUL_M]], [[J]]
; CHECK-NEXT:    [[A_PTR:%.*]] = getelementptr float, ptr [[A]], i64 [[IDX]]
; CHECK-NEXT:    [[A_VAL:%.*]] = load float, ptr [[A_PTR]], align 4
; CHECK-NEXT:    [[MUL:%.*]] = fmul float [[A_VAL]], [[SCALE_VAL]]
; CHECK-NEXT:    store float [[MUL]], ptr [[A_PTR]], align 4
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[J_CMP:%.*]] = icmp eq i64 [[J_NEXT]], [[M]]
; CHECK-NEXT:    br i1 [[J_CMP]], label %[[OUTER_LATCH_LOOPEXIT:.*]], label %[[INNER_BODY]]
; CHECK:       [[OUTER_LATCH_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[I_CMP:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[I_CMP]], label %[[EXIT_LOOPEXIT:.*]], label %[[OUTER_HEADER]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %cmp.outer = icmp sgt i64 %N, 0
  br i1 %cmp.outer, label %outer.ph, label %exit

outer.ph:
  %cmp.inner = icmp sgt i64 %M, 0
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  %scale.ptr = getelementptr float, ptr %scale, i64 %i
  %scale.val = load float, ptr %scale.ptr, align 4
  br i1 %cmp.inner, label %inner.ph, label %outer.latch

inner.ph:
  %i.mul.M = mul i64 %i, %M
  br label %inner.body

inner.body:
  %j = phi i64 [ 0, %inner.ph ], [ %j.next, %inner.body ]
  %idx = add i64 %i.mul.M, %j
  %A.ptr = getelementptr float, ptr %A, i64 %idx
  %A.val = load float, ptr %A.ptr, align 4
  %mul = fmul float %A.val, %scale.val
  store float %mul, ptr %A.ptr, align 4
  %j.next = add nuw nsw i64 %j, 1
  %j.cmp = icmp eq i64 %j.next, %M
  br i1 %j.cmp, label %outer.latch, label %inner.body

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp eq i64 %i.next, %N
  br i1 %i.cmp, label %exit, label %outer.header, !llvm.loop !0

