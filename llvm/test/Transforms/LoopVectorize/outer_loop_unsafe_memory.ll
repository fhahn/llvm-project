; CHECK-NEXT:    [[CMP_INNER:%.*]] = icmp sgt i64 [[M]], 0
; CHECK-NEXT:    [[I_START:%.*]] = sub i64 [[N]], 1
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[I_START]], %[[OUTER_PH]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[SCALE_PTR:%.*]] = getelementptr inbounds float, ptr [[SCALE]], i64 [[I]]
; CHECK-NEXT:    [[SCALE_VAL:%.*]] = load float, ptr [[SCALE_PTR]], align 4
; CHECK-NEXT:    br i1 [[CMP_INNER]], label %[[INNER_PH:.*]], label %[[OUTER_LATCH]]
; CHECK:       [[INNER_PH]]:
; CHECK-NEXT:    [[I_MUL_M:%.*]] = mul nsw i64 [[I]], [[M]]
