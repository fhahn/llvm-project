; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i16 [ [[BI_NEXT]], %[[LOOP1]] ]
; CHECK-NEXT:    [[RE:%.*]] = zext i16 [[R]] to i32
; CHECK-NEXT:    ret i32 [[RE]]
;
entry:
  %a0 = load i32, ptr %a
  br label %loop
loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop ]
  %best = phi i32 [ %a0, %entry ], [ %best.next, %loop ]
  %bi = phi i16 [ 0, %entry ], [ %bi.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %a, i64 %iv
  %l = load i32, ptr %gep
  %cmp = icmp sgt i32 %l, %best
  %t = trunc i64 %iv to i16
  %bi.next = select i1 %cmp, i16 %t, i16 %bi
  %best.next = tail call i32 @llvm.smax.i32(i32 %l, i32 %best)
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 65535
  br i1 %ec, label %exit, label %loop
exit:
  %r = phi i16 [ %bi.next, %loop ]
  %re = zext i16 %r to i32
  ret i32 %re
}
