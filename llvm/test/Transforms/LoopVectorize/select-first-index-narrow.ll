; CHECK-NEXT:    [[TMP18:%.*]] = select i1 [[TMP17]], i32 0, i32 [[TMP16]]
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[TMP0]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], label %[[EXIT_LOOPEXIT:.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
; CHECK-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i64 [ [[TMP2]], %[[MIDDLE_BLOCK]] ], [ 1, %[[PH]] ]
; CHECK-NEXT:    [[BC_MERGE_RDX:%.*]] = phi i64 [ [[TMP9]], %[[MIDDLE_BLOCK]] ], [ [[A0]], %[[PH]] ]
; CHECK-NEXT:    [[BC_MERGE_RDX4:%.*]] = phi i32 [ [[TMP18]], %[[MIDDLE_BLOCK]] ], [ 0, %[[PH]] ]
; CHECK-NEXT:    br label %[[LOOP1:.*]]
; CHECK:       [[LOOP1]]:
; CHECK-NEXT:    [[IV1:%.*]] = phi i64 [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP1]] ]
; CHECK-NEXT:    [[BEST:%.*]] = phi i64 [ [[BC_MERGE_RDX]], %[[SCALAR_PH]] ], [ [[BEST_NEXT:%.*]], %[[LOOP1]] ]
; CHECK-NEXT:    [[BI:%.*]] = phi i32 [ [[BC_MERGE_RDX4]], %[[SCALAR_PH]] ], [ [[BI_NEXT:%.*]], %[[LOOP1]] ]
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr inbounds i64, ptr [[A]], i64 [[IV1]]
; CHECK-NEXT:    [[L:%.*]] = load i64, ptr [[GEP1]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt i64 [[L]], [[BEST]]
; CHECK-NEXT:    [[T:%.*]] = trunc nuw nsw i64 [[IV1]] to i32
; CHECK-NEXT:    [[BI_NEXT]] = select i1 [[CMP]], i32 [[T]], i32 [[BI]]
; CHECK-NEXT:    [[BEST_NEXT]] = tail call i64 @llvm.smax.i64(i64 [[L]], i64 [[BEST]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV1]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[WTC]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT_LOOPEXIT]], label %[[LOOP1]], !llvm.loop [[LOOP13:![0-9]+]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    [[BI_NEXT_LCSSA:%.*]] = phi i32 [ [[BI_NEXT]], %[[LOOP1]] ], [ [[TMP18]], %[[MIDDLE_BLOCK]] ]
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[BI_NEXT_LCSSA]], %[[EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    ret i32 [[R]]
;
entry:
  %c = icmp sgt i32 %n, 1
  br i1 %c, label %ph, label %exit
ph:
  %a0 = load i64, ptr %a
  %wtc = zext nneg i32 %n to i64
  br label %loop
loop:
  %iv = phi i64 [ 1, %ph ], [ %iv.next, %loop ]
  %best = phi i64 [ %a0, %ph ], [ %best.next, %loop ]
  %bi = phi i32 [ 0, %ph ], [ %bi.next, %loop ]
  %gep = getelementptr inbounds i64, ptr %a, i64 %iv
  %l = load i64, ptr %gep
  %cmp = icmp sgt i64 %l, %best
  %t = trunc nuw nsw i64 %iv to i32
  %bi.next = select i1 %cmp, i32 %t, i32 %bi
  %best.next = tail call i64 @llvm.smax.i64(i64 %l, i64 %best)
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %wtc
  br i1 %ec, label %exit, label %loop
exit:
  %r = phi i32 [ 0, %entry ], [ %bi.next, %loop ]
  ret i32 %r
}

