entry:
  %a0 = load i32, ptr %a
  br label %loop
loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop ]
  %best = phi i32 [ %a0, %entry ], [ %best.next, %loop ]
  %bi = phi i32 [ 0, %entry ], [ %bi.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %a, i64 %iv
