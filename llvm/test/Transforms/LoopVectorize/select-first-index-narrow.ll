  %best.next = tail call i32 @llvm.smax.i32(i32 %l, i32 %best)
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop
exit:
  %r = phi i32 [ %bi.next, %loop ]
  ret i32 %r
}

; Sentinel boundary: an i16 index with trip count 65536 makes the last index
; value 65535, which is the i16 UMin sentinel. A never-updated lane would tie
; with the real index 65535, so the index must not be reduced in i16.
define i32 @argmax_s32_i16idx_at_sentinel(ptr %a) {
; CHECK-LABEL: define i32 @argmax_s32_i16idx_at_sentinel(
; CHECK-SAME: ptr [[A:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[A0:%.*]] = load i32, ptr [[A]], align 4
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[BEST:%.*]] = phi i32 [ [[A0]], %[[ENTRY]] ], [ [[BEST_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[BI:%.*]] = phi i16 [ 0, %[[ENTRY]] ], [ [[BI_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IV]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt i32 [[L]], [[BEST]]
; CHECK-NEXT:    [[T:%.*]] = trunc i64 [[IV]] to i16
; CHECK-NEXT:    [[BI_NEXT]] = select i1 [[CMP]], i16 [[T]], i16 [[BI]]
; CHECK-NEXT:    [[BEST_NEXT]] = tail call i32 @llvm.smax.i32(i32 [[L]], i32 [[BEST]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], 65536
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i16 [ [[BI_NEXT]], %[[LOOP]] ]
; CHECK-NEXT:    [[RE:%.*]] = zext i16 [[R]] to i32
; CHECK-NEXT:    ret i32 [[RE]]
;
entry:
  %a0 = load i32, ptr %a
  br label %loop
loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop ]
  %best = phi i32 [ %a0, %entry ], [ %best.next, %loop ]
  %bi = phi i16 [ 0, %entry ], [ %bi.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %a, i64 %iv
  %l = load i32, ptr %gep
  %cmp = icmp sgt i32 %l, %best
  %t = trunc i64 %iv to i16
  %bi.next = select i1 %cmp, i16 %t, i16 %bi
  %best.next = tail call i32 @llvm.smax.i32(i32 %l, i32 %best)
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 65536
  br i1 %ec, label %exit, label %loop
exit:
  %r = phi i16 [ %bi.next, %loop ]
  %re = zext i16 %r to i32
  ret i32 %re
}

