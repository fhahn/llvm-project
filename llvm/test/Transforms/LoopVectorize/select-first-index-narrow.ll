; Tests for strict-predicate (first-index-wins) argmin/argmax where the index
; reduction is narrower than the canonical IV. This is the common
; `int bi; for (int i ...)` idiom, where IndVarSimplify widens the IV to i64
; while the index stays i32.
;
; handleFirstArgMinOrMax bails out if the index type is not the canonical IV
; type, so none of these vectorize yet.

declare i32 @llvm.smax.i32(i32, i32)
declare i32 @llvm.smin.i32(i32, i32)
declare i32 @llvm.umax.i32(i32, i32)
declare i32 @llvm.umin.i32(i32, i32)
declare i8 @llvm.smax.i8(i8, i8)
declare i16 @llvm.smax.i16(i16, i16)
declare i64 @llvm.smax.i64(i64, i64)

; i32 element, i32 index, strict argmax (signed). The trip count is a zext of
; an i32 argument, so the index values provably fit i32.
define i32 @argmax_s32_i32idx(ptr %a, i32 %n) {
; CHECK-LABEL: define i32 @argmax_s32_i32idx(
; CHECK-SAME: ptr [[A:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[C:%.*]] = icmp sgt i32 [[N]], 1
; CHECK-NEXT:    br i1 [[C]], label %[[PH:.*]], label %[[EXIT:.*]]
; CHECK:       [[PH]]:
; CHECK-NEXT:    [[A0:%.*]] = load i32, ptr [[A]], align 4
; CHECK-NEXT:    [[WTC:%.*]] = zext nneg i32 [[N]] to i64
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[BEST:%.*]] = phi i32 [ [[A0]], %[[PH]] ], [ [[BEST_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[BI:%.*]] = phi i32 [ 0, %[[PH]] ], [ [[BI_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IV]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt i32 [[L]], [[BEST]]
; CHECK-NEXT:    [[T:%.*]] = trunc nuw nsw i64 [[IV]] to i32
; CHECK-NEXT:    [[BI_NEXT]] = select i1 [[CMP]], i32 [[T]], i32 [[BI]]
; CHECK-NEXT:    [[BEST_NEXT]] = tail call i32 @llvm.smax.i32(i32 [[L]], i32 [[BEST]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[WTC]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT_LOOPEXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    [[BI_NEXT_LCSSA:%.*]] = phi i32 [ [[BI_NEXT]], %[[LOOP]] ]
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[BI_NEXT_LCSSA]], %[[EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    ret i32 [[R]]
;
entry:
  %c = icmp sgt i32 %n, 1
  br i1 %c, label %ph, label %exit
ph:
  %a0 = load i32, ptr %a
  %wtc = zext nneg i32 %n to i64
  br label %loop
loop:
  %iv = phi i64 [ 1, %ph ], [ %iv.next, %loop ]
  %best = phi i32 [ %a0, %ph ], [ %best.next, %loop ]
  %bi = phi i32 [ 0, %ph ], [ %bi.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %a, i64 %iv
  %l = load i32, ptr %gep
  %cmp = icmp sgt i32 %l, %best
  %t = trunc nuw nsw i64 %iv to i32
  %bi.next = select i1 %cmp, i32 %t, i32 %bi
  %best.next = tail call i32 @llvm.smax.i32(i32 %l, i32 %best)
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %wtc
  br i1 %ec, label %exit, label %loop
exit:
  %r = phi i32 [ 0, %entry ], [ %bi.next, %loop ]
  ret i32 %r
}

