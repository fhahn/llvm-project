; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter "br i1|= select |!prof|!llvm.loop|^.*:" --version 6
; RUN: opt -p loop-vectorize -mtriple riscv64 -mattr=+v -tail-folding-policy=prefer-fold-tail -S %s | FileCheck %s

; The select clamping the AVL to the maximum safe number of elements for the
; dependence distance. The probability of its condition is not tracked.
define void @safe_avl(ptr %p) vscale_range(2, 1024) !prof !0 {
; CHECK-LABEL: define void @safe_avl(
; CHECK-SAME: ptr [[P:%.*]]) #[[ATTR0:[0-9]+]] !prof [[PROF0:![0-9]+]] {
; CHECK:  [[ENTRY:.*:]]
; CHECK:  [[VECTOR_PH:.*:]]
; CHECK:  [[VECTOR_BODY:.*]]:
; CHECK:    [[SAFE_AVL:%.*]] = select i1 [[TMP0:%.*]], i64 [[AVL:%.*]], i64 1024
; CHECK:    br i1 [[TMP6:%.*]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP1:![0-9]+]]
; CHECK:  [[MIDDLE_BLOCK]]:
; CHECK:  [[EXIT:.*:]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %a1 = getelementptr i64, ptr %p, i64 %iv
  %v = load i64, ptr %a1, align 32
  %offset = add i64 %iv, 1024
  %a2 = getelementptr i64, ptr %p, i64 %offset
  store i64 %v, ptr %a2, align 32
  %iv.next = add i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 3002
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

!0 = !{!"function_entry_count", i64 1000}
;.
; CHECK: [[PROF0]] = !{!"function_entry_count", i64 1000}
; CHECK: [[LOOP1]] = distinct !{[[LOOP1]], [[META2:![0-9]+]], [[META3:![0-9]+]]}
; CHECK: [[META2]] = !{!"llvm.loop.isvectorized", i32 1}
; CHECK: [[META3]] = !{!"llvm.loop.unroll.runtime.disable"}
;.
