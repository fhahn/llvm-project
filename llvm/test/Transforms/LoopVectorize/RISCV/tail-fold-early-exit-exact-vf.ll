; RUN: opt -S -passes=loop-vectorize -mtriple=riscv64 -mattr=+v -force-vector-width=8 -force-vector-interleave=1 -scalable-vectorization=on -tail-folding-policy=must-fold-tail -force-tail-folding-style=data-with-evl < %s | FileCheck %s

; The countable exit is known true for this VF. EVL conversion must preserve
; the early-exit condition without requiring the original count comparison.
define i32 @exact_scalable_vector(ptr align 4 dereferenceable(128) %p) vscale_range(2,4) {
; CHECK-LABEL: define i32 @exact_scalable_vector(
; CHECK-SAME: ptr align 4 dereferenceable(128) [[P:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[VSCALE:%.*]] = call i64 @llvm.vscale.i64()
; CHECK-NEXT:    [[N:%.*]] = shl nuw nsw i64 [[VSCALE]], 3
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[TMP0:%.*]] = trunc i64 [[N]] to i32
; CHECK-NEXT:    [[VP_OP_LOAD:%.*]] = call <vscale x 8 x i32> @llvm.vp.load.nxv8i32.p0(ptr align 4 [[P]], <vscale x 8 x i1> splat (i1 true), i32 [[TMP0]])
; CHECK-NEXT:    [[TMP1:%.*]] = icmp ne <vscale x 8 x i32> [[VP_OP_LOAD]], zeroinitializer
; CHECK-NEXT:    [[TMP2:%.*]] = call <vscale x 8 x i1> @llvm.vp.merge.nxv8i1(<vscale x 8 x i1> splat (i1 true), <vscale x 8 x i1> [[TMP1]], <vscale x 8 x i1> zeroinitializer, i32 [[TMP0]])
; CHECK-NEXT:    [[TMP3:%.*]] = freeze <vscale x 8 x i1> [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = call i1 @llvm.vector.reduce.or.nxv8i1(<vscale x 8 x i1> [[TMP3]])
; CHECK-NEXT:    br i1 [[TMP4]], label %[[VECTOR_EARLY_EXIT:.*]], label %[[VECTOR_BODY_INTERIM:.*]]
; CHECK:       [[VECTOR_BODY_INTERIM]]:
; CHECK-NEXT:    br label %[[MIDDLE_BLOCK:.*]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br label %[[COUNT_EXIT:.*]]
; CHECK:       [[VECTOR_EARLY_EXIT]]:
; CHECK-NEXT:    [[FIRST_ACTIVE_LANE:%.*]] = call i64 @llvm.experimental.cttz.elts.i64.nxv8i1(<vscale x 8 x i1> [[TMP2]], i1 false)
; CHECK-NEXT:    [[TMP5:%.*]] = extractelement <vscale x 8 x i32> [[VP_OP_LOAD]], i64 [[FIRST_ACTIVE_LANE]]
; CHECK-NEXT:    br label %[[EARLY_EXIT:.*]]
; CHECK:       [[EARLY_EXIT]]:
; CHECK-NEXT:    ret i32 [[TMP5]]
; CHECK:       [[COUNT_EXIT]]:
; CHECK-NEXT:    ret i32 -1
;
entry:
  %vscale = call i64 @llvm.vscale.i64()
  %n = shl nuw nsw i64 %vscale, 3
  br label %header

header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %ptr = getelementptr i32, ptr %p, i64 %iv
  %x = load i32, ptr %ptr, align 4
  %hit = icmp ne i32 %x, 0
  br i1 %hit, label %early.exit, label %latch

latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %done = icmp eq i64 %iv.next, %n
  br i1 %done, label %count.exit, label %header, !llvm.loop !0

early.exit:
  %result = phi i32 [ %x, %header ]
  ret i32 %result

count.exit:
  ret i32 -1
}

declare i64 @llvm.vscale.i64()

!0 = distinct !{!0, !1}
!1 = !{!"llvm.loop.vectorize.enable"}
