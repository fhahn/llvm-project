; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter-out-after "^middle.block:" --version 6
; RUN: opt -S -passes=loop-vectorize -mtriple riscv64 -mattr=+v \
; RUN:   -enable-wide-lane-mask -force-tail-folding-style=data-and-control \
; RUN:   -tail-folding-policy=prefer-fold-tail -force-vector-width=4 -force-vector-interleave=2 < %s | FileCheck %s

; Regression test for a crash in tryToReplaceALMWithWideALM: for a loop with no
; masked memory accesses (a pure counter loop) the active-lane-mask phis are
; dead and removed, leaving fewer VPActiveLaneMaskPHIRecipes than unroll parts.
; The wide-lane-mask transform must bail out gracefully in that case instead of
; asserting that there is one mask phi per unroll part.

target triple = "riscv64"

define i32 @no_masking_uf2() {
; CHECK-LABEL: define i32 @no_masking_uf2(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i32 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[INDEX_NEXT]] = add i32 [[INDEX]], 8
; CHECK-NEXT:    [[TMP0:%.*]] = icmp eq i32 [[INDEX_NEXT]], 0
; CHECK-NEXT:    br i1 [[TMP0]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
;
entry:
  br label %body

body:
  %p = phi i32 [ 1, %entry ], [ %inc, %body ]
  %inc = add i32 %p, 1
  %cmp = icmp eq i32 %inc, 0
  br i1 %cmp, label %end, label %body

end:
  ret i32 0
}
;.
; CHECK: [[LOOP0]] = distinct !{[[LOOP0]], [[META1:![0-9]+]], [[META2:![0-9]+]]}
; CHECK: [[META1]] = !{!"llvm.loop.isvectorized", i32 1}
; CHECK: [[META2]] = !{!"llvm.loop.unroll.runtime.disable"}
;.
