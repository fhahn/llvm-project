; CHECK-NEXT:    [[T2:%.*]] = phi float [ [[T6:%.*]], [[LOOP1]] ], [ [[TMP16]], [[SCALAR_PH]] ]
; CHECK-NEXT:    [[T3:%.*]] = getelementptr float, ptr [[ARG]], i64 [[T1]]
; CHECK-NEXT:    [[T4:%.*]] = load float, ptr [[T3]], align 4
