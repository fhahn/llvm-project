; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals none --filter-out-after "vector.ph" --version 5
; RUN: opt %s -passes=loop-vectorize -hoist-runtime-checks=false -force-vector-width=4 -force-target-max-vector-interleave=4 -S | FileCheck --check-prefix=AUTO-IC %s
; RUN: opt %s -passes=loop-vectorize -hoist-runtime-checks=false -force-vector-width=4 -force-target-max-vector-interleave=4 -force-vector-interleave=1 -S | FileCheck --check-prefix=FORCED-IC1 %s

target datalayout = "e-m:e-i64:64-i128:128-n32:64-S128"

; The threshold a difference is compared against is VF * UF * AccessSize - 1, so
; it must be derived from the interleave count the loop is actually vectorized
; with. Here the cost model selects UF == 2, which the second RUN line overrides
; to 1 via -force-vector-interleave=1. Both the minimum iteration check and the
; difference check have to follow that override, i.e. the pair (4, 31) for the
; selected UF of 2 and (4, 15) for the forced UF of 1.
define void @diff_check_threshold_follows_interleave_count(ptr %a, ptr %b, i64 %n) {
; AUTO-IC-LABEL: define void @diff_check_threshold_follows_interleave_count(
; AUTO-IC-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i64 [[N:%.*]]) {
; AUTO-IC-NEXT:  [[ENTRY:.*:]]
; AUTO-IC-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 8
; AUTO-IC-NEXT:    br i1 [[MIN_ITERS_CHECK]], [[SCALAR_PH:label %.*]], label %[[VECTOR_MEMCHECK:.*]]
; AUTO-IC:       [[VECTOR_MEMCHECK]]:
; AUTO-IC-NEXT:    [[B1:%.*]] = ptrtoaddr ptr [[B]] to i64
; AUTO-IC-NEXT:    [[A2:%.*]] = ptrtoaddr ptr [[A]] to i64
; AUTO-IC-NEXT:    [[TMP0:%.*]] = sub i64 [[B1]], [[A2]]
; AUTO-IC-NEXT:    [[TMP1:%.*]] = sub i64 [[TMP0]], 1
; AUTO-IC-NEXT:    [[DIFF_CHECK:%.*]] = icmp ult i64 [[TMP1]], 31
; AUTO-IC-NEXT:    br i1 [[DIFF_CHECK]], [[SCALAR_PH]], [[VECTOR_PH:label %.*]]
;
; FORCED-IC1-LABEL: define void @diff_check_threshold_follows_interleave_count(
; FORCED-IC1-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i64 [[N:%.*]]) {
; FORCED-IC1-NEXT:  [[ENTRY:.*:]]
; FORCED-IC1-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
; FORCED-IC1-NEXT:    br i1 [[MIN_ITERS_CHECK]], [[SCALAR_PH:label %.*]], label %[[VECTOR_MEMCHECK:.*]]
; FORCED-IC1:       [[VECTOR_MEMCHECK]]:
; FORCED-IC1-NEXT:    [[B1:%.*]] = ptrtoaddr ptr [[B]] to i64
; FORCED-IC1-NEXT:    [[A2:%.*]] = ptrtoaddr ptr [[A]] to i64
; FORCED-IC1-NEXT:    [[TMP0:%.*]] = sub i64 [[B1]], [[A2]]
; FORCED-IC1-NEXT:    [[TMP1:%.*]] = sub i64 [[TMP0]], 1
; FORCED-IC1-NEXT:    [[DIFF_CHECK:%.*]] = icmp ult i64 [[TMP1]], 15
; FORCED-IC1-NEXT:    br i1 [[DIFF_CHECK]], [[SCALAR_PH]], [[VECTOR_PH:label %.*]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
  %l = load i32, ptr %gep.a
  %mul = mul nsw i32 %l, 3
  %gep.b = getelementptr inbounds i32, ptr %b, i64 %iv
  store i32 %mul, ptr %gep.b
  %iv.next = add nuw nsw i64 %iv, 1
  %exitcond = icmp eq i64 %iv.next, %n
  br i1 %exitcond, label %exit, label %loop

exit:
  ret void
}
