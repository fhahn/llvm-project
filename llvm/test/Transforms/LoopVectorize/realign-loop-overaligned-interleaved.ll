; The body's load/store carry align 32, larger than VF*EltSize = 16. After
; unrolling to UF=4 the per-part recipes retain align 32, but for parts
; whose offset (part*VF*EltSize) is not a multiple of 32 the actual
; alignment is only 16.
;
; The realign body executes the body once with a shifted index. With
; TC=45, Stride=16, VF=4, RestartIdx=29, the part offsets (in bytes
; relative to the live-in base) are 116, 132, 148, 164. gcd(32, 116)=4,
; so claiming align 32 for every part would be unsound.
;
; tryToRealignLoop intersects the downgraded alignment with VF*EltSize
; (=16) AND with the runtime base shift (RestartIdx * EltSize = 116).
; gcd(commonAlignment(32, 116), 16) = gcd(4, 16) = 4, giving a uniform
; align 4 claim that is sound for every part.
define void @realign_overaligned_uf4(ptr noalias %dst, ptr noalias %src) {
; CHECK-LABEL: define void @realign_overaligned_uf4(
; CHECK-SAME: ptr noalias [[DST:%.*]], ptr noalias [[SRC:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr inbounds i32, ptr [[SRC]], i64 [[INDEX]]
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds i32, ptr [[TMP0]], i64 4
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr inbounds i32, ptr [[TMP0]], i64 8
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr inbounds i32, ptr [[TMP0]], i64 12
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP0]], align 32
; CHECK-NEXT:    [[WIDE_LOAD1:%.*]] = load <4 x i32>, ptr [[TMP1]], align 32
; CHECK-NEXT:    [[WIDE_LOAD2:%.*]] = load <4 x i32>, ptr [[TMP2]], align 32
; CHECK-NEXT:    [[WIDE_LOAD3:%.*]] = load <4 x i32>, ptr [[TMP3]], align 32
; CHECK-NEXT:    [[TMP4:%.*]] = add <4 x i32> [[WIDE_LOAD]], splat (i32 1)
; CHECK-NEXT:    [[TMP5:%.*]] = add <4 x i32> [[WIDE_LOAD1]], splat (i32 1)
; CHECK-NEXT:    [[TMP6:%.*]] = add <4 x i32> [[WIDE_LOAD2]], splat (i32 1)
