; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[TMP1]], [[TMP15]]
; CHECK-NEXT:    [[TMP16:%.*]] = trunc i64 [[N_VEC]] to i16
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
