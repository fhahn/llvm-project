; RUN: opt -passes=loop-vectorize -enable-interleaved-mem-accesses -force-vector-width=4 -force-vector-interleave=1 -S %s | FileCheck %s

target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"

; Two stores in an inner loop write to adjacent elements through two pointers
; (%pA and %pB = %dst + 1) that are both advanced by 2 elements each inner
; iteration and carried across the outer loop. Recognizing the outer pointer
; PHIs as add-recurrences lets ScalarEvolution compute a constant distance
; between the stores, so a stride-2 interleave group can be formed instead of
; scalarizing the stores.
define void @nested_interleave_group(ptr noalias %src, ptr noalias %dst, i64 %width, i64 %height) {
; CHECK-LABEL: @nested_interleave_group(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[DST_1:%.*]] = getelementptr inbounds nuw i8, ptr [[DST:%.*]], i64 4
; CHECK-NEXT:    [[WIDTH_POS:%.*]] = icmp ne i64 [[WIDTH:%.*]], 0
; CHECK-NEXT:    [[HEIGHT_POS:%.*]] = icmp ne i64 [[HEIGHT:%.*]], 0
; CHECK-NEXT:    [[GUARD:%.*]] = and i1 [[WIDTH_POS]], [[HEIGHT_POS]]
; CHECK-NEXT:    br i1 [[GUARD]], label [[OUTER_PH:%.*]], label [[EXIT:%.*]]
; CHECK:       outer.ph:
; CHECK-NEXT:    [[TMP0:%.*]] = mul i64 [[HEIGHT]], [[WIDTH]]
; CHECK-NEXT:    [[TMP1:%.*]] = shl i64 [[TMP0]], 3
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[DST]], i64 [[TMP1]]
; CHECK-NEXT:    [[TMP2:%.*]] = shl i64 [[WIDTH]], 3
; CHECK-NEXT:    [[TMP3:%.*]] = shl i64 [[HEIGHT]], 2
; CHECK-NEXT:    [[TMP4:%.*]] = shl i64 [[WIDTH]], 2
; CHECK-NEXT:    [[TMP5:%.*]] = add i64 [[TMP3]], [[TMP4]]
; CHECK-NEXT:    [[TMP6:%.*]] = add i64 [[TMP5]], -4
; CHECK-NEXT:    [[SCEVGEP1:%.*]] = getelementptr i8, ptr [[SRC:%.*]], i64 [[TMP6]]
; CHECK-NEXT:    br label [[OUTER:%.*]]
; CHECK:       outer:
; CHECK-NEXT:    [[OUTER_IV:%.*]] = phi i64 [ 0, [[OUTER_PH]] ], [ [[OUTER_IV_NEXT:%.*]], [[OUTER_LATCH:%.*]] ]
; CHECK-NEXT:    [[PA:%.*]] = phi ptr [ [[DST]], [[OUTER_PH]] ], [ [[PA_NEXT_LCSSA:%.*]], [[OUTER_LATCH]] ]
; CHECK-NEXT:    [[PB:%.*]] = phi ptr [ [[DST_1]], [[OUTER_PH]] ], [ [[PB_NEXT_LCSSA:%.*]], [[OUTER_LATCH]] ]
; CHECK-NEXT:    [[ROW:%.*]] = getelementptr inbounds float, ptr [[SRC]], i64 [[OUTER_IV]]
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[WIDTH]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label [[SCALAR_PH:%.*]], label [[VECTOR_MEMCHECK:%.*]]
; CHECK:       vector.memcheck:
; CHECK-NEXT:    [[BOUND0:%.*]] = icmp ult ptr [[DST]], [[SCEVGEP1]]
; CHECK-NEXT:    [[BOUND1:%.*]] = icmp ult ptr [[SRC]], [[SCEVGEP]]
; CHECK-NEXT:    [[FOUND_CONFLICT:%.*]] = and i1 [[BOUND0]], [[BOUND1]]
; CHECK-NEXT:    [[STRIDE_CHECK:%.*]] = icmp slt i64 [[TMP2]], 0
; CHECK-NEXT:    [[TMP7:%.*]] = or i1 [[FOUND_CONFLICT]], [[STRIDE_CHECK]]
; CHECK-NEXT:    br i1 [[TMP7]], label [[SCALAR_PH]], label [[VECTOR_PH:%.*]]
; CHECK:       vector.ph:
; CHECK-NEXT:    [[N_MOD_VF:%.*]] = urem i64 [[WIDTH]], 4
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[WIDTH]], [[N_MOD_VF]]
; CHECK-NEXT:    [[TMP8:%.*]] = shl i64 [[N_VEC]], 3
; CHECK-NEXT:    [[TMP9:%.*]] = getelementptr i8, ptr [[PA]], i64 [[TMP8]]
; CHECK-NEXT:    [[TMP10:%.*]] = getelementptr i8, ptr [[PB]], i64 [[TMP8]]
; CHECK-NEXT:    br label [[VECTOR_BODY:%.*]]
; CHECK:       vector.body:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, [[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], [[VECTOR_BODY]] ]
