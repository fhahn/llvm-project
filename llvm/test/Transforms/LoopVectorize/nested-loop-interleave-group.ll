; CHECK-NEXT:    [[NEXT_GEP:%.*]] = getelementptr i8, ptr [[PA]], i64 [[TMP11]]
; CHECK-NEXT:    [[TMP12:%.*]] = getelementptr inbounds float, ptr [[ROW]], i64 [[INDEX]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x float>, ptr [[TMP12]], align 4, !alias.scope [[META0:![0-9]+]]
; CHECK-NEXT:    [[TMP13:%.*]] = fmul <4 x float> [[WIDE_LOAD]], splat (float 2.000000e+00)
; CHECK-NEXT:    [[TMP14:%.*]] = fmul <4 x float> [[WIDE_LOAD]], splat (float 3.000000e+00)
; CHECK-NEXT:    [[TMP15:%.*]] = shufflevector <4 x float> [[TMP13]], <4 x float> [[TMP14]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[INTERLEAVED_VEC:%.*]] = shufflevector <8 x float> [[TMP15]], <8 x float> poison, <8 x i32> <i32 0, i32 4, i32 1, i32 5, i32 2, i32 6, i32 3, i32 7>
; CHECK-NEXT:    store <8 x float> [[INTERLEAVED_VEC]], ptr [[NEXT_GEP]], align 4, !alias.scope [[META3:![0-9]+]], !noalias [[META0]]
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[TMP16:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP16]], label [[MIDDLE_BLOCK:%.*]], label [[VECTOR_BODY]], !llvm.loop [[LOOP5:![0-9]+]]
; CHECK:       middle.block:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[WIDTH]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], label [[OUTER_LATCH]], label [[SCALAR_PH]]
; CHECK:       scalar.ph:
; CHECK-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i64 [ [[N_VEC]], [[MIDDLE_BLOCK]] ], [ 0, [[OUTER]] ], [ 0, [[VECTOR_MEMCHECK]] ]
; CHECK-NEXT:    [[BC_RESUME_VAL2:%.*]] = phi ptr [ [[TMP9]], [[MIDDLE_BLOCK]] ], [ [[PA]], [[OUTER]] ], [ [[PA]], [[VECTOR_MEMCHECK]] ]
; CHECK-NEXT:    [[BC_RESUME_VAL3:%.*]] = phi ptr [ [[TMP10]], [[MIDDLE_BLOCK]] ], [ [[PB]], [[OUTER]] ], [ [[PB]], [[VECTOR_MEMCHECK]] ]
; CHECK-NEXT:    br label [[INNER:%.*]]
; CHECK:       inner:
; CHECK-NEXT:    [[INNER_IV:%.*]] = phi i64 [ [[BC_RESUME_VAL]], [[SCALAR_PH]] ], [ [[INNER_IV_NEXT:%.*]], [[INNER]] ]
; CHECK-NEXT:    [[PA_INNER:%.*]] = phi ptr [ [[BC_RESUME_VAL2]], [[SCALAR_PH]] ], [ [[PA_NEXT:%.*]], [[INNER]] ]
; CHECK-NEXT:    [[PB_INNER:%.*]] = phi ptr [ [[BC_RESUME_VAL3]], [[SCALAR_PH]] ], [ [[PB_NEXT:%.*]], [[INNER]] ]
; CHECK-NEXT:    [[GEP_SRC:%.*]] = getelementptr inbounds float, ptr [[ROW]], i64 [[INNER_IV]]
; CHECK-NEXT:    [[LD:%.*]] = load float, ptr [[GEP_SRC]], align 4
; CHECK-NEXT:    [[MUL_A:%.*]] = fmul float [[LD]], 2.000000e+00
; CHECK-NEXT:    store float [[MUL_A]], ptr [[PA_INNER]], align 4
; CHECK-NEXT:    [[MUL_B:%.*]] = fmul float [[LD]], 3.000000e+00
; CHECK-NEXT:    store float [[MUL_B]], ptr [[PB_INNER]], align 4
; CHECK-NEXT:    [[PA_NEXT]] = getelementptr inbounds nuw i8, ptr [[PA_INNER]], i64 8
; CHECK-NEXT:    [[PB_NEXT]] = getelementptr inbounds nuw i8, ptr [[PB_INNER]], i64 8
; CHECK-NEXT:    [[INNER_IV_NEXT]] = add nuw nsw i64 [[INNER_IV]], 1
; CHECK-NEXT:    [[INNER_EC:%.*]] = icmp eq i64 [[INNER_IV_NEXT]], [[WIDTH]]
; CHECK-NEXT:    br i1 [[INNER_EC]], label [[OUTER_LATCH]], label [[INNER]], !llvm.loop [[LOOP8:![0-9]+]]
; CHECK:       outer.latch:
; CHECK-NEXT:    [[PA_NEXT_LCSSA]] = phi ptr [ [[PA_NEXT]], [[INNER]] ], [ [[TMP9]], [[MIDDLE_BLOCK]] ]
; CHECK-NEXT:    [[PB_NEXT_LCSSA]] = phi ptr [ [[PB_NEXT]], [[INNER]] ], [ [[TMP10]], [[MIDDLE_BLOCK]] ]
; CHECK-NEXT:    [[OUTER_IV_NEXT]] = add nuw nsw i64 [[OUTER_IV]], 1
; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp eq i64 [[OUTER_IV_NEXT]], [[HEIGHT]]
; CHECK-NEXT:    br i1 [[OUTER_EC]], label [[EXIT_LOOPEXIT:%.*]], label [[OUTER]]
; CHECK:       exit.loopexit:
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  %dst.1 = getelementptr inbounds nuw i8, ptr %dst, i64 4
  %width.pos = icmp ne i64 %width, 0
  %height.pos = icmp ne i64 %height, 0
  %guard = and i1 %width.pos, %height.pos
  br i1 %guard, label %outer.ph, label %exit

outer.ph:
  br label %outer

outer:
  %outer.iv = phi i64 [ 0, %outer.ph ], [ %outer.iv.next, %outer.latch ]
  %pA = phi ptr [ %dst, %outer.ph ], [ %pA.next.lcssa, %outer.latch ]
  %pB = phi ptr [ %dst.1, %outer.ph ], [ %pB.next.lcssa, %outer.latch ]
  %row = getelementptr inbounds float, ptr %src, i64 %outer.iv
  br label %inner

inner:
  %inner.iv = phi i64 [ 0, %outer ], [ %inner.iv.next, %inner ]
  %pA.inner = phi ptr [ %pA, %outer ], [ %pA.next, %inner ]
  %pB.inner = phi ptr [ %pB, %outer ], [ %pB.next, %inner ]
  %gep.src = getelementptr inbounds float, ptr %row, i64 %inner.iv
  %ld = load float, ptr %gep.src, align 4
  %mul.a = fmul float %ld, 2.000000e+00
  store float %mul.a, ptr %pA.inner, align 4
  %mul.b = fmul float %ld, 3.000000e+00
  store float %mul.b, ptr %pB.inner, align 4
  %pA.next = getelementptr inbounds nuw i8, ptr %pA.inner, i64 8
  %pB.next = getelementptr inbounds nuw i8, ptr %pB.inner, i64 8
  %inner.iv.next = add nuw nsw i64 %inner.iv, 1
  %inner.ec = icmp eq i64 %inner.iv.next, %width
  br i1 %inner.ec, label %outer.latch, label %inner

outer.latch:
  %pA.next.lcssa = phi ptr [ %pA.next, %inner ]
  %pB.next.lcssa = phi ptr [ %pB.next, %inner ]
  %outer.iv.next = add nuw nsw i64 %outer.iv, 1
  %outer.ec = icmp eq i64 %outer.iv.next, %height
  br i1 %outer.ec, label %exit, label %outer

exit:
  ret void
}
