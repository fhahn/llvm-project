; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=1 \
; RUN:   -scalable-vectorization=on -force-target-supports-scalable-vectors -S %s | FileCheck %s

target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"

; Check the estimated trip count assigned to the scalar remainder loop when the
; vector step is scalable. The exact step is not known at compile time, so the
; estimated value of vscale is used, that is a step of 4 x 1 = 4, matching the
; estimated trip count of the vector loop and the branch weights of the middle
; block.

; The trip count leaves a remainder of 1027 % 4 = 3 iterations for every
; power-of-two vscale, so the remainder loop runs 3 iterations rather than half
; a step. The estimates add up: 256 * 4 + 3 = 1027.
define void @constant_tc_residue(ptr noalias %p) !prof !0 {
; CHECK-LABEL: define void @constant_tc_residue(
; CHECK-SAME: ptr noalias [[P:%.*]]) !prof [[PROF0:![0-9]+]] {
; CHECK:    br i1 [[MIN_ITERS_CHECK:%.*]], [[SCALAR_PH:label %.*]], [[VECTOR_PH:label %.*]], !prof [[PROF1:![0-9]+]]
; CHECK:    br i1 [[TMP5:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF2:![0-9]+]], !llvm.loop [[LOOP3:![0-9]+]]
; CHECK:    br i1 [[CMP_N:%.*]], [[EXIT:label %.*]], [[SCALAR_PH]], !prof [[PROF7:![0-9]+]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT]], [[LOOP:label %.*]], !prof [[PROF8:![0-9]+]], !llvm.loop [[LOOP9:![0-9]+]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i64 %iv
  %l = load i32, ptr %gep, align 4
  %add = add i32 %l, 1
  store i32 %add, ptr %gep, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 1027
  br i1 %ec, label %exit, label %loop, !prof !1

exit:
  ret void
}

; The trip count is a multiple of the step for every power-of-two vscale, so the
; remainder loop is estimated to run zero iterations rather than half a step,
; even though it cannot be proven unreachable and is not removed.
define void @constant_tc_multiple_of_step(ptr noalias %p) !prof !0 {
; CHECK-LABEL: define void @constant_tc_multiple_of_step(
; CHECK-SAME: ptr noalias [[P:%.*]]) !prof [[PROF0]] {
; CHECK:    br i1 [[MIN_ITERS_CHECK:%.*]], [[SCALAR_PH:label %.*]], [[VECTOR_PH:label %.*]], !prof [[PROF1]]
; CHECK:    br i1 [[TMP5:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF2]], !llvm.loop [[LOOP11:![0-9]+]]
; CHECK:    br i1 [[CMP_N:%.*]], [[EXIT:label %.*]], [[SCALAR_PH]], !prof [[PROF7]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT]], [[LOOP:label %.*]], !prof [[PROF12:![0-9]+]], !llvm.loop [[LOOP13:![0-9]+]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i64 %iv
  %l = load i32, ptr %gep, align 4
  %add = add i32 %l, 1
  store i32 %add, ptr %gep, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 1024
  br i1 %ec, label %exit, label %loop, !prof !1

exit:
  ret void
}

; Negative control: the trip count is unknown, so no remainder can be derived
; from it and the remainder loop runs half a step (4 / 2 = 2) on average.
define void @unknown_tc(ptr noalias %p, i64 %n) !prof !0 {
; CHECK-LABEL: define void @unknown_tc(
; CHECK-SAME: ptr noalias [[P:%.*]], i64 [[N:%.*]]) !prof [[PROF0]] {
; CHECK:    br i1 [[MIN_ITERS_CHECK:%.*]], [[SCALAR_PH:label %.*]], [[VECTOR_PH:label %.*]], !prof [[PROF1]]
; CHECK:    br i1 [[TMP5:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF2]], !llvm.loop [[LOOP15:![0-9]+]]
; CHECK:    br i1 [[CMP_N:%.*]], [[EXIT:label %.*]], [[SCALAR_PH]], !prof [[PROF7]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT]], [[LOOP:label %.*]], !prof [[PROF12]], !llvm.loop [[LOOP16:![0-9]+]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i64 %iv
  %l = load i32, ptr %gep, align 4
  %add = add i32 %l, 1
  store i32 %add, ptr %gep, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop, !prof !1

exit:
  ret void
}

