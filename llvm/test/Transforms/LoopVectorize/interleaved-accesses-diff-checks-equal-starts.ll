entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %sum = phi i8 [ 0, %entry ], [ %sum.next, %loop ]
  %gep.src.1 = getelementptr inbounds [2 x i8], ptr %src, i64 %iv, i64 1
