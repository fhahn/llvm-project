entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %sum = phi i64 [ 0, %entry ], [ %sum.next, %loop ]
  %gep.src.1 = getelementptr inbounds [2 x i64], ptr %src, i64 %iv, i64 1
  %l.1 = load i64, ptr %gep.src.1, align 8
  %gep.dst = getelementptr inbounds x86_fp80, ptr %dst, i64 %iv
  store x86_fp80 0xK00000000000000000000, ptr %gep.dst, align 16
  %gep.src.0 = getelementptr inbounds [2 x i64], ptr %src, i64 %iv, i64 0
  %l.0 = load i64, ptr %gep.src.0, align 8
  %add = add i64 %l.0, %l.1
  %sum.next = add i64 %sum, %add
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret i64 %sum.next
}

