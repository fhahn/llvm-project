; CHECK-NEXT:    [[WIDE_VEC:%.*]] = load <8 x i8>, ptr [[TMP11]], align 1
; CHECK-NEXT:    [[STRIDED_VEC:%.*]] = shufflevector <8 x i8> [[WIDE_VEC]], <8 x i8> poison, <4 x i32> <i32 0, i32 2, i32 4, i32 6>
; CHECK-NEXT:    [[TMP12:%.*]] = getelementptr inbounds [2 x i8], ptr [[DST]], i64 [[INDEX]], i64 0
; CHECK-NEXT:    [[TMP13:%.*]] = getelementptr inbounds [2 x i8], ptr [[DST]], i64 [[TMP8]], i64 0
; CHECK-NEXT:    [[TMP14:%.*]] = getelementptr inbounds [2 x i8], ptr [[DST]], i64 [[TMP9]], i64 0
