target datalayout = "e-p:32:32-p1:64:64-i64:64"

; Runtime checks between interleave groups with 32-bit pointers and a
; scalable VF.
; for (i = 0; i < n; i++) {
;   x = a[2 * i]; y = a[2 * i + 1];
;   b[2 * i] = x + y;
;   b[2 * i + 1] = x - y;
; }
; With VF = vscale x 4 and IC = 2, a vector iteration accesses 64 * vscale
; bytes of each array. A check of the distance between the arrays compares it
; against 2 * 64 * vscale - 1, which fits in 32 bits iff vscale <= 2^25.
define void @max_vscale_2_to_25(ptr %a, ptr %b, i32 %n) vscale_range(1, 33554432) {
; CHECK-LABEL: define void @max_vscale_2_to_25(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i32 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = call i32 @llvm.vscale.i32()
; CHECK-NEXT:    [[TMP1:%.*]] = shl nuw i32 [[TMP0]], 3
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i32 [[N]], [[TMP1]]
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], [[SCALAR_PH:label %.*]], label %[[VECTOR_MEMCHECK:.*]]
; CHECK:       [[VECTOR_MEMCHECK]]:
; CHECK-NEXT:    [[TMP2:%.*]] = shl i32 [[N]], 3
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr i8, ptr [[B]], i32 [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = getelementptr i8, ptr [[A]], i32 [[TMP2]]
; CHECK-NEXT:    [[BOUND0:%.*]] = icmp ult ptr [[B]], [[TMP4]]
; CHECK-NEXT:    [[BOUND1:%.*]] = icmp ult ptr [[A]], [[TMP3]]
; CHECK-NEXT:    [[FOUND_CONFLICT:%.*]] = and i1 [[BOUND0]], [[BOUND1]]
; CHECK-NEXT:    br i1 [[FOUND_CONFLICT]], [[SCALAR_PH]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %idx.0 = shl nuw nsw i32 %iv, 1
  %idx.1 = or disjoint i32 %idx.0, 1
  %gep.a.0 = getelementptr inbounds i32, ptr %a, i32 %idx.0
  %x = load i32, ptr %gep.a.0, align 4
  %gep.a.1 = getelementptr inbounds i32, ptr %a, i32 %idx.1
  %y = load i32, ptr %gep.a.1, align 4
  %add = add i32 %x, %y
  %sub = sub i32 %x, %y
  %gep.b.0 = getelementptr inbounds i32, ptr %b, i32 %idx.0
  store i32 %add, ptr %gep.b.0, align 4
  %gep.b.1 = getelementptr inbounds i32, ptr %b, i32 %idx.1
  store i32 %sub, ptr %gep.b.1, align 4
  %iv.next = add nuw nsw i32 %iv, 1
  %ec = icmp eq i32 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

