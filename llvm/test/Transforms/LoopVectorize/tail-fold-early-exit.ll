entry:
  %bounded = icmp ule i64 %n, 64
  call void @llvm.assume(i1 %bounded)
  %empty = icmp eq i64 %n, 0
  br i1 %empty, label %count.exit, label %preheader

preheader:
  br label %header

header:
  %iv = phi i64 [ 0, %preheader ], [ %iv.next, %latch ]
  %ptr = getelementptr i32, ptr %p, i64 %iv
  %x = load i32, ptr %ptr, align 4
  %negative = icmp slt i32 %x, 0
  br i1 %negative, label %check.a, label %check.b

check.a:
  %a = add nsw i32 %x, 7
  %hit.a = icmp eq i32 %x, -9
  br i1 %hit.a, label %exit.a, label %latch

check.b:
  %b = mul nsw i32 %x, 2
  %hit.b = icmp eq i32 %x, 19
  br i1 %hit.b, label %exit.b, label %latch

latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %done = icmp eq i64 %iv.next, %n
  br i1 %done, label %count.exit, label %header

exit.a:
  %a.lcssa = phi i32 [ %a, %check.a ]
  ret i32 %a.lcssa

exit.b:
  %b.lcssa = phi i32 [ %b, %check.b ]
  ret i32 %b.lcssa

count.exit:
  ret i32 0
}

