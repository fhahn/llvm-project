; RUN: opt -passes=loop-vectorize -force-vector-width=8 \
; RUN:     -force-vector-interleave=1 -S %s | FileCheck %s

; Regression tests for loop-vectorizer crashes/miscompiles when a vector
; function ABI variant declaration disagrees with the demangled VFShape.
; All cases must reject the malformed variant and fall back to scalarized
; predicated calls.

; Masked variant declaration omits the trailing mask parameter (arg count
; mismatch). The mask would otherwise be silently dropped.
define void @masked_variant_missing_mask_param(ptr %a) {
; CHECK-LABEL: define void @masked_variant_missing_mask_param(
; CHECK-NOT: call {{.*}}@fixed_vec_fn2
; CHECK: vector.body:
; CHECK: pred.call.if:
; CHECK:   tail call { float, float } @fn2(
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep = getelementptr inbounds float, ptr %a, i64 %iv
  %l = load float, ptr %gep, align 4
  %cmp = fcmp ogt float %l, 0.0
  br i1 %cmp, label %then, label %loop.latch

then:
  %call = tail call { float, float } @fn2(float %l) #0
  %x = extractvalue { float, float } %call, 0
  %div = fdiv float %x, %l
  store float %div, ptr %gep, align 4
  br label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 1024
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

