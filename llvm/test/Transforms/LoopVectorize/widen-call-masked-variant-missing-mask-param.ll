declare { float, float } @fn2(float)

; Intentionally malformed: masked variant _ZGVnM8v_fn2 should take a mask
; operand, but this declaration has only the vector parameter.
declare { <8 x float>, <8 x float> } @fixed_vec_fn2(<8 x float>)

; Intentionally malformed: trailing parameter type is <8 x float> instead of
; the required <8 x i1> mask type.
declare { <8 x float>, <8 x float> } @fixed_vec_fn2_bad_mask(<8 x float>, <8 x float>)

