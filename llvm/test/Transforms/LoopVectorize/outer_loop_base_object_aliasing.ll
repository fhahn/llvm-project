; CHECK-NEXT:    [[ACC:%.*]] = phi float [ [[PREV]], %[[INNER_PH]] ], [ [[NACC:%.*]], %[[INNER_BODY]] ]
; CHECK-NEXT:    [[BP:%.*]] = getelementptr inbounds float, ptr [[B]], i64 [[J]]
; CHECK-NEXT:    [[BV:%.*]] = load float, ptr [[BP]], align 4
; CHECK-NEXT:    [[NACC]] = fadd float [[ACC]], [[BV]]
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
