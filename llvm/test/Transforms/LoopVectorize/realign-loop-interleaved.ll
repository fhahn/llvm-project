; CHECK-NEXT:    [[GEP_SRC1:%.*]] = getelementptr inbounds i32, ptr [[SRC]], i64 [[IV1]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[GEP_SRC1]], align 4
; CHECK-NEXT:    [[INC:%.*]] = add i32 [[V]], 1
