; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 4
; RUN: opt -S < %s -p loop-vectorize -force-vector-width=4 -enable-early-exit-vectorization | FileCheck %s

declare void @init_mem(ptr, i64)

; Test that rotated early exit loops (where the latch has the uncountable exit)
; are properly vectorized. The loads in the latch block should be widened and
; the early exit condition should use vector operations.
define i64 @rotated_early_exit_vectorized_loads() {
; CHECK-LABEL: define i64 @rotated_early_exit_vectorized_loads() {
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[P1:%.*]] = alloca [1024 x i8], align 1
; CHECK-NEXT:    [[P2:%.*]] = alloca [1024 x i8], align 1
; CHECK-NEXT:    call void @init_mem(ptr [[P1]], i64 1024)
; CHECK-NEXT:    call void @init_mem(ptr [[P2]], i64 1024)
; CHECK-NEXT:    br label [[VECTOR_BODY1:%.*]]
; CHECK:       loop.header:
; CHECK-NEXT:    [[INDEX1:%.*]] = phi i64 [ [[INDEX_NEXT:%.*]], [[LOOP_BODY:%.*]] ], [ 0, [[ENTRY:%.*]] ]
; CHECK-NEXT:    [[INDEX_NEXT]] = add i64 [[INDEX1]], 1
; CHECK-NEXT:    [[EXITCOND:%.*]] = icmp ne i64 [[INDEX_NEXT]], 64
; CHECK-NEXT:    br i1 [[EXITCOND]], label [[LOOP_BODY]], label [[LOOP_END:%.*]]
; CHECK:       loop.body:
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr inbounds i8, ptr [[P1]], i64 [[INDEX1]]
; CHECK-NEXT:    [[LD1:%.*]] = load i8, ptr [[TMP0]], align 1
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds i8, ptr [[P2]], i64 [[INDEX1]]
; CHECK-NEXT:    [[LD2:%.*]] = load i8, ptr [[TMP1]], align 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i8 [[LD1]], [[LD2]]
; CHECK-NEXT:    br i1 [[CMP]], label [[LOOP_END]], label [[VECTOR_BODY1]]
; CHECK:       loop.end:
; CHECK-NEXT:    [[RETVAL:%.*]] = phi i64 [ 64, [[VECTOR_BODY1]] ], [ [[INDEX1]], [[LOOP_BODY]] ]
; CHECK-NEXT:    ret i64 [[RETVAL]]
;
entry:
  %p1 = alloca [1024 x i8]
  %p2 = alloca [1024 x i8]
  call void @init_mem(ptr %p1, i64 1024)
  call void @init_mem(ptr %p2, i64 1024)
  br label %loop.header

; The header has the countable exit
loop.header:
  %index = phi i64 [ %index.next, %loop.body ], [ 0, %entry ]
  %index.next = add i64 %index, 1
  %exitcond = icmp ne i64 %index.next, 64
  br i1 %exitcond, label %loop.body, label %loop.end

; The latch has the uncountable (early) exit - this is the "rotated" case
loop.body:
  %gep1 = getelementptr inbounds i8, ptr %p1, i64 %index
  %ld1 = load i8, ptr %gep1, align 1
  %gep2 = getelementptr inbounds i8, ptr %p2, i64 %index
  %ld2 = load i8, ptr %gep2, align 1
  %cmp = icmp eq i8 %ld1, %ld2
  br i1 %cmp, label %loop.end, label %loop.header

loop.end:
  %retval = phi i64 [ 64, %loop.header ], [ %index, %loop.body ]
  ret i64 %retval
}

