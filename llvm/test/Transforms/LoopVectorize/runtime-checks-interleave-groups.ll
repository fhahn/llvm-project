  br label %outer.loop

outer.loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %inner.exit ]
  %row = mul nuw nsw i64 %i, %n
  br label %inner.loop

inner.loop:
  %j = phi i64 [ 0, %outer.loop ], [ %j.next, %inner.loop ]
  %idx = add nuw nsw i64 %row, %j
  %gep.src = getelementptr inbounds i64, ptr %src, i64 %idx
  %l = load i32, ptr %gep.src, align 4
  %ext = sext i32 %l to i64
  %gep.dst = getelementptr inbounds i64, ptr %dst, i64 %idx
  store i64 %ext, ptr %gep.dst, align 8
  %j.next = add nuw nsw i64 %j, 1
  %inner.ec = icmp eq i64 %j.next, %n
  br i1 %inner.ec, label %inner.exit, label %inner.loop

inner.exit:
  %i.next = add nuw nsw i64 %i, 1
  %outer.ec = icmp eq i64 %i.next, %m
  br i1 %outer.ec, label %exit, label %outer.loop

exit:
  ret void
}

; The distance between a and a + k is unknown, so each access is in its own
; checking group, and the check between the stores to a[2 * i] and
; a[2 * i + 1] always fails.
; for (i = 0; i < n; i++) {
;   x = a[k + 2 * i];
;   a[2 * i] = x;
;   a[2 * i + 1] = x + 1;
; }
define void @store_pair_check_always_fails(ptr %a, i64 %k, i64 %n) {
; CHECK-LABEL: define void @store_pair_check_always_fails(
; CHECK-SAME: ptr [[A:%.*]], i64 [[K:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[A_K:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[K]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[IDX_0:%.*]] = shl nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[IDX_1:%.*]] = or disjoint i64 [[IDX_0]], 1
; CHECK-NEXT:    [[GEP_A_K:%.*]] = getelementptr inbounds i32, ptr [[A_K]], i64 [[IDX_0]]
; CHECK-NEXT:    [[X:%.*]] = load i32, ptr [[GEP_A_K]], align 4
; CHECK-NEXT:    [[GEP_A_0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IDX_0]]
; CHECK-NEXT:    store i32 [[X]], ptr [[GEP_A_0]], align 4
; CHECK-NEXT:    [[ADD:%.*]] = add i32 [[X]], 1
; CHECK-NEXT:    [[GEP_A_1:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IDX_1]]
; CHECK-NEXT:    store i32 [[ADD]], ptr [[GEP_A_1]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %a.k = getelementptr inbounds i32, ptr %a, i64 %k
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %idx.0 = shl nuw nsw i64 %iv, 1
  %idx.1 = or disjoint i64 %idx.0, 1
  %gep.a.k = getelementptr inbounds i32, ptr %a.k, i64 %idx.0
  %x = load i32, ptr %gep.a.k, align 4
  %gep.a.0 = getelementptr inbounds i32, ptr %a, i64 %idx.0
  store i32 %x, ptr %gep.a.0, align 4
  %add = add i32 %x, 1
  %gep.a.1 = getelementptr inbounds i32, ptr %a, i64 %idx.1
  store i32 %add, ptr %gep.a.1, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
