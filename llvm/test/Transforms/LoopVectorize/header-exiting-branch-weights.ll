; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter "br i1|!prof|estimated_trip_count" --version 6
; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=1 -S %s | FileCheck %s

; The weights of a loop exiting somewhere other than its latch are just as usable
; as a latch's, they are only in a different place: the branch stays in the loop
; once per iteration and leaves it once per invocation, so the estimated trip
; count is the plain ratio of its weights rather than one more than it.
; With an estimate the vector loop's latch and the branch bypassing it get real
; weights instead of being marked unknown.
define void @header_exiting(ptr %p, i32 %n) !prof !0 {
; CHECK-LABEL: define void @header_exiting(
; CHECK-SAME: ptr [[P:%.*]], i32 [[N:%.*]]) !prof [[PROF0:![0-9]+]] {
; CHECK:    br i1 [[MIN_ITERS_CHECK:%.*]], [[SCALAR_PH:label %.*]], [[VECTOR_PH:label %.*]], !prof [[PROF1:![0-9]+]]
; CHECK:    [[TMP4:%.*]] = select i1 [[TMP3:%.*]], i32 4, i32 [[TMP2:%.*]], !prof [[PROF2:![0-9]+]]
; CHECK:    br i1 [[TMP7:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF3:![0-9]+]], !llvm.loop [[LOOP4:![0-9]+]]
; CHECK:    br i1 [[EC:%.*]], [[LOOP_LATCH:label %.*]], [[EXIT:label %.*]], !prof [[PROF8:![0-9]+]]
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %ec = icmp slt i32 %iv, %n
  br i1 %ec, label %loop.latch, label %exit, !prof !1

loop.latch:
  %idx = sext i32 %iv to i64
  %gep = getelementptr inbounds i16, ptr %p, i64 %idx
  store i16 0, ptr %gep, align 2
  %iv.next = add nsw i32 %iv, 1
  br label %loop.header

exit:
  ret void
}

!0 = !{!"function_entry_count", i64 1000}
!1 = !{!"branch_weights", i32 100, i32 1}
;.
