; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=1 -S %s | FileCheck %s

; Widening the group bounds to the outer loop for hoisting can make *every*
; runtime check pair provably disjoint. No runtime check must be emitted then,
; and the loop must still be vectorized.
%struct.t = type { [64 x i32], [32 x i32], [32 x [64 x i32]] }

define void @all_check_pairs_known_disjoint(ptr %obj) {
; CHECK-LABEL: define void @all_check_pairs_known_disjoint(
; CHECK-SAME: ptr [[OBJ:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER_PH:.*]]
; CHECK:       [[OUTER_PH]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[P2:%.*]] = getelementptr inbounds [[STRUCT_T:%.*]], ptr [[OBJ]], i64 0, i32 1, i64 [[I]]
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[TMP0:%.*]] = load i32, ptr [[P2]], align 4, !alias.scope [[META0:![0-9]+]]
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i32> poison, i32 [[TMP0]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i32> [[BROADCAST_SPLATINSERT]], <4 x i32> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds [[STRUCT_T]], ptr [[OBJ]], i64 0, i32 0, i64 [[INDEX]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP1]], align 4, !alias.scope [[META3:![0-9]+]]
; CHECK-NEXT:    [[TMP2:%.*]] = add nsw <4 x i32> [[BROADCAST_SPLAT]], [[WIDE_LOAD]]
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr inbounds [[STRUCT_T]], ptr [[OBJ]], i64 0, i32 2, i64 [[I]], i64 [[INDEX]]
; CHECK-NEXT:    [[WIDE_LOAD1:%.*]] = load <4 x i32>, ptr [[TMP3]], align 4, !alias.scope [[META5:![0-9]+]], !noalias [[META7:![0-9]+]]
; CHECK-NEXT:    [[TMP4:%.*]] = add nsw <4 x i32> [[TMP2]], [[WIDE_LOAD1]]
; CHECK-NEXT:    store <4 x i32> [[TMP4]], ptr [[TMP3]], align 4, !alias.scope [[META5]], !noalias [[META7]]
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[TMP5:%.*]] = icmp eq i64 [[INDEX_NEXT]], 64
; CHECK-NEXT:    br i1 [[TMP5]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP8:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[ECO:%.*]] = icmp eq i64 [[I_NEXT]], 32
; CHECK-NEXT:    br i1 [[ECO]], label %[[EXIT:.*]], label %[[OUTER_PH]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer.ph

outer.ph:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  %p2 = getelementptr inbounds %struct.t, ptr %obj, i64 0, i32 1, i64 %i
  br label %inner

inner:
  %j = phi i64 [ 0, %outer.ph ], [ %j.next, %inner ]
  %p1 = getelementptr inbounds %struct.t, ptr %obj, i64 0, i32 0, i64 %j
  %v1 = load i32, ptr %p1
  %v2 = load i32, ptr %p2
  %s = add nsw i32 %v2, %v1
  %p3 = getelementptr inbounds %struct.t, ptr %obj, i64 0, i32 2, i64 %i, i64 %j
  %v3 = load i32, ptr %p3
  %s2 = add nsw i32 %s, %v3
  store i32 %s2, ptr %p3
  %j.next = add nuw nsw i64 %j, 1
  %ec = icmp eq i64 %j.next, 64
  br i1 %ec, label %outer.latch, label %inner

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %eco = icmp eq i64 %i.next, 32
  br i1 %eco, label %exit, label %outer.ph

exit:
  ret void
}
;.
