; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i32, ptr [[SRC]], i64 [[IV]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    [[IS_ZERO:%.*]] = icmp eq i32 [[V]], 0
; CHECK-NEXT:    br i1 [[IS_ZERO]], label %[[EARLY_EXIT:.*]], label %[[LATCH]]
