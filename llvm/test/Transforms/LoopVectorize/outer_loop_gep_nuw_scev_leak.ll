; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --filter "getelementptr" --filter "A,\+,|B,\+,|A\),\+," --version 6
; RUN: opt -disable-output -passes='print<scalar-evolution>' < %s 2>&1 | FileCheck %s --check-prefix=BEFORE
; RUN: opt -disable-output -passes='loop-vectorize,print<scalar-evolution>' -enable-vplan-native-path < %s 2>&1 | FileCheck %s --check-prefix=AFTER

; Check that outer-loop vectorization does not leak an unjustified <nuw> onto
; the GEP address SCEVs. loop-vectorize preserves ScalarEvolution, so any
; nowrap flag the VPlan analysis forwards onto a getelementptr's SCEV stays
; visible afterwards. The checks are filtered to the getelementptr address
; expressions only: compare the BEFORE (plain SCEV) and AFTER (post
; loop-vectorize SCEV) flags on each pointer recurrence. A flag that appears
; in AFTER but not BEFORE is a leak.
;
; The AFTER addresses differ from BEFORE only in their Start term (the scalar
; remainder loop resumes from %bc.resume.val while the outer loop is
; vectorized); the recurrence step and, crucially, the nowrap flags must
; match.

define void @cond_inbounds(ptr noalias %A, ptr noalias %B, i64 %N, i64 %M,
; BEFORE-LABEL: 'cond_inbounds'
; BEFORE:    %sp = getelementptr float, ptr %A, i64 %i
; BEFORE:    --> {%A,+,4}<%outer.header> U: full-set S: full-set Exits: (-4 + (4 * %N) + %A) LoopDispositions: { %outer.header: Computable, %inner.body: Invariant }
; BEFORE:    %cp = getelementptr inbounds float, ptr %A, i64 %i
; BEFORE:    --> {%A,+,4}<%outer.header> U: full-set S: full-set Exits: (-4 + (4 * %N) + %A) LoopDispositions: { %outer.header: Computable, %inner.body: Invariant }
; BEFORE:    %bp = getelementptr inbounds float, ptr %B, i64 %j
; BEFORE:    --> {%B,+,4}<nuw><%inner.body> U: full-set S: full-set Exits: (-4 + (4 * %M) + %B) LoopDispositions: { %inner.body: Computable, %outer.header: Uniform }
;
; AFTER-LABEL: 'cond_inbounds'
; AFTER:    %sp = getelementptr float, ptr %A, i64 %i
; AFTER:    --> {((4 * %bc.resume.val) + %A),+,4}<%outer.header> U: full-set S: full-set Exits: (-4 + (4 * %N) + %A) LoopDispositions: { %outer.header: Computable, %inner.body: Invariant }
; AFTER:    %cp = getelementptr inbounds float, ptr %A, i64 %i
; AFTER:    --> {((4 * %bc.resume.val) + %A),+,4}<%outer.header> U: full-set S: full-set Exits: (-4 + (4 * %N) + %A) LoopDispositions: { %outer.header: Computable, %inner.body: Invariant }
; AFTER:    %bp = getelementptr inbounds float, ptr %B, i64 %j
; AFTER:    --> {%B,+,4}<nuw><%inner.body> U: full-set S: full-set Exits: (-4 + (4 * %M) + %B) LoopDispositions: { %inner.body: Computable, %outer.header: Uniform }
;
                           i1 %cond) {
entry:
  %co = icmp sgt i64 %N, 0
  br i1 %co, label %outer.ph, label %exit

outer.ph:
  %ci = icmp sgt i64 %M, 0
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  ; Non-inbounds store A[i]: its address could wrap across outer iterations.
  %sp = getelementptr float, ptr %A, i64 %i
  store float 3.000000e+00, ptr %sp, align 4
  br i1 %cond, label %cond.bb, label %outer.mid

cond.bb:
  ; Conditionally-executed inbounds GEP: must not forward inbounds->nuw.
  %cp = getelementptr inbounds float, ptr %A, i64 %i
  %v = load float, ptr %cp, align 4
  br label %outer.mid

outer.mid:
  br i1 %ci, label %inner.ph, label %outer.latch

inner.ph:
  br label %inner.body

inner.body:
  %j = phi i64 [ 0, %inner.ph ], [ %j.next, %inner.body ]
  %bp = getelementptr inbounds float, ptr %B, i64 %j
  %bv = load float, ptr %bp, align 4
  %j.next = add nuw nsw i64 %j, 1
  %jc = icmp eq i64 %j.next, %M
  br i1 %jc, label %outer.latch, label %inner.body

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %ic = icmp eq i64 %i.next, %N
  br i1 %ic, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

define void @uncond_inbounds(ptr noalias %A, ptr noalias %B, i64 %N, i64 %M) {
; BEFORE-LABEL: 'uncond_inbounds'
; BEFORE:    %gep = getelementptr inbounds float, ptr %A, i64 %i
; BEFORE:    --> {%A,+,4}<nuw><%outer.header> U: full-set S: full-set Exits: (-4 + (4 * %N) + %A) LoopDispositions: { %outer.header: Computable, %inner.body: Invariant }
; BEFORE:    %bp = getelementptr inbounds float, ptr %B, i64 %j
; BEFORE:    --> {%B,+,4}<nuw><%inner.body> U: full-set S: full-set Exits: (-4 + (4 * %M) + %B) LoopDispositions: { %inner.body: Computable, %outer.header: Uniform }
;
; AFTER-LABEL: 'uncond_inbounds'
; AFTER:    %gep = getelementptr inbounds float, ptr %A, i64 %i
; AFTER:    --> {((4 * %bc.resume.val) + %A),+,4}<%outer.header> U: full-set S: full-set Exits: (-4 + (4 * %N) + %A) LoopDispositions: { %outer.header: Computable, %inner.body: Invariant }
; AFTER:    %bp = getelementptr inbounds float, ptr %B, i64 %j
; AFTER:    --> {%B,+,4}<nuw><%inner.body> U: full-set S: full-set Exits: (-4 + (4 * %M) + %B) LoopDispositions: { %inner.body: Computable, %outer.header: Uniform }
;
entry:
  %co = icmp sgt i64 %N, 0
  br i1 %co, label %outer.ph, label %exit

outer.ph:
  %ci = icmp sgt i64 %M, 0
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  %gep = getelementptr inbounds float, ptr %A, i64 %i
  store float 0.000000e+00, ptr %gep, align 4
  br i1 %ci, label %inner.ph, label %outer.latch

inner.ph:
  br label %inner.body

inner.body:
  %j = phi i64 [ 0, %inner.ph ], [ %j.next, %inner.body ]
  %bp = getelementptr inbounds float, ptr %B, i64 %j
  %bv = load float, ptr %bp, align 4
  %cur = load float, ptr %gep, align 4
  %add = fadd float %cur, %bv
  store float %add, ptr %gep, align 4
  %j.next = add nuw nsw i64 %j, 1
  %jc = icmp eq i64 %j.next, %M
  br i1 %jc, label %outer.latch, label %inner.body

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %ic = icmp eq i64 %i.next, %N
  br i1 %ic, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

