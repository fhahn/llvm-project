; RUN: opt -disable-output -passes='print<scalar-evolution>' < %s 2>&1 | FileCheck %s --check-prefix=BEFORE
; RUN: opt -disable-output -passes='loop-vectorize,print<scalar-evolution>' -force-vector-width=4 -force-vector-interleave=1 < %s 2>&1 | FileCheck %s --check-prefix=AFTER

; Check the nowrap flags loop-vectorize forwards from a GEP onto its address
; SCEV. As loop-vectorize preserves ScalarEvolution, any flag forwarded by the
; VPlan analysis stays visible afterwards, so a flag that appears in AFTER but
; not in BEFORE must be justified for every iteration of the loop.

declare double @foo(double) #0
declare <4 x double> @foo_vec(<4 x double>)

; %merge dominates the latch and the only block the loop can be left from
; (%merge itself), so the access executes on every iteration that is entered and
; inbounds can be forwarded. IR's isSCEVExprNeverPoison cannot see through the
; diamond, hence BEFORE has no <nuw>.
define i64 @diamond_must_execute(ptr %src, i1 %c) {
; BEFORE-LABEL: 'diamond_must_execute'
; BEFORE:    %gep = getelementptr inbounds i64, ptr %src, i64 %iv
; BEFORE:    --> {%src,+,8}<nw><%header> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %header: Computable }
;
; AFTER-LABEL: 'diamond_must_execute'
; AFTER:    %gep = getelementptr inbounds i64, ptr %src, i64 %iv
; AFTER:    --> {%src,+,8}<nuw><%header> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %header: Computable }
;
entry:
  br label %header

header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  br i1 %c, label %if, label %else

if:
  br label %merge

else:
  br label %merge

merge:
  %gep = getelementptr inbounds i64, ptr %src, i64 %iv
  %ld = load i64, ptr %gep, align 8
  %early = icmp eq i64 %ld, 42
  br i1 %early, label %exit.early, label %latch

latch:
  %iv.next = add i64 %iv, 1
  %ec = icmp ne i64 %iv.next, 67
  br i1 %ec, label %header, label %exit

exit.early:
  ret i64 %iv

exit:
  ret i64 0
}

; The loop can be left from %header, before %guarded executes, so the access in
; %guarded does not execute on every iteration that is entered and its inbounds
; must not be forwarded.
define i64 @exit_before_access(ptr %src, ptr dereferenceable(1024) %p) {
; BEFORE-LABEL: 'exit_before_access'
; BEFORE:    %gep.p = getelementptr inbounds i8, ptr %p, i64 %iv
; BEFORE:    --> {%p,+,1}<nuw><%header> U: [1,-958) S: [1,-958) Exits: <<Unknown>> LoopDispositions: { %header: Computable }
; BEFORE:    %gep = getelementptr inbounds i64, ptr %src, i64 %iv
; BEFORE:    --> {%src,+,8}<nw><%header> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %header: Computable }
;
; AFTER-LABEL: 'exit_before_access'
; AFTER:    %gep.p = getelementptr inbounds i8, ptr %p, i64 %iv
; AFTER:    --> {%p,+,1}<nuw><%header> U: [1,-958) S: [1,-958) Exits: <<Unknown>> LoopDispositions: { %header: Computable }
; AFTER:    %gep = getelementptr inbounds i64, ptr %src, i64 %iv
; AFTER:    --> {%src,+,8}<nw><%header> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %header: Computable }
;
entry:
  br label %header

header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %gep.p = getelementptr inbounds i8, ptr %p, i64 %iv
  %ld.p = load i8, ptr %gep.p, align 1
  %early.p = icmp eq i8 %ld.p, 42
  br i1 %early.p, label %exit.early, label %guarded

guarded:
  %gep = getelementptr inbounds i64, ptr %src, i64 %iv
  %ld = load i64, ptr %gep, align 8
  %early = icmp eq i64 %ld, 7
  br i1 %early, label %exit.early, label %latch

latch:
  %iv.next = add i64 %iv, 1
  %ec = icmp ne i64 %iv.next, 67
  br i1 %ec, label %header, label %exit

exit.early:
  ret i64 %iv

exit:
  ret i64 0
}

; @foo is not willreturn, so execution is not guaranteed to reach the store and
; the inbounds of its address must not be forwarded. The address of the load
; before the call is not affected.
define void @call_may_not_return(ptr %dst, ptr %src) {
; BEFORE-LABEL: 'call_may_not_return'
; BEFORE:    %gep.src = getelementptr inbounds double, ptr %src, i64 %iv
; BEFORE:    --> {%src,+,8}<nuw><%loop> U: full-set S: full-set Exits: (7992 + %src) LoopDispositions: { %loop: Computable }
; BEFORE:    %gep.dst = getelementptr inbounds double, ptr %dst, i64 %iv
; BEFORE:    --> {%dst,+,8}<nw><%loop> U: full-set S: full-set Exits: (7992 + %dst) LoopDispositions: { %loop: Computable }
;
; AFTER-LABEL: 'call_may_not_return'
; AFTER:    %2 = getelementptr inbounds double, ptr %src, i64 %index
; AFTER:    --> {%src,+,32}<nuw><%vector.body> U: full-set S: full-set Exits: (7968 + %src) LoopDispositions: { %vector.body: Computable }
; AFTER:    %4 = getelementptr inbounds double, ptr %dst, i64 %index
; AFTER:    --> {%dst,+,32}<nw><%vector.body> U: full-set S: full-set Exits: (7968 + %dst) LoopDispositions: { %vector.body: Computable }
; AFTER:    %gep.src = getelementptr inbounds double, ptr %src, i64 %iv
; AFTER:    --> {%src,+,8}<nuw><%loop> U: full-set S: full-set Exits: (7992 + %src) LoopDispositions: { %loop: Computable }
; AFTER:    %gep.dst = getelementptr inbounds double, ptr %dst, i64 %iv
; AFTER:    --> {%dst,+,8}<nw><%loop> U: full-set S: full-set Exits: (7992 + %dst) LoopDispositions: { %loop: Computable }
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.src = getelementptr inbounds double, ptr %src, i64 %iv
  %l = load double, ptr %gep.src, align 8
  %call = call double @foo(double %l)
  %gep.dst = getelementptr inbounds double, ptr %dst, i64 %iv
  store double %call, ptr %gep.dst, align 8
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 1000
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

attributes #0 = { nounwind memory(none) "vector-function-abi-variant"="_ZGV_LLVM_N4v_foo(foo_vec)" }
