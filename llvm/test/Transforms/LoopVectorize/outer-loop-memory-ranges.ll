; Only the final inner-loop pointer is dereferenced. Earlier inbounds GEPs may
; be poison without making the scalar execution undefined. With B=A-1 this
; nest has a dependence, so treating the inner recurrence as a non-wrapping
; memory range would incorrectly admit vectorization.
define void @load_after_inner(ptr %A, ptr %B) {
; CHECK-LABEL: define void @load_after_inner(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    br label %[[INNER_BODY:.*]]
; CHECK:       [[INNER_BODY]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[OUTER_HEADER]] ], [ [[J_NEXT:%.*]], %[[INNER_BODY]] ]
; CHECK-NEXT:    [[J_SCALED:%.*]] = mul i64 [[J]], 9223372036854775807
; CHECK-NEXT:    [[IDX:%.*]] = add i64 [[I]], [[J_SCALED]]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i8, ptr [[A]], i64 [[IDX]]
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[J_CMP:%.*]] = icmp eq i64 [[J_NEXT]], 3
; CHECK-NEXT:    br i1 [[J_CMP]], label %[[OUTER_LATCH]], label %[[INNER_BODY]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[LAST_P:%.*]] = phi ptr [ [[P]], %[[INNER_BODY]] ]
; CHECK-NEXT:    [[V:%.*]] = load i8, ptr [[LAST_P]], align 1
; CHECK-NEXT:    [[NEG_I:%.*]] = sub i64 0, [[I]]
; CHECK-NEXT:    [[Q:%.*]] = getelementptr inbounds i8, ptr [[B]], i64 [[NEG_I]]
; CHECK-NEXT:    store i8 [[V]], ptr [[Q]], align 1
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[I_CMP:%.*]] = icmp eq i64 [[I_NEXT]], 4
; CHECK-NEXT:    br i1 [[I_CMP]], label %[[EXIT:.*]], label %[[OUTER_HEADER]], !llvm.loop [[LOOP0]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer.header
outer.header:
  %i = phi i64 [0, %entry], [%i.next, %outer.latch]
  br label %inner.body
inner.body:
  %j = phi i64 [0, %outer.header], [%j.next, %inner.body]
  %j.scaled = mul i64 %j, 9223372036854775807
  %idx = add i64 %i, %j.scaled
  %p = getelementptr inbounds i8, ptr %A, i64 %idx
  %j.next = add nuw nsw i64 %j, 1
  %j.cmp = icmp eq i64 %j.next, 3
  br i1 %j.cmp, label %outer.latch, label %inner.body
outer.latch:
  %last.p = phi ptr [%p, %inner.body]
  %v = load i8, ptr %last.p
  %neg.i = sub i64 0, %i
  %q = getelementptr inbounds i8, ptr %B, i64 %neg.i
  store i8 %v, ptr %q
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp eq i64 %i.next, 4
  br i1 %i.cmp, label %exit, label %outer.header, !llvm.loop !0
exit:
  ret void
}

