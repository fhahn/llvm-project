; CHECK-NEXT:      vp<[[VP7:%[0-9]+]]> = vector-pointer inbounds float, ir<%gep>, ir<1>
; CHECK-NEXT:      vp<[[VP8:%[0-9]+]]> = vector-pointer inbounds float, ir<%gep>, ir<1>, vp<[[VP6]]>
; CHECK-NEXT:      WIDEN ir<%l> = load vp<[[VP7]]>
; CHECK-NEXT:      WIDEN ir<%l>.1 = load vp<[[VP8]]>
; CHECK-NEXT:      REDUCE ir<%rdx.next> = ir<%rdx> +  reduce.fadd (ir<%l>)
; CHECK-NEXT:      REDUCE ir<%rdx.next>.1 = ir<%rdx.next> +  reduce.fadd (ir<%l>.1)
; CHECK-NEXT:      EMIT vp<%index.next> = add nuw vp<[[VP4]]>, vp<[[VP1]]>
; CHECK-NEXT:      EMIT branch-on-count vp<%index.next>, vp<[[VP2]]>
; CHECK-NEXT:    No successors
; CHECK-NEXT:  }
; CHECK-NEXT:  Successor(s): middle.block
; CHECK-EMPTY:
; CHECK-NEXT:  middle.block:
; CHECK-NEXT:    EMIT vp<[[VP10:%[0-9]+]]> = compute-reduction-result (fadd, in-loop, ordered) ir<%rdx.next>, ir<%rdx.next>.1
; CHECK-NEXT:    EMIT vp<%cmp.n> = icmp eq ir<%n>, vp<[[VP2]]>
; CHECK-NEXT:    EMIT branch-on-cond vp<%cmp.n>
; CHECK-NEXT:  Successor(s): ir-bb<exit>, scalar.ph
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %rdx = phi float [ 5.0, %entry ], [ %rdx.next, %loop ]
  %gep = getelementptr inbounds float, ptr %a, i64 %iv
  %l = load float, ptr %gep
  %rdx.next = fadd float %rdx, %l
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret float %rdx.next
}
