; The SCEV predicates of a loop are recorded on the plan, printed one
; assumption per line, and materialized as a "vector.scevcheck" block of
; VPInstructions bypassing the vector loop, ahead of the "vector.memcheck"
; block.

; The narrow induction %x must not wrap; overflow checks by 1 fold to plain
; compares.
define void @wrap_predicate(ptr %a, i64 %n, i32 %start) {
; BEFORE-LABEL: VPlan for loop in 'wrap_predicate'
; BEFORE:  VPlan 'Initial VPlan for VF={4},UF>=1' {
; BEFORE-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; BEFORE-NEXT:  Live-in vp<[[VP1:%[0-9]+]]> = VF * UF
; BEFORE-NEXT:  Live-in vp<[[VP2:%[0-9]+]]> = vector-trip-count
; BEFORE-NEXT:  Live-in ir<%n> = original trip-count
; BEFORE-NEXT:  Predicates:
; BEFORE-NEXT:    {(trunc i32 %start to i8),+,1}<%loop> Added Flags: <nusw>
; BEFORE-EMPTY:
; BEFORE-NEXT:  ir-bb<entry>:
; BEFORE-NEXT:    IR   %v = trunc i32 %start to i8
; BEFORE-NEXT:    IR   %initial = zext i8 %v to i64
; BEFORE-NEXT:    EMIT vp<%min.iters.check> = icmp ult ir<%n>, ir<4>
; BEFORE-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; BEFORE-NEXT:  Successor(s): scalar.ph, vector.ph
; BEFORE-EMPTY:
; BEFORE-NEXT:  vector.ph:
;
; FINAL-LABEL: VPlan for loop in 'wrap_predicate'
; FINAL:  VPlan 'Final VPlan for VF={4},UF={1}' {
; FINAL-NEXT:  Live-in ir<%n> = original trip-count
; FINAL-EMPTY:
; FINAL-NEXT:  ir-bb<entry>:
; FINAL-NEXT:    IR   %v = trunc i32 %start to i8
; FINAL-NEXT:    IR   %initial = zext i8 %v to i64
; FINAL-NEXT:    EMIT vp<%min.iters.check> = icmp ult ir<%n>, ir<4>
; FINAL-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; FINAL-NEXT:  Successor(s): ir-bb<scalar.ph>, vector.scevcheck
; FINAL-EMPTY:
; FINAL-NEXT:  vector.scevcheck:
; FINAL-NEXT:    EMIT vp<[[VP2:%[0-9]+]]> = add ir<%n>, ir<-1>
; FINAL-NEXT:    EMIT-SCALAR vp<[[VP3:%[0-9]+]]> = trunc vp<[[VP2]]> to i8
; FINAL-NEXT:    EMIT vp<[[VP4:%[0-9]+]]> = add ir<%v>, vp<[[VP3]]>
; FINAL-NEXT:    EMIT vp<[[VP5:%[0-9]+]]> = icmp ult vp<[[VP4]]>, ir<%v>
; FINAL-NEXT:    EMIT vp<[[VP6:%[0-9]+]]> = icmp ugt vp<[[VP2]]>, ir<255>
; FINAL-NEXT:    EMIT vp<[[VP7:%[0-9]+]]> = or vp<[[VP5]]>, vp<[[VP6]]>
; FINAL-NEXT:    EMIT branch-on-cond vp<[[VP7]]>
; FINAL-NEXT:  Successor(s): ir-bb<scalar.ph>, vector.ph
; FINAL-EMPTY:
; FINAL-NEXT:  vector.ph:
;
entry:
  %v = trunc i32 %start to i8
  %initial = zext i8 %v to i64
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %x = phi i8 [ %v, %entry ], [ %x.next, %loop ]
  %prev = phi i64 [ %initial, %entry ], [ %next, %loop ]
  %x.next = add i8 %x, 1
  %next = zext i8 %x.next to i64
  %gep = getelementptr inbounds i64, ptr %a, i64 %prev
  %val = xor i64 %i, %prev
  store i64 %val, ptr %gep, align 8
  %i.next = add nuw nsw i64 %i, 1
  %ec = icmp eq i64 %i.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; The narrow induction %x with step 4 must not wrap; its overflow check
; multiplies the backedge-taken count by the step with umul.with.overflow and
; extracts both fields of the result.
define void @wrap_predicate_step_4(ptr %dst, i64 %n, i32 %start) {
; BEFORE-LABEL: VPlan for loop in 'wrap_predicate_step_4'
; BEFORE:  VPlan 'Initial VPlan for VF={4},UF>=1' {
; BEFORE-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; BEFORE-NEXT:  Live-in vp<[[VP1:%[0-9]+]]> = VF * UF
; BEFORE-NEXT:  Live-in vp<[[VP2:%[0-9]+]]> = vector-trip-count
; BEFORE-NEXT:  Live-in ir<%n> = original trip-count
; BEFORE-NEXT:  Predicates:
; BEFORE-NEXT:    {(trunc i32 %start to i8),+,4}<%loop> Added Flags: <nusw>
; BEFORE-NEXT:    Equal predicate: %start == (zext i8 (trunc i32 %start to i8) to i32)
; BEFORE-EMPTY:
; BEFORE-NEXT:  ir-bb<entry>:
; BEFORE-NEXT:    EMIT vp<%min.iters.check> = icmp ult ir<%n>, ir<4>
; BEFORE-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; BEFORE-NEXT:  Successor(s): scalar.ph, vector.ph
; BEFORE-EMPTY:
; BEFORE-NEXT:  vector.ph:
;
; FINAL-LABEL: VPlan for loop in 'wrap_predicate_step_4'
; FINAL:  VPlan 'Final VPlan for VF={4},UF={1}' {
; FINAL-NEXT:  Live-in ir<%n> = original trip-count
; FINAL-EMPTY:
; FINAL-NEXT:  ir-bb<entry>:
; FINAL-NEXT:    EMIT vp<%min.iters.check> = icmp ult ir<%n>, ir<4>
; FINAL-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; FINAL-NEXT:  Successor(s): ir-bb<scalar.ph>, vector.scevcheck
; FINAL-EMPTY:
; FINAL-NEXT:  vector.scevcheck:
; FINAL-NEXT:    EMIT vp<[[VP2:%[0-9]+]]> = add ir<%n>, ir<-1>
; FINAL-NEXT:    EMIT-SCALAR vp<[[VP3:%[0-9]+]]> = trunc ir<%start> to i8
; FINAL-NEXT:    EMIT-SCALAR vp<[[VP4:%[0-9]+]]> = trunc vp<[[VP2]]> to i8
; FINAL-NEXT:    EMIT-SCALAR vp<%mul> = call { i8, i1 } @llvm.umul.with.overflow(ir<4>, vp<[[VP4]]>)
; FINAL-NEXT:    EMIT vp<%mul.result> = extractvalue vp<%mul>, ir<0>
; FINAL-NEXT:    EMIT vp<%mul.overflow> = extractvalue vp<%mul>, ir<1>
; FINAL-NEXT:    EMIT vp<[[VP5:%[0-9]+]]> = add vp<[[VP3]]>, vp<%mul.result>
; FINAL-NEXT:    EMIT vp<[[VP6:%[0-9]+]]> = icmp ult vp<[[VP5]]>, vp<[[VP3]]>
; FINAL-NEXT:    EMIT vp<[[VP7:%[0-9]+]]> = or vp<[[VP6]]>, vp<%mul.overflow>
; FINAL-NEXT:    EMIT vp<[[VP8:%[0-9]+]]> = icmp ugt vp<[[VP2]]>, ir<255>
; FINAL-NEXT:    EMIT vp<[[VP9:%[0-9]+]]> = or vp<[[VP7]]>, vp<[[VP8]]>
; FINAL-NEXT:    EMIT-SCALAR vp<[[VP10:%[0-9]+]]> = zext vp<[[VP3]]> to i32
; FINAL-NEXT:    EMIT vp<%ident.check> = icmp ne ir<%start>, vp<[[VP10]]>
; FINAL-NEXT:    EMIT vp<[[VP11:%[0-9]+]]> = or vp<[[VP9]]>, vp<%ident.check>
; FINAL-NEXT:    EMIT branch-on-cond vp<[[VP11]]>
; FINAL-NEXT:  Successor(s): ir-bb<scalar.ph>, vector.ph
; FINAL-EMPTY:
; FINAL-NEXT:  vector.ph:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %x = phi i32 [ %start, %entry ], [ %x.next, %loop ]
  %masked = and i32 %x, 255
  %x.next = add nuw nsw i32 %masked, 4
  %gep = getelementptr inbounds i32, ptr %dst, i64 %iv
  store i32 %x, ptr %gep, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; The symbolic stride %stride is assumed to be 1. Both SCEV and memory checks
; are recorded as predicates; the SCEV checks are materialized first.
define void @stride_and_memory_predicates(ptr %dst, ptr %src, i64 %stride, i64 %n) {
; BEFORE-LABEL: VPlan for loop in 'stride_and_memory_predicates'
; BEFORE:  VPlan 'Initial VPlan for VF={4},UF>=1' {
; BEFORE-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; BEFORE-NEXT:  Live-in vp<[[VP1:%[0-9]+]]> = VF * UF
; BEFORE-NEXT:  Live-in vp<[[VP2:%[0-9]+]]> = vector-trip-count
; BEFORE-NEXT:  Live-in ir<%n> = original trip-count
; BEFORE-NEXT:  Predicates:
; BEFORE-NEXT:    Equal predicate: %stride == 1
; BEFORE-NEXT:    No overlap: %dst uge ((4 * %n) + %src) or %src uge ((8 * %n) + %dst)
; BEFORE-EMPTY:
; BEFORE-NEXT:  ir-bb<entry>:
; BEFORE-NEXT:    EMIT vp<%min.iters.check> = icmp ult ir<%n>, ir<4>
; BEFORE-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; BEFORE-NEXT:  Successor(s): scalar.ph, vector.ph
; BEFORE-EMPTY:
; BEFORE-NEXT:  vector.ph:
;
; FINAL-LABEL: VPlan for loop in 'stride_and_memory_predicates'
; FINAL:  VPlan 'Final VPlan for VF={4},UF={1}' {
; FINAL-NEXT:  Live-in ir<%n> = original trip-count
; FINAL-EMPTY:
; FINAL-NEXT:  ir-bb<entry>:
; FINAL-NEXT:    EMIT vp<%min.iters.check> = icmp ult ir<%n>, ir<4>
; FINAL-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; FINAL-NEXT:  Successor(s): ir-bb<scalar.ph>, vector.scevcheck
; FINAL-EMPTY:
; FINAL-NEXT:  vector.scevcheck:
; FINAL-NEXT:    EMIT vp<%ident.check> = icmp ne ir<%stride>, ir<1>
; FINAL-NEXT:    EMIT branch-on-cond vp<%ident.check>
; FINAL-NEXT:  Successor(s): ir-bb<scalar.ph>, vector.memcheck
; FINAL-EMPTY:
; FINAL-NEXT:  vector.memcheck:
; FINAL-NEXT:    EMIT vp<[[VP3:%[0-9]+]]> = shl ir<%n>, ir<3>
; FINAL-NEXT:    EMIT vp<[[VP4:%[0-9]+]]> = ptradd ir<%dst>, vp<[[VP3]]>
; FINAL-NEXT:    EMIT vp<[[VP5:%[0-9]+]]> = shl ir<%n>, ir<2>
; FINAL-NEXT:    EMIT vp<[[VP6:%[0-9]+]]> = ptradd ir<%src>, vp<[[VP5]]>
; FINAL-NEXT:    EMIT vp<%bound0> = icmp ult ir<%dst>, vp<[[VP6]]>
; FINAL-NEXT:    EMIT vp<%bound1> = icmp ult ir<%src>, vp<[[VP4]]>
; FINAL-NEXT:    EMIT vp<%found.conflict> = and vp<%bound0>, vp<%bound1>
; FINAL-NEXT:    EMIT branch-on-cond vp<%found.conflict>
; FINAL-NEXT:  Successor(s): ir-bb<scalar.ph>, vector.ph
; FINAL-EMPTY:
; FINAL-NEXT:  vector.ph:
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %mul = mul i64 %i, %stride
  %gep.src = getelementptr inbounds i32, ptr %src, i64 %mul
  %l = load i32, ptr %gep.src, align 4
  %gep.dst = getelementptr inbounds i64, ptr %dst, i64 %i
  %ext = sext i32 %l to i64
  store i64 %ext, ptr %gep.dst, align 8
  %i.next = add nuw nsw i64 %i, 1
  %ec = icmp eq i64 %i.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; For inner loops of loop nests, the parts of the checks invariant in the
; parent loop, here the backedge-taken count, are hoisted out of it.
define void @wrap_predicate_nested(ptr %a, i64 %n, i64 %m, i32 %start) {
; BEFORE-LABEL: VPlan for loop in 'wrap_predicate_nested'
; BEFORE:  VPlan 'Initial VPlan for VF={4},UF>=1' {
; BEFORE-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; BEFORE-NEXT:  Live-in vp<[[VP1:%[0-9]+]]> = VF * UF
; BEFORE-NEXT:  Live-in vp<[[VP2:%[0-9]+]]> = vector-trip-count
; BEFORE-NEXT:  Live-in ir<%n> = original trip-count
; BEFORE-NEXT:  Predicates:
; BEFORE-NEXT:    {(trunc i32 %start to i8),+,1}<%loop> Added Flags: <nusw>
; BEFORE-EMPTY:
; BEFORE-NEXT:  ir-bb<outer>:
; BEFORE-NEXT:    IR   %j = phi i64 [ 0, %entry ], [ %j.next, %outer.latch ]
; BEFORE-NEXT:    EMIT vp<%min.iters.check> = icmp ult ir<%n>, ir<4>
; BEFORE-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; BEFORE-NEXT:  Successor(s): scalar.ph, vector.ph
; BEFORE-EMPTY:
; BEFORE-NEXT:  vector.ph:
;
; FINAL-LABEL: VPlan for loop in 'wrap_predicate_nested'
; FINAL:  VPlan 'Final VPlan for VF={4},UF={1}' {
; FINAL-NEXT:  Live-in ir<%n> = original trip-count
; FINAL-EMPTY:
; FINAL-NEXT:  ir-bb<outer>:
; FINAL-NEXT:    IR   %j = phi i64 [ 0, %entry ], [ %j.next, %outer.latch ]
; FINAL-NEXT:    EMIT vp<%min.iters.check> = icmp ult ir<%n>, ir<4>
; FINAL-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; FINAL-NEXT:  Successor(s): ir-bb<scalar.ph>, vector.scevcheck
; FINAL-EMPTY:
; FINAL-NEXT:  vector.scevcheck:
; FINAL-NEXT:    EMIT-SCALAR vp<[[VP2:%[0-9]+]]> = trunc ir<%0> to i8
; FINAL-NEXT:    EMIT vp<[[VP3:%[0-9]+]]> = add ir<%v>, vp<[[VP2]]>
; FINAL-NEXT:    EMIT vp<[[VP4:%[0-9]+]]> = icmp ult vp<[[VP3]]>, ir<%v>
; FINAL-NEXT:    EMIT vp<[[VP5:%[0-9]+]]> = icmp ugt ir<%0>, ir<255>
; FINAL-NEXT:    EMIT vp<[[VP6:%[0-9]+]]> = or vp<[[VP4]]>, vp<[[VP5]]>
; FINAL-NEXT:    EMIT branch-on-cond vp<[[VP6]]>
; FINAL-NEXT:  Successor(s): ir-bb<scalar.ph>, vector.ph
; FINAL-EMPTY:
; FINAL-NEXT:  vector.ph:
;
entry:
  %v = trunc i32 %start to i8
  %initial = zext i8 %v to i64
  br label %outer

outer:
  %j = phi i64 [ 0, %entry ], [ %j.next, %outer.latch ]
  br label %loop

loop:
  %i = phi i64 [ 0, %outer ], [ %i.next, %loop ]
  %x = phi i8 [ %v, %outer ], [ %x.next, %loop ]
  %prev = phi i64 [ %initial, %outer ], [ %next, %loop ]
  %x.next = add i8 %x, 1
  %next = zext i8 %x.next to i64
  %gep = getelementptr inbounds i64, ptr %a, i64 %prev
  %val = xor i64 %i, %prev
  store i64 %val, ptr %gep, align 8
  %i.next = add nuw nsw i64 %i, 1
  %ec = icmp eq i64 %i.next, %n
  br i1 %ec, label %outer.latch, label %loop

outer.latch:
  %j.next = add nuw nsw i64 %j, 1
  %outer.ec = icmp eq i64 %j.next, %m
  br i1 %outer.ec, label %exit, label %outer

exit:
  ret void
}
