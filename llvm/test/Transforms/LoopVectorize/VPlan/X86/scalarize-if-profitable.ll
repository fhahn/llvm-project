; RUN: opt -passes=loop-vectorize -mcpu=skylake-avx512 -force-vector-width=2 -force-vector-interleave=1 -vplan-print-after=makeScalarizationDecisions -disable-output %s 2>&1 | FileCheck %s

; Baseline VPlans for the predicated chain-scalarization cases, printed after
; convertToAbstractRecipes. The decision to scalarize the operand chains
; feeding the predicated div/rem, gather load and call is currently made by the
; legacy cost model during recipe construction, so the chain recipes already
; print as REPLICATE here. A later change adds a VPlan transform,
; VPlanTransforms::scalarizeIfProfitable, that takes this decision over.

target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"
target triple = "x86_64-apple-macosx10.8.0"

; The widened multiply feeds the predicated sdiv via a single-use chain. At
; VF=2 scalarizing the whole chain is at least as cheap as widening it (an
; AVX-512 vector i64 multiply plus extracts), so the multiply is scalarized
; to a REPLICATE.
define void @sdiv_mul_chain(ptr noalias %a, ptr noalias %b, i64 %x, i1 %c, i64 %n) {
; CHECK-LABEL: VPlan for loop in 'sdiv_mul_chain'
; CHECK:  VPlan ' for UF>=1' {
; CHECK-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; CHECK-NEXT:  Live-in vp<[[VP1:%[0-9]+]]> = VF * UF
; CHECK-NEXT:  Live-in vp<[[VP2:%[0-9]+]]> = vector-trip-count
; CHECK-NEXT:  vp<[[VP3:%[0-9]+]]> = original trip-count
; CHECK-EMPTY:
; CHECK-NEXT:  ir-bb<entry>:
; CHECK-NEXT:    EMIT vp<[[VP3]]> = EXPAND SCEV (1 smax %n)
; CHECK-NEXT:  Successor(s): scalar.ph, vector.ph
; CHECK-EMPTY:
; CHECK-NEXT:  vector.ph:
; CHECK-NEXT:  Successor(s): vector loop
; CHECK-EMPTY:
; CHECK-NEXT:  <x1> vector loop: {
; CHECK-NEXT:  vp<[[VP4:%[0-9]+]]> = CANONICAL-IV
; CHECK-EMPTY:
; CHECK-NEXT:    vector.body:
; CHECK-NEXT:      ir<%i> = WIDEN-INDUCTION nuw nsw ir<0>, ir<1>, vp<[[VP0]]>
; CHECK-NEXT:      CLONE ir<%gep.a> = getelementptr inbounds ir<%a>, ir<%i>
; CHECK-NEXT:      vp<[[VP5:%[0-9]+]]> = vector-pointer inbounds ir<%gep.a>, ir<1>
; CHECK-NEXT:      WIDEN ir<%lv> = load vp<[[VP5]]>
; CHECK-NEXT:    Successor(s): if.then
; CHECK-EMPTY:
; CHECK-NEXT:    if.then:
; CHECK-NEXT:      EMIT ir<%mul> = mul ir<%lv>, ir<%x>, ir<%c>
; CHECK-NEXT:      EMIT ir<%div> = sdiv ir<%mul>, ir<%x>, ir<%c>
; CHECK-NEXT:      CLONE ir<%gep.b> = getelementptr inbounds ir<%b>, ir<%i>
; CHECK-NEXT:      vp<[[VP6:%[0-9]+]]> = vector-pointer inbounds ir<%gep.b>, ir<1>
; CHECK-NEXT:      WIDEN store vp<[[VP6]]>, ir<%div>, ir<%c>
; CHECK-NEXT:    Successor(s): for.inc
; CHECK-EMPTY:
; CHECK-NEXT:    for.inc:
; CHECK-NEXT:      EMIT ir<%i.next> = add nuw nsw ir<%i>, ir<1>
; CHECK-NEXT:      CLONE ir<%cond> = icmp sge ir<%i.next>, ir<%n>
; CHECK-NEXT:      EMIT vp<%index.next> = add nuw vp<[[VP4]]>, vp<[[VP1]]>
; CHECK-NEXT:      EMIT branch-on-count vp<%index.next>, vp<[[VP2]]>
; CHECK-NEXT:    No successors
; CHECK-NEXT:  }
; CHECK-NEXT:  Successor(s): middle.block
;
entry:
  br label %for.body

for.body:
  %i = phi i64 [ 0, %entry ], [ %i.next, %for.inc ]
  %gep.a = getelementptr inbounds i64, ptr %a, i64 %i
  %lv = load i64, ptr %gep.a, align 8
  br i1 %c, label %if.then, label %for.inc

if.then:
  %mul = mul i64 %lv, %x
  %div = sdiv i64 %mul, %x
  %gep.b = getelementptr inbounds i64, ptr %b, i64 %i
  store i64 %div, ptr %gep.b, align 8
  br label %for.inc

for.inc:
  %i.next = add nuw nsw i64 %i, 1
  %cond = icmp slt i64 %i.next, %n
  br i1 %cond, label %for.body, label %for.end

for.end:
  ret void
}

