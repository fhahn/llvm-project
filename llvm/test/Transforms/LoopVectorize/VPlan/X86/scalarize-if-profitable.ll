; We need a vector variant in order to allow for vectorization of the call, but
; we want to test scalarization of the conditional call. A variant with a
; different number of lanes than the forced VF passes legality but scalarizes.
declare i64 @foo(i64) #0
declare <4 x i64> @vector_foo(<4 x i64>, <4 x i1>)
attributes #0 = { readonly nounwind "vector-function-abi-variant"="_ZGV_LLVM_M4v_foo(vector_foo)" }
