; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --filter-out-after "Successor\(s\): middle.block" --version 6
; RUN: opt -passes=loop-vectorize -mtriple=x86_64-- -force-vector-width=4 -force-vector-interleave=1 -vplan-print-after=scalarizeIfProfitable -disable-output %s 2>&1 | FileCheck %s

; Test for VPlanTransforms::scalarizeIfProfitable scalarizing the operand chain
; of a predicated store. Without efficient masked stores, the predicated store
; is scalarized for predication, and the widened multiply feeding it is a
; single-use chain operand. The transform pulls the multiply into the
; scalarized chain: it prints as REPLICATE after the transform, alongside the
; REPLICATE store.

target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"

define void @store_mul_chain(ptr noalias %a, ptr noalias %b, i32 %x, i1 %c, i64 %n) {
; CHECK-LABEL: VPlan for loop in 'store_mul_chain'
; CHECK:  VPlan ' for UF>=1' {
; CHECK-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; CHECK-NEXT:  Live-in vp<[[VP1:%[0-9]+]]> = VF * UF
; CHECK-NEXT:  Live-in vp<[[VP2:%[0-9]+]]> = vector-trip-count
; CHECK-NEXT:  vp<[[VP3:%[0-9]+]]> = original trip-count
; CHECK-EMPTY:
; CHECK-NEXT:  ir-bb<entry>:
; CHECK-NEXT:    EMIT vp<[[VP3]]> = EXPAND SCEV (1 smax %n)
; CHECK-NEXT:  Successor(s): scalar.ph, vector.ph
; CHECK-EMPTY:
; CHECK-NEXT:  vector.ph:
; CHECK-NEXT:  Successor(s): vector loop
; CHECK-EMPTY:
; CHECK-NEXT:  <x1> vector loop: {
; CHECK-NEXT:  vp<[[VP4:%[0-9]+]]> = CANONICAL-IV
; CHECK-EMPTY:
; CHECK-NEXT:    vector.body:
; CHECK-NEXT:      ir<%i> = WIDEN-INDUCTION nuw nsw ir<0>, ir<1>, vp<[[VP0]]>
; CHECK-NEXT:      CLONE ir<%gep.a> = getelementptr inbounds ir<%a>, ir<%i>
; CHECK-NEXT:      vp<[[VP5:%[0-9]+]]> = vector-pointer inbounds ir<%gep.a>, ir<1>
; CHECK-NEXT:      WIDEN ir<%lv> = load vp<[[VP5]]>
; CHECK-NEXT:    Successor(s): if.then
; CHECK-EMPTY:
; CHECK-NEXT:    if.then:
; CHECK-NEXT:      REPLICATE ir<%mul> = mul ir<%lv>, ir<%x>
; CHECK-NEXT:      REPLICATE ir<%gep.b> = getelementptr inbounds ir<%b>, ir<%i>
; CHECK-NEXT:      REPLICATE store ir<%mul>, ir<%gep.b>, ir<%c>
; CHECK-NEXT:    Successor(s): for.inc
; CHECK-EMPTY:
; CHECK-NEXT:    for.inc:
; CHECK-NEXT:      REPLICATE ir<%i.next> = add nuw nsw ir<%i>, ir<1>
; CHECK-NEXT:      CLONE ir<%cond> = icmp sge ir<%i.next>, ir<%n>
; CHECK-NEXT:      EMIT vp<%index.next> = add nuw vp<[[VP4]]>, vp<[[VP1]]>
; CHECK-NEXT:      EMIT branch-on-count vp<%index.next>, vp<[[VP2]]>
; CHECK-NEXT:    No successors
; CHECK-NEXT:  }
; CHECK-NEXT:  Successor(s): middle.block
;
entry:
  br label %for.body

for.body:
  %i = phi i64 [ 0, %entry ], [ %i.next, %for.inc ]
  %gep.a = getelementptr inbounds i32, ptr %a, i64 %i
  %lv = load i32, ptr %gep.a, align 4
  br i1 %c, label %if.then, label %for.inc

if.then:
  %mul = mul i32 %lv, %x
  %gep.b = getelementptr inbounds i32, ptr %b, i64 %i
  store i32 %mul, ptr %gep.b, align 4
  br label %for.inc

for.inc:
  %i.next = add nuw nsw i64 %i, 1
  %cond = icmp slt i64 %i.next, %n
  br i1 %cond, label %for.body, label %for.end

for.end:
  ret void
}
