  %c = icmp eq i32 %l, 0
  br i1 %c, label %then, label %loop.latch

then:
  %shl = shl i64 %n, 2
  %or = or disjoint i64 %shl, 1
  %and = and i64 %or, 255
  %lshr = lshr i64 %and, 1
  %not = xor i64 %lshr, -1
