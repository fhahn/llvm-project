; The decreasing IV {-8,+,-4} does not wrap as %bound is at least 0, but this
; is not proven, as the unsigned range of -8 - 4 * BTC is not known.
define void @step_minus_4(ptr noalias %dst, i8 %n) {
; CHECK-LABEL: VPlan for loop in 'step_minus_4'
; CHECK:  VPlan ' for UF>=1' {
; CHECK-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; CHECK-NEXT:  Predicates:
; CHECK-NEXT:    {-8,+,-4}<%loop> Added Flags: <nusw>
; CHECK-EMPTY:
; CHECK-NEXT:  ir-bb<entry>:
;
entry:
  %n.ext = sext i8 %n to i32
  %bound = add nsw i32 %n.ext, 128
  br label %loop

loop:
  %iv = phi i8 [ -4, %entry ], [ %iv.next, %loop ]
  %idx = zext i8 %iv to i64
  %gep = getelementptr inbounds i32, ptr %dst, i64 %idx
  store i32 0, ptr %gep, align 4
  %iv.next = add i8 %iv, -4
