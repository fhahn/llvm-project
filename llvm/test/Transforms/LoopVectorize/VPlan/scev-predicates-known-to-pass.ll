; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=1 -disable-output \
; RUN:   -vplan-print-after=finalizeSCEVPredicates %s 2>&1 | FileCheck %s

; SCEV predicates whose runtime check is known to pass are not recorded on the
; plan.

; The backedge-taken count needs the i8 IV {4,+,4} to not wrap. %bound is at
; most 252, so the IV does not wrap and the predicate is not recorded.
define void @step_4_bound_le_252(ptr noalias %dst, i8 %n) {
; CHECK-LABEL: VPlan for loop in 'step_4_bound_le_252'
; CHECK:  VPlan ' for UF>=1' {
; CHECK-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; CHECK-EMPTY:
; CHECK-NEXT:  ir-bb<entry>:
;
entry:
  %n.ext = sext i8 %n to i32
  %bound = add nsw i32 %n.ext, 125
  br label %loop

loop:
  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop ]
  %idx = zext i8 %iv to i64
  %gep = getelementptr inbounds i32, ptr %dst, i64 %idx
  store i32 0, ptr %gep, align 4
  %iv.next = add i8 %iv, 4
  %iv.next.ext = zext i8 %iv.next to i32
  %ec = icmp slt i32 %iv.next.ext, %bound
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}

