}

; Like @step_4_bound_le_252, with an additional i32 IV {0,+,1} that does not
; wrap, as the backedge-taken count is narrower (i16).
define void @btc_narrower_than_iv(ptr noalias %dst, i8 %n) {
; CHECK-LABEL: VPlan for loop in 'btc_narrower_than_iv'
; CHECK:  VPlan ' for UF>=1' {
; CHECK-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; CHECK-EMPTY:
; CHECK-NEXT:  ir-bb<entry>:
;
entry:
  %n.ext = sext i8 %n to i16
  %bound = add nsw i16 %n.ext, 125
  br label %loop

loop:
  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop ]
  %iv.32 = phi i32 [ 0, %entry ], [ %iv.32.next, %loop ]
  %idx = sext i32 %iv.32 to i64
  %gep = getelementptr inbounds i32, ptr %dst, i64 %idx
  store i32 0, ptr %gep, align 4
  %iv.next = add i8 %iv, 4
  %iv.32.next = add i32 %iv.32, 1
  %iv.next.ext = zext i8 %iv.next to i16
  %ec = icmp slt i16 %iv.next.ext, %bound
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}
