; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --filter-out-after "vector.ph:" --version 6
; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=1 -disable-output \
; RUN:   -vplan-print-before=materializePredicates %s 2>&1 | FileCheck %s

; Memory runtime checks are recorded as a predicate on the plan, printing the
; conditions that must hold.

define void @three_groups(ptr %a, ptr %b, ptr %c, i64 %n) {
;
; CHECK-LABEL: VPlan for loop in 'three_groups'
; CHECK:  VPlan 'Initial VPlan for VF={4},UF>=1' {
; CHECK-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; CHECK-NEXT:  Live-in vp<[[VP1:%[0-9]+]]> = VF * UF
; CHECK-NEXT:  Live-in vp<[[VP2:%[0-9]+]]> = vector-trip-count
; CHECK-NEXT:  Live-in ir<%n> = original trip-count
; CHECK-NEXT:  Predicates:
; CHECK-NEXT:    No overlap: %c uge ((4 * %n) + %a) or %a uge ((4 * %n) + %c)
; CHECK-NEXT:    No overlap: %c uge ((4 * %n) + %b) or %b uge ((4 * %n) + %c)
; CHECK-NEXT:    No overlap: %a uge ((4 * %n) + %b) or %b uge ((4 * %n) + %a)
; CHECK-EMPTY:
; CHECK-NEXT:  ir-bb<entry>:
; CHECK-NEXT:    EMIT vp<%min.iters.check> = icmp ult ir<%n>, ir<4>
; CHECK-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; CHECK-NEXT:  Successor(s): scalar.ph, vector.ph
; CHECK-EMPTY:
; CHECK-NEXT:  vector.ph:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
  %load.a = load i32, ptr %gep.a, align 4
  %gep.b = getelementptr inbounds i32, ptr %b, i64 %iv
  %load.b = load i32, ptr %gep.b, align 4
  %sum = add i32 %load.a, %load.b
  %gep.c = getelementptr inbounds i32, ptr %c, i64 %iv
  store i32 %sum, ptr %gep.c, align 4
  store i32 %load.b, ptr %gep.a, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; For inner loops of loop nests, the bounds varying in the outer loop are
; widened to cover the whole outer loop, so the checks can be hoisted out of it;
; the widened bounds and strides to check are printed.
define void @nested_hoisted_bounds(ptr %dst, ptr %src, i32 %m, i32 %n) {
;
; CHECK-LABEL: VPlan for loop in 'nested_hoisted_bounds'
; CHECK:  VPlan 'Initial VPlan for VF={4},UF>=1' {
; CHECK-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; CHECK-NEXT:  Live-in vp<[[VP1:%[0-9]+]]> = VF * UF
; CHECK-NEXT:  Live-in vp<[[VP2:%[0-9]+]]> = vector-trip-count
; CHECK-NEXT:  vp<[[VP3:%[0-9]+]]> = original trip-count
; CHECK-NEXT:  Predicates:
; CHECK-NEXT:    No overlap: %dst uge ((4 * (zext i32 %m to i64) * (zext i32 %n to i64)) + %src) or %src uge ((4 * (zext i32 %m to i64) * (zext i32 %n to i64)) + %dst)
; CHECK-EMPTY:
; CHECK-NEXT:  ir-bb<outer.loop>:
; CHECK-NEXT:    IR   %outer.iv = phi i64 [ 0, %entry ], [ %outer.iv.next, %inner.exit ]
; CHECK-NEXT:    IR   %row = mul nsw i64 %outer.iv, %wide.n
; CHECK-NEXT:    EMIT vp<[[VP3]]> = EXPAND SCEV (zext i32 %n to i64)
; CHECK-NEXT:    EMIT vp<%min.iters.check> = icmp ult vp<[[VP3]]>, ir<4>
; CHECK-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; CHECK-NEXT:  Successor(s): scalar.ph, vector.ph
; CHECK-EMPTY:
; CHECK-NEXT:  vector.ph:
;
entry:
  %wide.m = zext i32 %m to i64
  %wide.n = zext i32 %n to i64
  br label %outer.loop

outer.loop:
  %outer.iv = phi i64 [ 0, %entry ], [ %outer.iv.next, %inner.exit ]
  %row = mul nsw i64 %outer.iv, %wide.n
  br label %inner.loop

inner.loop:
  %inner.iv = phi i64 [ 0, %outer.loop ], [ %inner.iv.next, %inner.loop ]
  %idx = add nuw nsw i64 %inner.iv, %row
  %gep.src = getelementptr inbounds i32, ptr %src, i64 %idx
  %l.src = load i32, ptr %gep.src, align 4
  %gep.dst = getelementptr inbounds i32, ptr %dst, i64 %idx
  %l.dst = load i32, ptr %gep.dst, align 4
  %add = add nsw i32 %l.dst, %l.src
  store i32 %add, ptr %gep.dst, align 4
  %inner.iv.next = add nuw nsw i64 %inner.iv, 1
  %inner.ec = icmp eq i64 %inner.iv.next, %wide.n
  br i1 %inner.ec, label %inner.exit, label %inner.loop

inner.exit:
  %outer.iv.next = add nuw nsw i64 %outer.iv, 1
  %outer.ec = icmp eq i64 %outer.iv.next, %wide.m
  br i1 %outer.ec, label %exit, label %outer.loop

exit:
  ret void
}

define void @nested_hoisted_bounds_stride_checks(ptr %dst, ptr %src, i32 %stride1, i32 %stride2, i32 %m, i32 %n) {
;
; CHECK-LABEL: VPlan for loop in 'nested_hoisted_bounds_stride_checks'
; CHECK:  VPlan 'Initial VPlan for VF={4},UF>=1' {
; CHECK-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; CHECK-NEXT:  Live-in vp<[[VP1:%[0-9]+]]> = VF * UF
; CHECK-NEXT:  Live-in vp<[[VP2:%[0-9]+]]> = vector-trip-count
; CHECK-NEXT:  vp<[[VP3:%[0-9]+]]> = original trip-count
; CHECK-NEXT:  Predicates:
; CHECK-NEXT:    No overlap: %dst uge (4 + (4 * (zext i32 %n to i64))<nuw><nsw> + (4 * (sext i32 %stride2 to i64) * (-1 + (zext i32 %m to i64))<nsw>) + %src) or %src uge (4 + (4 * (zext i32 %n to i64))<nuw><nsw> + (4 * (sext i32 %stride1 to i64) * (-1 + (zext i32 %m to i64))<nsw>) + %dst)
; CHECK-NEXT:    Non-negative stride: (4 * (sext i32 %stride1 to i64))<nsw> sge 0
; CHECK-NEXT:    Non-negative stride: (4 * (sext i32 %stride2 to i64))<nsw> sge 0
; CHECK-EMPTY:
; CHECK-NEXT:  ir-bb<outer.loop>:
; CHECK-NEXT:    IR   %outer.iv = phi i64 [ 0, %outer.loop.pre ], [ %outer.iv.next, %inner.exit ]
; CHECK-NEXT:    IR   %offset.src = mul nsw i64 %outer.iv, %wide.stride2
; CHECK-NEXT:    IR   %offset.dst = mul nsw i64 %outer.iv, %wide.stride1
; CHECK-NEXT:    EMIT vp<[[VP3]]> = EXPAND SCEV (1 + (zext i32 %n to i64))<nuw><nsw>
; CHECK-NEXT:    EMIT vp<%min.iters.check> = icmp ult vp<[[VP3]]>, ir<4>
; CHECK-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; CHECK-NEXT:  Successor(s): scalar.ph, vector.ph
; CHECK-EMPTY:
; CHECK-NEXT:  vector.ph:
;
entry:
  %m.pos = icmp sgt i32 %m, 0
  %n.nonneg = icmp sgt i32 %n, -1
  %enter = and i1 %m.pos, %n.nonneg
  br i1 %enter, label %outer.loop.pre, label %exit

outer.loop.pre:
  %wide.n = zext i32 %n to i64
  %wide.stride1 = sext i32 %stride1 to i64
  %wide.stride2 = sext i32 %stride2 to i64
  %wide.m = zext i32 %m to i64
  br label %outer.loop

outer.loop:
  %outer.iv = phi i64 [ 0, %outer.loop.pre ], [ %outer.iv.next, %inner.exit ]
  %offset.src = mul nsw i64 %outer.iv, %wide.stride2
  %offset.dst = mul nsw i64 %outer.iv, %wide.stride1
  br label %inner.loop

inner.loop:
  %inner.iv = phi i64 [ %wide.n, %outer.loop ], [ %inner.iv.next, %inner.loop ]
  %idx.src = add nsw i64 %inner.iv, %offset.src
  %gep.src = getelementptr inbounds i32, ptr %src, i64 %idx.src
  %l.src = load i32, ptr %gep.src, align 4
  %idx.dst = add nsw i64 %inner.iv, %offset.dst
  %gep.dst = getelementptr inbounds i32, ptr %dst, i64 %idx.dst
  %l.dst = load i32, ptr %gep.dst, align 4
  %add = add nsw i32 %l.dst, %l.src
  store i32 %add, ptr %gep.dst, align 4
  %inner.iv.next = add nsw i64 %inner.iv, -1
  %inner.cond = icmp sgt i64 %inner.iv, 0
  br i1 %inner.cond, label %inner.loop, label %inner.exit

inner.exit:
  %outer.iv.next = add nuw nsw i64 %outer.iv, 1
  %outer.ec = icmp eq i64 %outer.iv.next, %wide.m
  br i1 %outer.ec, label %exit, label %outer.loop

exit:
  ret void
}

; Difference checks print the distance that must be 0 or at least the accessed
; size; a repeated distance is printed once, as it is only checked once.
define void @diff_checks_repeated_distance(ptr %p, ptr %q, i64 %k, i64 %n) {
;
; CHECK-LABEL: VPlan for loop in 'diff_checks_repeated_distance'
; CHECK:  VPlan 'Initial VPlan for VF={4},UF>=1' {
; CHECK-NEXT:  Live-in vp<[[VP0:%[0-9]+]]> = VF
; CHECK-NEXT:  Live-in vp<[[VP1:%[0-9]+]]> = VF * UF
; CHECK-NEXT:  Live-in vp<[[VP2:%[0-9]+]]> = vector-trip-count
; CHECK-NEXT:  Live-in ir<%n> = original trip-count
; CHECK-NEXT:  Predicates:
; CHECK-NEXT:    Safe distance: ((-1 * (ptrtoaddr ptr %p to i64)) + (ptrtoaddr ptr %q to i64)) == 0 or ((-1 * (ptrtoaddr ptr %p to i64)) + (ptrtoaddr ptr %q to i64)) uge VF * UF * 4
; CHECK-NEXT:    Safe distance: (4 * %k) == 0 or (4 * %k) uge VF * UF * 4
; CHECK-NEXT:    Safe distance: ((-4 * %k) + (-1 * (ptrtoaddr ptr %p to i64)) + (ptrtoaddr ptr %q to i64)) == 0 or ((-4 * %k) + (-1 * (ptrtoaddr ptr %p to i64)) + (ptrtoaddr ptr %q to i64)) uge VF * UF * 4
; CHECK-NEXT:    Safe distance: ((4 * %k) + (-1 * (ptrtoaddr ptr %p to i64)) + (ptrtoaddr ptr %q to i64)) == 0 or ((4 * %k) + (-1 * (ptrtoaddr ptr %p to i64)) + (ptrtoaddr ptr %q to i64)) uge VF * UF * 4
; CHECK-EMPTY:
; CHECK-NEXT:  ir-bb<entry>:
; CHECK-NEXT:    IR   %gep.p.k = getelementptr i32, ptr %p, i64 %k
; CHECK-NEXT:    IR   %gep.q.k = getelementptr i32, ptr %q, i64 %k
; CHECK-NEXT:    EMIT vp<%min.iters.check> = icmp ult ir<%n>, ir<4>
; CHECK-NEXT:    EMIT branch-on-cond vp<%min.iters.check>
; CHECK-NEXT:  Successor(s): scalar.ph, vector.ph
; CHECK-EMPTY:
; CHECK-NEXT:  vector.ph:
;
entry:
  %gep.p.k = getelementptr i32, ptr %p, i64 %k
  %gep.q.k = getelementptr i32, ptr %q, i64 %k
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.p = getelementptr i32, ptr %p, i64 %iv
  %l.p = load i32, ptr %gep.p, align 4
  %gep.p.k.iv = getelementptr i32, ptr %gep.p.k, i64 %iv
  store i32 %l.p, ptr %gep.p.k.iv, align 4
  %gep.q = getelementptr i32, ptr %q, i64 %iv
  %l.q = load i32, ptr %gep.q, align 4
  %gep.q.k.iv = getelementptr i32, ptr %gep.q.k, i64 %iv
  store i32 %l.q, ptr %gep.q.k.iv, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
