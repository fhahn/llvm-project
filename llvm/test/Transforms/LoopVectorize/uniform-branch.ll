; Branches on a condition that is the same for all lanes are kept as control
; flow instead of being if-converted, so the guarded operations do not need to
; be masked.

; The store is guarded by a loop-invariant condition, so it can be widened and
; executed under a real branch, instead of being scalarized and predicated.
define void @invariant_cond_store(ptr noalias %dst, i32 %n) {
; CHECK-LABEL: define void @invariant_cond_store(
; CHECK-SAME: ptr noalias [[DST:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[TMP0:%.*]] = icmp sgt i32 [[N]], 10
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[LOOP_LATCH2:.*]] ]
; CHECK-NEXT:    br i1 [[TMP0]], label %[[IF_THEN1:.*]], label %[[LOOP_LATCH2]]
; CHECK:       [[IF_THEN1]]:
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds i32, ptr [[DST]], i64 [[INDEX]]
; CHECK-NEXT:    store <4 x i32> splat (i32 42), ptr [[TMP1]], align 4
; CHECK-NEXT:    br label %[[LOOP_LATCH2]]
; CHECK:       [[LOOP_LATCH2]]:
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i64 [[INDEX_NEXT]], 1024
; CHECK-NEXT:    br i1 [[TMP2]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %c = icmp sgt i32 %n, 10
  br i1 %c, label %if.then, label %loop.latch

if.then:
  %gep = getelementptr inbounds i32, ptr %dst, i64 %iv
  store i32 42, ptr %gep, align 4
  br label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 1024
  br i1 %ec, label %exit, label %loop.header

exit:
  ret void
}

