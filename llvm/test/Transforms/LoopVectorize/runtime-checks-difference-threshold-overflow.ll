; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals none --filter-out-after "vector.ph" --version 6
; RUN: opt %s -passes=loop-vectorize -force-vector-width=4096 -force-vector-interleave=3 -S | FileCheck %s

target datalayout = "e-p:16:16-n16"

; The diff check threshold 4096 * 3 * 8 does not fit the 16-bit index type.
define void @threshold_does_not_fit_index_type(ptr %a, ptr %b, i16 %n) {
; CHECK-LABEL: define void @threshold_does_not_fit_index_type(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i16 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A4:%.*]] = ptrtoaddr ptr [[A]] to i16
; CHECK-NEXT:    [[B3:%.*]] = ptrtoaddr ptr [[B]] to i16
; CHECK-NEXT:    [[TMP0:%.*]] = add i16 [[N]], -1
; CHECK-NEXT:    [[TMP1:%.*]] = zext i16 [[TMP0]] to i32
; CHECK-NEXT:    [[TMP2:%.*]] = add nuw nsw i32 [[TMP1]], 1
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i32 [[TMP2]], 12288
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], [[SCALAR_PH:label %.*]], label %[[VECTOR_MEMCHECK:.*]]
; CHECK:       [[VECTOR_MEMCHECK]]:
; CHECK-NEXT:    [[TMP3:%.*]] = sub i16 [[B3]], [[A4]]
; CHECK-NEXT:    [[TMP4:%.*]] = sub i16 [[TMP3]], 1
; CHECK-NEXT:    [[DIFF_CHECK:%.*]] = icmp ult i16 [[TMP4]], -1
; CHECK-NEXT:    br i1 [[DIFF_CHECK]], [[SCALAR_PH]], [[VECTOR_PH:label %.*]]
;
entry:
  br label %loop

loop:
  %iv = phi i16 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.a = getelementptr inbounds i64, ptr %a, i16 %iv
  %l = load i64, ptr %gep.a, align 8
  %add = add i64 %l, 1
  %gep.b = getelementptr inbounds i64, ptr %b, i16 %iv
  store i64 %add, ptr %gep.b, align 8
  %iv.next = add i16 %iv, 1
  %ec = icmp eq i16 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; Same as above, but in a nested loop with starts varying in the outer loop.
define void @nested_loop_threshold_does_not_fit_index_type(ptr %a, ptr %b, i16 %n) {
; CHECK-LABEL: define void @nested_loop_threshold_does_not_fit_index_type(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i16 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[A2:%.*]] = ptrtoaddr ptr [[A]] to i16
; CHECK-NEXT:    [[B1:%.*]] = ptrtoaddr ptr [[B]] to i16
; CHECK-NEXT:    [[TMP0:%.*]] = sub i16 [[B1]], [[A2]]
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[OUTER_IV:%.*]] = phi i16 [ 0, %[[ENTRY]] ], [ [[OUTER_IV_NEXT:%.*]], [[OUTER_LATCH:%.*]] ]
; CHECK-NEXT:    [[A_START:%.*]] = getelementptr inbounds i64, ptr [[A]], i16 [[OUTER_IV]]
; CHECK-NEXT:    [[B_START:%.*]] = getelementptr inbounds i64, ptr [[B]], i16 [[OUTER_IV]]
; CHECK-NEXT:    [[TMP1:%.*]] = add i16 [[N]], -1
; CHECK-NEXT:    [[TMP2:%.*]] = zext i16 [[TMP1]] to i32
; CHECK-NEXT:    [[TMP3:%.*]] = add nuw nsw i32 [[TMP2]], 1
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i32 [[TMP3]], 12288
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], [[SCALAR_PH:label %.*]], label %[[VECTOR_MEMCHECK:.*]]
; CHECK:       [[VECTOR_MEMCHECK]]:
; CHECK-NEXT:    [[TMP4:%.*]] = sub i16 [[TMP0]], 1
; CHECK-NEXT:    [[DIFF_CHECK:%.*]] = icmp ult i16 [[TMP4]], -1
; CHECK-NEXT:    br i1 [[DIFF_CHECK]], [[SCALAR_PH]], [[VECTOR_PH:label %.*]]
;
entry:
  br label %outer.header

outer.header:
  %outer.iv = phi i16 [ 0, %entry ], [ %outer.iv.next, %outer.latch ]
  %a.start = getelementptr inbounds i64, ptr %a, i16 %outer.iv
  %b.start = getelementptr inbounds i64, ptr %b, i16 %outer.iv
  br label %inner

inner:
  %iv = phi i16 [ 0, %outer.header ], [ %iv.next, %inner ]
  %gep.a = getelementptr inbounds i64, ptr %a.start, i16 %iv
  %l = load i64, ptr %gep.a, align 8
  %add = add i64 %l, 1
  %gep.b = getelementptr inbounds i64, ptr %b.start, i16 %iv
  store i64 %add, ptr %gep.b, align 8
  %iv.next = add i16 %iv, 1
  %ec = icmp eq i16 %iv.next, %n
  br i1 %ec, label %outer.latch, label %inner

outer.latch:
  %outer.iv.next = add i16 %outer.iv, 1
  %outer.ec = icmp eq i16 %outer.iv.next, %n
  br i1 %outer.ec, label %exit, label %outer.header

exit:
  ret void
}
