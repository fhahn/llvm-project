; RUN: opt -passes=loop-vectorize -mtriple=x86_64 -mattr=+avx2 -force-vector-width=4 -force-vector-interleave=1 -force-target-supports-masked-memory-ops -verify-each -vplan-verify-each -S < %s | FileCheck %s

; Uniform floating-point comparisons still produce vector masks. Keep the
; comparison vectorized instead of extracting and broadcasting its first lane.

define void @uniform_fcmp_mask(ptr noalias %dst, ptr noalias %src, i64 %trip.count, float %x, float %y) {
; CHECK-LABEL: define void @uniform_fcmp_mask(
; CHECK-SAME: ptr noalias [[DST:%.*]], ptr noalias [[SRC:%.*]], i64 [[TRIP_COUNT:%.*]], float [[X:%.*]], float [[Y:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[EMPTY:%.*]] = icmp eq i64 [[TRIP_COUNT]], 0
; CHECK-NEXT:    br i1 [[EMPTY]], label %[[EXIT:.*]], label %[[LOOP_PREHEADER:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[TRIP_COUNT]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[TMP0:%.*]] = and i64 [[TRIP_COUNT]], 3
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[TRIP_COUNT]], [[TMP0]]
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x float> poison, float [[Y]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x float> [[BROADCAST_SPLATINSERT]], <4 x float> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT1:%.*]] = insertelement <4 x float> poison, float [[X]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT2:%.*]] = shufflevector <4 x float> [[BROADCAST_SPLATINSERT1]], <4 x float> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP1:%.*]] = fcmp uno <4 x float> [[BROADCAST_SPLAT2]], [[BROADCAST_SPLAT]]
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX3:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT4:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr i32, ptr [[SRC]], i64 [[INDEX3]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP2]], align 4
; CHECK-NEXT:    [[TMP3:%.*]] = add <4 x i32> [[WIDE_LOAD]], splat (i32 29)
; CHECK-NEXT:    [[TMP4:%.*]] = getelementptr i32, ptr [[DST]], i64 [[INDEX3]]
; CHECK-NEXT:    call void @llvm.masked.store.v4i32.p0(<4 x i32> [[TMP3]], ptr align 4 [[TMP4]], <4 x i1> [[TMP1]])
; CHECK-NEXT:    [[INDEX_NEXT4]] = add nuw i64 [[INDEX3]], 4
; CHECK-NEXT:    [[TMP5:%.*]] = icmp eq i64 [[INDEX_NEXT4]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP5]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[TRIP_COUNT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], label %[[EXIT_LOOPEXIT:.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
; CHECK-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i64 [ [[N_VEC]], %[[MIDDLE_BLOCK]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ [[INDEX_NEXT:%.*]], %[[LATCH:.*]] ], [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ]
; CHECK-NEXT:    [[SRC_PTR:%.*]] = getelementptr i32, ptr [[SRC]], i64 [[INDEX]]
; CHECK-NEXT:    [[VALUE:%.*]] = load i32, ptr [[SRC_PTR]], align 4
; CHECK-NEXT:    [[X_IS_NAN:%.*]] = fcmp uno float [[X]], [[X]]
; CHECK-NEXT:    [[Y_IS_NAN:%.*]] = fcmp uno float [[Y]], [[Y]]
; CHECK-NEXT:    [[EITHER_IS_NAN:%.*]] = or i1 [[X_IS_NAN]], [[Y_IS_NAN]]
; CHECK-NEXT:    br i1 [[EITHER_IS_NAN]], label %[[STORE:.*]], label %[[LATCH]]
; CHECK:       [[STORE]]:
; CHECK-NEXT:    [[RESULT:%.*]] = add i32 [[VALUE]], 29
; CHECK-NEXT:    [[DST_PTR:%.*]] = getelementptr i32, ptr [[DST]], i64 [[INDEX]]
; CHECK-NEXT:    store i32 [[RESULT]], ptr [[DST_PTR]], align 4
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[INDEX_NEXT]] = add i64 [[INDEX]], 1
; CHECK-NEXT:    [[CONTINUE:%.*]] = icmp ult i64 [[INDEX_NEXT]], [[TRIP_COUNT]]
; CHECK-NEXT:    br i1 [[CONTINUE]], label %[[LOOP]], label %[[EXIT_LOOPEXIT]], !llvm.loop [[LOOP3:![0-9]+]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %empty = icmp eq i64 %trip.count, 0
  br i1 %empty, label %exit, label %loop

loop:
  %index = phi i64 [ 0, %entry ], [ %index.next, %latch ]
  %src.ptr = getelementptr i32, ptr %src, i64 %index
  %value = load i32, ptr %src.ptr, align 4
  %x.is.nan = fcmp uno float %x, %x
  %y.is.nan = fcmp uno float %y, %y
  %either.is.nan = or i1 %x.is.nan, %y.is.nan
  br i1 %either.is.nan, label %store, label %latch

store:
  %result = add i32 %value, 29
  %dst.ptr = getelementptr i32, ptr %dst, i64 %index
  store i32 %result, ptr %dst.ptr, align 4
  br label %latch

latch:
  %index.next = add i64 %index, 1
  %continue = icmp ult i64 %index.next, %trip.count
  br i1 %continue, label %loop, label %exit, !llvm.loop !0

exit:
  ret void
}

!0 = distinct !{!0, !1}
!1 = !{!"llvm.loop.vectorize.enable"}
