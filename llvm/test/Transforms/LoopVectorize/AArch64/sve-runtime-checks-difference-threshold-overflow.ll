; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals none --filter-out-after "vector.ph" --version 6
; RUN: opt %s -passes=loop-vectorize -force-vector-width=4096 -force-vector-interleave=3 -scalable-vectorization=on -S | FileCheck %s

target datalayout = "e-p:16:16-n16"
target triple = "aarch64-unknown-linux-gnu"

; The diff check threshold vscale * 4096 * 3 does not fit the 16-bit index type
; for vscale >= 8.
define void @threshold_does_not_fit_index_type(ptr %a, ptr %b, i16 %n) #0 {
; CHECK-LABEL: define void @threshold_does_not_fit_index_type(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i16 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A4:%.*]] = ptrtoaddr ptr [[A]] to i16
; CHECK-NEXT:    [[B3:%.*]] = ptrtoaddr ptr [[B]] to i16
; CHECK-NEXT:    [[TMP0:%.*]] = add i16 [[N]], -1
; CHECK-NEXT:    [[TMP1:%.*]] = zext i16 [[TMP0]] to i32
; CHECK-NEXT:    [[TMP2:%.*]] = add nuw nsw i32 [[TMP1]], 1
; CHECK-NEXT:    [[TMP3:%.*]] = call i32 @llvm.vscale.i32()
; CHECK-NEXT:    [[TMP4:%.*]] = mul nuw i32 [[TMP3]], 12288
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i32 [[TMP2]], [[TMP4]]
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], [[SCALAR_PH:label %.*]], label %[[VECTOR_MEMCHECK:.*]]
; CHECK:       [[VECTOR_MEMCHECK]]:
; CHECK-NEXT:    [[TMP8:%.*]] = sub i16 [[B3]], [[A4]]
; CHECK-NEXT:    [[TMP9:%.*]] = sub i16 [[TMP8]], 1
; CHECK-NEXT:    [[DIFF_CHECK:%.*]] = icmp ult i16 [[TMP9]], -1
; CHECK-NEXT:    br i1 [[DIFF_CHECK]], [[SCALAR_PH]], [[VECTOR_PH:label %.*]]
;
entry:
  br label %loop

loop:
  %iv = phi i16 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.a = getelementptr inbounds i8, ptr %a, i16 %iv
  %l = load i8, ptr %gep.a, align 1
  %add = add i8 %l, 1
  %gep.b = getelementptr inbounds i8, ptr %b, i16 %iv
  store i8 %add, ptr %gep.b, align 1
  %iv.next = add i16 %iv, 1
  %ec = icmp eq i16 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

