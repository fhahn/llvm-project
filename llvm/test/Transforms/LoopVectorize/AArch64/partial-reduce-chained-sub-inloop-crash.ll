; CHECK-NEXT:    [[VEC_PHI11:%.*]] = phi i32 [ [[BC_MERGE_RDX]], %[[VEC_EPILOG_PH]] ], [ [[TMP60:%.*]], %[[VEC_EPILOG_VECTOR_BODY]] ]
