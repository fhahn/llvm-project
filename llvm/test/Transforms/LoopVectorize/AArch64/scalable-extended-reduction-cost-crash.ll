entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  %gep = getelementptr inbounds i16, ptr %b, i64 %iv
  %v = load i16, ptr %gep, align 2
  %ext = sext i16 %v to i32
  %acc.next = add nsw i32 %acc, %ext
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 10240
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %acc.next
}

