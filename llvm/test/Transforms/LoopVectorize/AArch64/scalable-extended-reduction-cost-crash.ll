; CHECK-NEXT:    [[ACC_NEXT]] = add nsw i32 [[ACC]], [[EXT]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], 10240
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT1]], label %[[LOOP]], !llvm.loop [[LOOP9:![0-9]+]]
; CHECK:       [[EXIT1]]:
; CHECK-NEXT:    [[ACC_NEXT_LCSSA:%.*]] = phi i32 [ [[ACC_NEXT]], %[[LOOP]] ], [ [[BIN_RDX8]], %[[MIDDLE_BLOCK]] ]
; CHECK-NEXT:    ret i32 [[ACC_NEXT_LCSSA]]
