; RUN: opt -p loop-vectorize -force-vector-width=4 -S %s | FileCheck %s

target triple = "arm64-apple-macosx"

; Speculative-load early-exit vectorization: calls in the loop body. The
; speculative-load helper replays live calls in its scalar loop; dead calls
; and GEPs are cleaned up and do not prevent vectorization.

; A live call feeding the exit condition (llvm.abs). The speculative-load
; helper replays the call in its scalar loop.
define i32 @live_call(ptr %p, i64 %n) {
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep = getelementptr inbounds i8, ptr %p, i64 %iv
  %ld = load i8, ptr %gep, align 1
  %abs = call i8 @llvm.abs.i8(i8 %ld, i1 false)
  %ext = zext i8 %abs to i32
  %cmp = icmp sgt i32 %ext, 42
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i32 1

exit:
  ret i32 0
}

; A dead call is removed and does not prevent vectorization.
define i32 @dead_call(ptr %p, i64 %n) {
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %dead = call i8 @llvm.abs.i8(i8 0, i1 false)
  %gep = getelementptr inbounds i8, ptr %p, i64 %iv
  %ld = load i8, ptr %gep, align 1
  %ext = zext i8 %ld to i32
  %cmp = icmp sgt i32 %ext, 42
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i32 1

exit:
  ret i32 0
}

; A dead GEP with constant operands in an early-exit loop with
; speculative loads does not crash during VPlan simplification. The GEP
; has no underlying instruction after speculative-load helper cloning, so
; tryToFoldLiveIns must handle the null underlying value. The loop is
; still vectorized.
define i32 @dead_gep(ptr %p, i64 %n) {
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %dead.gep = getelementptr i8, ptr null, i64 8
  %gep = getelementptr inbounds i8, ptr %p, i64 %iv
  %ld = load i8, ptr %gep, align 1
  %ext = zext i8 %ld to i32
  %cmp = icmp sgt i32 %ext, 42
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i32 1

exit:
  ret i32 0
}


declare i8 @llvm.abs.i8(i8, i1 immarg) #0

attributes #0 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
