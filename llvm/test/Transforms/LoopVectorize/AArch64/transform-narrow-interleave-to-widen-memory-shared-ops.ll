; RUN: opt -p loop-vectorize -mcpu=apple-m1 -force-vector-interleave=1 -S %s | FileCheck %s

target triple = "arm64-apple-macosx"

; A[2i+j] = B[2i+j] * S[Idx[i]]: the replicated chain loading S, including a
; sext, is shared by all members down to the scalar steps.
define void @shared_replicated_load(ptr noalias %A, ptr noalias %B, ptr noalias %S, ptr noalias %Idx, i64 %n) {
; CHECK-LABEL: define void @shared_replicated_load(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr noalias [[B:%.*]], ptr noalias [[S:%.*]], ptr noalias [[IDX:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 2
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr inbounds i32, ptr [[IDX]], i64 [[INDEX]]
; CHECK-NEXT:    [[TMP1:%.*]] = load i32, ptr [[TMP0]], align 4
; CHECK-NEXT:    [[TMP2:%.*]] = sext i32 [[TMP1]] to i64
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr inbounds double, ptr [[S]], i64 [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = load double, ptr [[TMP3]], align 8
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <2 x double> poison, double [[TMP4]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <2 x double> [[BROADCAST_SPLATINSERT]], <2 x double> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP5:%.*]] = shl nuw nsw i64 [[INDEX]], 1
; CHECK-NEXT:    [[TMP6:%.*]] = getelementptr inbounds double, ptr [[B]], i64 [[TMP5]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <2 x double>, ptr [[TMP6]], align 8
; CHECK-NEXT:    [[TMP7:%.*]] = fmul <2 x double> [[WIDE_LOAD]], [[BROADCAST_SPLAT]]
; CHECK-NEXT:    [[TMP8:%.*]] = getelementptr inbounds double, ptr [[A]], i64 [[TMP5]]
; CHECK-NEXT:    store <2 x double> [[TMP7]], ptr [[TMP8]], align 8
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 1
; CHECK-NEXT:    [[TMP9:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[TMP9]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br [[EXIT:label %.*]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %idx.p = getelementptr inbounds i32, ptr %Idx, i64 %iv
  %idx = load i32, ptr %idx.p, align 4
  %idx.ext = sext i32 %idx to i64
  %s.p = getelementptr inbounds double, ptr %S, i64 %idx.ext
  %s = load double, ptr %s.p, align 8
  %i0 = shl nuw nsw i64 %iv, 1
  %i1 = or disjoint i64 %i0, 1
  %b0.p = getelementptr inbounds double, ptr %B, i64 %i0
  %b1.p = getelementptr inbounds double, ptr %B, i64 %i1
  %b0 = load double, ptr %b0.p, align 8
  %b1 = load double, ptr %b1.p, align 8
  %r0 = fmul double %b0, %s
  %r1 = fmul double %b1, %s
  %a0.p = getelementptr inbounds double, ptr %A, i64 %i0
  %a1.p = getelementptr inbounds double, ptr %A, i64 %i1
  store double %r0, ptr %a0.p, align 8
  store double %r1, ptr %a1.p, align 8
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; The shared trunc is created by VPlan simplification and has no underlying
; instruction.
define void @shared_cast_without_underlying_instr(ptr noalias %A, ptr noalias %B, i64 %n) {
; CHECK-LABEL: define void @shared_cast_without_underlying_instr(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr noalias [[B:%.*]], i64 [[N:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr inbounds i64, ptr [[B]], i64 [[INDEX]]
; CHECK-NEXT:    [[TMP1:%.*]] = load i64, ptr [[TMP0]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = trunc i64 [[TMP1]] to i32
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i32> poison, i32 [[TMP2]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i32> [[BROADCAST_SPLATINSERT]], <4 x i32> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP3:%.*]] = shl nuw nsw i64 [[INDEX]], 2
; CHECK-NEXT:    [[TMP4:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[TMP3]]
; CHECK-NEXT:    store <4 x i32> [[BROADCAST_SPLAT]], ptr [[TMP4]], align 4
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 1
; CHECK-NEXT:    [[TMP5:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[TMP5]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP4:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br [[EXIT:label %.*]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %b.p = getelementptr inbounds i64, ptr %B, i64 %iv
  %b = load i64, ptr %b.p, align 8
  %z = zext i64 %b to i128
  %t = trunc i128 %z to i32
  %i0 = shl nuw nsw i64 %iv, 2
  %i1 = or disjoint i64 %i0, 1
  %i2 = or disjoint i64 %i0, 2
  %i3 = or disjoint i64 %i0, 3
  %a0.p = getelementptr inbounds i32, ptr %A, i64 %i0
  %a1.p = getelementptr inbounds i32, ptr %A, i64 %i1
  %a2.p = getelementptr inbounds i32, ptr %A, i64 %i2
  %a3.p = getelementptr inbounds i32, ptr %A, i64 %i3
  store i32 %t, ptr %a0.p, align 4
  store i32 %t, ptr %a1.p, align 4
  store i32 %t, ptr %a2.p, align 4
  store i32 %t, ptr %a3.p, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

