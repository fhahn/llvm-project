  %ld = load i8, ptr %gep.src, align 1
  %ext = zext i8 %ld to i32
  %mul = mul i32 %ext, 3
  %trunc = trunc i32 %mul to i8
  %gep.dst = getelementptr inbounds i8, ptr %dst, i64 %iv
  store i8 %trunc, ptr %gep.dst, align 1
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp ult i64 %iv.next, 19
