; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; Regression test for a loop-vectorizer miscompile: narrowInterleaveGroups
; must not preserve the poison-generating flags of the first interleave-group
; member on the narrowed wide operation when other members carry weaker (or no)
; flags, as that would refine a previously-defined scalar value into poison.
;
; In the input, member 0 uses an `or disjoint` and member 1 uses a plain `or`.
; After narrowing to a single `or` over a <2 x i64>, keeping the `disjoint`
; flag would poison the lane coming from member 1 whenever its low bit is set,
; even though the scalar code was defined there (x | 1 == x). The same applies
; to `add nsw`/`add` and `udiv exact`/`udiv`.
;
; narrowInterleaveGroupOp intersects the flags across all interleave-group
; members (VPRecipeWithIRFlags::intersectFlags), so the narrowed operation
; carries no poison-generating flag when the members disagree.
;
; RUN: opt -passes=loop-vectorize -force-vector-width=2 \
; RUN:     -force-vector-interleave=1 -S %s | FileCheck %s

target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

define void @flag_mismatch_disjoint(ptr noalias %dst, ptr noalias %src) {
; CHECK-LABEL: define void @flag_mismatch_disjoint(
; CHECK-SAME: ptr noalias [[DST:%.*]], ptr noalias [[SRC:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = shl nsw i64 [[INDEX]], 1
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds i64, ptr [[SRC]], i64 [[TMP0]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <2 x i64>, ptr [[TMP1]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = or <2 x i64> [[WIDE_LOAD]], splat (i64 1)
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr inbounds i64, ptr [[DST]], i64 [[TMP0]]
; CHECK-NEXT:    store <2 x i64> [[TMP2]], ptr [[TMP3]], align 8
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 1
; CHECK-NEXT:    [[TMP4:%.*]] = icmp eq i64 [[INDEX_NEXT]], 100
; CHECK-NEXT:    br i1 [[TMP4]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
; After the fix the `disjoint` flag must be dropped because only one
; member of the original interleave group had it.
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %mul.2 = shl nsw i64 %iv, 1
  %p0 = getelementptr inbounds i64, ptr %src, i64 %mul.2
  %l0 = load i64, ptr %p0, align 8
  %a0 = or disjoint i64 %l0, 1                 ; disjoint on member 0
  %d0 = getelementptr inbounds i64, ptr %dst, i64 %mul.2
  store i64 %a0, ptr %d0, align 8
  %idx.1 = or disjoint i64 %mul.2, 1
  %p1 = getelementptr inbounds i64, ptr %src, i64 %idx.1
  %l1 = load i64, ptr %p1, align 8
  %a1 = or i64 %l1, 1                          ; no disjoint on member 1
  %d1 = getelementptr inbounds i64, ptr %dst, i64 %idx.1
  store i64 %a1, ptr %d1, align 8
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 100
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

