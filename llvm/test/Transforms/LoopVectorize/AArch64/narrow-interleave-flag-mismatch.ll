; Narrowing an interleave group must intersect the poison-generating flags of
; all members, not keep those of the first member.

target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

define void @or_disjoint_only_on_member_0(ptr noalias %src, ptr noalias %dst) {
; CHECK-LABEL: define void @or_disjoint_only_on_member_0(
; CHECK-SAME: ptr noalias [[SRC:%.*]], ptr noalias [[DST:%.*]]) {
