; RUN: opt -p loop-vectorize -force-vector-width=4 -S %s | FileCheck %s

target triple = "arm64-apple-macosx"

; Regression tests for poison handling in the speculative-load early-exit
; vectorization path. A function marked FIXME is currently vectorized
; incorrectly, and its CHECK lines capture the current (buggy) output so that
; the eventual fix produces a visible, reviewable diff.

; FIXME: Re-poisoning via arithmetic flags. The speculative load produces
; poison in the trailing lanes past the one taking the early exit. The result
; is frozen, but arithmetic on the frozen value keeps its poison-generating
; flags (here `add nsw`), so a lane whose frozen value overflows re-introduces
; poison. That poison then flows into the *unfrozen* compare feeding
; @llvm.experimental.cttz.elts (note the freeze feeds only the reduce.or exit
; test, not the cttz.elts index computation), which computes the exit lane
; index -- a poison exit index is a miscompile. The nsw flag on the widened
; add should be dropped (or the cttz.elts input should be the frozen mask).
define i64 @repoison_via_nsw_flag(ptr %A, i64 %n) {
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i32, ptr %A, i64 %iv
  %ld.A = load i32, ptr %gep.A, align 4
  %scaled = add nsw i32 %ld.A, %ld.A
  %cmp = icmp eq i32 %scaled, 42
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; A poison value in the exit condition shares the live-in used as the oracle's
; chunk-start placeholder. The oracle must bind the placeholder by setting the
; replayed induction's start operand directly, not via replaceAllUsesWith, so
; the user's own poison stays `or i64 %{{.*}}, poison`.
define i64 @shared_poison_livein_rewritten(ptr %A, i64 %n) {
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i32, ptr %A, i64 %iv
  %ld.A = load i32, ptr %gep.A, align 4
  %ld.ext = sext i32 %ld.A to i64
  %poisoned = or i64 %ld.ext, poison
  %cmp = icmp eq i64 %poisoned, 42
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}
