; RUN: opt -p loop-vectorize -force-vector-width=4 -S %s | FileCheck %s

target triple = "arm64-apple-macosx"

; Speculative-load early-exit vectorization: different element types and
; multiple loads sharing a single speculative-load helper.

; i16 element type.
define i64 @i16_loads(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i16, ptr %A, i64 %iv
  %ld.A = load i16, ptr %gep.A, align 2
  %gep.B = getelementptr inbounds i16, ptr %B, i64 %iv
  %ld.B = load i16, ptr %gep.B, align 2
  %cmp = icmp eq i16 %ld.A, %ld.B
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; i32 element type: larger per-lane element size for the speculative-load
; helper's byte count.
define i64 @i32_loads(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i32, ptr %A, i64 %iv
  %ld.A = load i32, ptr %gep.A, align 4
  %gep.B = getelementptr inbounds i32, ptr %B, i64 %iv
  %ld.B = load i32, ptr %gep.B, align 4
  %cmp = icmp ne i32 %ld.A, %ld.B
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; Three loads: compare (A[i] + B[i]) against C[i].
define i64 @three_loads(ptr %A, ptr %B, ptr %C, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i8, ptr %B, i64 %iv
  %ld.B = load i8, ptr %gep.B, align 1
  %gep.C = getelementptr inbounds i8, ptr %C, i64 %iv
  %ld.C = load i8, ptr %gep.C, align 1
  %sum.ab = add i8 %ld.A, %ld.B
  %cmp = icmp eq i8 %sum.ab, %ld.C
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}
; Negative: pointer element type. A <VF x ptr> speculative load has no
; primitive size, so the loop must not be speculatively vectorized.
define i64 @ptr_loads(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds ptr, ptr %A, i64 %iv
  %ld.A = load ptr, ptr %gep.A, align 8
  %gep.B = getelementptr inbounds ptr, ptr %B, i64 %iv
  %ld.B = load ptr, ptr %gep.B, align 8
  %cmp = icmp ne ptr %ld.A, %ld.B
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; Negative: sub-byte integer element type. A <VF x i1> speculative load is not
; a whole number of bytes, so the loop must not be speculatively vectorized.
define i64 @i1_loads(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i1, ptr %A, i64 %iv
  %ld.A = load i1, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i1, ptr %B, i64 %iv
  %ld.B = load i1, ptr %gep.B, align 1
  %cmp = icmp ne i1 %ld.A, %ld.B
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}
