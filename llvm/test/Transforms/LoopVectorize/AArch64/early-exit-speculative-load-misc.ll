; RUN: opt -p loop-vectorize -force-vector-width=4 -S %s | FileCheck %s

target triple = "arm64-apple-macosx"

; Speculative-load early-exit vectorization: miscellaneous loop shapes
; (conditional exits, multi-block bodies, sentinel trip counts, interleaving).

; Exit condition in a conditional block (masked). The speculative-load
; helper replays the conditional structure, only entering the comparison
; block when the mask is set. All speculative loads use the same byte
; count from the helper.
define i64 @conditional_exit(ptr %mask, ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.mask = getelementptr inbounds i8, ptr %mask, i64 %iv
  %ld.mask = load i8, ptr %gep.mask, align 1
  %mask.cmp = icmp ne i8 %ld.mask, 0
  br i1 %mask.cmp, label %check, label %loop.latch

check:
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i8, ptr %B, i64 %iv
  %ld.B = load i8, ptr %gep.B, align 1
  %cmp = icmp ne i8 %ld.A, %ld.B
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; The speculative-load helper expansion preserves correct predecessor
; ordering for phi nodes in multi-block loop bodies. The loop body has a
; conditional branch leading to two blocks that merge at a phi node
; before the early exit check.
define ptr @multiblock_phi(i64 %n) {
entry:
  br label %header

latch.exit:
  ret ptr null

header:
  %iv = phi i64 [ %iv.next, %latch ], [ 0, %entry ]
  br i1 false, label %if.true, label %if.false

if.true:
  %gep.i16 = getelementptr [2 x i8], ptr null, i64 %iv
  %ld.i16 = load i16, ptr %gep.i16, align 2
  br label %merge

if.false:
  %gep.i32 = getelementptr [4 x i8], ptr null, i64 %iv
  %ld.i32 = load i32, ptr %gep.i32, align 4
  br label %merge

merge:
  %val = phi i32 [ %ld.i32, %if.false ], [ 1, %if.true ]
  %cmp = icmp eq i32 %val, 0
  br i1 %cmp, label %latch, label %early.exit

latch:
  %iv.next = add i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %latch.exit, label %header

early.exit:
  ret ptr null
}

; The trip count %n is also the sentinel value the early-exit condition
; compares against (find-sentinel pattern). The speculative-load helper
; must replay the real exit condition `icmp eq %ld, %n`, not have %n
; clobbered by the trip-count teardown.
define i64 @trip_count_is_sentinel(ptr %A, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %conv = sext i8 %ld.A to i64
  %cmp = icmp eq i64 %conv, %n
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; A user-forced interleave count must not interleave a loop using a
; speculative-load helper: the helper's canonical-IV operand is not
; offset per unrolled part, so parts >= 1 would replay the wrong lane
; window. The loop is vectorized with UF=1 (a single helper, no per-part
; pointer offset).
define i64 @no_interleave_with_forced_ic(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i8, ptr %B, i64 %iv
  %ld.B = load i8, ptr %gep.B, align 1
  %cmp = icmp ne i8 %ld.A, %ld.B
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit, !llvm.loop !0

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

!0 = distinct !{!0, !1}
!1 = !{!"llvm.loop.interleave.count", i32 4}
