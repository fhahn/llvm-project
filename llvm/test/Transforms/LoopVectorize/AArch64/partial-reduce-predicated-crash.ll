; Regression test for a loop-vectorizer crash in partial-reduction chain
; construction. For a *predicated* (conditional) partial-reduction chain
; `acc.next = select(%cond, add(acc, ext*ext), acc)`, the exit value of the
; chain is found via findUserOf matching the select. The matched select recipe
; is a widened select (a VPWidenRecipe), not a VPInstruction, so casting it
; narrowly to VPInstruction used to assert; and because the select condition is
; only defined after the reduction's binary op, the new reduction recipe must
; be anchored at the select rather than before the binary op to avoid a
; use-before-def. Both are handled in VPlanTransforms::transformToPartialReduction;
; the masked-off lanes contribute the additive identity (0) to the reduction.

target triple = "aarch64-unknown-linux-gnu"

define i32 @predicated_dotprod(ptr %a, ptr %b, i32 %n) {
; CHECK-LABEL: define i32 @predicated_dotprod(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i32 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i32 [[N]], 32
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_SCEVCHECK:.*]]
; CHECK:       [[VECTOR_SCEVCHECK]]:
; CHECK-NEXT:    [[TMP0:%.*]] = add i32 [[N]], -1
; CHECK-NEXT:    [[TMP1:%.*]] = icmp slt i32 [[TMP0]], 0
; CHECK-NEXT:    br i1 [[TMP1]], label %[[SCALAR_PH]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[N_MOD_VF:%.*]] = and i32 [[N]], 31
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i32 [[N]], [[N_MOD_VF]]
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i32 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[VEC_PHI:%.*]] = phi <4 x i32> [ zeroinitializer, %[[VECTOR_PH]] ], [ [[PARTIAL_REDUCE:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[VEC_PHI2:%.*]] = phi <4 x i32> [ zeroinitializer, %[[VECTOR_PH]] ], [ [[PARTIAL_REDUCE6:%.*]], %[[VECTOR_BODY]] ]
