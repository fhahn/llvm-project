; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi i32 [ [[BC_MERGE_RDX]], %[[SCALAR_PH]] ], [ [[ACC_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GA:%.*]] = getelementptr inbounds i8, ptr [[A]], i32 [[IV]]
; CHECK-NEXT:    [[GB:%.*]] = getelementptr inbounds i8, ptr [[B]], i32 [[IV]]
; CHECK-NEXT:    [[AV:%.*]] = load i8, ptr [[GA]], align 1
; CHECK-NEXT:    [[BV:%.*]] = load i8, ptr [[GB]], align 1
; CHECK-NEXT:    [[AX:%.*]] = sext i8 [[AV]] to i32
; CHECK-NEXT:    [[BX:%.*]] = sext i8 [[BV]] to i32
; CHECK-NEXT:    [[MUL:%.*]] = mul i32 [[AX]], [[BX]]
; CHECK-NEXT:    [[ADD:%.*]] = add i32 [[ACC]], [[MUL]]
; CHECK-NEXT:    [[POS:%.*]] = icmp sgt i8 [[AV]], 0
; CHECK-NEXT:    [[ACC_NEXT]] = select i1 [[POS]], i32 [[ADD]], i32 [[ACC]]
; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT]], label %[[LOOP]], !llvm.loop [[LOOP3:![0-9]+]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[ACC_NEXT_LCSSA:%.*]] = phi i32 [ [[ACC_NEXT]], %[[LOOP]] ], [ [[TMP17]], %[[MIDDLE_BLOCK]] ]
; CHECK-NEXT:    ret i32 [[ACC_NEXT_LCSSA]]
;
entry:
  br label %loop
loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  %ga = getelementptr inbounds i8, ptr %a, i32 %iv
  %gb = getelementptr inbounds i8, ptr %b, i32 %iv
  %av = load i8, ptr %ga
  %bv = load i8, ptr %gb
  %ax = sext i8 %av to i32
  %bx = sext i8 %bv to i32
  %mul = mul i32 %ax, %bx
  %add = add i32 %acc, %mul
  %pos = icmp sgt i8 %av, 0
  %acc.next = select i1 %pos, i32 %add, i32 %acc
  %iv.next = add i32 %iv, 1
  %ec = icmp eq i32 %iv.next, %n
  br i1 %ec, label %exit, label %loop
exit:
  ret i32 %acc.next
}

