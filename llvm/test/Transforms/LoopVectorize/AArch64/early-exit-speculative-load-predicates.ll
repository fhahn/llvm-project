; RUN: opt -p loop-vectorize -force-vector-width=4 -S %s | FileCheck %s

target triple = "arm64-apple-macosx"

; Speculative-load early-exit vectorization: exit conditions using different
; icmp/fcmp predicates and comparison operands (constants, arguments).

; Basic: two i8 loads compared with icmp ne.
define i64 @icmp_ne_i8(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i8, ptr %B, i64 %iv
  %ld.B = load i8, ptr %gep.B, align 1
  %cmp = icmp ne i8 %ld.A, %ld.B
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; icmp eq predicate (different from ne).
define i64 @icmp_eq_i8(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i8, ptr %B, i64 %iv
  %ld.B = load i8, ptr %gep.B, align 1
  %cmp = icmp eq i8 %ld.A, %ld.B
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

