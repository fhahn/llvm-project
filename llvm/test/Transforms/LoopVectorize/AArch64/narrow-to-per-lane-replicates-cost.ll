  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %c.next = add i32 %c, 1
  store i32 %c.next, ptr %count, align 4
  %hb = lshr i64 %iv, %sh
  %cmp = icmp eq i64 %hb, 0
  %sel = select i1 %cmp, ptr %A, ptr %B
  %z = zext i32 %c to i64
  %gep = getelementptr [8 x i8], ptr %ptrs, i64 %z
  store ptr %sel, ptr %gep, align 8
  %iv.next = add i64 %iv, 1
  %ec = icmp eq i64 %iv, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
