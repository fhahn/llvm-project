; RUN: opt -p loop-vectorize -force-vector-width=4 -S %s | FileCheck %s

target triple = "arm64-apple-macosx"

; Speculative-load early-exit vectorization: induction variable variants
; (non-canonical start/step, narrow IV type, unsupported pointer IV).

; Non-canonical induction (start=10, step=1) used for GEP indexing.
; The speculative-load helper must compute DerivedIV = 10 + AdjustedIV
; via VPDerivedIVRecipe.
define i64 @noncanonical_start(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %iv.off = phi i64 [ 10, %entry ], [ %iv.off.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv.off
  %ld.A = load i8, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i8, ptr %B, i64 %iv.off
  %ld.B = load i8, ptr %gep.B, align 1
  %cmp = icmp ne i8 %ld.A, %ld.B
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %iv.off.next = add nuw nsw i64 %iv.off, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; Non-canonical induction (start=0, step=2) used as comparison operand
; (not for GEP, so loads stay contiguous). The speculative-load helper
; must compute DerivedIV = AdjustedIV * 2 via VPDerivedIVRecipe.
define i64 @noncanonical_step(ptr %A, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %iv.2 = phi i64 [ 0, %entry ], [ %iv.2.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %trunc = trunc i64 %iv.2 to i8
  %cmp = icmp ne i8 %ld.A, %trunc
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %iv.2.next = add nuw nsw i64 %iv.2, 2
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; The speculative-load helper correctly handles an i32 induction
; variable; its trip count must match the IV type.
define i32 @i32_iv(ptr %A, ptr %B, i32 %n) {
entry:
  %cmp.entry = icmp sgt i32 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i32 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i8, ptr %B, i32 %iv
  %ld.B = load i8, ptr %gep.B, align 1
  %cmp = icmp ne i8 %ld.A, %ld.B
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i32 %iv, 1
  %ec = icmp ne i32 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i32 %iv

exit:
  ret i32 -1
}

; Pointer induction variable. The speculative-load helper cannot offset
; pointer IVs by lane, so the loop is not vectorized.
; TODO: support pointer induction variables in the helper.
define i64 @no_vectorize_pointer_iv(ptr %begin, ptr %end) {
entry:
  %is.empty = icmp eq ptr %begin, %end
  br i1 %is.empty, label %exit, label %loop

loop:
  %ptr = phi ptr [ %begin, %entry ], [ %ptr.next, %loop.latch ]
  %ld = load i8, ptr %ptr, align 1
  %cmp = icmp eq i8 %ld, 42
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %ptr.next = getelementptr inbounds i8, ptr %ptr, i64 1
  %done = icmp eq ptr %ptr.next, %end
  br i1 %done, label %exit, label %loop

early.exit:
  %iv = ptrtoint ptr %ptr to i64
  ret i64 %iv

exit:
  ret i64 -1
}
