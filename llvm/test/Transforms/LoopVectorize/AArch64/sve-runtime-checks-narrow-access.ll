; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals none --filter-out-after "^vector.ph:" --version 6
; RUN: opt -p loop-vectorize -mattr=+sve -force-vector-width="vscale x 2" \
; RUN:   -force-vector-interleave=1 -S %s | FileCheck %s

target triple = "aarch64-unknown-linux-gnu"

; for (i = 0; i < n; i++)
;   b[i] = *(int *)&a[i];
; With VF = vscale x 2, a check of the distance between %a and %b compares it
; against 32 * vscale - 1, which fits in 64 bits iff vscale <= 2^59, and
; vscale is unbounded without vscale_range.
define void @narrow_load_no_vscale_range(ptr %a, ptr %b, i64 %n) {
; CHECK-LABEL: define void @narrow_load_no_vscale_range(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = call i64 @llvm.vscale.i64()
; CHECK-NEXT:    [[TMP1:%.*]] = shl nuw i64 [[TMP0]], 1
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ule i64 [[N]], [[TMP1]]
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], [[SCALAR_PH:label %.*]], label %[[VECTOR_MEMCHECK:.*]]
; CHECK:       [[VECTOR_MEMCHECK]]:
; CHECK-NEXT:    [[TMP2:%.*]] = shl i64 [[N]], 3
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr i8, ptr [[B]], i64 [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = add i64 [[TMP2]], -4
; CHECK-NEXT:    [[TMP5:%.*]] = getelementptr i8, ptr [[A]], i64 [[TMP4]]
; CHECK-NEXT:    [[BOUND0:%.*]] = icmp ult ptr [[B]], [[TMP5]]
; CHECK-NEXT:    [[BOUND1:%.*]] = icmp ult ptr [[A]], [[TMP3]]
; CHECK-NEXT:    [[FOUND_CONFLICT:%.*]] = and i1 [[BOUND0]], [[BOUND1]]
; CHECK-NEXT:    br i1 [[FOUND_CONFLICT]], [[SCALAR_PH]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.a = getelementptr inbounds i64, ptr %a, i64 %iv
  %l = load i32, ptr %gep.a, align 4
  %ext = sext i32 %l to i64
  %gep.b = getelementptr inbounds i64, ptr %b, i64 %iv
  store i64 %ext, ptr %gep.b, align 8
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; narrow_load_no_vscale_range in a loop nest, whose starts advance by the same
; step in the outer loop.
; for (i = 0; i < m; i++)
;   for (j = 0; j < n; j++)
;     b[i * n + j] = *(int *)&a[i * n + j];
define void @narrow_load_no_vscale_range_outer_loop(ptr %a, ptr %b, i64 %m, i64 %n) {
; CHECK-LABEL: define void @narrow_load_no_vscale_range_outer_loop(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i64 [[M:%.*]], i64 [[N:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = mul i64 [[N]], [[M]]
; CHECK-NEXT:    [[TMP1:%.*]] = shl i64 [[TMP0]], 3
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[B]], i64 [[TMP1]]
; CHECK-NEXT:    [[TMP2:%.*]] = shl i64 [[N]], 3
; CHECK-NEXT:    [[TMP3:%.*]] = add i64 [[TMP1]], -4
; CHECK-NEXT:    [[SCEVGEP1:%.*]] = getelementptr i8, ptr [[A]], i64 [[TMP3]]
; CHECK-NEXT:    br label %[[OUTER_LOOP:.*]]
; CHECK:       [[OUTER_LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], [[INNER_EXIT:%.*]] ]
; CHECK-NEXT:    [[ROW:%.*]] = mul nuw nsw i64 [[I]], [[N]]
; CHECK-NEXT:    [[TMP4:%.*]] = call i64 @llvm.vscale.i64()
; CHECK-NEXT:    [[TMP5:%.*]] = shl nuw i64 [[TMP4]], 1
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ule i64 [[N]], [[TMP5]]
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], [[SCALAR_PH:label %.*]], label %[[VECTOR_MEMCHECK:.*]]
; CHECK:       [[VECTOR_MEMCHECK]]:
; CHECK-NEXT:    [[BOUND0:%.*]] = icmp ult ptr [[B]], [[SCEVGEP1]]
; CHECK-NEXT:    [[BOUND1:%.*]] = icmp ult ptr [[A]], [[SCEVGEP]]
; CHECK-NEXT:    [[FOUND_CONFLICT:%.*]] = and i1 [[BOUND0]], [[BOUND1]]
; CHECK-NEXT:    [[STRIDE_CHECK:%.*]] = icmp slt i64 [[TMP2]], 0
; CHECK-NEXT:    [[TMP6:%.*]] = or i1 [[FOUND_CONFLICT]], [[STRIDE_CHECK]]
; CHECK-NEXT:    [[STRIDE_CHECK2:%.*]] = icmp slt i64 [[TMP2]], 0
; CHECK-NEXT:    br i1 [[TMP6]], [[SCALAR_PH]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
;
entry:
  br label %outer.loop

outer.loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %inner.exit ]
  %row = mul nuw nsw i64 %i, %n
  br label %inner.loop

inner.loop:
  %j = phi i64 [ 0, %outer.loop ], [ %j.next, %inner.loop ]
  %idx = add nuw nsw i64 %row, %j
  %gep.a = getelementptr inbounds i64, ptr %a, i64 %idx
  %l = load i32, ptr %gep.a, align 4
  %ext = sext i32 %l to i64
  %gep.b = getelementptr inbounds i64, ptr %b, i64 %idx
  store i64 %ext, ptr %gep.b, align 8
  %j.next = add nuw nsw i64 %j, 1
  %inner.ec = icmp eq i64 %j.next, %n
  br i1 %inner.ec, label %inner.exit, label %inner.loop

inner.exit:
  %i.next = add nuw nsw i64 %i, 1
  %outer.ec = icmp eq i64 %i.next, %m
  br i1 %outer.ec, label %exit, label %outer.loop

exit:
  ret void
}

