; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals none --filter-out-after "^vector.ph:" --version 6
; RUN: opt -p loop-vectorize -mattr=+sve -force-vector-width="vscale x 2" \
; RUN:   -force-vector-interleave=1 -S %s | FileCheck %s

target triple = "aarch64-unknown-linux-gnu"

; for (i = 0; i < n; i++)
;   b[i] = *(int *)&a[i];
; With VF = vscale x 2, a check of the distance between %a and %b compares it
; against 32 * vscale - 1, which fits in 64 bits iff vscale <= 2^59, and
; vscale is unbounded without vscale_range.
define void @narrow_load_no_vscale_range(ptr %a, ptr %b, i64 %n) {
; CHECK-LABEL: define void @narrow_load_no_vscale_range(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP_A:%.*]] = getelementptr inbounds i64, ptr [[A]], i64 [[IV]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP_A]], align 4
; CHECK-NEXT:    [[EXT:%.*]] = sext i32 [[L]] to i64
; CHECK-NEXT:    [[GEP_B:%.*]] = getelementptr inbounds i64, ptr [[B]], i64 [[IV]]
; CHECK-NEXT:    store i64 [[EXT]], ptr [[GEP_B]], align 8
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.a = getelementptr inbounds i64, ptr %a, i64 %iv
  %l = load i32, ptr %gep.a, align 4
  %ext = sext i32 %l to i64
  %gep.b = getelementptr inbounds i64, ptr %b, i64 %iv
  store i64 %ext, ptr %gep.b, align 8
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

