target triple = "arm64-apple-macosx"

; The trip count is at most 12 via the loop guard. Make sure the planner does
; not pick VF * IC = 16, which would make the main vector loop dead.
define void @tc_bounded_by_ult_guard(ptr %dst, i64 %n) {
; CHECK-LABEL: define void @tc_bounded_by_ult_guard(
