; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[PRED_CALL_CONTINUE2:.*]] ]
; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <2 x i64> [ <i64 0, i64 1>, %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[PRED_CALL_CONTINUE2]] ]
; CHECK-NEXT:    [[TMP1:%.*]] = load i64, ptr [[Q]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = icmp sgt <2 x i64> [[VEC_IND]], splat (i64 10)
; CHECK-NEXT:    [[TMP3:%.*]] = extractelement <2 x i1> [[TMP2]], i64 0
; CHECK-NEXT:    br i1 [[TMP3]], label %[[PRED_CALL_IF:.*]], label %[[PRED_CALL_CONTINUE:.*]]
; CHECK:       [[PRED_CALL_IF]]:
; CHECK-NEXT:    [[TMP4:%.*]] = call i64 @pure_not_speculatable(i64 [[TMP1]]) #[[ATTR8:[0-9]+]]
; CHECK-NEXT:    [[TMP5:%.*]] = insertelement <2 x i64> poison, i64 [[TMP4]], i64 0
; CHECK-NEXT:    br label %[[PRED_CALL_CONTINUE]]
; CHECK:       [[PRED_CALL_CONTINUE]]:
