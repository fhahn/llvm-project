; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter "!prof" --version 6
; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=1 -S %s | FileCheck %s

target triple = "aarch64-unknown-linux-gnu"

; The interleave group of the strided load has a gap, so a scalar epilogue is
; required. The trip count is a multiple of the vector step (4), hence the
; vector loop runs one step less and the remainder loop runs a full step of 4
; iterations, rather than 1024 % 4 = 0. The estimated trip counts add up to the
; estimate for the original loop: 255 * 4 + 4 = 1024.
define i32 @requires_scalar_epilogue(ptr %a) !prof !0 {
; CHECK-LABEL: define i32 @requires_scalar_epilogue(
; CHECK-SAME: ptr [[A:%.*]]) !prof [[PROF0:![0-9]+]] {
; CHECK:    br i1 [[TMP3:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF1:![0-9]+]], !llvm.loop [[LOOP2:![0-9]+]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT:label %.*]], [[LOOP:label %.*]], !prof [[PROF6:![0-9]+]], !llvm.loop [[LOOP7:![0-9]+]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %red = phi i32 [ 0, %entry ], [ %add, %loop ]
  %idx = shl nuw nsw i64 %iv, 1
  %gep = getelementptr inbounds i32, ptr %a, i64 %idx
  %l = load i32, ptr %gep, align 4
  %add = add i32 %red, %l
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 1024
  br i1 %ec, label %exit, label %loop, !prof !1

exit:
  ret i32 %add
}

; Same as @requires_scalar_epilogue, but the original loop is estimated to run
; fewer iterations (3) than a single step. The vector loop is then estimated to
; run zero iterations, which must not be decremented for the required scalar
; epilogue.
define i32 @requires_scalar_epilogue_cold_profile(ptr %a) !prof !0 {
; CHECK-LABEL: define i32 @requires_scalar_epilogue_cold_profile(
; CHECK-SAME: ptr [[A:%.*]]) !prof [[PROF0]] {
; CHECK:    br i1 [[TMP3:%.*]], [[MIDDLE_BLOCK:label %.*]], [[VECTOR_BODY:label %.*]], !prof [[PROF9:![0-9]+]], !llvm.loop [[LOOP10:![0-9]+]]
; CHECK:    br i1 [[EC:%.*]], [[EXIT:label %.*]], [[LOOP:label %.*]], !prof [[PROF6]], !llvm.loop [[LOOP12:![0-9]+]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %red = phi i32 [ 0, %entry ], [ %add, %loop ]
  %idx = shl nuw nsw i64 %iv, 1
  %gep = getelementptr inbounds i32, ptr %a, i64 %idx
  %l = load i32, ptr %gep, align 4
  %add = add i32 %red, %l
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 1024
  br i1 %ec, label %exit, label %loop, !prof !2

exit:
  ret i32 %add
}

!0 = !{!"function_entry_count", i64 1000}
!1 = !{!"branch_weights", i32 1, i32 1023}
!2 = !{!"branch_weights", i32 1, i32 2}
