; (fptosi + sitofp). Factor 5 exceeds VF 4, so the group narrows to a single
; <5 x float> wide op with the cast chain widened to <5 x i32>/<5 x float>.
define void @load_store_factor5_saxpy_cast_chain(ptr noalias %A, ptr noalias %B, float %alpha) {
; CHECK-LABEL: define void @load_store_factor5_saxpy_cast_chain(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr noalias [[B:%.*]], float [[ALPHA:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <5 x float> poison, float [[ALPHA]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <5 x float> [[BROADCAST_SPLATINSERT]], <5 x float> poison, <5 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = mul nuw nsw i64 [[INDEX]], 5
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds float, ptr [[A]], i64 [[TMP0]]
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr inbounds float, ptr [[B]], i64 [[TMP0]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <5 x float>, ptr [[TMP2]], align 4
; CHECK-NEXT:    [[TMP3:%.*]] = fmul fast <5 x float> [[WIDE_LOAD]], [[BROADCAST_SPLAT]]
; CHECK-NEXT:    [[TMP4:%.*]] = fptosi <5 x float> [[TMP3]] to <5 x i32>
; CHECK-NEXT:    [[TMP5:%.*]] = sitofp <5 x i32> [[TMP4]] to <5 x float>
; CHECK-NEXT:    [[WIDE_LOAD1:%.*]] = load <5 x float>, ptr [[TMP1]], align 4
; CHECK-NEXT:    [[TMP6:%.*]] = fadd fast <5 x float> [[WIDE_LOAD1]], [[TMP5]]
; CHECK-NEXT:    store <5 x float> [[TMP6]], ptr [[TMP1]], align 4
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 1
; CHECK-NEXT:    [[TMP15:%.*]] = icmp eq i64 [[INDEX_NEXT]], 1000
; CHECK-NEXT:    br i1 [[TMP15]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP6:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %offset = mul nuw nsw i64 %iv, 5
  %a.0 = getelementptr inbounds float, ptr %A, i64 %offset
  %b.0 = getelementptr inbounds float, ptr %B, i64 %offset
  %lb.0 = load float, ptr %b.0, align 4
  %m.0 = fmul fast float %lb.0, %alpha
  %ci.0 = fptosi float %m.0 to i32
  %cf.0 = sitofp i32 %ci.0 to float
  %la.0 = load float, ptr %a.0, align 4
  %r.0 = fadd fast float %la.0, %cf.0
  store float %r.0, ptr %a.0, align 4
  %o.1 = add nuw nsw i64 %offset, 1
  %a.1 = getelementptr inbounds float, ptr %A, i64 %o.1
  %b.1 = getelementptr inbounds float, ptr %B, i64 %o.1
  %lb.1 = load float, ptr %b.1, align 4
  %m.1 = fmul fast float %lb.1, %alpha
  %ci.1 = fptosi float %m.1 to i32
  %cf.1 = sitofp i32 %ci.1 to float
  %la.1 = load float, ptr %a.1, align 4
  %r.1 = fadd fast float %la.1, %cf.1
  store float %r.1, ptr %a.1, align 4
  %o.2 = add nuw nsw i64 %offset, 2
  %a.2 = getelementptr inbounds float, ptr %A, i64 %o.2
  %b.2 = getelementptr inbounds float, ptr %B, i64 %o.2
  %lb.2 = load float, ptr %b.2, align 4
  %m.2 = fmul fast float %lb.2, %alpha
  %ci.2 = fptosi float %m.2 to i32
  %cf.2 = sitofp i32 %ci.2 to float
  %la.2 = load float, ptr %a.2, align 4
  %r.2 = fadd fast float %la.2, %cf.2
  store float %r.2, ptr %a.2, align 4
  %o.3 = add nuw nsw i64 %offset, 3
  %a.3 = getelementptr inbounds float, ptr %A, i64 %o.3
  %b.3 = getelementptr inbounds float, ptr %B, i64 %o.3
  %lb.3 = load float, ptr %b.3, align 4
  %m.3 = fmul fast float %lb.3, %alpha
  %ci.3 = fptosi float %m.3 to i32
  %cf.3 = sitofp i32 %ci.3 to float
  %la.3 = load float, ptr %a.3, align 4
  %r.3 = fadd fast float %la.3, %cf.3
  store float %r.3, ptr %a.3, align 4
  %o.4 = add nuw nsw i64 %offset, 4
  %a.4 = getelementptr inbounds float, ptr %A, i64 %o.4
  %b.4 = getelementptr inbounds float, ptr %B, i64 %o.4
  %lb.4 = load float, ptr %b.4, align 4
  %m.4 = fmul fast float %lb.4, %alpha
  %ci.4 = fptosi float %m.4 to i32
  %cf.4 = sitofp i32 %ci.4 to float
  %la.4 = load float, ptr %a.4, align 4
  %r.4 = fadd fast float %la.4, %cf.4
