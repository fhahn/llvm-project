; Scalable VF with a large maximum vscale: VF.getKnownMinValue() (4) * MaxVScale
; (2^30) == 2^32, which previously overflowed the 32-bit `unsigned MaxVF` to 0 in
; isIndvarOverflowCheckKnownFalse, spuriously reporting the IV-overflow check as
; known-false and wrongly keeping `nuw` on the canonical IV increment. The trip
; count can be up to 2^32-1 while the runtime vscale (hence the IV step) can be as
; small as 1, so the i32 IV can genuinely wrap: the increment must NOT have nuw.
define void @iv_overflow_large_vscale(ptr noalias %a, ptr noalias %b, ptr %np) vscale_range(1, 1073741824) {
; CHECK-LABEL: define void @iv_overflow_large_vscale(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr noalias [[B:%.*]], ptr [[NP:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[VECTOR_BODY:.*:]]
; CHECK-NEXT:    [[INDEX:%.*]] = load i32, ptr [[NP]], align 4, !range [[RNG0:![0-9]+]]
; CHECK-NEXT:    br label %[[VECTOR_SCEVCHECK:.*]]
; CHECK:       [[VECTOR_SCEVCHECK]]:
; CHECK-NEXT:    [[TMP0:%.*]] = add i32 [[INDEX]], -1
; CHECK-NEXT:    [[TMP1:%.*]] = icmp slt i32 [[TMP0]], 0
; CHECK-NEXT:    br i1 [[TMP1]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[TMP2:%.*]] = call i32 @llvm.vscale.i32()
; CHECK-NEXT:    [[TMP4:%.*]] = shl nuw i32 [[TMP2]], 2
; CHECK-NEXT:    [[TMP3:%.*]] = sub i32 [[TMP4]], 1
; CHECK-NEXT:    [[INDEX_NEXT:%.*]] = add i32 [[INDEX]], [[TMP3]]
; CHECK-NEXT:    [[N_MOD_VF:%.*]] = urem i32 [[INDEX_NEXT]], [[TMP4]]
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i32 [[INDEX_NEXT]], [[N_MOD_VF]]
; CHECK-NEXT:    [[TRIP_COUNT_MINUS_1:%.*]] = sub i32 [[INDEX]], 1
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <vscale x 4 x i32> poison, i32 [[TRIP_COUNT_MINUS_1]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <vscale x 4 x i32> [[BROADCAST_SPLATINSERT]], <vscale x 4 x i32> poison, <vscale x 4 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP5:%.*]] = call <vscale x 4 x i32> @llvm.stepvector.nxv4i32()
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT1:%.*]] = insertelement <vscale x 4 x i32> poison, i32 [[TMP4]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT2:%.*]] = shufflevector <vscale x 4 x i32> [[BROADCAST_SPLATINSERT1]], <vscale x 4 x i32> poison, <vscale x 4 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[VECTOR_BODY1:.*]]
; CHECK:       [[VECTOR_BODY1]]:
; CHECK-NEXT:    [[INDEX1:%.*]] = phi i32 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT1:%.*]], %[[VECTOR_BODY1]] ]
; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <vscale x 4 x i32> [ [[TMP5]], %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[VECTOR_BODY1]] ]
; CHECK-NEXT:    [[TMP6:%.*]] = icmp ule <vscale x 4 x i32> [[VEC_IND]], [[BROADCAST_SPLAT]]
; CHECK-NEXT:    [[TMP7:%.*]] = getelementptr i32, ptr [[A]], i32 [[INDEX1]]
; CHECK-NEXT:    [[WIDE_MASKED_LOAD:%.*]] = call <vscale x 4 x i32> @llvm.masked.load.nxv4i32.p0(ptr align 4 [[TMP7]], <vscale x 4 x i1> [[TMP6]], <vscale x 4 x i32> poison)
; CHECK-NEXT:    [[TMP8:%.*]] = add <vscale x 4 x i32> [[WIDE_MASKED_LOAD]], splat (i32 1)
; CHECK-NEXT:    [[TMP9:%.*]] = getelementptr i32, ptr [[B]], i32 [[INDEX1]]
; CHECK-NEXT:    call void @llvm.masked.store.nxv4i32.p0(<vscale x 4 x i32> [[TMP8]], ptr align 4 [[TMP9]], <vscale x 4 x i1> [[TMP6]])
; CHECK-NEXT:    [[INDEX_NEXT1]] = add i32 [[INDEX1]], [[TMP4]]
; CHECK-NEXT:    [[VEC_IND_NEXT]] = add nuw <vscale x 4 x i32> [[VEC_IND]], [[BROADCAST_SPLAT2]]
; CHECK-NEXT:    [[TMP10:%.*]] = icmp eq i32 [[INDEX_NEXT1]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP10]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY1]], !llvm.loop [[LOOP1:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[SCALAR_PH]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GA:%.*]] = getelementptr i32, ptr [[A]], i32 [[IV]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GA]], align 4
; CHECK-NEXT:    [[ADD:%.*]] = add i32 [[L]], 1
; CHECK-NEXT:    [[GB:%.*]] = getelementptr i32, ptr [[B]], i32 [[IV]]
; CHECK-NEXT:    store i32 [[ADD]], ptr [[GB]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp ult i32 [[IV_NEXT]], [[INDEX]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP]], label %[[EXIT]], !llvm.loop [[LOOP4:![0-9]+]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %n = load i32, ptr %np, !range !4
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %ga = getelementptr i32, ptr %a, i32 %iv
  %l = load i32, ptr %ga
  %add = add i32 %l, 1
  %gb = getelementptr i32, ptr %b, i32 %iv
  store i32 %add, ptr %gb
  %iv.next = add i32 %iv, 1
  %ec = icmp ult i32 %iv.next, %n
  br i1 %ec, label %loop, label %exit, !llvm.loop !0

exit:
  ret void
}

