  %gep.dst = getelementptr i32, ptr %dst, i32 %iv
  store i32 %l, ptr %gep.dst
  %iv.next = add i32 %iv, 1
  %ec = icmp ult i32 %iv.next, %n
  br i1 %ec, label %loop, label %exit

