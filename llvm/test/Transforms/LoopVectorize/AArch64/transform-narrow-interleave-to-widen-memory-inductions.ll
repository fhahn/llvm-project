; CHECK-NEXT:    [[STRIDED_VEC4:%.*]] = shufflevector <4 x i64> [[WIDE_VEC2]], <4 x i64> poison, <2 x i32> <i32 1, i32 3>
; CHECK-NEXT:    [[TMP8:%.*]] = add <2 x i64> [[STRIDED_VEC]], [[VEC_IND]]
; CHECK-NEXT:    [[TMP9:%.*]] = add <2 x i64> [[STRIDED_VEC3]], [[STEP_ADD]]
; CHECK-NEXT:    [[TMP10:%.*]] = add <2 x i64> [[STRIDED_VEC1]], [[TMP2]]
; CHECK-NEXT:    [[TMP11:%.*]] = add <2 x i64> [[STRIDED_VEC4]], [[TMP3]]
; CHECK-NEXT:    [[TMP12:%.*]] = getelementptr inbounds i64, ptr [[A]], i64 [[TMP4]]
; CHECK-NEXT:    [[TMP13:%.*]] = getelementptr inbounds i64, ptr [[A]], i64 [[TMP5]]
; CHECK-NEXT:    [[TMP14:%.*]] = shufflevector <2 x i64> [[TMP8]], <2 x i64> [[TMP10]], <4 x i32> <i32 0, i32 1, i32 2, i32 3>
; CHECK-NEXT:    [[INTERLEAVED_VEC:%.*]] = shufflevector <4 x i64> [[TMP14]], <4 x i64> poison, <4 x i32> <i32 0, i32 2, i32 1, i32 3>
; CHECK-NEXT:    store <4 x i64> [[INTERLEAVED_VEC]], ptr [[TMP12]], align 8
; CHECK-NEXT:    [[TMP15:%.*]] = shufflevector <2 x i64> [[TMP9]], <2 x i64> [[TMP11]], <4 x i32> <i32 0, i32 1, i32 2, i32 3>
; CHECK-NEXT:    [[INTERLEAVED_VEC5:%.*]] = shufflevector <4 x i64> [[TMP15]], <4 x i64> poison, <4 x i32> <i32 0, i32 2, i32 1, i32 3>
; CHECK-NEXT:    store <4 x i64> [[INTERLEAVED_VEC5]], ptr [[TMP13]], align 8
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[VEC_IND_NEXT]] = add nuw nsw <2 x i64> [[STEP_ADD]], splat (i64 2)
; CHECK-NEXT:    [[TMP16:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP16]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP10:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], [[EXIT:label %.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %iv.1 = add i64 %iv, 1
  %i0 = shl nuw nsw i64 %iv, 1
  %i1 = or disjoint i64 %i0, 1
  %b0.p = getelementptr inbounds i64, ptr %B, i64 %i0
  %b1.p = getelementptr inbounds i64, ptr %B, i64 %i1
  %b0 = load i64, ptr %b0.p, align 8
  %b1 = load i64, ptr %b1.p, align 8
  %r0 = add i64 %b0, %iv
  %r1 = add i64 %b1, %iv.1
  %a0.p = getelementptr inbounds i64, ptr %A, i64 %i0
  %a1.p = getelementptr inbounds i64, ptr %A, i64 %i1
  store i64 %r0, ptr %a0.p, align 8
  store i64 %r1, ptr %a1.p, align 8
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; A[2i+j] = 2 * (double)i + (B[2i+j] - (double)i): the cast of the induction is
; shared by all members, both directly and via a shared fadd, and is kept wide
; as a cast of the broadcast induction.
define void @iv_cast_shared(ptr noalias %A, ptr noalias %B, i64 %n) {
; CHECK-LABEL: define void @iv_cast_shared(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr noalias [[B:%.*]], i64 [[N:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[TMP0:%.*]] = and i64 [[N]], 1
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[N]], [[TMP0]]
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP1:%.*]] = add i64 [[INDEX]], 1
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <2 x i64> poison, i64 [[INDEX]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <2 x i64> [[BROADCAST_SPLATINSERT]], <2 x i64> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT1:%.*]] = insertelement <2 x i64> poison, i64 [[TMP1]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT2:%.*]] = shufflevector <2 x i64> [[BROADCAST_SPLATINSERT1]], <2 x i64> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP2:%.*]] = uitofp nneg <2 x i64> [[BROADCAST_SPLAT]] to <2 x double>
; CHECK-NEXT:    [[TMP3:%.*]] = extractelement <2 x double> [[TMP2]], i64 0
; CHECK-NEXT:    [[TMP4:%.*]] = uitofp nneg <2 x i64> [[BROADCAST_SPLAT2]] to <2 x double>
; CHECK-NEXT:    [[TMP5:%.*]] = extractelement <2 x double> [[TMP4]], i64 0
; CHECK-NEXT:    [[TMP6:%.*]] = fadd double [[TMP3]], [[TMP3]]
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT4:%.*]] = insertelement <2 x double> poison, double [[TMP6]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT5:%.*]] = shufflevector <2 x double> [[BROADCAST_SPLATINSERT4]], <2 x double> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP7:%.*]] = fadd double [[TMP5]], [[TMP5]]
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT6:%.*]] = insertelement <2 x double> poison, double [[TMP7]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT7:%.*]] = shufflevector <2 x double> [[BROADCAST_SPLATINSERT6]], <2 x double> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP8:%.*]] = shl nuw nsw i64 [[INDEX]], 1
; CHECK-NEXT:    [[TMP9:%.*]] = shl nuw nsw i64 [[TMP1]], 1
; CHECK-NEXT:    [[TMP10:%.*]] = getelementptr inbounds double, ptr [[B]], i64 [[TMP8]]
; CHECK-NEXT:    [[TMP11:%.*]] = getelementptr inbounds double, ptr [[B]], i64 [[TMP9]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <2 x double>, ptr [[TMP10]], align 8
; CHECK-NEXT:    [[WIDE_LOAD3:%.*]] = load <2 x double>, ptr [[TMP11]], align 8
; CHECK-NEXT:    [[TMP12:%.*]] = fsub <2 x double> [[WIDE_LOAD]], [[TMP2]]
; CHECK-NEXT:    [[TMP13:%.*]] = fsub <2 x double> [[WIDE_LOAD3]], [[TMP4]]
; CHECK-NEXT:    [[TMP14:%.*]] = fadd <2 x double> [[BROADCAST_SPLAT5]], [[TMP12]]
; CHECK-NEXT:    [[TMP15:%.*]] = fadd <2 x double> [[BROADCAST_SPLAT7]], [[TMP13]]
; CHECK-NEXT:    [[TMP16:%.*]] = getelementptr inbounds double, ptr [[A]], i64 [[TMP8]]
; CHECK-NEXT:    [[TMP17:%.*]] = getelementptr inbounds double, ptr [[A]], i64 [[TMP9]]
; CHECK-NEXT:    store <2 x double> [[TMP14]], ptr [[TMP16]], align 8
; CHECK-NEXT:    store <2 x double> [[TMP15]], ptr [[TMP17]], align 8
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 2
; CHECK-NEXT:    [[TMP18:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP18]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP12:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], [[EXIT:label %.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %conv = uitofp nneg i64 %iv to double
  %conv.2 = fadd double %conv, %conv
  %idx.0 = shl nuw nsw i64 %iv, 1
  %idx.1 = or disjoint i64 %idx.0, 1
  %b.0.gep = getelementptr inbounds double, ptr %B, i64 %idx.0
  %b.1.gep = getelementptr inbounds double, ptr %B, i64 %idx.1
  %b.0 = load double, ptr %b.0.gep, align 8
  %b.1 = load double, ptr %b.1.gep, align 8
  %sub.0 = fsub double %b.0, %conv
  %sub.1 = fsub double %b.1, %conv
  %add.0 = fadd double %conv.2, %sub.0
  %add.1 = fadd double %conv.2, %sub.1
  %a.0.gep = getelementptr inbounds double, ptr %A, i64 %idx.0
  %a.1.gep = getelementptr inbounds double, ptr %A, i64 %idx.1
  store double %add.0, ptr %a.0.gep, align 8
  store double %add.1, ptr %a.1.gep, align 8
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
