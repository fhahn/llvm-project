target triple = "arm64-apple-macosx"

; Speculative-load early-exit vectorization: exit conditions computed from
; unary and binary operations on loaded values.

; Add two loaded values and compare the sum against a constant.
define i64 @add_loads_cmp_const(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i8, ptr %B, i64 %iv
  %ld.B = load i8, ptr %gep.B, align 1
  %sum = add i8 %ld.A, %ld.B
  %cmp = icmp eq i8 %sum, 0
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; Sub two loaded values and compare against zero.
define i64 @sub_loads_cmp_const(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i8, ptr %B, i64 %iv
  %ld.B = load i8, ptr %gep.B, align 1
  %sub = sub i8 %ld.A, %ld.B
  %cmp = icmp sgt i8 %sub, 0
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; XOR two loaded values and compare against zero.
define i64 @xor_loads_cmp_const(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i8, ptr %B, i64 %iv
  %ld.B = load i8, ptr %gep.B, align 1
  %xor = xor i8 %ld.A, %ld.B
  %cmp = icmp ne i8 %xor, 0
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; Mul loaded values and compare against constant.
define i64 @mul_loads_cmp_const(ptr %A, ptr %B, i64 %n) {
entry:
  %cmp.entry = icmp sgt i64 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %gep.B = getelementptr inbounds i8, ptr %B, i64 %iv
  %ld.B = load i8, ptr %gep.B, align 1
  %mul = mul i8 %ld.A, %ld.B
  %cmp = icmp eq i8 %mul, 0
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

; Unary op (fneg) feeding the fcmp exit condition. The
; speculative-load helper replays the fneg in its scalar loop.
define i1 @fneg_cmp(ptr %v1, i64 %n) {
entry:
  br label %for.body

for.cond:
  %indvars.iv.next = add i64 %indvars.iv, 1
  %exitcond.not = icmp eq i64 %indvars.iv.next, %n
  br i1 %exitcond.not, label %return.loopexit, label %for.body

for.body:
  %indvars.iv = phi i64 [ 0, %entry ], [ %indvars.iv.next, %for.cond ]
  %fneg.i = fneg float 0.000000e+00
  %arrayidx = getelementptr [4 x i8], ptr %v1, i64 %indvars.iv
  %0 = load float, ptr %arrayidx, align 4
  %cmp7.i = fcmp ugt float %0, %fneg.i
  br i1 %cmp7.i, label %return.loopexit, label %for.cond

return.loopexit:
  ret i1 false
}
