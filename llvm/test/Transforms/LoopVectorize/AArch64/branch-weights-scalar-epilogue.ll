; CHECK:    [[TMP4:%.*]] = select i1 [[TMP3]], i64 [[TMP1]], i64 [[N_MOD_VF]], !prof [[PROF8]]
; CHECK:    br label %[[VECTOR_BODY:.*]]
; CHECK:  [[VECTOR_BODY]]:
; CHECK:    [[TMP41:%.*]] = icmp eq i64 [[INDEX_NEXT:%.*]], [[N_VEC:%.*]]
; CHECK:    br i1 [[TMP41]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !prof [[PROF16:![0-9]+]], !llvm.loop [[LOOP17:![0-9]+]]
; CHECK:  [[MIDDLE_BLOCK]]:
; CHECK:    br label %[[VEC_EPILOG_ITER_CHECK:.*]]
; CHECK:  [[VEC_EPILOG_ITER_CHECK]]:
; CHECK:    [[MIN_EPILOG_ITERS_CHECK:%.*]] = icmp ule i64 [[TMP4]], 4
; CHECK:    br i1 [[MIN_EPILOG_ITERS_CHECK]], label %[[VEC_EPILOG_SCALAR_PH]], label %[[VEC_EPILOG_PH]], !prof [[PROF2]]
