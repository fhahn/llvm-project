  %conv.2 = uitofp i8 %l.2 to float
  %v.2 = fdiv float %conv.2, %max
  %gt.2 = fcmp ogt float %v.2, 1.000000e+00
  br i1 %gt.2, label %ch2.end, label %ch2.not.gt

ch2.not.gt:
