  br label %ch0

ch0:
  %src.0 = getelementptr inbounds nuw i8, ptr %src.base, i64 0
  %l.0 = load i8, ptr %src.0, align 1
  %conv.0 = uitofp i8 %l.0 to float
  %v.0 = fdiv float %conv.0, %max
  %gt.0 = fcmp ogt float %v.0, 1.000000e+00
  br i1 %gt.0, label %ch0.end, label %ch0.not.gt

