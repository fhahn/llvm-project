  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %gep.src = getelementptr inbounds nuw i32, ptr %src, i64 %iv
  %idx = load i32, ptr %gep.src, align 4
  %in.range = icmp ult i32 %idx, 1024
  br i1 %in.range, label %then, label %latch

then:
  %idx.ext = zext nneg i32 %idx to i64
  %gep.table = getelementptr inbounds nuw float, ptr @table, i64 %idx.ext
  %t = load float, ptr %gep.table, align 4
  br label %latch

latch:
  %res = phi float [ %t, %then ], [ 0.000000e+00, %loop ]
  %gep.dst = getelementptr inbounds nuw float, ptr %dst, i64 %iv
  store float %res, ptr %gep.dst, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

