; CHECK-NEXT:    [[GEP_LOAD:%.*]] = getelementptr inbounds i32, ptr [[A_OFF]], i64 [[IV]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[GEP_LOAD]], align 4
; CHECK-NEXT:    [[INC:%.*]] = add i32 [[V]], 1
; CHECK-NEXT:    [[GEP_STORE:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IV]]
