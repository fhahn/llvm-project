; Distinct no-alias buffers (one reached through a GEP chain) resolve to
; separate objects, so realign proceeds.
define void @realign_distinct_underlying_via_chain(ptr noalias %dst, ptr noalias %src) {
; CHECK-LABEL: define void @realign_distinct_underlying_via_chain(
; CHECK-SAME: ptr noalias [[DST:%.*]], ptr noalias [[SRC:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[SRC_OFF:%.*]] = getelementptr inbounds i32, ptr [[SRC]], i64 0
; CHECK-NEXT:    [[DST_OFF:%.*]] = getelementptr inbounds i32, ptr [[DST]], i64 0
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr inbounds i32, ptr [[SRC_OFF]], i64 [[INDEX]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP0]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = add <4 x i32> [[WIDE_LOAD]], splat (i32 1)
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr inbounds i32, ptr [[DST_OFF]], i64 [[INDEX]]
; CHECK-NEXT:    store <4 x i32> [[TMP1]], ptr [[TMP2]], align 4
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[TMP3:%.*]] = icmp eq i64 [[INDEX_NEXT]], 32
; CHECK-NEXT:    br i1 [[TMP3]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP6:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br label %[[VECTOR_REALIGN_PH:.*]]
; CHECK:       [[VECTOR_REALIGN_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY1:.*]]
; CHECK:       [[VECTOR_BODY1]]:
; CHECK-NEXT:    [[INDEX2:%.*]] = phi i64 [ 30, %[[VECTOR_REALIGN_PH]] ], [ [[INDEX_NEXT4:%.*]], %[[VECTOR_BODY1]] ]
; CHECK-NEXT:    [[TMP4:%.*]] = getelementptr inbounds i32, ptr [[SRC_OFF]], i64 [[INDEX2]]
; CHECK-NEXT:    [[WIDE_LOAD3:%.*]] = load <4 x i32>, ptr [[TMP4]], align 4
; CHECK-NEXT:    [[TMP5:%.*]] = add <4 x i32> [[WIDE_LOAD3]], splat (i32 1)
; CHECK-NEXT:    [[TMP6:%.*]] = getelementptr inbounds i32, ptr [[DST_OFF]], i64 [[INDEX2]]
; CHECK-NEXT:    store <4 x i32> [[TMP5]], ptr [[TMP6]], align 4
; CHECK-NEXT:    [[INDEX_NEXT4]] = add nuw i64 [[INDEX2]], 4
; CHECK-NEXT:    [[TMP7:%.*]] = icmp eq i64 [[INDEX_NEXT4]], 34
; CHECK-NEXT:    br i1 [[TMP7]], label %[[EXIT:.*]], label %[[VECTOR_BODY1]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %src.off = getelementptr inbounds i32, ptr %src, i64 0
  %dst.off = getelementptr inbounds i32, ptr %dst, i64 0
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.src = getelementptr inbounds i32, ptr %src.off, i64 %iv
  %v = load i32, ptr %gep.src, align 4
  %inc = add i32 %v, 1
  %gep.dst = getelementptr inbounds i32, ptr %dst.off, i64 %iv
  store i32 %inc, ptr %gep.dst, align 4
  %iv.next = add i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 34
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

