  %gep.a = getelementptr inbounds i64, ptr %a, i64 %iv
  %l.a = load i64, ptr %gep.a, align 8
  %add.a = add i64 %l.a, %l.b
  %add.p = add i64 %l.p.0, %l.p.1
  %res = add i64 %add.a, %add.p
  %gep.e = getelementptr inbounds i64, ptr %e, i64 %iv
  store i64 %res, ptr %gep.e, align 8
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
