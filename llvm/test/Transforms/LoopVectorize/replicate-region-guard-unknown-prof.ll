; CHECK:  [[VECTOR_PH:.*:]]
; CHECK:  [[VECTOR_BODY:.*]]:
; CHECK:    br i1 [[TMP5:%.*]], label %[[PRED_LOAD_IF:.*]], label %[[PRED_LOAD_CONTINUE:.*]], !prof [[PROF1:![0-9]+]]
; CHECK:  [[PRED_LOAD_IF]]:
; CHECK:  [[PRED_LOAD_CONTINUE]]:
; CHECK:    br i1 [[TMP10:%.*]], label %[[PRED_LOAD_IF1:.*]], label %[[PRED_LOAD_CONTINUE2:.*]], !prof [[PROF1]]
; CHECK:  [[PRED_LOAD_IF1]]:
; CHECK:  [[PRED_LOAD_CONTINUE2]]:
; CHECK:    br i1 [[TMP15:%.*]], label %[[PRED_LOAD_IF3:.*]], label %[[PRED_LOAD_CONTINUE4:.*]], !prof [[PROF1]]
; CHECK:  [[PRED_LOAD_IF3]]:
; CHECK:  [[PRED_LOAD_CONTINUE4]]:
; CHECK:    br i1 [[TMP20:%.*]], label %[[PRED_LOAD_IF5:.*]], label %[[PRED_LOAD_CONTINUE6:.*]], !prof [[PROF1]]
; CHECK:  [[PRED_LOAD_IF5]]:
; CHECK:  [[PRED_LOAD_CONTINUE6]]:
; CHECK:    [[TMP26:%.*]] = select <4 x i1> [[TMP1:%.*]], <4 x i1> [[TMP25:%.*]], <4 x i1> zeroinitializer
; CHECK:    br i1 [[TMP27:%.*]], label %[[PRED_STORE_IF:.*]], label %[[PRED_STORE_CONTINUE:.*]], !prof [[PROF2:![0-9]+]]
; CHECK:  [[PRED_STORE_IF]]:
; CHECK:  [[PRED_STORE_CONTINUE]]:
; CHECK:    br i1 [[TMP30:%.*]], label %[[PRED_STORE_IF7:.*]], label %[[PRED_STORE_CONTINUE8:.*]], !prof [[PROF2]]
; CHECK:  [[PRED_STORE_IF7]]:
; CHECK:  [[PRED_STORE_CONTINUE8]]:
; CHECK:    br i1 [[TMP33:%.*]], label %[[PRED_STORE_IF9:.*]], label %[[PRED_STORE_CONTINUE10:.*]], !prof [[PROF2]]
; CHECK:  [[PRED_STORE_IF9]]:
