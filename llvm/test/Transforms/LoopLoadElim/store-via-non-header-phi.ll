; RUN: opt -passes=loop-load-elim -runtime-check-per-loop-load-elim=2 -S %s | FileCheck %s

; The store through %ptr.phi may write to %a[iv + 1] between the store and the
; load of it in the next iteration, so its incoming pointers must be checked
; against %a.
; FIXME: The load is forwarded without checking the incoming pointers of
; %ptr.phi.
define void @store_via_non_header_phi(ptr %a, ptr %b, ptr %c, i1 %cond, i64 %n) {
; CHECK-LABEL: define void @store_via_non_header_phi(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]], ptr [[C:%.*]], i1 [[COND:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[LOOP_PH:.*]]:
; CHECK-NEXT:    [[LOAD_INITIAL:%.*]] = load i32, ptr [[A]], align 4
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[STORE_FORWARDED:%.*]] = phi i32 [ [[LOAD_INITIAL]], %[[LOOP_PH]] ], [ [[IV_TRUNC:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[LOOP_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH]] ]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[GEP_A_NEXT:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IV_NEXT]]
; CHECK-NEXT:    [[IV_TRUNC]] = trunc i64 [[IV]] to i32
; CHECK-NEXT:    store i32 [[IV_TRUNC]], ptr [[GEP_A_NEXT]], align 4
; CHECK-NEXT:    [[GEP_A:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IV]]
; CHECK-NEXT:    [[L_A:%.*]] = load i32, ptr [[GEP_A]], align 4
; CHECK-NEXT:    [[GEP_B:%.*]] = getelementptr inbounds i32, ptr [[B]], i64 [[IV]]
; CHECK-NEXT:    [[GEP_C:%.*]] = getelementptr inbounds i32, ptr [[C]], i64 [[IV]]
; CHECK-NEXT:    br i1 [[COND]], label %[[LOOP_THEN:.*]], label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_THEN]]:
; CHECK-NEXT:    br label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[PTR_PHI:%.*]] = phi ptr [ [[GEP_B]], %[[LOOP_THEN]] ], [ [[GEP_C]], %[[LOOP]] ]
; CHECK-NEXT:    store i32 [[STORE_FORWARDED]], ptr [[PTR_PHI]], align 4
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT_LOOPEXIT6:.*]], label %[[LOOP]]
; CHECK:       [[EXIT_LOOPEXIT6]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %iv.next = add nuw nsw i64 %iv, 1
  %gep.a.next = getelementptr inbounds i32, ptr %a, i64 %iv.next
  %iv.trunc = trunc i64 %iv to i32
  store i32 %iv.trunc, ptr %gep.a.next, align 4
  %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
  %l.a = load i32, ptr %gep.a, align 4
  %gep.b = getelementptr inbounds i32, ptr %b, i64 %iv
  %gep.c = getelementptr inbounds i32, ptr %c, i64 %iv
  br i1 %cond, label %loop.then, label %loop.latch

loop.then:
  br label %loop.latch

loop.latch:
  %ptr.phi = phi ptr [ %gep.b, %loop.then ], [ %gep.c, %loop ]
  store i32 %l.a, ptr %ptr.phi, align 4
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
