; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=instsimplify -S %s | FileCheck %s
;
; ConstantFolding folds integer vector reductions with constant operands, but
; not llvm.vector.reduce.fadd / fmul. Strict (ordered) reductions of constants
; can be folded exactly by evaluating the operations in order, so no
; reassociation is needed. Seen after vectorizing a loop whose operands later
; became constants (e.g. ffmpeg's af_loudnorm init_gaussian_filter).

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

; Ordered (strict) fadd reduction of constants folds exactly by evaluating
; the additions in order; no reassociation is needed.
define double @reduce_fadd_const() {
; CHECK-LABEL: define double @reduce_fadd_const() {
; CHECK-NEXT:    [[R:%.*]] = call double @llvm.vector.reduce.fadd.v4f64(double 1.000000e+00, <4 x double> <double 2.000000e+00, double 3.000000e+00, double 4.000000e+00, double 5.000000e+00>)
; CHECK-NEXT:    ret double [[R]]
;
  %r = call double @llvm.vector.reduce.fadd.v4f64(double 1.0, <4 x double> <double 2.0, double 3.0, double 4.0, double 5.0>)
  ret double %r
}

define float @reduce_fmul_const() {
; CHECK-LABEL: define float @reduce_fmul_const() {
; CHECK-NEXT:    [[R:%.*]] = call float @llvm.vector.reduce.fmul.v4f32(float 2.000000e+00, <4 x float> <float 1.000000e+00, float 2.000000e+00, float 3.000000e+00, float 5.000000e-01>)
; CHECK-NEXT:    ret float [[R]]
;
  %r = call float @llvm.vector.reduce.fmul.v4f32(float 2.0, <4 x float> <float 1.0, float 2.0, float 3.0, float 0.5>)
  ret float %r
}

; Negative: a non-constant start value.
define double @reduce_fadd_nonconst_start(double %s) {
; CHECK-LABEL: define double @reduce_fadd_nonconst_start(
; CHECK-SAME: double [[S:%.*]]) {
; CHECK-NEXT:    [[R:%.*]] = call double @llvm.vector.reduce.fadd.v4f64(double [[S]], <4 x double> <double 2.000000e+00, double 3.000000e+00, double 4.000000e+00, double 5.000000e+00>)
; CHECK-NEXT:    ret double [[R]]
;
  %r = call double @llvm.vector.reduce.fadd.v4f64(double %s, <4 x double> <double 2.0, double 3.0, double 4.0, double 5.0>)
  ret double %r
}

declare double @llvm.vector.reduce.fadd.v4f64(double, <4 x double>)
declare float @llvm.vector.reduce.fmul.v4f32(float, <4 x float>)
