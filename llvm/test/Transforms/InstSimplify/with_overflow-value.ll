; The value component of a *.with.overflow intrinsic is the wrapped result of
; the operation, so it folds to whatever the plain binop folds to.

declare void @use.i1(i1)
declare void @use.v2i1(<2 x i1>)
declare void @use.nxv4i1(<vscale x 4 x i1>)

define i32 @add_of_sub(i32 %x, i32 %y) {
; CHECK-LABEL: define i32 @add_of_sub(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:    [[S:%.*]] = sub i32 [[Y]], [[X]]
; CHECK-NEXT:    [[WO:%.*]] = call { i32, i1 } @llvm.sadd.with.overflow.i32(i32 [[X]], i32 [[S]])
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i32, i1 } [[WO]], 1
; CHECK-NEXT:    call void @use.i1(i1 [[OV]])
; CHECK-NEXT:    ret i32 [[Y]]
;
  %s = sub i32 %y, %x
  %wo = call { i32, i1 } @llvm.sadd.with.overflow.i32(i32 %x, i32 %s)
  %ov = extractvalue { i32, i1 } %wo, 1
  call void @use.i1(i1 %ov)
  %v = extractvalue { i32, i1 } %wo, 0
  ret i32 %v
}

