; CHECK-NEXT:    [[TMP13:%.*]] = shufflevector <2 x double> poison, <2 x double> [[TMP12]], <2 x i32> <i32 2, i32 3>
; CHECK-NEXT:    [[Y_NZ:%.*]] = icmp ne i64 [[Y]], 0
; CHECK-NEXT:    br i1 [[Y_NZ]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
