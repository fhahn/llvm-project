; REQUIRES: aarch64-registered-target

target datalayout = "e-m:o-i64:64-f80:128-n8:16:32:64-S128"
target triple = "aarch64-apple-ios"

; Tests for {ld, ld} -> multiply -> st chains that are not fused, because
; fusion is not profitable.

define void @lifetime_for_first_arg_before_multiply(ptr %B, ptr %C) {
