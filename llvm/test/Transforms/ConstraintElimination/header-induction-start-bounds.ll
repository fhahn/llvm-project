  %pv = phi ptr [ %p, %entry ], [ %pv.next, %loop ]
  %must.not.fold = icmp sge ptr %pv, %p
  call void @use(i1 %must.not.fold)
  %pv.next = getelementptr nuw i8, ptr %pv, i64 1
  %ec = call i1 @cond()
  br i1 %ec, label %loop, label %exit
exit:
  ret void
}
