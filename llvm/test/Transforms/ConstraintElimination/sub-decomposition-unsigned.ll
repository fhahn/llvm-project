; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s

; Decomposition of a plain `sub A, B` in the unsigned system, valid under the
; precondition A u>= B (so the subtraction does not wrap). This is the shape a
; checked subtraction (ssub.with.overflow) lowers to after its overflow flag is
; folded, e.g. a decreasing derived index count - i / count - 1 - i.

declare void @llvm.assume(i1)

; count - i (with i u< count) stays in (0, count], so it is never u> count.
define i1 @sub_not_ugt_bound(i32 %count, i32 %i) {
; CHECK-LABEL: define i1 @sub_not_ugt_bound(
; CHECK-SAME: i32 [[COUNT:%.*]], i32 [[I:%.*]]) {
; CHECK-NEXT:    [[PRE:%.*]] = icmp ult i32 [[I]], [[COUNT]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[D:%.*]] = sub nuw i32 [[COUNT]], [[I]]
; CHECK-NEXT:    ret i1 false
;
  %pre = icmp ult i32 %i, %count
  call void @llvm.assume(i1 %pre)
  %d = sub i32 %count, %i
  %c = icmp ugt i32 %d, %count
  ret i1 %c
}

; count - 1 - i (a decreasing derived index) with i u< count/2 is u< count.
define i1 @sub_derived_index_bound(i32 %count, i32 %i) {
; CHECK-LABEL: define i1 @sub_derived_index_bound(
; CHECK-SAME: i32 [[COUNT:%.*]], i32 [[I:%.*]]) {
; CHECK-NEXT:    [[HALF:%.*]] = lshr i32 [[COUNT]], 1
; CHECK-NEXT:    [[PRE:%.*]] = icmp ult i32 [[I]], [[HALF]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[CM1:%.*]] = sub nuw i32 [[COUNT]], 1
; CHECK-NEXT:    [[D:%.*]] = sub nuw i32 [[CM1]], [[I]]
; CHECK-NEXT:    ret i1 false
;
  %half = lshr i32 %count, 1
  %pre = icmp ult i32 %i, %half
  call void @llvm.assume(i1 %pre)
  %cm1 = sub nuw i32 %count, 1
  %d = sub i32 %cm1, %i
  %c = icmp uge i32 %d, %count
  ret i1 %c
}

; Without a dominating A u>= B fact the precondition cannot be discharged, so
; the decomposition must not fire and the check stays.
define i1 @neg_sub_no_bound(i32 %a, i32 %b, i32 %limit) {
; CHECK-LABEL: define i1 @neg_sub_no_bound(
; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]], i32 [[LIMIT:%.*]]) {
; CHECK-NEXT:    [[D:%.*]] = sub i32 [[A]], [[B]]
; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[D]], [[LIMIT]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %d = sub i32 %a, %b
  %c = icmp ult i32 %d, %limit
  ret i1 %c
}

; A self-comparison of a sub must still work structurally and must not be lost
; by dragging in an unprovable precondition (the sub has a constant minuend, so
; the new decomposition is skipped entirely).
define i1 @neg_sub_constant_minuend_self_cmp() {
; CHECK-LABEL: define i1 @neg_sub_constant_minuend_self_cmp() {
; CHECK-NEXT:    [[SUB:%.*]] = sub i8 0, 0
; CHECK-NEXT:    ret i1 false
;
  %sub = sub i8 0, 0
  %c = icmp ult i8 %sub, %sub
  ret i1 %c
}
