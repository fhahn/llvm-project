; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[C:%.*]] = icmp ule i8 [[M]], -16
; CHECK-NEXT:    ret i1 [[C]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i1 false
;
entry:
  %m = shl i8 %a, 2
  call void @use(i8 %m)
  %c.1 = icmp ule i8 %a, 64
