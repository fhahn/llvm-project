@g = global [16 x i8] zeroinitializer

; %idx is scaled by 2^64-1 and 1, so it does not contribute to the offset and
; the access implies no bound on it.
define i1 @load_global_index_with_zero_total_scale(i64 %idx) {
; CHECK-LABEL: define i1 @load_global_index_with_zero_total_scale(
; CHECK-SAME: i64 [[IDX:%.*]]) {
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr nuw [18446744073709551615 x i8], ptr @g, i64 [[IDX]], i64 [[IDX]]
; CHECK-NEXT:    [[LOAD:%.*]] = load i8, ptr [[GEP]], align 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IDX]], 0
; CHECK-NEXT:    ret i1 [[CMP]]
;
  %gep = getelementptr nuw [18446744073709551615 x i8], ptr @g, i64 %idx, i64 %idx
  %load = load i8, ptr %gep
  %cmp = icmp eq i64 %idx, 0
  ret i1 %cmp
}
