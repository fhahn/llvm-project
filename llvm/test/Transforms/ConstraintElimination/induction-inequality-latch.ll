; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s

; A loop whose induction is controlled by an inequality latch on the
; post-increment (continue while i + step </<= B, or exit while i + step >=/> B)
; still bounds the header value: continuing implies i + step is below B, and the
; next header value equals that, so PN stays below B in the loop. The first
; iteration is covered by a StartValue precondition. This is the shape of a
; strided loop such as `for i in stride(from: 0, to: count, by: 2)`.

declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)
declare void @use(i1)

; Continue-while-true `slt(i + 2, n)` latch: the bound check i u< n folds.
define void @stride2_slt_latch(i64 %n) {
; CHECK-LABEL: define void @stride2_slt_latch(
; CHECK-SAME: i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[EZ:%.*]] = icmp eq i64 [[N]], 0
; CHECK-NEXT:    br i1 [[EZ]], label %[[EXIT:.*]], label %[[PH:.*]]
; CHECK:       [[PH]]:
; CHECK-NEXT:    br label %[[H:.*]]
; CHECK:       [[H]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[INEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[INEXT]] = add nsw i64 [[I]], 2
; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[INEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[H]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %ez = icmp eq i64 %n, 0
  br i1 %ez, label %exit, label %ph

ph:
  br label %h

h:
  %i = phi i64 [ 0, %ph ], [ %inext, %latch ]
  %oob = icmp ult i64 %i, %n
  call void @use(i1 %oob)
  br label %latch

latch:
  %inext = add nsw i64 %i, 2
  %c = icmp slt i64 %inext, %n
  br i1 %c, label %h, label %exit

exit:
  ret void
}

; Exit-while-true `sge(i + 2, n)` latch, with the counting compare OR-ed with an
