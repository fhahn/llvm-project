; CHECK-NEXT:    br i1 [[C]], label %[[T:.*]], label %[[F:.*]]
; CHECK:       [[T]]:
; CHECK-NEXT:    [[Q:%.*]] = icmp ult i64 [[A]], [[B]]
; CHECK-NEXT:    ret i1 [[Q]]
; CHECK:       [[F]]:
; CHECK-NEXT:    ret i1 false
;
