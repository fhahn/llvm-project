; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s

declare void @llvm.trap()

; For non-negative operands the signed and unsigned orderings coincide, so an
; unsigned query can be answered by the signed system. Here `count + ~i`
; decomposes to `count - 1 - i`, which is only valid signed, so the unsigned
; system on its own cannot prove the `ult` check. InstCombine canonicalizes
; `sub (count - 1), i` into this xor+add shape, so it is the form reverse
; iterating bounds checks actually reach us in.
define void @ult_query_via_signed_system(i64 %count, i64 %i) {
; CHECK-LABEL: define void @ult_query_via_signed_system(
; CHECK-SAME: i64 [[COUNT:%.*]], i64 [[I:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[NN:%.*]] = icmp sgt i64 [[COUNT]], -1
; CHECK-NEXT:    br i1 [[NN]], label %[[C1:.*]], label %[[OUT:.*]]
; CHECK:       [[C1]]:
; CHECK-NEXT:    [[INN:%.*]] = icmp sgt i64 [[I]], -1
; CHECK-NEXT:    br i1 [[INN]], label %[[C2:.*]], label %[[OUT]]
; CHECK:       [[C2]]:
; CHECK-NEXT:    [[LT:%.*]] = icmp ult i64 [[I]], [[COUNT]]
; CHECK-NEXT:    br i1 [[LT]], label %[[C3:.*]], label %[[OUT]]
; CHECK:       [[C3]]:
; CHECK-NEXT:    [[NEG:%.*]] = xor i64 [[I]], -1
; CHECK-NEXT:    [[IDX:%.*]] = add nsw i64 [[COUNT]], [[NEG]]
; CHECK-NEXT:    br i1 true, label %[[OUT]], label %[[TRAP:.*]]
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    call void @llvm.trap()
; CHECK-NEXT:    unreachable
; CHECK:       [[OUT]]:
; CHECK-NEXT:    ret void
;
entry:
  %nn = icmp sgt i64 %count, -1
  br i1 %nn, label %c1, label %out

c1:
  %inn = icmp sgt i64 %i, -1
  br i1 %inn, label %c2, label %out

c2:
  %lt = icmp ult i64 %i, %count
  br i1 %lt, label %c3, label %out

c3:
  %neg = xor i64 %i, -1
  %idx = add nsw i64 %count, %neg
  %ok = icmp ult i64 %idx, %count
  br i1 %ok, label %out, label %trap

trap:
  call void @llvm.trap()
  unreachable

out:
  ret void
}

