; sadd.with.overflow(A, C) with a constant C does not signed-overflow when A
; stays in range after adding C: for C s>= 0 that needs A s<= SMAX - C, for
; C s< 0 it needs A s>= SMIN - C. The bound on A is discharged either by the
; constraint solver (constant bound) or, as a fallback, by SCEV's signed range
; (variable bound on a loop induction).

declare { i8, i1 } @llvm.sadd.with.overflow.i8(i8, i8)
declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)
declare void @llvm.assume(i1)
declare void @use(i1)
declare void @use.agg({ i8, i1 })

; A is in [0, 100), so A + 1 does not overflow (A s<= SMAX - 1).
define i8 @sadd_no_overflow_pos_const(i8 %a) {
; CHECK-LABEL: define i8 @sadd_no_overflow_pos_const(
; CHECK-SAME: i8 [[A:%.*]]) {
; CHECK-NEXT:    [[LO:%.*]] = icmp sge i8 [[A]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[LO]])
; CHECK-NEXT:    [[HI:%.*]] = icmp slt i8 [[A]], 100
; CHECK-NEXT:    [[OK:%.*]] = and i1 [[LO]], [[HI]]
; CHECK-NEXT:    br i1 [[OK]], label %[[THEN:.*]], label %[[ELSE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[V:%.*]] = add nsw i8 [[A]], 1
; CHECK-NEXT:    call void @use(i1 false)
; CHECK-NEXT:    ret i8 [[V]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    ret i8 0
;
  %lo = icmp sge i8 %a, 0
  call void @llvm.assume(i1 %lo)
  %hi = icmp slt i8 %a, 100
  call void @llvm.assume(i1 %hi)
  %s = call { i8, i1 } @llvm.sadd.with.overflow.i8(i8 %a, i8 1)
  %v = extractvalue { i8, i1 } %s, 0
  %o = extractvalue { i8, i1 } %s, 1
  call void @use(i1 %o)
  ret i8 %v
}

