; The bound is a variable, so the solver cannot prove A s<= SMAX - 1. But A is
; an induction {0,+,1} with exit bound %count - 1, so SCEV's signed range for A
; excludes SMAX and A + 1 cannot overflow.
define i1 @sadd_var_bound_induction(i64 %count) {
; CHECK-LABEL: define i1 @sadd_var_bound_induction(
; CHECK-SAME: i64 [[COUNT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt i64 [[COUNT]], 1
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP_PREHEADER:.*]], label %[[DONE:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    [[SUB:%.*]] = add nsw i64 [[COUNT]], -1
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[LOOP_PREHEADER]] ], [ [[I_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[I_NEXT]] = add nsw i64 [[I]], 1
; CHECK-NEXT:    br i1 false, label %[[TRAP:.*]], label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[COND:%.*]] = icmp slt i64 [[I_NEXT]], [[SUB]]
; CHECK-NEXT:    br i1 [[COND]], label %[[LOOP]], label %[[DONE]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret i1 true
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    ret i1 false
;
entry:
  %cmp = icmp sgt i64 %count, 1
  br i1 %cmp, label %loop.preheader, label %done

loop.preheader:
  %sub = add nsw i64 %count, -1
  br label %loop

loop:
  %i = phi i64 [ 0, %loop.preheader ], [ %i.next, %loop.latch ]
  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %i, i64 1)
  %i.next = extractvalue { i64, i1 } %s, 0
  %ov = extractvalue { i64, i1 } %s, 1
  br i1 %ov, label %trap, label %loop.latch

loop.latch:
  %cond = icmp slt i64 %i.next, %sub
  br i1 %cond, label %loop, label %done

done:
  ret i1 true

trap:
  ret i1 false
}

