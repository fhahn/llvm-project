; The induction {0,+,1} has no computable exit bound, so SCEV's signed range for
; %i is the full range including SMAX and %i + 1 may overflow.
define void @neg_sadd_unbounded_induction(ptr %p) {
; CHECK-LABEL: define void @neg_sadd_unbounded_induction(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[S:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[I]], i64 1)
; CHECK-NEXT:    [[I_NEXT]] = extractvalue { i64, i1 } [[S]], 0
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i64, i1 } [[S]], 1
; CHECK-NEXT:    store i64 [[I]], ptr [[P]], align 4
; CHECK-NEXT:    br i1 [[OV]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %i, i64 1)
  %i.next = extractvalue { i64, i1 } %s, 0
  %ov = extractvalue { i64, i1 } %s, 1
  store i64 %i, ptr %p
  br i1 %ov, label %exit, label %loop

exit:
  ret void
}
