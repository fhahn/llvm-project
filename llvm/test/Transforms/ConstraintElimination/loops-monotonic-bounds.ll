  br label %loop.header

loop.header:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %latch.1 ], [ %iv.next, %latch.2 ]
  %ec = icmp ult i32 %iv, %n
  br i1 %ec, label %loop.body, label %exit

loop.body:
  %f.1 = icmp ult i32 %iv, %start
  call void @use(i1 %f.1)
  %iv.next = add nuw nsw i32 %iv, 1
  %c = call i1 @cond()
  br i1 %c, label %latch.1, label %latch.2

latch.1:
  br label %loop.header

latch.2:
  br label %loop.header

exit:
  ret void
}

; Negative test: no unique loop predecessor, so the phi has more than 2
; incoming values.
define void @negative_multiple_loop_preds(i32 %start, i32 %n, i1 %c) {
; CHECK-LABEL: @negative_multiple_loop_preds(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br i1 [[C:%.*]], label [[PH_1:%.*]], label [[PH_2:%.*]]
; CHECK:       ph.1:
; CHECK-NEXT:    br label [[LOOP_HEADER:%.*]]
; CHECK:       ph.2:
; CHECK-NEXT:    br label [[LOOP_HEADER]]
; CHECK:       loop.header:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START:%.*]], [[PH_1]] ], [ [[START]], [[PH_2]] ], [ [[IV_NEXT:%.*]], [[LOOP_LATCH:%.*]] ]
; CHECK-NEXT:    [[EC:%.*]] = icmp ult i32 [[IV]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[EC]], label [[LOOP_BODY:%.*]], label [[EXIT:%.*]]
; CHECK:       loop.body:
; CHECK-NEXT:    [[F_1:%.*]] = icmp ult i32 [[IV]], [[START]]
; CHECK-NEXT:    call void @use(i1 [[F_1]])
; CHECK-NEXT:    br label [[LOOP_LATCH]]
; CHECK:       loop.latch:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 1
; CHECK-NEXT:    br label [[LOOP_HEADER]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c, label %ph.1, label %ph.2

ph.1:
  br label %loop.header

ph.2:
  br label %loop.header

loop.header:
  %iv = phi i32 [ %start, %ph.1 ], [ %start, %ph.2 ], [ %iv.next, %loop.latch ]
  %ec = icmp ult i32 %iv, %n
  br i1 %ec, label %loop.body, label %exit

loop.body:
  %f.1 = icmp ult i32 %iv, %start
  call void @use(i1 %f.1)
  br label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i32 %iv, 1
  br label %loop.header

exit:
  ret void
}

; Negative test: the value coming from the inner latch is not an increment of
; %x, so no bound is derived for the inner loop.
define void @negative_backedge_value_not_an_increment(i32 %n) {
; CHECK-LABEL: @negative_backedge_value_not_an_increment(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[OUTER_HEADER:%.*]]
; CHECK:       outer.header:
; CHECK-NEXT:    [[O:%.*]] = phi i32 [ 0, [[ENTRY:%.*]] ], [ [[O_NEXT:%.*]], [[OUTER_LATCH:%.*]] ]
; CHECK-NEXT:    br label [[INNER_HEADER:%.*]]
; CHECK:       inner.header:
; CHECK-NEXT:    [[X:%.*]] = phi i32 [ [[O]], [[OUTER_HEADER]] ], [ [[O]], [[INNER_LATCH:%.*]] ]
; CHECK-NEXT:    [[F_1:%.*]] = icmp ult i32 [[X]], [[O]]
; CHECK-NEXT:    call void @use(i1 [[F_1]])
; CHECK-NEXT:    [[EC_INNER:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[EC_INNER]], label [[INNER_LATCH]], label [[OUTER_LATCH]]
; CHECK:       inner.latch:
; CHECK-NEXT:    br label [[INNER_HEADER]]
; CHECK:       outer.latch:
; CHECK-NEXT:    [[O_NEXT]] = add nuw nsw i32 [[O]], 1
; CHECK-NEXT:    [[EC_OUTER:%.*]] = icmp eq i32 [[O_NEXT]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[EC_OUTER]], label [[EXIT:%.*]], label [[OUTER_HEADER]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer.header

outer.header:
  %o = phi i32 [ 0, %entry ], [ %o.next, %outer.latch ]
  br label %inner.header

inner.header:
  %x = phi i32 [ %o, %outer.header ], [ %o, %inner.latch ]
  %f.1 = icmp ult i32 %x, %o
  call void @use(i1 %f.1)
  %ec.inner = call i1 @cond()
  br i1 %ec.inner, label %inner.latch, label %outer.latch

inner.latch:
  br label %inner.header

outer.latch:
  %o.next = add nuw nsw i32 %o, 1
  %ec.outer = icmp eq i32 %o.next, %n
  br i1 %ec.outer, label %exit, label %outer.header

exit:
  ret void
}
