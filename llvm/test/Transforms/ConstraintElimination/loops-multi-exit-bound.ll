; CHECK:       loop.body:
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label [[EXIT_MERGE]], label [[LOOP_LATCH]]
; CHECK:       loop.latch:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i32 [[IV]], 1
; CHECK-NEXT:    br label [[LOOP_HEADER]]
; CHECK:       exit.merge:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ [[BIG]], [[ENTRY:%.*]] ], [ [[IV]], [[LOOP_HEADER]] ], [ [[IV]], [[LOOP_BODY]] ]
; CHECK-NEXT:    [[T:%.*]] = icmp ule i32 [[P]], [[N]]
; CHECK-NEXT:    ret i1 [[T]]
;
entry:
  %big = add i32 %n, 1
  %pre = icmp ule i32 %start, %n
  br i1 %pre, label %loop.ph, label %exit.merge

loop.ph:
  br label %loop.header

loop.header:
  %iv = phi i32 [ %start, %loop.ph ], [ %iv.next, %loop.latch ]
  %ec = icmp eq i32 %iv, %n
  br i1 %ec, label %exit.merge, label %loop.body

loop.body:
  %c = call i1 @cond()
  br i1 %c, label %exit.merge, label %loop.latch

loop.latch:
  %iv.next = add nuw i32 %iv, 1
  br label %loop.header

exit.merge:
  %p = phi i32 [ %big, %entry ], [ %iv, %loop.header ], [ %iv, %loop.body ]
  %t = icmp ule i32 %p, %n
  ret i1 %t
}

; Without a guard, %start u<= %n cannot be proven, so the induction may wrap
; and no bound can be derived.
define i1 @no_provable_precondition_merge(i32 %start, i32 %n) {
; CHECK-LABEL: @no_provable_precondition_merge(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP_HEADER:%.*]]
; CHECK:       loop.header:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START:%.*]], [[ENTRY:%.*]] ], [ [[IV_NEXT:%.*]], [[LOOP_LATCH:%.*]] ]
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[IV]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[EC]], label [[EXIT_MERGE:%.*]], label [[LOOP_BODY:%.*]]
; CHECK:       loop.body:
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label [[EXIT_MERGE]], label [[LOOP_LATCH]]
; CHECK:       loop.latch:
; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
; CHECK-NEXT:    br label [[LOOP_HEADER]]
; CHECK:       exit.merge:
; CHECK-NEXT:    [[T:%.*]] = icmp ule i32 [[IV]], [[N]]
; CHECK-NEXT:    ret i1 [[T]]
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop.latch ]
  %ec = icmp eq i32 %iv, %n
  br i1 %ec, label %exit.merge, label %loop.body

loop.body:
  %c = call i1 @cond()
  br i1 %c, label %exit.merge, label %loop.latch

loop.latch:
  %iv.next = add i32 %iv, 1
  br label %loop.header

exit.merge:
  %t = icmp ule i32 %iv, %n
  ret i1 %t
}
