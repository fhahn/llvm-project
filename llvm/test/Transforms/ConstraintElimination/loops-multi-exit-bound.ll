; The bound also holds in the header itself, before the exit condition is
; tested.
define void @bound_in_header(i32 %start, i32 %n) {
; CHECK-LABEL: @bound_in_header(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[PRE:%.*]] = icmp ule i32 [[START:%.*]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[PRE]], label [[LOOP_PH:%.*]], label [[EXIT:%.*]]
; CHECK:       loop.ph:
; CHECK-NEXT:    br label [[LOOP_HEADER:%.*]]
; CHECK:       loop.header:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START]], [[LOOP_PH]] ], [ [[IV_NEXT:%.*]], [[LOOP_LATCH:%.*]] ]
; CHECK-NEXT:    call void @use.i1(i1 true)
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label [[EXIT]], label [[LOOP_BODY:%.*]]
; CHECK:       loop.body:
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label [[EXIT]], label [[LOOP_LATCH]]
; CHECK:       loop.latch:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i32 [[IV]], 1
; CHECK-NEXT:    br label [[LOOP_HEADER]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  %pre = icmp ule i32 %start, %n
  br i1 %pre, label %loop.ph, label %exit

loop.ph:
  br label %loop.header

loop.header:
  %iv = phi i32 [ %start, %loop.ph ], [ %iv.next, %loop.latch ]
  %t.hdr = icmp ule i32 %iv, %n
  call void @use.i1(i1 %t.hdr)
  %ec = icmp eq i32 %iv, %n
  br i1 %ec, label %exit, label %loop.body

loop.body:
  %c = call i1 @cond()
  br i1 %c, label %exit, label %loop.latch

loop.latch:
  %iv.next = add nuw i32 %iv, 1
  br label %loop.header

exit:
  ret void
}

