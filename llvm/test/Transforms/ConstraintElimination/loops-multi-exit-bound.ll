; The exit block of the inner loop is inside the outer loop.
define i1 @nested_inner_exit_in_outer_loop(i32 %start, i32 %n) {
; CHECK-LABEL: @nested_inner_exit_in_outer_loop(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[PRE:%.*]] = icmp ule i32 [[START:%.*]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[PRE]], label [[OUTER_PH:%.*]], label [[EXIT_GUARD:%.*]]
; CHECK:       outer.ph:
; CHECK-NEXT:    br label [[OUTER_HEADER:%.*]]
; CHECK:       outer.header:
; CHECK-NEXT:    [[OUTER_IV:%.*]] = phi i32 [ 0, [[OUTER_PH]] ], [ [[OUTER_IV_NEXT:%.*]], [[OUTER_LATCH:%.*]] ]
; CHECK-NEXT:    br label [[INNER_HEADER:%.*]]
; CHECK:       inner.header:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START]], [[OUTER_HEADER]] ], [ [[IV_NEXT:%.*]], [[INNER_LATCH:%.*]] ]
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label [[INNER_EXIT_MERGE:%.*]], label [[INNER_BODY:%.*]]
; CHECK:       inner.body:
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label [[INNER_EXIT_MERGE]], label [[INNER_LATCH]]
; CHECK:       inner.latch:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i32 [[IV]], 1
; CHECK-NEXT:    br label [[INNER_HEADER]]
; CHECK:       inner.exit.merge:
; CHECK-NEXT:    br i1 true, label [[OUTER_LATCH]], label [[EXIT:%.*]]
; CHECK:       outer.latch:
; CHECK-NEXT:    [[OUTER_IV_NEXT]] = add nuw i32 [[OUTER_IV]], 1
; CHECK-NEXT:    [[EC_OUTER:%.*]] = icmp eq i32 [[OUTER_IV_NEXT]], 100
; CHECK-NEXT:    br i1 [[EC_OUTER]], label [[EXIT]], label [[OUTER_HEADER]]
; CHECK:       exit:
; CHECK-NEXT:    ret i1 true
; CHECK:       exit.guard:
; CHECK-NEXT:    ret i1 false
;
entry:
  %pre = icmp ule i32 %start, %n
  br i1 %pre, label %outer.ph, label %exit.guard

outer.ph:
  br label %outer.header

outer.header:
  %outer.iv = phi i32 [ 0, %outer.ph ], [ %outer.iv.next, %outer.latch ]
  br label %inner.header

inner.header:
  %iv = phi i32 [ %start, %outer.header ], [ %iv.next, %inner.latch ]
  %ec = icmp eq i32 %iv, %n
  br i1 %ec, label %inner.exit.merge, label %inner.body

inner.body:
  %c = call i1 @cond()
  br i1 %c, label %inner.exit.merge, label %inner.latch

inner.latch:
  %iv.next = add nuw i32 %iv, 1
  br label %inner.header

inner.exit.merge:
  %t = icmp ule i32 %iv, %n
  br i1 %t, label %outer.latch, label %exit

outer.latch:
  %outer.iv.next = add nuw i32 %outer.iv, 1
  %ec.outer = icmp eq i32 %outer.iv.next, 100
  br i1 %ec.outer, label %exit, label %outer.header

exit:
  ret i1 %t

exit.guard:
  ret i1 false
}

