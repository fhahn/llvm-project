; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -passes=constraint-elimination -constraint-elimination-max-decompose-depth=4 -S %s | FileCheck %s

; decompose() recurses on operand chains. Without a depth limit a long chain of
; decomposable operations (e.g. `add nuw`) makes the recursion depth equal to
; the chain length, exhausting the stack. The recursion depth is now bounded by
; -constraint-elimination-max-decompose-depth; deeper expressions are treated
; opaquely (lowering reasoning effectiveness, but never crashing).

; A chain shorter than the depth limit is still fully decomposed, so the known
; condition is folded.
define i1 @chain_within_limit(i64 %x) {
; CHECK-LABEL: @chain_within_limit(
; CHECK-NEXT:    [[V0:%.*]] = add nuw i64 [[X:%.*]], 1
; CHECK-NEXT:    [[V1:%.*]] = add nuw i64 [[V0]], 1
; CHECK-NEXT:    ret i1 true
;
  %v0 = add nuw i64 %x, 1
  %v1 = add nuw i64 %v0, 1
  %c = icmp uge i64 %v1, %x
  ret i1 %c
}

; A chain deeper than the limit is treated opaquely past the cap, so the
; condition is left untouched, but decomposition does not recurse without bound.
define i1 @chain_exceeds_limit(i64 %x) {
; CHECK-LABEL: @chain_exceeds_limit(
; CHECK-NEXT:    [[V0:%.*]] = add nuw i64 [[X:%.*]], 1
; CHECK-NEXT:    [[V1:%.*]] = add nuw i64 [[V0]], 1
; CHECK-NEXT:    [[V2:%.*]] = add nuw i64 [[V1]], 1
; CHECK-NEXT:    [[V3:%.*]] = add nuw i64 [[V2]], 1
; CHECK-NEXT:    [[V4:%.*]] = add nuw i64 [[V3]], 1
; CHECK-NEXT:    [[V5:%.*]] = add nuw i64 [[V4]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp uge i64 [[V5]], [[X]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %v0 = add nuw i64 %x, 1
  %v1 = add nuw i64 %v0, 1
  %v2 = add nuw i64 %v1, 1
  %v3 = add nuw i64 %v2, 1
  %v4 = add nuw i64 %v3, 1
  %v5 = add nuw i64 %v4, 1
  %c = icmp uge i64 %v5, %x
  ret i1 %c
}
