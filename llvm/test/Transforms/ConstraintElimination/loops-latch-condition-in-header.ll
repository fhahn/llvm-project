; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp ult i32 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP_HEADER]], label %[[LOOP_OTHER:.*]]
; CHECK:       [[LOOP_OTHER]]:
; CHECK-NEXT:    call void @use(i1 false)
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard = icmp ult i32 %start, %n
  br i1 %guard, label %loop.header, label %exit

loop.header:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop.latch ]
  %t.1 = icmp ult i32 %iv, %n
  call void @use(i1 %t.1)
  br label %loop.latch

loop.latch:
  %iv.next = add i32 %iv, 1
  %ec = icmp ult i32 %iv.next, %n
  br i1 %ec, label %loop.header, label %loop.other

loop.other:
  call void @use(i1 false)
  br label %exit

exit:
  ret void
}

; Multi-exit loop: the fact in the header is independent of the early exit.
define void @latch_ult_multi_exit(i32 %start, i32 %n) {
; CHECK-LABEL: define void @latch_ult_multi_exit(
; CHECK-SAME: i32 [[START:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ult i32 [[START]], [[N]]
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_HEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START]], %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    [[EC_1:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[EC_1]], label %[[EXIT_EARLY:.*]], label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
; CHECK-NEXT:    [[EC_2:%.*]] = icmp ult i32 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC_2]], label %[[LOOP_HEADER]], label %[[EXIT]]
; CHECK:       [[EXIT_EARLY]]:
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    ret void
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard = icmp ult i32 %start, %n
  br i1 %guard, label %loop.header, label %exit

loop.header:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop.latch ]
  %t.1 = icmp ult i32 %iv, %n
  call void @use(i1 %t.1)
  %ec.1 = call i1 @cond()
  br i1 %ec.1, label %exit.early, label %loop.latch

loop.latch:
  %iv.next = add i32 %iv, 1
  %ec.2 = icmp ult i32 %iv.next, %n
  br i1 %ec.2, label %loop.header, label %exit

exit.early:
  %t.2 = icmp ult i32 %iv, %n
  call void @use(i1 %t.2)
  ret void

exit:
  ret void
}

; The same phi drives an EQ exit condition in the header and a relational exit
; condition in the latch. Both derivations apply and do not contradict.
define void @latch_ult_and_header_eq(i32 %start, i32 %n, i32 %m) {
; CHECK-LABEL: define void @latch_ult_and_header_eq(
; CHECK-SAME: i32 [[START:%.*]], i32 [[N:%.*]], i32 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[GUARD_1:%.*]] = icmp ult i32 [[START]], [[N]]
; CHECK-NEXT:    [[GUARD_2:%.*]] = icmp ule i32 [[START]], [[M]]
; CHECK-NEXT:    [[GUARD:%.*]] = and i1 [[GUARD_1]], [[GUARD_2]]
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_HEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START]], %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[EC_1:%.*]] = icmp eq i32 [[IV]], [[M]]
; CHECK-NEXT:    br i1 [[EC_1]], label %[[EXIT]], label %[[LOOP_BODY:.*]]
; CHECK:       [[LOOP_BODY]]:
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    br label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
; CHECK-NEXT:    [[EC_2:%.*]] = icmp ult i32 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC_2]], label %[[LOOP_HEADER]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard.1 = icmp ult i32 %start, %n
  %guard.2 = icmp ule i32 %start, %m
  %guard = and i1 %guard.1, %guard.2
  br i1 %guard, label %loop.header, label %exit

loop.header:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop.latch ]
  %ec.1 = icmp eq i32 %iv, %m
  br i1 %ec.1, label %exit, label %loop.body

loop.body:
  %t.1 = icmp ult i32 %iv, %n
  call void @use(i1 %t.1)
  %t.2 = icmp ule i32 %iv, %m
  call void @use(i1 %t.2)
  br label %loop.latch

loop.latch:
  %iv.next = add i32 %iv, 1
  %ec.2 = icmp ult i32 %iv.next, %n
  br i1 %ec.2, label %loop.header, label %exit

exit:
  ret void
}

