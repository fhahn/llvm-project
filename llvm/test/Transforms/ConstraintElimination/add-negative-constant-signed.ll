; CHECK-NEXT:    [[AND_2:%.*]] = and i1 [[AND_1]], [[C]]
; CHECK-NEXT:    [[SUB:%.*]] = add nsw i64 [[X]], [[Y]]
; CHECK-NEXT:    br i1 [[AND_2]], label %[[IF_END:.*]], label %[[EXIT:.*]]
; CHECK:       [[IF_END]]:
; CHECK-NEXT:    ret i1 true
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i1 false
