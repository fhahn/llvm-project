; Boundary coverage for the SCEV signed-range fallback used to fold
; sadd.with.overflow when the constraint solver cannot discharge the bound. The
; fold must fire exactly when SCEV's signed range for the addend's base excludes
; the value that would overflow. See sadd-with-overflow.ll for the base cases.

declare { i8, i1 } @llvm.sadd.with.overflow.i8(i8, i8)

; A non-unit-stride induction {0,+,2} exiting at i s< 100: the largest value the
; overflow test sees is 100, and 100 + 2 does not overflow. SCEV's range is
; [0, 101), so the check folds.
define i8 @sadd_stride2_boundary_folded() {
; CHECK-LABEL: define i8 @sadd_stride2_boundary_folded() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i8 [ 0, %[[ENTRY]] ], [ [[TMP0:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[TMP0]] = add nsw i8 [[I]], 2
; CHECK-NEXT:    br i1 false, label %[[TRAP:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[COND:%.*]] = icmp slt i8 [[I]], 100
; CHECK-NEXT:    br i1 [[COND]], label %[[LOOP]], label %[[DONE:.*]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret i8 [[I]]
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    ret i8 0
;
entry:
  br label %loop

loop:
  %i = phi i8 [ 0, %entry ], [ %i.next, %latch ]
  %s = call { i8, i1 } @llvm.sadd.with.overflow.i8(i8 %i, i8 2)
  %i.next = extractvalue { i8, i1 } %s, 0
  %o = extractvalue { i8, i1 } %s, 1
  br i1 %o, label %trap, label %latch

latch:
  %cond = icmp slt i8 %i, 100
  br i1 %cond, label %loop, label %done

done:
  ret i8 %i

trap:
  ret i8 0
}

