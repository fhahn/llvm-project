; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s

; `sadd.with.overflow(A, B)` with both operands variable cannot overflow when
; the mathematical sum `A + B` is sandwiched between two other program values:
; a value of the same integer type is always in [SMIN, SMAX], so
; `Lo s<= A + B s<= Hi` leaves no room for overflow in either direction.
; The sum is not an IR value, so it reaches the solver as an *addend* on one
; side of a two-operand query.

declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)
declare void @llvm.assume(i1)

; 0 s<= %a + %b (both non-negative) and %a + %b s<= %w (via %b s<= %n and
; %a + %n s<= %w).  Both bounds hold, the overflow flag is false.
define i1 @sadd_var_sandwiched(i64 %a, i64 %b, i64 %n, i64 %w) {
; CHECK-LABEL: define i1 @sadd_var_sandwiched(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]], i64 [[N:%.*]], i64 [[W:%.*]]) {
; CHECK-NEXT:    [[P0:%.*]] = icmp sge i64 [[A]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[P0]])
; CHECK-NEXT:    [[P1:%.*]] = icmp sge i64 [[B]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[P1]])
; CHECK-NEXT:    [[P2:%.*]] = icmp sle i64 [[B]], [[N]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[P2]])
; CHECK-NEXT:    [[SUM:%.*]] = add nsw i64 [[A]], [[N]]
; CHECK-NEXT:    [[P3:%.*]] = icmp sle i64 [[SUM]], [[W]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[P3]])
; CHECK-NEXT:    ret i1 false
;
  %p0 = icmp sge i64 %a, 0
  call void @llvm.assume(i1 %p0)
  %p1 = icmp sge i64 %b, 0
  call void @llvm.assume(i1 %p1)
  %p2 = icmp sle i64 %b, %n
  call void @llvm.assume(i1 %p2)
  %sum = add nsw i64 %a, %n
  %p3 = icmp sle i64 %sum, %w
  call void @llvm.assume(i1 %p3)
  %wo = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 %b)
  %ov = extractvalue { i64, i1 } %wo, 1
  ret i1 %ov
}

; The upper bound is missing (nothing relates %b to a value bounding the sum),
; so the overflow flag must be kept.
define i1 @sadd_var_no_upper_bound(i64 %a, i64 %b) {
; CHECK-LABEL: define i1 @sadd_var_no_upper_bound(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:    [[P0:%.*]] = icmp sge i64 [[A]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[P0]])
; CHECK-NEXT:    [[P1:%.*]] = icmp sge i64 [[B]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[P1]])
; CHECK-NEXT:    [[WO:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i64, i1 } [[WO]], 1
; CHECK-NEXT:    ret i1 [[OV]]
;
  %p0 = icmp sge i64 %a, 0
  call void @llvm.assume(i1 %p0)
  %p1 = icmp sge i64 %b, 0
  call void @llvm.assume(i1 %p1)
  %wo = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 %b)
  %ov = extractvalue { i64, i1 } %wo, 1
  ret i1 %ov
}

; The lower bound is missing: %a s<= %w bounds the sum from above only if %b is
; non-negative, and nothing rules out a large negative %b underflowing.
define i1 @sadd_var_no_lower_bound(i64 %a, i64 %b, i64 %w) {
; CHECK-LABEL: define i1 @sadd_var_no_lower_bound(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]], i64 [[W:%.*]]) {
; CHECK-NEXT:    [[P0:%.*]] = icmp sle i64 [[B]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[P0]])
; CHECK-NEXT:    [[P1:%.*]] = icmp sle i64 [[A]], [[W]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[P1]])
; CHECK-NEXT:    [[WO:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i64, i1 } [[WO]], 1
; CHECK-NEXT:    ret i1 [[OV]]
;
  %p0 = icmp sle i64 %b, 0
  call void @llvm.assume(i1 %p0)
  %p1 = icmp sle i64 %a, %w
  call void @llvm.assume(i1 %p1)
  %wo = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 %b)
  %ov = extractvalue { i64, i1 } %wo, 1
  ret i1 %ov
}

; A witness must not be derived from the sum being bounded: `%a + %b s<= %later`
; with %later == %a + %b + 1 is trivially true but proves nothing, because
; %later's decomposition is only in range if the add did not overflow.  %later
; does not dominate the intrinsic, so it is rejected.
define i64 @sadd_var_witness_below_intrinsic(i64 %a, i64 %b) {
; CHECK-LABEL: define i64 @sadd_var_witness_below_intrinsic(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:    [[P0:%.*]] = icmp sge i64 [[A]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[P0]])
; CHECK-NEXT:    [[P1:%.*]] = icmp sge i64 [[B]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[P1]])
; CHECK-NEXT:    [[WO:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i64, i1 } [[WO]], 1
; CHECK-NEXT:    br i1 [[OV]], label %[[TRAP:.*]], label %[[CONT:.*]]
; CHECK:       [[CONT]]:
; CHECK-NEXT:    [[S:%.*]] = extractvalue { i64, i1 } [[WO]], 0
; CHECK-NEXT:    [[LATER:%.*]] = add nsw i64 [[S]], 1
; CHECK-NEXT:    [[P2:%.*]] = icmp sle i64 [[S]], [[LATER]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[P2]])
; CHECK-NEXT:    ret i64 [[S]]
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    ret i64 0
;
  %p0 = icmp sge i64 %a, 0
  call void @llvm.assume(i1 %p0)
  %p1 = icmp sge i64 %b, 0
  call void @llvm.assume(i1 %p1)
  %wo = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 %b)
  %ov = extractvalue { i64, i1 } %wo, 1
  br i1 %ov, label %trap, label %cont

cont:
  %s = extractvalue { i64, i1 } %wo, 0
  %later = add nsw i64 %s, 1
  %p2 = icmp sle i64 %s, %later
  call void @llvm.assume(i1 %p2)
  ret i64 %s

trap:
  ret i64 0
}

; An unsigned bound is not enough: `A + B u<= W` only limits the sum to UMAX.
; Here %a and %b are unsigned-bounded by %w but the signed sum still overflows
; (e.g. %a = %b = SMAX/2 + 1), so the flag must be kept.
define i1 @sadd_var_unsigned_bound_insufficient(i64 %a, i64 %b, i64 %w) {
; CHECK-LABEL: define i1 @sadd_var_unsigned_bound_insufficient(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]], i64 [[W:%.*]]) {
; CHECK-NEXT:    [[P0:%.*]] = icmp ule i64 [[A]], [[W]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[P0]])
; CHECK-NEXT:    [[P1:%.*]] = icmp ule i64 [[B]], [[W]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[P1]])
; CHECK-NEXT:    [[WO:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i64, i1 } [[WO]], 1
; CHECK-NEXT:    ret i1 [[OV]]
;
  %p0 = icmp ule i64 %a, %w
  call void @llvm.assume(i1 %p0)
  %p1 = icmp ule i64 %b, %w
  call void @llvm.assume(i1 %p1)
  %wo = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 %b)
  %ov = extractvalue { i64, i1 } %wo, 1
  ret i1 %ov
}

; End-to-end shape from Swift's `span[base + i]` under
; `base >= 0, n >= 0, base + n <= count`: the per-iteration `base + i` overflow
; check is removed because 0 s<= base + i s<= base + n s<= count.
define i64 @span_guarded_offset(ptr %p, i64 %count, i64 %base, i64 %n) {
; CHECK-LABEL: define i64 @span_guarded_offset(
; CHECK-SAME: ptr [[P:%.*]], i64 [[COUNT:%.*]], i64 [[BASE:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[C0:%.*]] = icmp sgt i64 [[BASE]], -1
; CHECK-NEXT:    [[C1:%.*]] = icmp sgt i64 [[N]], -1
; CHECK-NEXT:    [[AND:%.*]] = select i1 [[C0]], i1 [[C1]], i1 false
; CHECK-NEXT:    br i1 [[AND]], label %[[CHECKED:.*]], label %[[EXIT:.*]]
; CHECK:       [[CHECKED]]:
; CHECK-NEXT:    [[WOB:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[BASE]], i64 [[N]])
; CHECK-NEXT:    [[OVB:%.*]] = extractvalue { i64, i1 } [[WOB]], 1
; CHECK-NEXT:    br i1 [[OVB]], label %[[TRAP:.*]], label %[[GUARD:.*]]
; CHECK:       [[GUARD]]:
; CHECK-NEXT:    [[END:%.*]] = extractvalue { i64, i1 } [[WOB]], 0
; CHECK-NEXT:    [[TOOBIG:%.*]] = icmp slt i64 [[COUNT]], [[END]]
; CHECK-NEXT:    [[EMPTY:%.*]] = icmp eq i64 [[N]], 0
; CHECK-NEXT:    [[SKIP:%.*]] = or i1 [[EMPTY]], [[TOOBIG]]
; CHECK-NEXT:    br i1 [[SKIP]], label %[[EXIT]], label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[SUM:%.*]] = phi i64 [ 0, %[[GUARD]] ], [ [[SUM_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[GUARD]] ], [ [[IV_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = add nsw i64 [[BASE]], [[IV]]
; CHECK-NEXT:    br i1 false, label %[[TRAP]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw [8 x i8], ptr [[P]], i64 [[TMP0]]
; CHECK-NEXT:    [[LD:%.*]] = load i64, ptr [[GEP]], align 8
; CHECK-NEXT:    [[SUM_NEXT]] = add i64 [[LD]], [[SUM]]
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i64 [ 0, %[[GUARD]] ], [ 0, %[[ENTRY]] ], [ [[SUM_NEXT]], %[[LATCH]] ]
; CHECK-NEXT:    ret i64 [[RES]]
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    unreachable
;
entry:
  %c0 = icmp sgt i64 %base, -1
  %c1 = icmp sgt i64 %n, -1
  %and = select i1 %c0, i1 %c1, i1 false
  br i1 %and, label %checked, label %exit

checked:
  %wob = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %base, i64 %n)
  %ovb = extractvalue { i64, i1 } %wob, 1
  br i1 %ovb, label %trap, label %guard

guard:
  %end = extractvalue { i64, i1 } %wob, 0
  %toobig = icmp slt i64 %count, %end
  %empty = icmp eq i64 %n, 0
  %skip = or i1 %empty, %toobig
  br i1 %skip, label %exit, label %loop

loop:
  %sum = phi i64 [ 0, %guard ], [ %sum.next, %latch ]
  %iv = phi i64 [ 0, %guard ], [ %iv.next, %latch ]
  %wo = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %base, i64 %iv)
  %ov = extractvalue { i64, i1 } %wo, 1
  br i1 %ov, label %trap, label %latch

latch:
  %idx = extractvalue { i64, i1 } %wo, 0
  %iv.next = add nuw nsw i64 %iv, 1
  %gep = getelementptr inbounds nuw [8 x i8], ptr %p, i64 %idx
  %ld = load i64, ptr %gep, align 8
  %sum.next = add i64 %ld, %sum
  %done = icmp eq i64 %iv.next, %n
  br i1 %done, label %exit, label %loop

exit:
  %res = phi i64 [ 0, %guard ], [ 0, %entry ], [ %sum.next, %latch ]
  ret i64 %res

trap:
  unreachable
}
