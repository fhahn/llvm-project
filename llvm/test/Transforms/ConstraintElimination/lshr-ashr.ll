; CHECK-NEXT:    [[R:%.*]] = lshr i32 [[X]], 4
; CHECK-NEXT:    br label [[CHECK:%.*]]
; CHECK:       check:
; CHECK-NEXT:    ret i1 true
; CHECK:       else:
; CHECK-NEXT:    ret i1 false
;
entry:
  %cmp = icmp ule i32 %x, %bound
  br i1 %cmp, label %mid, label %else

mid:
  %r = lshr i32 %x, 4
  br label %check

check:
  %v = icmp ule i32 %r, %bound
  ret i1 %v

else:
  ret i1 false
}

