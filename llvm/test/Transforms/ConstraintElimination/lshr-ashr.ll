; lshr x, C: result <= UINT_MAX >> C, so result < (UINT_MAX >> C) + 1.
define i1 @lshr_const_shift_ule_max(i32 noundef %x) {
; CHECK-LABEL: @lshr_const_shift_ule_max(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[R:%.*]] = lshr i32 [[X:%.*]], 8
; CHECK-NEXT:    ret i1 true
;
entry:
  %r = lshr i32 %x, 8
  ; Result <= 0x00FFFFFF (16777215)
  %v = icmp ule i32 %r, 16777215
  ret i1 %v
}

; lshr x, C: result < bound when (UINT_MAX >> C) < bound.
define i1 @lshr_const_shift_ult_bound(i32 noundef %x) {
; CHECK-LABEL: @lshr_const_shift_ult_bound(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[R:%.*]] = lshr i32 [[X:%.*]], 16
; CHECK-NEXT:    ret i1 true
;
entry:
  %r = lshr i32 %x, 16
  ; Result <= 0x0000FFFF (65535), so result < 65536.
  %v = icmp ult i32 %r, 65536
  ret i1 %v
}

