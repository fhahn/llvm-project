; CHECK:       [[GUARDED]]:
; CHECK-NEXT:    [[H:%.*]] = lshr i64 [[X]], 64
; CHECK-NEXT:    [[CHK:%.*]] = icmp ult i64 [[H]], [[N]]
; CHECK-NEXT:    ret i1 [[CHK]]
; CHECK:       [[OUT]]:
; CHECK-NEXT:    ret i1 false
;
entry:
