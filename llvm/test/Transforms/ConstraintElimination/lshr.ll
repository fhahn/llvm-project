; CHECK-NEXT:    br i1 [[INRANGE]], label %[[GUARDED:.*]], label %[[OUT:.*]]
; CHECK:       [[GUARDED]]:
; CHECK-NEXT:    [[H:%.*]] = lshr i64 [[X]], 4
; CHECK-NEXT:    ret i1 true
; CHECK:       [[OUT]]:
; CHECK-NEXT:    ret i1 false
;
