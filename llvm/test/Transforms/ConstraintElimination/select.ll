; Multiple selects with the same implied condition.
define i32 @select_multiple_same_cond(i32 %x, i32 %y, i32 %a, i32 %b, i32 %c, i32 %d) {
; CHECK-LABEL: @select_multiple_same_cond(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[CMP1:%.*]] = icmp ult i32 [[X:%.*]], [[Y:%.*]]
; CHECK-NEXT:    br i1 [[CMP1]], label [[THEN:%.*]], label [[ELSE:%.*]]
; CHECK:       then:
; CHECK-NEXT:    [[RES:%.*]] = add i32 [[A:%.*]], [[C:%.*]]
; CHECK-NEXT:    ret i32 [[RES]]
; CHECK:       else:
; CHECK-NEXT:    ret i32 0
;
entry:
  %cmp1 = icmp ult i32 %x, %y
  br i1 %cmp1, label %then, label %else

then:
  %cmp2 = icmp ult i32 %x, %y
  %sel1 = select i1 %cmp2, i32 %a, i32 %b
  %sel2 = select i1 %cmp2, i32 %c, i32 %d
