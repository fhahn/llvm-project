; Select with signed predicate implied by dominating unsigned + non-negative.
define i32 @select_signed_from_unsigned(i32 %x, i32 %y, i32 %a, i32 %b) {
; CHECK-LABEL: @select_signed_from_unsigned(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[CMP1:%.*]] = icmp ult i32 [[X:%.*]], [[Y:%.*]]
; CHECK-NEXT:    br i1 [[CMP1]], label [[THEN:%.*]], label [[ELSE:%.*]]
; CHECK:       then:
; CHECK-NEXT:    [[CMP2:%.*]] = icmp slt i32 [[X]], [[Y]]
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[CMP2]], i32 [[A:%.*]], i32 [[B:%.*]]
; CHECK-NEXT:    ret i32 [[SEL]]
; CHECK:       else:
; CHECK-NEXT:    ret i32 0
;
entry:
  %cmp1 = icmp ult i32 %x, %y
  br i1 %cmp1, label %then, label %else

then:
  ; x < y unsigned, but we don't necessarily know x < y signed
  %cmp2 = icmp slt i32 %x, %y
  %sel = select i1 %cmp2, i32 %a, i32 %b
  ret i32 %sel

else:
  ret i32 0
}

