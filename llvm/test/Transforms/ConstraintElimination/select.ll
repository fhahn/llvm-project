; Select in loop body with loop invariant condition.
define i32 @select_in_loop(i32 %n, i32 %a, i32 %b) {
; CHECK-LABEL: @select_in_loop(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[CMP_ENTRY:%.*]] = icmp sgt i32 [[N:%.*]], 0
; CHECK-NEXT:    br i1 [[CMP_ENTRY]], label [[LOOP:%.*]], label [[EXIT:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, [[ENTRY:%.*]] ], [ [[I_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[CMP_LOOP:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP_LOOP]], label [[LOOP]], label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    [[RES:%.*]] = phi i32 [ 0, [[ENTRY]] ], [ [[A:%.*]], [[LOOP]] ]
; CHECK-NEXT:    ret i32 [[RES]]
;
entry:
  %cmp.entry = icmp sgt i32 %n, 0
  br i1 %cmp.entry, label %loop, label %exit

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %cmp.sel = icmp sgt i32 %n, 0
  %sel = select i1 %cmp.sel, i32 %a, i32 %b
  %i.next = add i32 %i, 1
  %cmp.loop = icmp slt i32 %i.next, %n
  br i1 %cmp.loop, label %loop, label %exit

exit:
  %res = phi i32 [ 0, %entry ], [ %sel, %loop ]
  ret i32 %res
}

