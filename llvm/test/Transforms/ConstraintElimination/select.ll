; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s

; Select with condition implied true by dominating branch.
define i32 @select_cond_implied_true(i32 %x, i32 %y, i32 %a, i32 %b) {
; CHECK-LABEL: @select_cond_implied_true(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[CMP1:%.*]] = icmp ult i32 [[X:%.*]], [[Y:%.*]]
; CHECK-NEXT:    br i1 [[CMP1]], label [[THEN:%.*]], label [[ELSE:%.*]]
; CHECK:       then:
; CHECK-NEXT:    ret i32 [[A:%.*]]
; CHECK:       else:
; CHECK-NEXT:    ret i32 0
;
entry:
  %cmp1 = icmp ult i32 %x, %y
  br i1 %cmp1, label %then, label %else

then:
  %cmp2 = icmp ult i32 %x, %y
  %sel = select i1 %cmp2, i32 %a, i32 %b
  ret i32 %sel

else:
  ret i32 0
}

