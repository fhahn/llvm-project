; CHECK-NEXT:    [[B:%.*]] = mul nsw i64 [[X]], 4611686018427387904
; CHECK-NEXT:    [[OP0:%.*]] = add nsw i64 [[A]], [[B]]
; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[OP0]], [[P]]
; CHECK-NEXT:    br i1 [[C]], label [[T:%.*]], label [[F:%.*]]
; CHECK:       t:
