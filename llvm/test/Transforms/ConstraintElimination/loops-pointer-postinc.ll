; The loop exits via the header when %p.next == %end and via the latch
; otherwise. In both exit blocks %p.next u<= %end holds.
define i1 @postinc_header_exit_facts_multi_exit(ptr %start, ptr %end, i1 %c) {
; CHECK-LABEL: define i1 @postinc_header_exit_facts_multi_exit(
; CHECK-SAME: ptr [[START:%.*]], ptr [[END:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ult ptr [[START]], [[END]]
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_HEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[START]], %[[ENTRY]] ], [ [[P_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[P_NEXT]] = getelementptr inbounds i8, ptr [[P]], i64 1
; CHECK-NEXT:    [[EC:%.*]] = icmp ne ptr [[P_NEXT]], [[END]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP_LATCH]], label %[[EXIT]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    br i1 [[C]], label %[[EXIT_EARLY:.*]], label %[[LOOP_HEADER]]
; CHECK:       [[EXIT_EARLY]]:
; CHECK-NEXT:    ret i1 false
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i1 false
;
entry:
  %guard = icmp ult ptr %start, %end
  br i1 %guard, label %loop.header, label %exit

loop.header:
  %p = phi ptr [ %start, %entry ], [ %p.next, %loop.latch ]
  %p.next = getelementptr inbounds i8, ptr %p, i64 1
  %ec = icmp ne ptr %p.next, %end
  br i1 %ec, label %loop.latch, label %exit

loop.latch:
  br i1 %c, label %exit.early, label %loop.header

exit.early:
  %t.1 = icmp ugt ptr %p.next, %end
  ret i1 %t.1

exit:
  ret i1 false
}

