; RUN: opt -p constraint-elimination -S %s | FileCheck %s

; Tests for loop exit conditions comparing the post-increment of a pointer
; induction, i.e. a getelementptr on the induction phi, against a loop-invariant
; bound.

; Address space 1 has a 32 bit index type, while the pointers are 64 bit wide.
target datalayout = "e-p1:64:64:64:32"

declare void @use(i1)

; The latch exits when %p.next == %end, so %p is in [%start, %end - 1] and
; %p u< %end holds in the header, given the guard %start u< %end.
define void @postinc_latch_step_1(ptr %start, ptr %end) {
; CHECK-LABEL: define void @postinc_latch_step_1(
; CHECK-SAME: ptr [[START:%.*]], ptr [[END:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ult ptr [[START]], [[END]]
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_HEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[START]], %[[ENTRY]] ], [ [[P_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    br label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[P_NEXT]] = getelementptr inbounds i8, ptr [[P]], i64 1
; CHECK-NEXT:    [[EC:%.*]] = icmp ne ptr [[P_NEXT]], [[END]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP_HEADER]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard = icmp ult ptr %start, %end
  br i1 %guard, label %loop.header, label %exit

loop.header:
  %p = phi ptr [ %start, %entry ], [ %p.next, %loop.latch ]
  %t.1 = icmp ult ptr %p, %end
  call void @use(i1 %t.1)
  br label %loop.latch

loop.latch:
  %p.next = getelementptr inbounds i8, ptr %p, i64 1
  %ec = icmp ne ptr %p.next, %end
  br i1 %ec, label %loop.header, label %exit

exit:
  ret void
}

