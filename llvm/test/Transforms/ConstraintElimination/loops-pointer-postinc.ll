; (%end, %start], given the guard %end u<= %start.
define void @postdec_header_cmp_phi(ptr %start, ptr %end) {
; CHECK-LABEL: define void @postdec_header_cmp_phi(
; CHECK-SAME: ptr [[START:%.*]], ptr [[END:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ule ptr [[END]], [[START]]
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_HEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[START]], %[[ENTRY]] ], [ [[P_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[EC:%.*]] = icmp ne ptr [[P]], [[END]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP_BODY:.*]], label %[[EXIT]]
; CHECK:       [[LOOP_BODY]]:
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    br label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[P_NEXT]] = getelementptr inbounds i8, ptr [[P]], i64 -1
; CHECK-NEXT:    br label %[[LOOP_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard = icmp ule ptr %end, %start
  br i1 %guard, label %loop.header, label %exit

loop.header:
  %p = phi ptr [ %start, %entry ], [ %p.next, %loop.latch ]
  %ec = icmp ne ptr %p, %end
  br i1 %ec, label %loop.body, label %exit

loop.body:
  %t.1 = icmp ugt ptr %p, %end
  call void @use(i1 %t.1)
  %t.2 = icmp ule ptr %p, %start
  call void @use(i1 %t.2)
  br label %loop.latch

loop.latch:
  %p.next = getelementptr inbounds i8, ptr %p, i64 -1
  br label %loop.header

exit:
  ret void
}

; Negative test: the offset of the compared GEP is not constant.
define void @postinc_latch_variable_offset_in_compare(ptr %start, ptr %end, i64 %off) {
; CHECK-LABEL: define void @postinc_latch_variable_offset_in_compare(
; CHECK-SAME: ptr [[START:%.*]], ptr [[END:%.*]], i64 [[OFF:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ult ptr [[START]], [[END]]
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_HEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[START]], %[[ENTRY]] ], [ [[P_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[C_1:%.*]] = icmp ult ptr [[P]], [[END]]
; CHECK-NEXT:    call void @use(i1 [[C_1]])
; CHECK-NEXT:    br label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[P_NEXT]] = getelementptr inbounds i8, ptr [[P]], i64 1
; CHECK-NEXT:    [[P_OFF:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 [[OFF]]
; CHECK-NEXT:    [[EC:%.*]] = icmp ne ptr [[P_OFF]], [[END]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP_HEADER]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard = icmp ult ptr %start, %end
  br i1 %guard, label %loop.header, label %exit

loop.header:
  %p = phi ptr [ %start, %entry ], [ %p.next, %loop.latch ]
  %c.1 = icmp ult ptr %p, %end
  call void @use(i1 %c.1)
  br label %loop.latch

loop.latch:
  %p.next = getelementptr inbounds i8, ptr %p, i64 1
  %p.off = getelementptr inbounds i8, ptr %p, i64 %off
  %ec = icmp ne ptr %p.off, %end
  br i1 %ec, label %loop.header, label %exit

exit:
  ret void
}

; Negative test: the step of the induction is not constant.
define void @postinc_header_variable_step(ptr %start, ptr %end, i64 %step) {
; CHECK-LABEL: define void @postinc_header_variable_step(
; CHECK-SAME: ptr [[START:%.*]], ptr [[END:%.*]], i64 [[STEP:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ult ptr [[START]], [[END]]
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_HEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[START]], %[[ENTRY]] ], [ [[P_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[EC:%.*]] = icmp ne ptr [[P]], [[END]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP_BODY:.*]], label %[[EXIT]]
; CHECK:       [[LOOP_BODY]]:
; CHECK-NEXT:    [[C_1:%.*]] = icmp ult ptr [[P]], [[END]]
; CHECK-NEXT:    call void @use(i1 [[C_1]])
; CHECK-NEXT:    br label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[P_NEXT]] = getelementptr inbounds i8, ptr [[P]], i64 [[STEP]]
; CHECK-NEXT:    br label %[[LOOP_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard = icmp ult ptr %start, %end
  br i1 %guard, label %loop.header, label %exit

loop.header:
  %p = phi ptr [ %start, %entry ], [ %p.next, %loop.latch ]
  %ec = icmp ne ptr %p, %end
  br i1 %ec, label %loop.body, label %exit

loop.body:
  %c.1 = icmp ult ptr %p, %end
  call void @use(i1 %c.1)
  br label %loop.latch

loop.latch:
  %p.next = getelementptr inbounds i8, ptr %p, i64 %step
  br label %loop.header

exit:
  ret void
}

; Negative test: nothing is known about a vector of pointers induction.
define void @postinc_latch_vector_of_pointers(<2 x ptr> %start, <2 x ptr> %end) {
; CHECK-LABEL: define void @postinc_latch_vector_of_pointers(
; CHECK-SAME: <2 x ptr> [[START:%.*]], <2 x ptr> [[END:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[P:%.*]] = phi <2 x ptr> [ [[START]], %[[ENTRY]] ], [ [[P_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[C_1:%.*]] = icmp ult <2 x ptr> [[P]], [[START]]
; CHECK-NEXT:    call void @use_vec(<2 x i1> [[C_1]])
; CHECK-NEXT:    br label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[P_NEXT]] = getelementptr inbounds i8, <2 x ptr> [[P]], <2 x i64> splat (i64 1)
; CHECK-NEXT:    [[EC:%.*]] = icmp ne <2 x ptr> [[P_NEXT]], [[END]]
; CHECK-NEXT:    [[EC_0:%.*]] = extractelement <2 x i1> [[EC]], i32 0
; CHECK-NEXT:    br i1 [[EC_0]], label %[[LOOP_HEADER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop.header

loop.header:
  %p = phi <2 x ptr> [ %start, %entry ], [ %p.next, %loop.latch ]
  %c.1 = icmp ult <2 x ptr> %p, %start
  call void @use_vec(<2 x i1> %c.1)
  br label %loop.latch

loop.latch:
  %p.next = getelementptr inbounds i8, <2 x ptr> %p, <2 x i64> splat (i64 1)
  %ec = icmp ne <2 x ptr> %p.next, %end
  %ec.0 = extractelement <2 x i1> %ec, i32 0
  br i1 %ec.0, label %loop.header, label %exit

exit:
  ret void
}

; Negative test: without a guard, %start may be equal to %end, in which case the
; induction never reaches %end and %p u< %end does not hold in any iteration.
define void @postinc_single_block_loop_no_guard(ptr %start, ptr %end) {
; CHECK-LABEL: define void @postinc_single_block_loop_no_guard(
; CHECK-SAME: ptr [[START:%.*]], ptr [[END:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[START]], %[[ENTRY]] ], [ [[P_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P_NEXT]] = getelementptr inbounds i8, ptr [[P]], i64 1
; CHECK-NEXT:    [[C_1:%.*]] = icmp ult ptr [[P]], [[END]]
; CHECK-NEXT:    call void @use(i1 [[C_1]])
; CHECK-NEXT:    [[EC:%.*]] = icmp ne ptr [[P_NEXT]], [[END]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %p = phi ptr [ %start, %entry ], [ %p.next, %loop ]
  %p.next = getelementptr inbounds i8, ptr %p, i64 1
  %c.1 = icmp ult ptr %p, %end
  call void @use(i1 %c.1)
  %ec = icmp ne ptr %p.next, %end
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}

; Negative test: single-block loops are not supported, as the in-loop successor
; of the exiting block is the block itself.
define void @postinc_single_block_loop_guarded(ptr %start, ptr %end) {
; CHECK-LABEL: define void @postinc_single_block_loop_guarded(
; CHECK-SAME: ptr [[START:%.*]], ptr [[END:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
