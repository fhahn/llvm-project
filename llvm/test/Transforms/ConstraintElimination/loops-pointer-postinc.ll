; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[START]], %[[ENTRY]] ], [ [[P_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P_NEXT]] = getelementptr inbounds i8, ptr [[P]], i64 1
; CHECK-NEXT:    [[C_1:%.*]] = icmp ult ptr [[P]], [[END]]
; CHECK-NEXT:    call void @use(i1 [[C_1]])
; CHECK-NEXT:    [[EC:%.*]] = icmp ne ptr [[P_NEXT]], [[END]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard = icmp ult ptr %start, %end
  br i1 %guard, label %loop, label %exit

loop:
  %p = phi ptr [ %start, %entry ], [ %p.next, %loop ]
  %p.next = getelementptr inbounds i8, ptr %p, i64 1
  %c.1 = icmp ult ptr %p, %end
  call void @use(i1 %c.1)
  %ec = icmp ne ptr %p.next, %end
