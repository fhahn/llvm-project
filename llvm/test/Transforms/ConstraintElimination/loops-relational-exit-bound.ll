  %f.1 = icmp ugt i32 %iv.next, %n
  call void @use(i1 %f.1)
  ret void

exit.early:
  ret void
}

; The post-increment is compared in the header.
define void @ult_postinc_header(i32 %n) {
; CHECK-LABEL: define void @ult_postinc_header(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ugt i32 [[N]], 0
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_HEADER:.*]], label %[[EXIT_EARLY:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i32 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp ult i32 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP_LATCH]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    br label %[[LOOP_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    call void @use(i1 false)
; CHECK-NEXT:    ret void
; CHECK:       [[EXIT_EARLY]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard = icmp ugt i32 %n, 0
  br i1 %guard, label %loop.header, label %exit.early

loop.header:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %iv.next = add nuw i32 %iv, 1
  %ec = icmp ult i32 %iv.next, %n
  br i1 %ec, label %loop.latch, label %exit

loop.latch:
  br label %loop.header

exit:
  %f.1 = icmp ugt i32 %iv.next, %n
  call void @use(i1 %f.1)
  ret void

exit.early:
  ret void
}

; Pointer induction stepping by one byte via an inbounds GEP, which implies the
; increment does not wrap unsigned.
define void @ptr_ult_step1_guarded(ptr %start, ptr %end) {
; CHECK-LABEL: define void @ptr_ult_step1_guarded(
; CHECK-SAME: ptr [[START:%.*]], ptr [[END:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
