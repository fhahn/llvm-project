; The exit block is shared with another exiting block, so the exiting edge from
; the header does not dominate it and no fact must be added for it.
define void @ult_shared_exit_block(i32 %n) {
; CHECK-LABEL: define void @ult_shared_exit_block(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[EC:%.*]] = icmp ult i32 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP_BODY:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_BODY]]:
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP_LATCH]], label %[[EXIT]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i32 [[IV]], 1
; CHECK-NEXT:    br label %[[LOOP_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[F_1:%.*]] = icmp ugt i32 [[IV]], [[N]]
; CHECK-NEXT:    call void @use(i1 [[F_1]])
; CHECK-NEXT:    ret void
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %ec = icmp ult i32 %iv, %n
  br i1 %ec, label %loop.body, label %exit

loop.body:
  %c = call i1 @cond()
  br i1 %c, label %loop.latch, label %exit

loop.latch:
  %iv.next = add nuw i32 %iv, 1
  br label %loop.header

exit:
  %f.1 = icmp ugt i32 %iv, %n
  call void @use(i1 %f.1)
  ret void
}

; The exit block of the header is only reached from the header, so it gets the
; fact. %exit.body is reached only after the header condition held, so the
; stronger %iv u< %n is already available there via %loop.body.
define void @ult_multiple_exits(i32 %n) {
; CHECK-LABEL: define void @ult_multiple_exits(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[EC:%.*]] = icmp ult i32 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP_BODY:.*]], label %[[EXIT_HEADER:.*]]
; CHECK:       [[LOOP_BODY]]:
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP_LATCH]], label %[[EXIT_BODY:.*]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i32 [[IV]], 1
; CHECK-NEXT:    br label %[[LOOP_HEADER]]
; CHECK:       [[EXIT_HEADER]]:
; CHECK-NEXT:    call void @use(i1 false)
; CHECK-NEXT:    ret void
; CHECK:       [[EXIT_BODY]]:
; CHECK-NEXT:    call void @use(i1 false)
; CHECK-NEXT:    ret void
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %ec = icmp ult i32 %iv, %n
  br i1 %ec, label %loop.body, label %exit.header

loop.body:
  %c = call i1 @cond()
  br i1 %c, label %loop.latch, label %exit.body

loop.latch:
  %iv.next = add nuw i32 %iv, 1
  br label %loop.header

exit.header:
  %f.1 = icmp ugt i32 %iv, %n
  call void @use(i1 %f.1)
  ret void

exit.body:
  %f.2 = icmp ugt i32 %iv, %n
  call void @use(i1 %f.2)
  ret void
}

; The exit block has a second predecessor outside the loop, so the exiting edge
