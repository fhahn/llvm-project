; CHECK-NEXT:    [[P:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV]], %[[LOOP_HEADER]] ]
; CHECK-NEXT:    [[F_1:%.*]] = icmp ugt i32 [[P]], [[N]]
; CHECK-NEXT:    call void @use(i1 [[F_1]])
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c, label %loop.header, label %exit

loop.header:
