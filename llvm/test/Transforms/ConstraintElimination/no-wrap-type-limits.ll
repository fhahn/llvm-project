; CHECK-NEXT:    [[S:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[A]], i64 2)
; CHECK-NEXT:    [[O:%.*]] = extractvalue { i64, i1 } [[S]], 1
; CHECK-NEXT:    ret i1 [[O]]
;
  %pre = icmp slt i64 %a, %w
  call void @llvm.assume(i1 %pre)
  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 2)
  %o = extractvalue { i64, i1 } %s, 1
  ret i1 %o
}

