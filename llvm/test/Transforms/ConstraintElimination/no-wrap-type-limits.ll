; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s

; Every value in a constraint system is in the range of its type, and the
; systems state those limits as rows. A bound `Op + Slack <= W` on some other
; value W then proves `Op <= SMAX - Slack`, which is what no-wrap reasoning
; needs.
;
; A limit is only stated where it fits into a 64-bit coefficient, which leaves
; out -SMIN and UMAX at 64 bits; the neg_* tests below cover that gap.

declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)
declare { i8, i1 } @llvm.uadd.with.overflow.i8(i8, i8)
declare void @llvm.assume(i1)
declare void @use(i8)

; A s< W (W a variable, hence W s<= SMAX) proves A + 1 does not overflow.
define i1 @sadd_one_slt(i64 %a, i64 %w) {
; CHECK-LABEL: define i1 @sadd_one_slt(
; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i64 [[A]], [[W]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    ret i1 false
;
  %pre = icmp slt i64 %a, %w
  call void @llvm.assume(i1 %pre)
  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 1)
  %o = extractvalue { i64, i1 } %s, 1
  ret i1 %o
}

; A s> W would prove A s>= SMIN + 1, but `V s>= SMIN` is not representable at
; 64 bits, so the overflow check stays.
define i1 @neg_sadd_negone_sgt_i64(i64 %a, i64 %w) {
; CHECK-LABEL: define i1 @neg_sadd_negone_sgt_i64(
; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
; CHECK-NEXT:    [[PRE:%.*]] = icmp sgt i64 [[A]], [[W]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[S:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[A]], i64 -1)
; CHECK-NEXT:    [[O:%.*]] = extractvalue { i64, i1 } [[S]], 1
; CHECK-NEXT:    ret i1 [[O]]
;
  %pre = icmp sgt i64 %a, %w
  call void @llvm.assume(i1 %pre)
  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 -1)
  %o = extractvalue { i64, i1 } %s, 1
  ret i1 %o
}

; A non-strict bound A s<= W does not prove A + 1 is in range (A and W could
; both be SMAX), so the overflow check must be kept.
define i1 @neg_sadd_one_sle(i64 %a, i64 %w) {
; CHECK-LABEL: define i1 @neg_sadd_one_sle(
; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
; CHECK-NEXT:    [[PRE:%.*]] = icmp sle i64 [[A]], [[W]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[S:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[A]], i64 1)
; CHECK-NEXT:    [[O:%.*]] = extractvalue { i64, i1 } [[S]], 1
; CHECK-NEXT:    ret i1 [[O]]
;
  %pre = icmp sle i64 %a, %w
  call void @llvm.assume(i1 %pre)
  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 1)
  %o = extractvalue { i64, i1 } %s, 1
  ret i1 %o
}

