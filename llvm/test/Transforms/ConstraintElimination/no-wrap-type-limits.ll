; The motivating shape: a checked increment of an induction variable that is
; strictly below a *variable* loop bound.
define void @loop_checked_increment(i64 %n, ptr %p) {
; CHECK-LABEL: define void @loop_checked_increment(
; CHECK-SAME: i64 [[N:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[TMP0:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP_LATCH]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    store i8 0, ptr [[P]], align 1
; CHECK-NEXT:    [[TMP0]] = add nsw i64 [[IV]], 1
; CHECK-NEXT:    br i1 false, label %[[TRAP:.*]], label %[[LOOP_HEADER]]
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    unreachable
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %cmp = icmp slt i64 %iv, %n
  br i1 %cmp, label %loop.latch, label %exit

loop.latch:
  store i8 0, ptr %p
  %ovf = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %iv, i64 1)
  %iv.next = extractvalue { i64, i1 } %ovf, 0
  %o = extractvalue { i64, i1 } %ovf, 1
  br i1 %o, label %trap, label %loop.header

trap:
  unreachable

exit:
  ret void
}

; The same loop with a plain increment gets nsw.
define void @loop_increment_nsw(i64 %n, ptr %p) {
; CHECK-LABEL: define void @loop_increment_nsw(
; CHECK-SAME: i64 [[N:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP_LATCH]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    store i8 0, ptr [[P]], align 1
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    br label %[[LOOP_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %cmp = icmp slt i64 %iv, %n
  br i1 %cmp, label %loop.latch, label %exit

loop.latch:
  store i8 0, ptr %p
  %iv.next = add i64 %iv, 1
  br label %loop.header

exit:
  ret void
}

; A bound against a wider value does not bound A by A's own limit: the fact is
; A s< W over i64, and W may be SMAX32 + 1 while A is SMAX32.
define i32 @neg_bound_wider_than_op(i32 %a, i64 %w) {
; CHECK-LABEL: define i32 @neg_bound_wider_than_op(
; CHECK-SAME: i32 [[A:%.*]], i64 [[W:%.*]]) {
; CHECK-NEXT:    [[SA:%.*]] = sext i32 [[A]] to i64
; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i64 [[SA]], [[W]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[ADD:%.*]] = add i32 [[A]], 1
; CHECK-NEXT:    ret i32 [[ADD]]
;
  %sa = sext i32 %a to i64
  %pre = icmp slt i64 %sa, %w
  call void @llvm.assume(i1 %pre)
  %add = add i32 %a, 1
  ret i32 %add
}

; The same fact against a narrower value does prove the bound.
define i64 @bound_narrower_than_op(i64 %a, i32 %w) {
; CHECK-LABEL: define i64 @bound_narrower_than_op(
; CHECK-SAME: i64 [[A:%.*]], i32 [[W:%.*]]) {
; CHECK-NEXT:    [[SW:%.*]] = sext i32 [[W]] to i64
; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i64 [[A]], [[SW]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[ADD:%.*]] = add nsw i64 [[A]], 1
; CHECK-NEXT:    ret i64 [[ADD]]
;
  %sw = sext i32 %w to i64
  %pre = icmp slt i64 %a, %sw
  call void @llvm.assume(i1 %pre)
  %add = add i64 %a, 1
  ret i64 %add
}

; The limits are ordinary rows, so the solver combines them with the rest of
; the system: here the bound on A comes from a row over three variables.
define i64 @limit_through_multi_variable_row(i64 %a, i64 %x, i64 %w) {
; CHECK-LABEL: define i64 @limit_through_multi_variable_row(
; CHECK-SAME: i64 [[A:%.*]], i64 [[X:%.*]], i64 [[W:%.*]]) {
; CHECK-NEXT:    [[NN:%.*]] = icmp sge i64 [[X]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[NN]])
; CHECK-NEXT:    [[AX:%.*]] = add nsw i64 [[A]], [[X]]
; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i64 [[AX]], [[W]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[ADD:%.*]] = add nsw i64 [[A]], 1
; CHECK-NEXT:    ret i64 [[ADD]]
;
  %nn = icmp sge i64 %x, 0
  call void @llvm.assume(i1 %nn)
  %ax = add nsw i64 %a, %x
  %pre = icmp slt i64 %ax, %w
  call void @llvm.assume(i1 %pre)
  %add = add i64 %a, 1
  ret i64 %add
}

; And they decide comparisons against the limits themselves.
define i1 @icmp_at_signed_limits(i8 %a) {
; CHECK-LABEL: define i1 @icmp_at_signed_limits(
; CHECK-SAME: i8 [[A:%.*]]) {
; CHECK-NEXT:    [[R:%.*]] = and i1 true, true
; CHECK-NEXT:    ret i1 [[R]]
;
  %hi = icmp sle i8 %a, 127
  %lo = icmp sge i8 %a, -128
  %r = and i1 %hi, %lo
  ret i1 %r
}

; i64 is the exception for the unsigned maximum: the row is not representable.
define i1 @icmp_at_unsigned_limit_i64(i64 %a) {
