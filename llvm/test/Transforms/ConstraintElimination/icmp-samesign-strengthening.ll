; A signed relational compare whose operands are both known non-negative is
; equivalent to the unsigned one; record that with samesign.

define void @slt_both_non_negative(i32 %a, i32 %b) {
; CHECK-LABEL: define void @slt_both_non_negative(
; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A_NN:%.*]] = icmp sgt i32 [[A]], -1
; CHECK-NEXT:    call void @llvm.assume(i1 [[A_NN]])
; CHECK-NEXT:    [[B_NN:%.*]] = icmp sgt i32 [[B]], -1
; CHECK-NEXT:    call void @llvm.assume(i1 [[B_NN]])
; CHECK-NEXT:    [[C:%.*]] = icmp samesign ult i32 [[A]], [[B]]
; CHECK-NEXT:    call void @use(i1 [[C]])
; CHECK-NEXT:    ret void
;
entry:
  %a.nn = icmp sgt i32 %a, -1
  call void @llvm.assume(i1 %a.nn)
  %b.nn = icmp sgt i32 %b, -1
  call void @llvm.assume(i1 %b.nn)
  %c = icmp slt i32 %a, %b
  call void @use(i1 %c)
  ret void
}

