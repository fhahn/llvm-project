; CHECK:       [[HDR]]:
; CHECK-NEXT:    [[ACC:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[ACC_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[IDX:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[CUR:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[CUR]] = phi i64 [ 32, %[[PH]] ], [ [[NEXTV:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[INB:%.*]] = icmp ult i64 [[IDX]], [[COUNT]]
; CHECK-NEXT:    br i1 [[INB]], label %[[BODY:.*]], label %[[TRAP1:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[OV:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[CUR]], i64 32)
; CHECK-NEXT:    [[OVBIT:%.*]] = extractvalue { i64, i1 } [[OV]], 1
; CHECK-NEXT:    br i1 [[OVBIT]], label %[[TRAP2:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[NEXTV]] = extractvalue { i64, i1 } [[OV]], 0
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw i8, ptr [[BASE]], i64 [[IDX]]
; CHECK-NEXT:    [[LD:%.*]] = load i8, ptr [[GEP]], align 1
; CHECK-NEXT:    [[Z:%.*]] = zext i8 [[LD]] to i64
; CHECK-NEXT:    [[ACC_NEXT]] = add i64 [[ACC]], [[Z]]
; CHECK-NEXT:    [[DONE:%.*]] = icmp slt i64 [[COUNT]], [[NEXTV]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT]], label %[[HDR]]
; CHECK:       [[EXIT]]:
