; %start + 3 <s %high implies %start + {1,2,3} <s %high. `or disjoint` cannot
; carry between its operands, so it is that add and does not wrap.
define void @test_or_disjoint_as_add_slt(i8 %start, i8 %high) {
; CHECK-LABEL: define void @test_or_disjoint_as_add_slt(
; CHECK-SAME: i8 [[START:%.*]], i8 [[HIGH:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[START_PLUS_3:%.*]] = add nsw i8 [[START]], 3
; CHECK-NEXT:    [[C_1:%.*]] = icmp sge i8 [[START_PLUS_3]], [[HIGH]]
; CHECK-NEXT:    br i1 [[C_1]], label %[[THEN:.*]], label %[[END:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[I_1:%.*]] = or disjoint i8 [[START]], 1
; CHECK-NEXT:    [[T_1:%.*]] = icmp slt i8 [[I_1]], [[HIGH]]
; CHECK-NEXT:    call void @use(i1 [[T_1]])
; CHECK-NEXT:    ret void
; CHECK:       [[END]]:
; CHECK-NEXT:    [[START_1:%.*]] = or disjoint i8 [[START]], 1
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    [[START_2:%.*]] = or disjoint i8 [[START]], 2
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    [[START_3:%.*]] = or disjoint i8 [[START]], 3
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    [[START_4:%.*]] = or disjoint i8 [[START]], 4
; CHECK-NEXT:    [[C_4:%.*]] = icmp slt i8 [[START_4]], [[HIGH]]
; CHECK-NEXT:    call void @use(i1 [[C_4]])
; CHECK-NEXT:    ret void
;
entry:
  %start.plus.3 = add nsw i8 %start, 3
  %c.1 = icmp sge i8 %start.plus.3, %high
  br i1 %c.1, label %then, label %end

then:
  %i.1 = or disjoint i8 %start, 1
  %t.1 = icmp slt i8 %i.1, %high
  call void @use(i1 %t.1)
  ret void

end:
  %start.1 = or disjoint i8 %start, 1
  %f.1 = icmp slt i8 %start.1, %high
  call void @use(i1 %f.1)
  %start.2 = or disjoint i8 %start, 2
  %f.2 = icmp slt i8 %start.2, %high
  call void @use(i1 %f.2)
  %start.3 = or disjoint i8 %start, 3
  %f.3 = icmp slt i8 %start.3, %high
  call void @use(i1 %f.3)
  %start.4 = or disjoint i8 %start, 4
  %c.4 = icmp slt i8 %start.4, %high
  call void @use(i1 %c.4)
  ret void
}

; Same, with the disjoint or on the fact side: %x + 4 <=s %n implies %x <s %n.
