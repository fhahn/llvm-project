; CHECK-NEXT:    [[SUB:%.*]] = call i16 @llvm.usub.sat.i16(i16 [[A]], i16 [[B]])
; CHECK-NEXT:    [[ADD:%.*]] = add nuw i16 [[SUB]], [[B]]
; CHECK-NEXT:    [[C:%.*]] = icmp uge i16 [[ADD]], [[A]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %pre = icmp sge i16 %a, %b
