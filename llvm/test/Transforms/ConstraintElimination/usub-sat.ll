; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s

; Tests for the lower bound of llvm.usub.sat: under a dominating `a u>= b`,
; usub.sat(a, b) is exactly `a - b` and is decomposed as such, which relates the
; saturating difference back to its operands. The upper bound
; `usub.sat(a, b) u<= a` is covered by uadd-usub-sat.ll.

declare i64 @llvm.usub.sat.i64(i64, i64)
declare i16 @llvm.usub.sat.i16(i16, i16)
declare void @llvm.assume(i1)

; a u>= b ==> b + usub.sat(a, b) u>= a.
define i1 @usub_sat_lower_bound(i64 %a, i64 %b) {
; CHECK-LABEL: define i1 @usub_sat_lower_bound(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:    [[PRE:%.*]] = icmp uge i64 [[A]], [[B]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[SUB:%.*]] = call i64 @llvm.usub.sat.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    [[ADD:%.*]] = add nuw i64 [[SUB]], [[B]]
; CHECK-NEXT:    [[C:%.*]] = icmp uge i64 [[ADD]], [[A]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %pre = icmp uge i64 %a, %b
  call void @llvm.assume(i1 %pre)
  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
  %add = add nuw i64 %sub, %b
  %c = icmp uge i64 %add, %a
  ret i1 %c
}

; The reverse direction also holds: b + usub.sat(a, b) u<= a.
define i1 @usub_sat_upper_bound_of_sum(i64 %a, i64 %b) {
; CHECK-LABEL: define i1 @usub_sat_upper_bound_of_sum(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:    [[PRE:%.*]] = icmp uge i64 [[A]], [[B]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[SUB:%.*]] = call i64 @llvm.usub.sat.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    [[ADD:%.*]] = add nuw i64 [[SUB]], [[B]]
; CHECK-NEXT:    [[C:%.*]] = icmp ule i64 [[ADD]], [[A]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %pre = icmp uge i64 %a, %b
  call void @llvm.assume(i1 %pre)
  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
  %add = add nuw i64 %sub, %b
  %c = icmp ule i64 %add, %a
  ret i1 %c
}

; The pre-condition may also come from a branch.
define i1 @usub_sat_lower_bound_branch(i64 %a, i64 %b) {
; CHECK-LABEL: define i1 @usub_sat_lower_bound_branch(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[PRE:%.*]] = icmp uge i64 [[A]], [[B]]
; CHECK-NEXT:    br i1 [[PRE]], label %[[BB:.*]], label %[[EXIT:.*]]
; CHECK:       [[BB]]:
; CHECK-NEXT:    [[SUB:%.*]] = call i64 @llvm.usub.sat.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    [[ADD:%.*]] = add nuw i64 [[SUB]], [[B]]
; CHECK-NEXT:    [[C:%.*]] = icmp uge i64 [[ADD]], [[A]]
; CHECK-NEXT:    ret i1 [[C]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i1 false
;
entry:
  %pre = icmp uge i64 %a, %b
  br i1 %pre, label %bb, label %exit

bb:
  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
  %add = add nuw i64 %sub, %b
  %c = icmp uge i64 %add, %a
  ret i1 %c

exit:
  ret i1 false
}

; The strict pre-condition a u> b implies a u>= b as well.
define i1 @usub_sat_lower_bound_strict_precond(i64 %a, i64 %b) {
; CHECK-LABEL: define i1 @usub_sat_lower_bound_strict_precond(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:    [[PRE:%.*]] = icmp ugt i64 [[A]], [[B]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[SUB:%.*]] = call i64 @llvm.usub.sat.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    [[ADD:%.*]] = add nuw i64 [[SUB]], [[B]]
; CHECK-NEXT:    [[C:%.*]] = icmp uge i64 [[ADD]], [[A]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %pre = icmp ugt i64 %a, %b
  call void @llvm.assume(i1 %pre)
  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
  %add = add nuw i64 %sub, %b
  %c = icmp uge i64 %add, %a
  ret i1 %c
}

; The main motivating shape: a span offset bound. With base u<= count,
; lim = usub.sat(count, base) = count - base, so base + i u< count for i u< lim.
define i1 @usub_sat_span_offset_bound(i64 %count, i64 %base, i64 %i) {
; CHECK-LABEL: define i1 @usub_sat_span_offset_bound(
; CHECK-SAME: i64 [[COUNT:%.*]], i64 [[BASE:%.*]], i64 [[I:%.*]]) {
; CHECK-NEXT:    [[PRE:%.*]] = icmp ule i64 [[BASE]], [[COUNT]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[LIM:%.*]] = call i64 @llvm.usub.sat.i64(i64 [[COUNT]], i64 [[BASE]])
; CHECK-NEXT:    [[INBOUNDS:%.*]] = icmp ult i64 [[I]], [[LIM]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[INBOUNDS]])
; CHECK-NEXT:    [[IDX:%.*]] = add nuw i64 [[BASE]], [[I]]
; CHECK-NEXT:    [[C:%.*]] = icmp ult i64 [[IDX]], [[COUNT]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %pre = icmp ule i64 %base, %count
  call void @llvm.assume(i1 %pre)
  %lim = call i64 @llvm.usub.sat.i64(i64 %count, i64 %base)
  %inbounds = icmp ult i64 %i, %lim
  call void @llvm.assume(i1 %inbounds)
  %idx = add nuw i64 %base, %i
  %c = icmp ult i64 %idx, %count
  ret i1 %c
}

; Nested decomposition: the operands of the usub.sat are themselves decomposed,
; here usub.sat(a, b + 1) with a u>= b + 1 is a - b - 1.
define i1 @usub_sat_decompose_operands(i64 %a, i64 %b) {
; CHECK-LABEL: define i1 @usub_sat_decompose_operands(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:    [[B1:%.*]] = add nuw i64 [[B]], 1
; CHECK-NEXT:    [[PRE:%.*]] = icmp uge i64 [[A]], [[B1]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[SUB:%.*]] = call i64 @llvm.usub.sat.i64(i64 [[A]], i64 [[B1]])
; CHECK-NEXT:    [[ADD:%.*]] = add nuw i64 [[SUB]], [[B]]
; CHECK-NEXT:    [[C:%.*]] = icmp ult i64 [[ADD]], [[A]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %b1 = add nuw i64 %b, 1
  %pre = icmp uge i64 %a, %b1
  call void @llvm.assume(i1 %pre)
  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b1)
  %add = add nuw i64 %sub, %b
  %c = icmp ult i64 %add, %a
  ret i1 %c
}

; Without the pre-condition a u>= b the usub.sat may saturate to 0, in which
; case b + usub.sat(a, b) == b, which can be u< a.
define i1 @neg_usub_sat_no_precond(i64 %a, i64 %b) {
; CHECK-LABEL: define i1 @neg_usub_sat_no_precond(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:    [[SUB:%.*]] = call i64 @llvm.usub.sat.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    [[ADD:%.*]] = add nuw i64 [[SUB]], [[B]]
; CHECK-NEXT:    [[C:%.*]] = icmp uge i64 [[ADD]], [[A]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
  %add = add nuw i64 %sub, %b
  %c = icmp uge i64 %add, %a
  ret i1 %c
}

; The pre-condition holds in the wrong direction (a u<= b), so the usub.sat
; saturates and the difference is not a - b.
define i1 @neg_usub_sat_inverted_precond(i64 %a, i64 %b) {
; CHECK-LABEL: define i1 @neg_usub_sat_inverted_precond(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:    [[PRE:%.*]] = icmp ult i64 [[A]], [[B]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
; CHECK-NEXT:    [[SUB:%.*]] = call i64 @llvm.usub.sat.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    [[ADD:%.*]] = add nuw i64 [[SUB]], [[B]]
; CHECK-NEXT:    ret i1 false
;
  %pre = icmp ult i64 %a, %b
  call void @llvm.assume(i1 %pre)
  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
  %add = add nuw i64 %sub, %b
  %c = icmp ule i64 %add, %a
  ret i1 %c
}

