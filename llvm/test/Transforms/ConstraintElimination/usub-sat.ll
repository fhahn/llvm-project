; nothing is known about the saturation of usub.sat(a, b).
define i1 @neg_usub_sat_precond_on_other_value(i64 %a, i64 %b, i64 %c) {
; CHECK-LABEL: define i1 @neg_usub_sat_precond_on_other_value(
