; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -S -passes=separate-const-offset-from-gep < %s | FileCheck %s
; RUN: opt -S -passes='separate-const-offset-from-gep<lower-gep>' < %s | FileCheck %s --check-prefix=LOWER

target triple = "aarch64-linux-gnu"

; Index is implicitly multiplied by vscale and so not really constant.
define ptr @test1(ptr %base, i64 %idx) #0 {
; CHECK-LABEL: @test1(
; CHECK-NEXT:    [[IDX_NEXT:%.*]] = add nuw nsw i64 [[IDX:%.*]], 1
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr <vscale x 4 x float>, ptr [[BASE:%.*]], i64 [[IDX_NEXT]]
; CHECK-NEXT:    ret ptr [[GEP]]
;
; LOWER-LABEL: @test1(
; LOWER-NEXT:    [[IDX_NEXT:%.*]] = add nuw nsw i64 [[IDX:%.*]], 1
; LOWER-NEXT:    [[GEP:%.*]] = getelementptr <vscale x 4 x float>, ptr [[BASE:%.*]], i64 [[IDX_NEXT]]
; LOWER-NEXT:    ret ptr [[GEP]]
;
  %idx.next = add nuw nsw i64 %idx, 1
  %gep = getelementptr <vscale x 4 x float>, ptr %base, i64 %idx.next
  ret ptr %gep
}

; Whilst the first index is not constant, the calculation of the second index
; does contain a constant that can be extracted.
define ptr @test2(ptr %base, i64 %idx) {
; CHECK-LABEL: @test2(
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr <vscale x 4 x float>, ptr [[BASE:%.*]], i64 3, i64 [[IDX:%.*]]
; CHECK-NEXT:    [[GEP2:%.*]] = getelementptr i8, ptr [[TMP1]], i64 4
; CHECK-NEXT:    ret ptr [[GEP2]]
;
; LOWER-LABEL: @test2(
; LOWER-NEXT:    [[TMP1:%.*]] = call i64 @llvm.vscale.i64()
; LOWER-NEXT:    [[TMP2:%.*]] = mul nuw i64 [[TMP1]], 16
; LOWER-NEXT:    [[TMP3:%.*]] = mul i64 3, [[TMP2]]
; LOWER-NEXT:    [[UGLYGEP:%.*]] = getelementptr i8, ptr [[BASE:%.*]], i64 [[TMP3]]
; LOWER-NEXT:    [[TMP4:%.*]] = shl i64 [[IDX:%.*]], 2
; LOWER-NEXT:    [[UGLYGEP1:%.*]] = getelementptr i8, ptr [[UGLYGEP]], i64 [[TMP4]]
; LOWER-NEXT:    [[UGLYGEP2:%.*]] = getelementptr i8, ptr [[UGLYGEP1]], i64 4
; LOWER-NEXT:    ret ptr [[UGLYGEP2]]
;
  %idx.next = add nuw nsw i64 %idx, 1
  %gep = getelementptr <vscale x 4 x float>, ptr %base, i64 3, i64 %idx.next
  ret ptr %gep
}

