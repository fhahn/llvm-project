; FIXME: The index is rebuilt as 200 - zext(%a), and the zext of %a is cloned
; from `zext nneg` of the sub, keeping nneg. nneg only held for the result of
; the sub nuw, not for %a: for %a = -128 (128 unsigned), %s = 72 and the
; original index is 72, but `zext nneg i8 -128` is poison, so the new GEP
; computes a poison pointer. LLVM's UB-aware interpreter (llubi) reports
; "Invalid memory access with a poison pointer" for a load through the result,
; while the source loads %base[72]. The cloned zext must not carry nneg.
define ptr @zext_nneg_sub_nuw(ptr %base, i8 %a) {
; CHECK-LABEL: define ptr @zext_nneg_sub_nuw(
; CHECK-SAME: ptr [[BASE:%.*]], i8 [[A:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = zext nneg i8 [[A]] to i64
; CHECK-NEXT:    [[S:%.*]] = sub i64 0, [[TMP1]]
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr i8, ptr [[BASE]], i64 [[S]]
; CHECK-NEXT:    [[P1:%.*]] = getelementptr i8, ptr [[TMP2]], i64 200
; CHECK-NEXT:    ret ptr [[P1]]
;
  %s = sub nuw i8 200, %a
  %z = zext nneg i8 %s to i64
  %p = getelementptr i8, ptr %base, i64 %z
  ret ptr %p
}
