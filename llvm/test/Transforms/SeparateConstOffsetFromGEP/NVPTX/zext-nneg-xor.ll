; FIXME: Bit 0 of the xor constant 0x81 is disjoint from %s and is extracted
; as offset 1; the index is rebuilt as `xor (zext %s), 128`, with the zext of
; %s cloned from the original `zext nneg` and keeping nneg. nneg only held for
; the xor result, not for %s: for %a = 8, %s = 0x80 and %x = 0x01, so the
; original index is 1, but `zext nneg i8 -128` is poison, so the new GEP
; computes a poison pointer. LLVM's UB-aware interpreter (llubi) reports
; "Invalid memory access with a poison pointer" for a load through the result,
; while the source loads %base[1]. The cloned zext must not carry nneg.
define ptr @zext_nneg_xor_sign_bit(ptr %base, i8 %a) {
; CHECK-LABEL: define ptr @zext_nneg_xor_sign_bit(
; CHECK-SAME: ptr [[BASE:%.*]], i8 [[A:%.*]]) {
; CHECK-NEXT:    [[S:%.*]] = shl i8 [[A]], 4
; CHECK-NEXT:    [[TMP1:%.*]] = zext nneg i8 [[S]] to i64
; CHECK-NEXT:    [[X:%.*]] = xor i64 [[TMP1]], 128
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr i8, ptr [[BASE]], i64 [[X]]
; CHECK-NEXT:    [[P1:%.*]] = getelementptr i8, ptr [[TMP2]], i64 1
; CHECK-NEXT:    ret ptr [[P1]]
;
  %s = shl i8 %a, 4
  %x = xor i8 %s, -127
  %z = zext nneg i8 %x to i64
  %p = getelementptr i8, ptr %base, i64 %z
  ret ptr %p
}
