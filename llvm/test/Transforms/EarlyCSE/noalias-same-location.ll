; %l1 only executes if %c is true, so %l0 cannot use %l1's !noalias scopes.
define float @cse_conditional_later_load(ptr %p, i1 %c) {
; CHECK-LABEL: define float @cse_conditional_later_load(
; CHECK-SAME: ptr [[P:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[L0:%.*]] = load float, ptr [[P]], align 4, !noalias [[META0]]
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi float [ [[L0]], %[[THEN]] ], [ 0.000000e+00, %[[ENTRY]] ]
; CHECK-NEXT:    [[S:%.*]] = fadd float [[L0]], [[R]]
; CHECK-NEXT:    ret float [[S]]
;
entry:
  %l0 = load float, ptr %p, align 4, !noalias !0
  br i1 %c, label %then, label %exit

then:
  %l1 = load float, ptr %p, align 4, !noalias !3
  br label %exit

exit:
  %r = phi float [ %l1, %then ], [ 0.0, %entry ]
  %s = fadd float %l0, %r
  ret float %s
}

