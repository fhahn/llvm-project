; RUN: opt -passes=dse -S %s | FileCheck %s

; Address space 1 has a 32-bit index width, address space 0 a 64-bit one.
; Non-inbounds offsets in address space 1 wrap modulo 2^32, so they cannot be
; accumulated into a 64-bit offset across the addrspacecast.
target datalayout = "p1:32:32"

; %x1b and %y are both %b - 2^31 (mod 2^32), so %d == %k + 1 and the final
; store is not redundant.
define i32 @partial_overlap_wrapping_offsets(ptr addrspace(1) %b) {
; CHECK-LABEL: define i32 @partial_overlap_wrapping_offsets(
; CHECK-SAME: ptr addrspace(1) [[B:%.*]]) {
; CHECK-NEXT:    [[X1:%.*]] = getelementptr i8, ptr addrspace(1) [[B]], i32 2147483647
; CHECK-NEXT:    [[X1B:%.*]] = getelementptr i8, ptr addrspace(1) [[X1]], i32 1
; CHECK-NEXT:    [[Y:%.*]] = getelementptr i8, ptr addrspace(1) [[B]], i32 -2147483648
; CHECK-NEXT:    [[C1:%.*]] = addrspacecast ptr addrspace(1) [[X1B]] to ptr
; CHECK-NEXT:    [[C2:%.*]] = addrspacecast ptr addrspace(1) [[Y]] to ptr
; CHECK-NEXT:    [[D:%.*]] = getelementptr i8, ptr [[C1]], i64 2
; CHECK-NEXT:    [[K:%.*]] = getelementptr i8, ptr [[C2]], i64 1
; CHECK-NEXT:    store i32 1, ptr [[K]], align 1
; CHECK-NEXT:    store i32 2, ptr [[D]], align 1
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[K]], align 1
; CHECK-NEXT:    store i32 1, ptr [[K]], align 1
; CHECK-NEXT:    ret i32 [[V]]
;
  %x1 = getelementptr i8, ptr addrspace(1) %b, i32 2147483647
  %x1b = getelementptr i8, ptr addrspace(1) %x1, i32 1
  %y = getelementptr i8, ptr addrspace(1) %b, i32 -2147483648
  %c1 = addrspacecast ptr addrspace(1) %x1b to ptr
  %c2 = addrspacecast ptr addrspace(1) %y to ptr
  %d = getelementptr i8, ptr %c1, i64 2
  %k = getelementptr i8, ptr %c2, i64 1
  store i32 1, ptr %k, align 1
  store i32 2, ptr %d, align 1
  %v = load i32, ptr %k, align 1
  store i32 1, ptr %k, align 1
  ret i32 %v
}

