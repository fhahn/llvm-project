; CHECK-NEXT:    [[K:%.*]] = getelementptr i8, ptr [[B]], i64 -9223372036854775808
; CHECK-NEXT:    store i64 1, ptr [[D]], align 1
; CHECK-NEXT:    store i64 2, ptr [[K]], align 1
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[D]], align 1
; CHECK-NEXT:    store i64 1, ptr [[D]], align 1
; CHECK-NEXT:    ret i64 [[V]]
;
  %d = getelementptr i8, ptr %b, i64 9223372036854775807
  %k = getelementptr i8, ptr %b, i64 -9223372036854775808
  store i64 1, ptr %d, align 1
  store i64 2, ptr %k, align 1
  %v = load i64, ptr %d, align 1
  store i64 1, ptr %d, align 1
  ret i64 %v
