; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=dse -S %s | FileCheck %s

; Constant offsets from a common base whose accesses wrap around the end of
; the index space. Addresses are computed modulo 2^IndexWidth, so comparing
; the offsets as plain integers is wrong for them.

target datalayout = "p1:32:32-p2:32:32"

; %k == %d + 1 modulo 2^64: the i64 store does not overwrite the first byte
; of the i32 store, which must be kept.
define void @wrap_i64(ptr %b) {
; CHECK-LABEL: define void @wrap_i64(
; CHECK-SAME: ptr [[B:%.*]]) {
; CHECK-NEXT:    [[D:%.*]] = getelementptr i8, ptr [[B]], i64 9223372036854775807
; CHECK-NEXT:    [[K:%.*]] = getelementptr i8, ptr [[B]], i64 -9223372036854775808
; CHECK-NEXT:    store i32 1, ptr [[D]], align 1
; CHECK-NEXT:    store i64 2, ptr [[K]], align 1
; CHECK-NEXT:    ret void
;
  %d = getelementptr i8, ptr %b, i64 9223372036854775807
  %k = getelementptr i8, ptr %b, i64 -9223372036854775808
  store i32 1, ptr %d, align 1
  store i64 2, ptr %k, align 1
  ret void
}

; Same with a 32-bit index: the i32 store must be kept.
define void @wrap_i32(ptr addrspace(1) %b) {
; CHECK-LABEL: define void @wrap_i32(
; CHECK-SAME: ptr addrspace(1) [[B:%.*]]) {
; CHECK-NEXT:    [[D:%.*]] = getelementptr i8, ptr addrspace(1) [[B]], i32 2147483647
; CHECK-NEXT:    [[K:%.*]] = getelementptr i8, ptr addrspace(1) [[B]], i32 -2147483648
; CHECK-NEXT:    store i32 1, ptr addrspace(1) [[D]], align 1
; CHECK-NEXT:    store i64 2, ptr addrspace(1) [[K]], align 1
; CHECK-NEXT:    ret void
;
  %d = getelementptr i8, ptr addrspace(1) %b, i32 2147483647
  %k = getelementptr i8, ptr addrspace(1) %b, i32 -2147483648
  store i32 1, ptr addrspace(1) %d, align 1
  store i64 2, ptr addrspace(1) %k, align 1
  ret void
}

; %k == %d + 1 modulo 2^32: the store to %d clobbers %k, so the last store is
; not redundant with the first one.
define i32 @wrap_i32_not_redundant(ptr addrspace(1) %b) {
; CHECK-LABEL: define i32 @wrap_i32_not_redundant(
; CHECK-SAME: ptr addrspace(1) [[B:%.*]]) {
; CHECK-NEXT:    [[D:%.*]] = getelementptr i8, ptr addrspace(1) [[B]], i32 2147483647
; CHECK-NEXT:    [[K:%.*]] = getelementptr i8, ptr addrspace(1) [[B]], i32 -2147483648
; CHECK-NEXT:    store i32 1, ptr addrspace(1) [[K]], align 1
; CHECK-NEXT:    store i32 2, ptr addrspace(1) [[D]], align 1
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr addrspace(1) [[K]], align 1
; CHECK-NEXT:    store i32 1, ptr addrspace(1) [[K]], align 1
; CHECK-NEXT:    ret i32 [[V]]
;
  %d = getelementptr i8, ptr addrspace(1) %b, i32 2147483647
  %k = getelementptr i8, ptr addrspace(1) %b, i32 -2147483648
  store i32 1, ptr addrspace(1) %k, align 1
  store i32 2, ptr addrspace(1) %d, align 1
  %v = load i32, ptr addrspace(1) %k, align 1
  store i32 1, ptr addrspace(1) %k, align 1
  ret i32 %v
}

; Same with the roles swapped: the store to %k clobbers %d. Here the killing
