; %bp is decomposed in addrspace(1) as %b + 2147483640 modulo 2^32, %k in
; addrspace(0) as %b + (2147483640 - 2^32) modulo 2^64. If %b + 2147483640
; wraps in addrspace(1), %bp == %k, so the store to %bp clobbers %k and the
; last store is not redundant.
define i32 @cross_width_not_redundant(ptr addrspace(1) %b) {
; CHECK-LABEL: define i32 @cross_width_not_redundant(
; CHECK-SAME: ptr addrspace(1) [[B:%.*]]) {
; CHECK-NEXT:    [[Q2:%.*]] = getelementptr i8, ptr addrspace(1) [[B]], i32 2147483640
; CHECK-NEXT:    [[BP:%.*]] = addrspacecast ptr addrspace(1) [[Q2]] to ptr
; CHECK-NEXT:    [[C:%.*]] = addrspacecast ptr addrspace(1) [[B]] to ptr
; CHECK-NEXT:    [[K:%.*]] = getelementptr i8, ptr [[C]], i64 -2147483656
; CHECK-NEXT:    store i32 1, ptr [[K]], align 1
; CHECK-NEXT:    store i32 2, ptr [[BP]], align 1
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[K]], align 1
; CHECK-NEXT:    store i32 1, ptr [[K]], align 1
; CHECK-NEXT:    ret i32 [[V]]
;
  %q2 = getelementptr i8, ptr addrspace(1) %b, i32 2147483640
  %bp = addrspacecast ptr addrspace(1) %q2 to ptr
  %c = addrspacecast ptr addrspace(1) %b to ptr
  %k = getelementptr i8, ptr %c, i64 -2147483656
  store i32 1, ptr %k, align 1
  store i32 2, ptr %bp, align 1
  %v = load i32, ptr %k, align 1
  store i32 1, ptr %k, align 1
  ret i32 %v
}

; Both pointers are decomposed with a 32-bit index: the store to %bp does not
; overlap %k and the last store is redundant.
define i32 @same_width_redundant(ptr addrspace(1) %b) {
; CHECK-LABEL: define i32 @same_width_redundant(
; CHECK-SAME: ptr addrspace(1) [[B:%.*]]) {
; CHECK-NEXT:    [[Q2:%.*]] = getelementptr i8, ptr addrspace(1) [[B]], i32 8
; CHECK-NEXT:    [[BP:%.*]] = addrspacecast ptr addrspace(1) [[Q2]] to ptr addrspace(2)
; CHECK-NEXT:    [[C:%.*]] = addrspacecast ptr addrspace(1) [[B]] to ptr addrspace(2)
; CHECK-NEXT:    [[K:%.*]] = getelementptr i8, ptr addrspace(2) [[C]], i32 12
; CHECK-NEXT:    store i32 1, ptr addrspace(2) [[K]], align 1
; CHECK-NEXT:    store i32 2, ptr addrspace(2) [[BP]], align 1
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr addrspace(2) [[K]], align 1
; CHECK-NEXT:    ret i32 [[V]]
;
  %q2 = getelementptr i8, ptr addrspace(1) %b, i32 8
  %bp = addrspacecast ptr addrspace(1) %q2 to ptr addrspace(2)
  %c = addrspacecast ptr addrspace(1) %b to ptr addrspace(2)
  %k = getelementptr i8, ptr addrspace(2) %c, i32 12
  store i32 1, ptr addrspace(2) %k, align 1
  store i32 2, ptr addrspace(2) %bp, align 1
  %v = load i32, ptr addrspace(2) %k, align 1
  store i32 1, ptr addrspace(2) %k, align 1
  ret i32 %v
}

; %g is %c + 12 modulo 2^32, the dead bytes of %b are [%b, %b + 16) modulo
; 2^64. If %c + 12 wraps in addrspace(1), %g is not one of them, so the store
; must be kept.
define void @dead_on_return_narrower_ptr(ptr dead_on_return(16) %b) {
; CHECK-LABEL: define void @dead_on_return_narrower_ptr(
; CHECK-SAME: ptr dead_on_return(16) [[B:%.*]]) {
; CHECK-NEXT:    [[C:%.*]] = addrspacecast ptr [[B]] to ptr addrspace(1)
; CHECK-NEXT:    [[G:%.*]] = getelementptr i8, ptr addrspace(1) [[C]], i32 12
; CHECK-NEXT:    store i32 0, ptr addrspace(1) [[G]], align 1
; CHECK-NEXT:    ret void
;
  %c = addrspacecast ptr %b to ptr addrspace(1)
  %g = getelementptr i8, ptr addrspace(1) %c, i32 12
  store i32 0, ptr addrspace(1) %g, align 1
  ret void
}

; %g is %c + 12 modulo 2^64, the dead bytes of %b are [%b, %b + 16) modulo
; 2^32. If those wrap in addrspace(1), %g is not one of them.
define void @dead_on_return_wider_ptr(ptr addrspace(1) dead_on_return(16) %b) {
; CHECK-LABEL: define void @dead_on_return_wider_ptr(
; CHECK-SAME: ptr addrspace(1) dead_on_return(16) [[B:%.*]]) {
; CHECK-NEXT:    [[C:%.*]] = addrspacecast ptr addrspace(1) [[B]] to ptr
; CHECK-NEXT:    [[G:%.*]] = getelementptr i8, ptr [[C]], i64 12
; CHECK-NEXT:    store i32 0, ptr [[G]], align 1
; CHECK-NEXT:    ret void
;
  %c = addrspacecast ptr addrspace(1) %b to ptr
  %g = getelementptr i8, ptr %c, i64 12
  store i32 0, ptr %g, align 1
  ret void
}

; Same index width: the store is to dead bytes of %b and can be removed.
define void @dead_on_return_same_width(ptr addrspace(1) dead_on_return(16) %b) {
; CHECK-LABEL: define void @dead_on_return_same_width(
; CHECK-SAME: ptr addrspace(1) dead_on_return(16) [[B:%.*]]) {
; CHECK-NEXT:    ret void
;
  %c = addrspacecast ptr addrspace(1) %b to ptr addrspace(2)
  %g = getelementptr i8, ptr addrspace(2) %c, i32 12
  store i32 0, ptr addrspace(2) %g, align 1
