; overwritten by the two i32 stores.
define void @partial_in_range_i64(ptr %b, i64 %x, i32 %y, i32 %z) {
; CHECK-LABEL: define void @partial_in_range_i64(
; CHECK-SAME: ptr [[B:%.*]], i64 [[X:%.*]], i32 [[Y:%.*]], i32 [[Z:%.*]]) {
; CHECK-NEXT:    [[D:%.*]] = getelementptr i8, ptr [[B]], i64 9223372036854775799
; CHECK-NEXT:    [[K:%.*]] = getelementptr i8, ptr [[B]], i64 9223372036854775803
; CHECK-NEXT:    store i32 [[Y]], ptr [[D]], align 1
; CHECK-NEXT:    store i32 [[Z]], ptr [[K]], align 1
; CHECK-NEXT:    ret void
;
  %d = getelementptr i8, ptr %b, i64 9223372036854775799
  %k = getelementptr i8, ptr %b, i64 9223372036854775803
  store i64 %x, ptr %d, align 1
  store i32 %y, ptr %d, align 1
  store i32 %z, ptr %k, align 1
  ret void
}

