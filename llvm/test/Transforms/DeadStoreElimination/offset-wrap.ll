; The offsets wrap, but AA proves that the i8 store is completely overwritten.
define void @wrap_aa_complete(ptr %b) {
; CHECK-LABEL: define void @wrap_aa_complete(
; CHECK-SAME: ptr [[B:%.*]]) {
; CHECK-NEXT:    [[K:%.*]] = getelementptr i8, ptr [[B]], i64 9223372036854775805
; CHECK-NEXT:    store i64 2, ptr [[K]], align 1
; CHECK-NEXT:    ret void
;
  %d = getelementptr i8, ptr %b, i64 -9223372036854775808
  %k = getelementptr i8, ptr %b, i64 9223372036854775805
  store i8 1, ptr %d, align 1
  store i64 2, ptr %k, align 1
  ret void
}

; The store ends where the memset ends and stores the memset's value, so it is
; redundant. Its offset is too large for AA to report.
define void @complete_large_offset(ptr %b) {
; CHECK-LABEL: define void @complete_large_offset(
; CHECK-SAME: ptr [[B:%.*]]) {
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr align 16 [[B]], i8 0, i64 4194320, i1 false)
; CHECK-NEXT:    ret void
;
  %d = getelementptr i8, ptr %b, i64 4194316
  call void @llvm.memset.p0.i64(ptr align 16 %b, i8 0, i64 4194320, i1 false)
  store i32 0, ptr %d, align 1
  ret void
}

