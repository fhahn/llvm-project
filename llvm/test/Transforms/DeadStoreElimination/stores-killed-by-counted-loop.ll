; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=dse -S %s | FileCheck %s
;
; DSE does not use a store in a counted loop as a killing store for earlier
; stores to the range the loop covers. Each loop store has a single
; per-iteration location, so DSE cannot see that the loop overwrites the whole
; range p[0..TC) before any read.
;
; Base pipelines get this for free when the early LoopFullUnrollPass unrolls
; the loop first. Once full unrolling is deferred past the loop vectorizer,
; DSE only ever sees the rolled loop. Possible fix: treat a store with an
; affine pointer {%p,+,4} in a loop with a constant trip count, executed on
; every iteration, as killing the byte range it covers (SCEV, or the counted
; loop range helper getConstantLoopAccessByteRange in LoopUtils).

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

; Stores to p[0], p[5] and p[31] before the loop are dead: the counted loop
; below stores to every element of p[0..31] on every path before any read.
define void @stores_killed_by_loop(ptr noalias %p, ptr noalias %q) {
; CHECK-LABEL: define void @stores_killed_by_loop(
; CHECK-SAME: ptr noalias [[P:%.*]], ptr noalias [[Q:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    store i32 1, ptr [[P]], align 4
; CHECK-NEXT:    [[P_5:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 5
; CHECK-NEXT:    store i32 2, ptr [[P_5]], align 4
; CHECK-NEXT:    [[P_31:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 31
; CHECK-NEXT:    store i32 3, ptr [[P_31]], align 4
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP_Q:%.*]] = getelementptr inbounds i32, ptr [[Q]], i64 [[IV]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP_Q]], align 4
; CHECK-NEXT:    [[GEP_P:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    store i32 [[L]], ptr [[GEP_P]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], 32
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  store i32 1, ptr %p, align 4
  %p.5 = getelementptr inbounds i32, ptr %p, i64 5
  store i32 2, ptr %p.5, align 4
  %p.31 = getelementptr inbounds i32, ptr %p, i64 31
  store i32 3, ptr %p.31, align 4
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.q = getelementptr inbounds i32, ptr %q, i64 %iv
  %l = load i32, ptr %gep.q, align 4
  %gep.p = getelementptr inbounds i32, ptr %p, i64 %iv
  store i32 %l, ptr %gep.p, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 32
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; The memset of p[0..31] is dead: the loop overwrites the whole range.
define void @memset_killed_by_loop(ptr noalias %p, ptr noalias %q) {
; CHECK-LABEL: define void @memset_killed_by_loop(
; CHECK-SAME: ptr noalias [[P:%.*]], ptr noalias [[Q:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr align 4 [[P]], i8 0, i64 128, i1 false)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP_Q:%.*]] = getelementptr inbounds i32, ptr [[Q]], i64 [[IV]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP_Q]], align 4
; CHECK-NEXT:    [[GEP_P:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    store i32 [[L]], ptr [[GEP_P]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], 32
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  call void @llvm.memset.p0.i64(ptr align 4 %p, i8 0, i64 128, i1 false)
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.q = getelementptr inbounds i32, ptr %q, i64 %iv
  %l = load i32, ptr %gep.q, align 4
  %gep.p = getelementptr inbounds i32, ptr %p, i64 %iv
  store i32 %l, ptr %gep.p, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 32
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; Negative: the loop only covers p[0..15], so the store to p[31] stays.
define void @store_not_covered(ptr noalias %p, ptr noalias %q) {
; CHECK-LABEL: define void @store_not_covered(
; CHECK-SAME: ptr noalias [[P:%.*]], ptr noalias [[Q:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[P_31:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 31
; CHECK-NEXT:    store i32 3, ptr [[P_31]], align 4
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP_Q:%.*]] = getelementptr inbounds i32, ptr [[Q]], i64 [[IV]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP_Q]], align 4
; CHECK-NEXT:    [[GEP_P:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    store i32 [[L]], ptr [[GEP_P]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], 16
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %p.31 = getelementptr inbounds i32, ptr %p, i64 31
  store i32 3, ptr %p.31, align 4
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.q = getelementptr inbounds i32, ptr %q, i64 %iv
  %l = load i32, ptr %gep.q, align 4
  %gep.p = getelementptr inbounds i32, ptr %p, i64 %iv
  store i32 %l, ptr %gep.p, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 16
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; Negative: the loop reads p[%iv - 1] before overwriting p[%iv], so the
; earlier store to p[0] is read by the second iteration.
define void @store_read_in_loop(ptr noalias %p) {
; CHECK-LABEL: define void @store_read_in_loop(
; CHECK-SAME: ptr noalias [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    store i32 7, ptr [[P]], align 4
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[IV_PREV:%.*]] = add nsw i64 [[IV]], -1
; CHECK-NEXT:    [[GEP_PREV:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 [[IV_PREV]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP_PREV]], align 4
; CHECK-NEXT:    [[GEP_P:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    store i32 [[L]], ptr [[GEP_P]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], 32
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  store i32 7, ptr %p, align 4
  br label %loop

loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop ]
  %iv.prev = add nsw i64 %iv, -1
  %gep.prev = getelementptr inbounds i32, ptr %p, i64 %iv.prev
  %l = load i32, ptr %gep.prev, align 4
  %gep.p = getelementptr inbounds i32, ptr %p, i64 %iv
  store i32 %l, ptr %gep.p, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 32
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)
