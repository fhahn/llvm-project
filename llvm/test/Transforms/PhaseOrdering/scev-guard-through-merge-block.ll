; Reduced from Json::BuiltStyledStreamWriter::writeArrayValue (cinebench).
;
; The 'size != 0' guard in @write_array dominates the loop, but only through
; the block @indent returns to once it has been inlined. That block has two
; predecessors and no PHI to key off, so the unique-predecessor climb in
; LoopGuards::collectFromBlock stops there and the guard is only reachable by
; continuing up the dominator tree.
;
; Without the guard the backedge-taken count is clamped with a umax, which
; keeps IndVarSimplify from proving that %index does not wrap, so the widened
; i64 induction variable has to be truncated back to i32 for the exit compare
; and re-extended for the call argument:
;
;   %indvars = trunc i64 %indvars.iv.next to i32
;   %conv = and i64 %indvars.iv.next, 4294967295
;   %p = tail call ptr @elt(ptr nonnull %v, i64 %conv)
;   %exitcond = icmp eq i32 %size, %indvars
;
; With the guard the loop runs entirely on the i64 induction variable.

target datalayout = "e-p:64:64-i64:64-n8:16:32:64"

declare ptr @elt(ptr, i64)

define internal ptr @indent(ptr %w) {
entry:
  %depth = load volatile i64, ptr %w, align 8
  %none = icmp eq i64 %depth, 0
  br i1 %none, label %ret, label %pad

pad:
  store volatile i32 0, ptr %w, align 4
  br label %ret

ret:
  ret ptr null
}

define void @write_array(ptr %w, ptr %v) {
; CHECK-LABEL: define void @write_array(
; CHECK-SAME: ptr nofree captures(address) [[W:%.*]], ptr [[V:%.*]]) local_unnamed_addr {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[SIZE:%.*]] = load volatile i32, ptr [[V]], align 4
; CHECK-NEXT:    [[EMPTY:%.*]] = icmp eq i32 [[SIZE]], 0
; CHECK-NEXT:    br i1 [[EMPTY]], label %[[EXIT:.*]], label %[[IF_ELSE:.*]]
; CHECK:       [[IF_ELSE]]:
; CHECK-NEXT:    [[DEPTH_I:%.*]] = load volatile i64, ptr [[W]], align 8
; CHECK-NEXT:    [[NONE_I:%.*]] = icmp eq i64 [[DEPTH_I]], 0
; CHECK-NEXT:    br i1 [[NONE_I]], label %[[INDENT_EXIT:.*]], label %[[PAD_I:.*]]
; CHECK:       [[PAD_I]]:
; CHECK-NEXT:    store volatile i32 0, ptr [[W]], align 8
; CHECK-NEXT:    br label %[[INDENT_EXIT]]
; CHECK:       [[INDENT_EXIT]]:
; CHECK-NEXT:    [[P1:%.*]] = tail call ptr @elt(ptr nonnull [[V]], i64 0)
; CHECK-NEXT:    [[TMP0:%.*]] = zext i32 [[SIZE]] to i64
; CHECK-NEXT:    br label %[[FOR_INC:.*]]
; CHECK:       [[FOR_INC]]:
; CHECK-NEXT:    [[INDVARS_IV:%.*]] = phi i64 [ 0, %[[INDENT_EXIT]] ], [ [[INDVARS_IV_NEXT:%.*]], %[[FOR_INC]] ]
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add nuw nsw i64 [[INDVARS_IV]], 1
; CHECK-NEXT:    [[SEP:%.*]] = load volatile ptr, ptr [[W]], align 8
; CHECK-NEXT:    [[P:%.*]] = tail call ptr @elt(ptr nonnull [[V]], i64 [[INDVARS_IV_NEXT]])
; CHECK-NEXT:    [[LAST:%.*]] = icmp eq i64 [[INDVARS_IV_NEXT]], [[TMP0]]
; CHECK-NEXT:    br i1 [[LAST]], label %[[EXIT]], label %[[FOR_INC]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %size = load volatile i32, ptr %v, align 4
  %empty = icmp eq i32 %size, 0
  br i1 %empty, label %exit, label %if.else

if.else:
  %ind = call ptr @indent(ptr %w)
  br label %for.cond

for.cond:
  %index = phi i32 [ 0, %if.else ], [ %inc, %for.inc ]
  %conv = zext i32 %index to i64
  %p = call ptr @elt(ptr %v, i64 %conv)
  %last = icmp eq i32 %index, %size
  br i1 %last, label %exit, label %for.inc

for.inc:
  %inc = add i32 %index, 1
  %sep = load volatile ptr, ptr %w, align 8
  br label %for.cond

exit:
  ret void
}
