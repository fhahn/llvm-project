; CHECK-NEXT:    [[TMP6]] = tail call <4 x i32> @llvm.smax.v4i32(<4 x i32> [[WIDE_LOAD5]], <4 x i32> [[VEC_PHI2]])
; CHECK-NEXT:    [[TMP7]] = tail call <4 x i32> @llvm.smax.v4i32(<4 x i32> [[WIDE_LOAD6]], <4 x i32> [[VEC_PHI3]])
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 16
; CHECK-NEXT:    [[TMP8:%.*]] = icmp eq i64 [[INDEX_NEXT]], 992
; CHECK-NEXT:    br i1 [[TMP8]], label %[[VEC_EPILOG_VECTOR_BODY:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[VEC_EPILOG_VECTOR_BODY]]:
; CHECK-NEXT:    [[RDX_MINMAX:%.*]] = tail call <4 x i32> @llvm.smax.v4i32(<4 x i32> [[TMP4]], <4 x i32> [[TMP5]])
; CHECK-NEXT:    [[RDX_MINMAX7:%.*]] = tail call <4 x i32> @llvm.smax.v4i32(<4 x i32> [[RDX_MINMAX]], <4 x i32> [[TMP6]])
; CHECK-NEXT:    [[RDX_MINMAX8:%.*]] = tail call <4 x i32> @llvm.smax.v4i32(<4 x i32> [[RDX_MINMAX7]], <4 x i32> [[TMP7]])
; CHECK-NEXT:    [[TMP9:%.*]] = tail call i32 @llvm.vector.reduce.smax.v4i32(<4 x i32> [[RDX_MINMAX8]])
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i32> poison, i32 [[TMP9]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i32> [[BROADCAST_SPLATINSERT]], <4 x i32> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP10:%.*]] = getelementptr inbounds nuw i8, ptr [[COUNT]], i64 3968
; CHECK-NEXT:    [[WIDE_LOAD11:%.*]] = load <4 x i32>, ptr [[TMP10]], align 4
; CHECK-NEXT:    [[TMP11:%.*]] = tail call <4 x i32> @llvm.smax.v4i32(<4 x i32> [[WIDE_LOAD11]], <4 x i32> [[BROADCAST_SPLAT]])
; CHECK-NEXT:    [[TMP12:%.*]] = getelementptr inbounds nuw i8, ptr [[COUNT]], i64 3984
; CHECK-NEXT:    [[WIDE_LOAD11_1:%.*]] = load <4 x i32>, ptr [[TMP12]], align 4
; CHECK-NEXT:    [[TMP13:%.*]] = tail call <4 x i32> @llvm.smax.v4i32(<4 x i32> [[WIDE_LOAD11_1]], <4 x i32> [[TMP11]])
; CHECK-NEXT:    [[TMP14:%.*]] = tail call i32 @llvm.vector.reduce.smax.v4i32(<4 x i32> [[TMP13]])
; CHECK-NEXT:    ret i32 [[TMP14]]
;
entry:
  %count = alloca [1000 x i32], align 4
  call void @llvm.memset.p0.i64(ptr align 4 %count, i8 0, i64 4000, i1 false)
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %best = phi i32 [ -1, %entry ], [ %best.next, %loop ]
  %gep = getelementptr inbounds [1000 x i32], ptr %count, i64 0, i64 %iv
  %c = load i32, ptr %gep, align 4
  %best.next = call i32 @llvm.smax.i32(i32 %c, i32 %best)
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 1000
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %best.next
}

