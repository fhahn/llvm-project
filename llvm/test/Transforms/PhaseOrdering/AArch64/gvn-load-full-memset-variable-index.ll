; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='default<O3>' -S %s | FileCheck %s
;
; End-to-end version of GVN/load-from-full-memset-variable-index.ll. The loops
; are not fully unrolled at -O3 (TC=1000, or optsize), so the loads keep a
; variable index and GVN does not forward the memset value. If the memset covers
; the whole local array, every in-bounds load reads 0 and the argmax folds to a
; constant.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

; The whole local array is zeroed by a memset and never written again, so a
; load at any in-bounds index of it, here a variable %i, reads 0.
define i32 @load_var_index_after_full_memset(i64 %i) {
; CHECK-LABEL: define i32 @load_var_index_after_full_memset(
; CHECK-SAME: i64 [[I:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[COUNT:%.*]] = alloca [1000 x i32], align 4
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr noundef nonnull align 4 dereferenceable(4000) [[COUNT]], i8 0, i64 4000, i1 false)
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds [4 x i8], ptr [[COUNT]], i64 [[I]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    ret i32 [[L]]
;
entry:
  %count = alloca [1000 x i32], align 4
  call void @llvm.memset.p0.i64(ptr align 4 %count, i8 0, i64 4000, i1 false)
  %gep = getelementptr inbounds [1000 x i32], ptr %count, i64 0, i64 %i
  %l = load i32, ptr %gep, align 4
  ret i32 %l
}

; Same inside a counted loop (reduced from hmmer's MajorityRuleConsensus): an
; argmax over a freshly zeroed array folds to the initial values.
