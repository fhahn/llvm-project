; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-attributes --version 6
; RUN: opt -passes='default<O3>' -S %s | FileCheck %s

; Function attributes inferred for a function with a loop LoopFullUnrollPass
; would fully unroll early. FunctionAttrs runs in the CGSCC pipeline, before
; the deferred loop is unrolled late, so attributes that need a loop-free
; function are not inferred.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

; Base: @sum16 is loop-free after the early full unroll, so it gets willreturn
; and mustprogress. Deferred: FunctionAttrs sees the loop, and
; functionWillReturn rejects any backedge, so neither is inferred. Fix: infer
; willreturn for counted loops with a constant bound; this is independent of
; deferral.
define i32 @sum16(ptr %p) noinline {
; CHECK: Function Attrs: mustprogress nofree noinline norecurse nosync nounwind willreturn memory(argmem: read)
; CHECK-LABEL: define i32 @sum16(
; CHECK-SAME: ptr nofree readonly captures(none) [[P:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <16 x i32>, ptr [[P]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = mul nsw <16 x i32> [[TMP0]], [[TMP0]]
; CHECK-NEXT:    [[TMP2:%.*]] = tail call i32 @llvm.vector.reduce.add.v16i32(<16 x i32> [[TMP1]])
; CHECK-NEXT:    ret i32 [[TMP2]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %sum = phi i32 [ 0, %entry ], [ %sum.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i64 %iv
  %l = load i32, ptr %gep, align 4
  %mul = mul nsw i32 %l, %l
  %sum.next = add nsw i32 %sum, %mul
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 16
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %sum.next
}

; Base: the call to the read-only, willreturn @sum16 is dead and deleted.
; Deferred: @sum16 is not willreturn, so the call is kept. Fix: as for @sum16.
define void @caller(ptr %p) {
; CHECK: Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
; CHECK-LABEL: define void @caller(
; CHECK-SAME: ptr nofree readonly captures(none) [[P:%.*]]) local_unnamed_addr #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    ret void
;
entry:
  %r = call i32 @sum16(ptr %p)
  ret void
}
