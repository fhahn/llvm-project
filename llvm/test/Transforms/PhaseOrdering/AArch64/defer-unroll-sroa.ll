; A local buffer that is only accessed by loops LoopFullUnrollPass would fully
; unroll early. With early full unrolling, all accesses to the buffer use
; constant offsets and SROA removes it. If the full unroll of a loop accessing
; the buffer is deferred past the loop vectorizer, the vectorizer adds runtime
; alias checks between the buffer and other pointers, which keep the buffer
; alive.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

