entry:
  %temp = alloca [4 x i32], align 4
  %buf = alloca [16 x i8], align 1
  br label %outer

outer:
  %n.cur = phi i64 [ %n, %entry ], [ %n.next, %xor.exit ]
  %data.cur = phi ptr [ %data, %entry ], [ %data.next, %xor.exit ]
  %outer.cmp = icmp ne i64 %n.cur, 0
  br i1 %outer.cmp, label %outer.body, label %exit

outer.body:
  call void @llvm.lifetime.start.p0(ptr %temp)
  call void @llvm.lifetime.start.p0(ptr %buf)
  call void @encode(ptr %temp, ptr %p)
  br label %split.loop

split.loop:
  %k = phi i64 [ 0, %outer.body ], [ %k.next, %split.loop ]
  %gep.temp = getelementptr inbounds [4 x i32], ptr %temp, i64 0, i64 %k
  %word = load i32, ptr %gep.temp, align 4
  %byte.0 = trunc i32 %word to i8
  %idx.0 = mul nuw nsw i64 %k, 4
  %gep.buf.0 = getelementptr inbounds [16 x i8], ptr %buf, i64 0, i64 %idx.0
  store i8 %byte.0, ptr %gep.buf.0, align 1
  %shr.1 = lshr i32 %word, 8
  %byte.1 = trunc i32 %shr.1 to i8
  %idx.1 = add nuw nsw i64 %idx.0, 1
  %gep.buf.1 = getelementptr inbounds [16 x i8], ptr %buf, i64 0, i64 %idx.1
  store i8 %byte.1, ptr %gep.buf.1, align 1
  %shr.2 = lshr i32 %word, 16
  %byte.2 = trunc i32 %shr.2 to i8
  %idx.2 = add nuw nsw i64 %idx.0, 2
  %gep.buf.2 = getelementptr inbounds [16 x i8], ptr %buf, i64 0, i64 %idx.2
  store i8 %byte.2, ptr %gep.buf.2, align 1
  %shr.3 = lshr i32 %word, 24
  %byte.3 = trunc i32 %shr.3 to i8
  %idx.3 = add nuw nsw i64 %idx.0, 3
  %gep.buf.3 = getelementptr inbounds [16 x i8], ptr %buf, i64 0, i64 %idx.3
  store i8 %byte.3, ptr %gep.buf.3, align 1
  %k.next = add nuw nsw i64 %k, 1
  %split.cmp = icmp ult i64 %k.next, 4
  br i1 %split.cmp, label %split.loop, label %xor.loop

xor.loop:
  %i = phi i64 [ 0, %split.loop ], [ %i.next, %xor.loop ]
  %data.ptr = phi ptr [ %data.cur, %split.loop ], [ %data.ptr.next, %xor.loop ]
  %gep.buf = getelementptr inbounds [16 x i8], ptr %buf, i64 0, i64 %i
  %b = load i8, ptr %gep.buf, align 1
  %d = load i8, ptr %data.ptr, align 1
  %xor = xor i8 %d, %b
  store i8 %xor, ptr %data.ptr, align 1
  %data.ptr.next = getelementptr inbounds nuw i8, ptr %data.ptr, i64 1
  %i.next = add nuw nsw i64 %i, 1
  %xor.cmp = icmp ult i64 %i.next, 16
  br i1 %xor.cmp, label %xor.loop, label %xor.exit

xor.exit:
  %data.next = phi ptr [ %data.ptr.next, %xor.loop ]
  call void @llvm.lifetime.end.p0(ptr %buf)
  call void @llvm.lifetime.end.p0(ptr %temp)
  %n.next = add i64 %n.cur, -1
  br label %outer

exit:
  ret void
}

