; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='default<O3>' -S %s | FileCheck %s

; A local buffer that is only accessed by loops LoopFullUnrollPass would fully
; unroll early. With early full unrolling, all accesses to the buffer use
; constant offsets and SROA removes it. If the full unroll of a loop accessing
; the buffer is deferred past the loop vectorizer, the vectorizer adds runtime
; alias checks between the buffer and other pointers, which keep the buffer
; alive.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

; From 7zip's AesCtr_Code: a TC=4 loop splits words into a local 16-byte %buf
; and a TC=16 loop xors %buf into %data. Base: SROA replaces %buf by %temp and
; the xor is one <16 x i8> op. Deferred: BasicAA says MayAlias for %buf vs.
; %data through the nested outer/inner/LCSSA phis, so LV adds a runtime check
; that captures %buf and blocks SROA. Fix: BasicAA looking through phis and
; selects for non-escaping locals (branch basicaa-phi-alloca makes this match).
define void @ctr_xor(ptr %p, ptr %data, i64 %n) {
; CHECK-LABEL: define void @ctr_xor(
; CHECK-SAME: ptr [[P:%.*]], ptr nofree captures(none) [[DATA:%.*]], i64 [[N:%.*]]) local_unnamed_addr {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TEMP:%.*]] = alloca [4 x i32], align 16
; CHECK-NEXT:    [[OUTER_CMP_NOT1:%.*]] = icmp eq i64 [[N]], 0
; CHECK-NEXT:    br i1 [[OUTER_CMP_NOT1]], label %[[EXIT:.*]], label %[[OUTER_BODY:.*]]
; CHECK:       [[OUTER_BODY]]:
; CHECK-NEXT:    [[DATA_CUR3:%.*]] = phi ptr [ [[DATA_PTR_NEXT_15:%.*]], %[[OUTER_BODY]] ], [ [[DATA]], %[[ENTRY]] ]
; CHECK-NEXT:    [[N_CUR2:%.*]] = phi i64 [ [[N_NEXT:%.*]], %[[OUTER_BODY]] ], [ [[N]], %[[ENTRY]] ]
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr nonnull [[TEMP]])
; CHECK-NEXT:    call void @encode(ptr nonnull [[TEMP]], ptr [[P]])
; CHECK-NEXT:    [[TMP0:%.*]] = load <16 x i8>, ptr [[TEMP]], align 16
; CHECK-NEXT:    [[TMP1:%.*]] = load <16 x i8>, ptr [[DATA_CUR3]], align 1
; CHECK-NEXT:    [[TMP2:%.*]] = xor <16 x i8> [[TMP1]], [[TMP0]]
; CHECK-NEXT:    store <16 x i8> [[TMP2]], ptr [[DATA_CUR3]], align 1
; CHECK-NEXT:    [[DATA_PTR_NEXT_15]] = getelementptr inbounds nuw i8, ptr [[DATA_CUR3]], i64 16
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr nonnull [[TEMP]])
; CHECK-NEXT:    [[N_NEXT]] = add i64 [[N_CUR2]], -1
; CHECK-NEXT:    [[OUTER_CMP_NOT:%.*]] = icmp eq i64 [[N_NEXT]], 0
; CHECK-NEXT:    br i1 [[OUTER_CMP_NOT]], label %[[EXIT]], label %[[OUTER_BODY]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %temp = alloca [4 x i32], align 4
  %buf = alloca [16 x i8], align 1
  br label %outer

outer:
  %n.cur = phi i64 [ %n, %entry ], [ %n.next, %xor.exit ]
  %data.cur = phi ptr [ %data, %entry ], [ %data.next, %xor.exit ]
  %outer.cmp = icmp ne i64 %n.cur, 0
  br i1 %outer.cmp, label %outer.body, label %exit

outer.body:
  call void @llvm.lifetime.start.p0(ptr %temp)
  call void @llvm.lifetime.start.p0(ptr %buf)
  call void @encode(ptr %temp, ptr %p)
  br label %split.loop

split.loop:
  %k = phi i64 [ 0, %outer.body ], [ %k.next, %split.loop ]
  %gep.temp = getelementptr inbounds [4 x i32], ptr %temp, i64 0, i64 %k
  %word = load i32, ptr %gep.temp, align 4
  %byte.0 = trunc i32 %word to i8
  %idx.0 = mul nuw nsw i64 %k, 4
  %gep.buf.0 = getelementptr inbounds [16 x i8], ptr %buf, i64 0, i64 %idx.0
  store i8 %byte.0, ptr %gep.buf.0, align 1
  %shr.1 = lshr i32 %word, 8
  %byte.1 = trunc i32 %shr.1 to i8
  %idx.1 = add nuw nsw i64 %idx.0, 1
  %gep.buf.1 = getelementptr inbounds [16 x i8], ptr %buf, i64 0, i64 %idx.1
  store i8 %byte.1, ptr %gep.buf.1, align 1
  %shr.2 = lshr i32 %word, 16
  %byte.2 = trunc i32 %shr.2 to i8
  %idx.2 = add nuw nsw i64 %idx.0, 2
  %gep.buf.2 = getelementptr inbounds [16 x i8], ptr %buf, i64 0, i64 %idx.2
  store i8 %byte.2, ptr %gep.buf.2, align 1
  %shr.3 = lshr i32 %word, 24
  %byte.3 = trunc i32 %shr.3 to i8
  %idx.3 = add nuw nsw i64 %idx.0, 3
  %gep.buf.3 = getelementptr inbounds [16 x i8], ptr %buf, i64 0, i64 %idx.3
  store i8 %byte.3, ptr %gep.buf.3, align 1
  %k.next = add nuw nsw i64 %k, 1
  %split.cmp = icmp ult i64 %k.next, 4
  br i1 %split.cmp, label %split.loop, label %xor.loop

xor.loop:
  %i = phi i64 [ 0, %split.loop ], [ %i.next, %xor.loop ]
  %data.ptr = phi ptr [ %data.cur, %split.loop ], [ %data.ptr.next, %xor.loop ]
  %gep.buf = getelementptr inbounds [16 x i8], ptr %buf, i64 0, i64 %i
  %b = load i8, ptr %gep.buf, align 1
  %d = load i8, ptr %data.ptr, align 1
  %xor = xor i8 %d, %b
  store i8 %xor, ptr %data.ptr, align 1
  %data.ptr.next = getelementptr inbounds nuw i8, ptr %data.ptr, i64 1
  %i.next = add nuw nsw i64 %i, 1
  %xor.cmp = icmp ult i64 %i.next, 16
  br i1 %xor.cmp, label %xor.loop, label %xor.exit

xor.exit:
  %data.next = phi ptr [ %data.ptr.next, %xor.loop ]
  call void @llvm.lifetime.end.p0(ptr %buf)
  call void @llvm.lifetime.end.p0(ptr %temp)
  %n.next = add i64 %n.cur, -1
  br label %outer

exit:
  ret void
}

declare void @encode(ptr, ptr)
declare void @llvm.lifetime.start.p0(ptr)
declare void @llvm.lifetime.end.p0(ptr)
