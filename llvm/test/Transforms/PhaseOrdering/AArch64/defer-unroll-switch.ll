; RUN: opt -passes='default<O3>' -S %s | FileCheck %s

; A read-only search over a constant table in a loop LoopFullUnrollPass would
; fully unroll early. LV cannot vectorize it, so it is fully unrolled late, and
; the cleanup chain's SimplifyCFG forms a switch after the only SimplifyCFG that
; converts switches to lookup tables has run.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

@n0 = external global i8
@n1 = external global i8
@n2 = external global i8
@n3 = external global i8
@n4 = external global i8
@n5 = external global i8
@n6 = external global i8
@n7 = external global i8
@n8 = external global i8
@n9 = external global i8
@n10 = external global i8
@n11 = external global i8
@n12 = external global i8
@n13 = external global i8
@n14 = external global i8
@n15 = external global i8
@table = internal constant [16 x { ptr, i32 }] [{ ptr, i32 } { ptr @n0, i32 235 }, { ptr, i32 } { ptr @n1, i32 236 }, { ptr, i32 } { ptr @n2, i32 237 }, { ptr, i32 } { ptr @n3, i32 238 }, { ptr, i32 } { ptr @n4, i32 239 }, { ptr, i32 } { ptr @n5, i32 240 }, { ptr, i32 } { ptr @n6, i32 241 }, { ptr, i32 } { ptr @n7, i32 242 }, { ptr, i32 } { ptr @n8, i32 243 }, { ptr, i32 } { ptr @n9, i32 244 }, { ptr, i32 } { ptr @n10, i32 245 }, { ptr, i32 } { ptr @n11, i32 246 }, { ptr, i32 } { ptr @n12, i32 247 }, { ptr, i32 } { ptr @n13, i32 248 }, { ptr, i32 } { ptr @n14, i32 249 }, { ptr, i32 } { ptr @n15, i32 250 }]

; std::find_if over a table of {name, key} pairs (like the thunk table search
; in AArch64SLSHardening::runOnMachineFunction). Base: the early unroll and
; SimplifyCFG turn the search into a lookup table. Deferred: LV rejects the
; strided load in the early-exit loop, and the chain's SimplifyCFG leaves a
; 16-case switch. Fix: switch-to-lookup in the chain's SimplifyCFG, or not
; deferring early-exit loops that LV cannot vectorize.
define ptr @find_name(i32 %x) {
; CHECK-LABEL: define ptr @find_name(
; CHECK-SAME: i32 [[X:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[SWITCH_TABLEIDX:%.*]] = add i32 [[X]], -235
; CHECK-NEXT:    [[TMP0:%.*]] = icmp ult i32 [[SWITCH_TABLEIDX]], 16
; CHECK-NEXT:    br i1 [[TMP0]], label %[[SWITCH_LOOKUP:.*]], label %[[EXIT:.*]]
; CHECK:       [[SWITCH_LOOKUP]]:
; CHECK-NEXT:    [[TMP1:%.*]] = zext nneg i32 [[SWITCH_TABLEIDX]] to i64
; CHECK-NEXT:    [[SWITCH_GEP:%.*]] = getelementptr inbounds nuw [8 x i8], ptr @switch.table.find_name, i64 [[TMP1]]
; CHECK-NEXT:    [[SWITCH_LOAD:%.*]] = load ptr, ptr [[SWITCH_GEP]], align 8
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi ptr [ getelementptr inbounds nuw (i8, ptr @table, i64 256), %[[ENTRY]] ], [ [[SWITCH_LOAD]], %[[SWITCH_LOOKUP]] ]
; CHECK-NEXT:    [[NAME:%.*]] = load ptr, ptr [[R]], align 8
; CHECK-NEXT:    ret ptr [[NAME]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep = getelementptr inbounds { ptr, i32 }, ptr @table, i64 %iv, i32 1
  %k = load i32, ptr %gep, align 8
  %c = icmp eq i32 %k, %x
  br i1 %c, label %found, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 16
  br i1 %ec, label %exit, label %loop

found:
  %e = getelementptr inbounds { ptr, i32 }, ptr @table, i64 %iv
  br label %exit

exit:
  %r = phi ptr [ %e, %found ], [ getelementptr inbounds ([16 x { ptr, i32 }], ptr @table, i64 1), %loop.latch ]
  %name = load ptr, ptr %r, align 8
  ret ptr %name
}
