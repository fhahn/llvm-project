entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep = getelementptr inbounds { ptr, i32 }, ptr @table, i64 %iv, i32 1
  %k = load i32, ptr %gep, align 8
  %c = icmp eq i32 %k, %x
  br i1 %c, label %found, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 16
  br i1 %ec, label %exit, label %loop

found:
  %e = getelementptr inbounds { ptr, i32 }, ptr @table, i64 %iv
  br label %exit

exit:
  %r = phi ptr [ %e, %found ], [ getelementptr inbounds ([16 x { ptr, i32 }], ptr @table, i64 1), %loop.latch ]
