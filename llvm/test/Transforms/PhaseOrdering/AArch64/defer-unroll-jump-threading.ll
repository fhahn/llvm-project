define internal i32 @find_unique(ptr %sps) {
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %k = phi i32 [ -1, %entry ], [ %k.next, %loop.latch ]
  %gep = getelementptr inbounds ptr, ptr %sps, i64 %iv
  %l = load ptr, ptr %gep, align 8
  %is.null = icmp eq ptr %l, null
  br i1 %is.null, label %loop.latch, label %if.nonnull

if.nonnull:
  %iv.trunc = trunc i64 %iv to i32
  %found = icmp sgt i32 %k, -1
  br i1 %found, label %exit, label %loop.latch

loop.latch:
  %k.next = phi i32 [ %k, %loop ], [ %iv.trunc, %if.nonnull ]
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 16
  br i1 %ec, label %exit, label %loop

exit:
  %res = phi i32 [ -1, %if.nonnull ], [ %k.next, %loop.latch ]
  ret i32 %res
}
