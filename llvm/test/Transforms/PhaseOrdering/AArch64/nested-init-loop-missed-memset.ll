; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals none --version 6
; RUN: opt -passes="default<O3>" -S %s | FileCheck %s

; PhaseOrdering regression guard for the bjarne screen_init pattern:
; a doubly-nested init loop should collapse to a single @llvm.memset.
;
; This broke in an earlier defer-unroll + extra-unroll-after-vectorize
; experiment: the post-LV full unroll eagerly unrolled the stride-24
; inner loop before LoopIdiomRecognizePass on the outer could fold the
; nested pattern into a memset, leaving ~840 explicit stores in the
; final IR.
;
; Source equivalent (MultiSource/Benchmarks/Prolangs-C++/shapes/bjarne.cpp):
;   char screen[40][24];
;   void init() {
;     for (int y = 0; y < 24; y++)       // outer = y
;       for (int x = 0; x < 40; x++)     // inner = x  (stride-24 stores)
;         screen[x][y] = ' ';
;   }

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"
target triple = "arm64-apple-macosx14"

@screen = dso_local local_unnamed_addr global [40 x [24 x i8]] zeroinitializer, align 16


define void @init() local_unnamed_addr {
; CHECK-LABEL: define void @init(
; CHECK-SAME: ) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    tail call void @llvm.memset.p0.i64(ptr noundef nonnull align 16 dereferenceable(960) @screen, i8 32, i64 960, i1 false)
; CHECK-NEXT:    ret void
;
entry:
  br label %y.header

y.header:
  %y = phi i64 [ 0, %entry ], [ %y.next, %y.latch ]
  br label %x.body

x.body:
  %x = phi i64 [ 0, %y.header ], [ %x.next, %x.body ]
  %gep = getelementptr inbounds [40 x [24 x i8]], ptr @screen, i64 0, i64 %x, i64 %y
  store i8 32, ptr %gep, align 1
  %x.next = add nuw nsw i64 %x, 1
  %x.done = icmp eq i64 %x.next, 40
  br i1 %x.done, label %y.latch, label %x.body

y.latch:
  %y.next = add nuw nsw i64 %y, 1
  %y.done = icmp eq i64 %y.next, 24
  br i1 %y.done, label %exit, label %y.header

exit:
  ret void
}
