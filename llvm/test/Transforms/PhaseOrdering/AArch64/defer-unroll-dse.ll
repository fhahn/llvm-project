; The stores of the TC=32 init loop are completely overwritten by the memcpy.
; Base: DSE removes them and only the memcpy remains. Deferred: the vector
; stores are kept, because the chain's DSE runs before its LoopUnrollPass.
; Fix: the pipeline fix of @dead_straight; or DSE deleting a loop store whose
; whole written range is overwritten later with no intervening reads, after
; which LoopDeletion removes the loop.
define void @dead_init_memcpy(ptr noalias %p, ptr noalias %q) {
; CHECK-LABEL: define void @dead_init_memcpy(
; CHECK-SAME: ptr noalias nofree writeonly captures(none) initializes((0, 128)) [[P:%.*]], ptr noalias nofree readonly captures(none) [[Q:%.*]]) local_unnamed_addr #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    tail call void @llvm.memcpy.p0.p0.i64(ptr noundef nonnull align 4 dereferenceable(128) [[P]], ptr noundef nonnull align 4 dereferenceable(128) [[Q]], i64 128, i1 false)
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %iv.trunc = trunc i64 %iv to i32
  %gep.p = getelementptr inbounds i32, ptr %p, i64 %iv
  store i32 %iv.trunc, ptr %gep.p, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 32
  br i1 %ec, label %exit, label %loop

exit:
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %p, ptr align 4 %q, i64 128, i1 false)
  ret void
}

declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)
declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)
