; The outer 4-iter loop must still fully unroll. The early-exit inner
; ends up as separate (peeled / partially unrolled) iterations -- never
; as a deferred body that gates the outer.
entry:
  br label %outer

outer:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %outer.latch ]
  br label %inner

inner:
  %j = phi i64 [ 0, %outer ], [ %j.next, %inner.cont ]
  %sum = phi i32 [ %acc, %outer ], [ %sum.next, %inner.cont ]
  %off = mul i64 %i, 10
  %idx = add i64 %off, %j
  %cgep = getelementptr inbounds i32, ptr %cond, i64 %idx
  %c = load i32, ptr %cgep, align 4
  %brk = icmp eq i32 %c, 0
  br i1 %brk, label %outer.latch, label %inner.cont

inner.cont:
  %vgep = getelementptr inbounds i32, ptr %a, i64 %idx
  %v = load i32, ptr %vgep, align 4
  %sum.next = add i32 %sum, %v
  %j.next = add nuw nsw i64 %j, 1
  %j.cmp = icmp ult i64 %j.next, 10
  br i1 %j.cmp, label %inner, label %outer.latch

outer.latch:
  %acc.next = phi i32 [ %sum, %inner ], [ %sum.next, %inner.cont ]
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp ult i64 %i.next, 4
  br i1 %i.cmp, label %outer, label %exit

exit:
  ret i32 %acc.next
}

