; Stale-marker case (aom_sad-style): a function whose innermost loop is
; deferred when the function is processed in isolation, then inlined into
; a context where an enclosing loop has a small constant trip count.
; Without re-evaluating the marker, the outer would be skipped from
; full-unroll forever; with re-evaluation, the marker is treated as stale
; and the outer fully unrolls.
define internal i32 @inner_callee(ptr %a, ptr %b, i32 %width) {
entry:
  br label %loop

loop:
  %j = phi i32 [ 0, %entry ], [ %j.next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  %j64 = sext i32 %j to i64
  %ap = getelementptr inbounds i8, ptr %a, i64 %j64
  %va = load i8, ptr %ap, align 1
  %va.z = zext i8 %va to i32
  %bp = getelementptr inbounds i8, ptr %b, i64 %j64
  %vb = load i8, ptr %bp, align 1
  %vb.z = zext i8 %vb to i32
  %diff = sub nsw i32 %va.z, %vb.z
  %abs = tail call i32 @llvm.abs.i32(i32 %diff, i1 true)
  %acc.next = add i32 %acc, %abs
  %j.next = add nuw nsw i32 %j, 1
  %cmp = icmp slt i32 %j.next, %width
  br i1 %cmp, label %loop, label %exit

exit:
  ret i32 %acc.next
}

