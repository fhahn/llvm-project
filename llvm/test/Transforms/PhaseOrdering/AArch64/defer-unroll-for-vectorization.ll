entry:
  br label %outer

outer:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  br label %inner

inner:
  %j = phi i64 [ 0, %outer ], [ %j.next, %inner ]
  %off = mul i64 %i, 10
  %idx = add i64 %off, %j
  %src = getelementptr inbounds i32, ptr %a, i64 %idx
  %val = load i32, ptr %src, align 4
  %add = add nsw i32 %val, 1
  %dst.gep = getelementptr inbounds i32, ptr %dst, i64 %idx
  store i32 %add, ptr %dst.gep, align 4
  %j.next = add nuw nsw i64 %j, 1
  %j.cmp = icmp ult i64 %j.next, 10
  br i1 %j.cmp, label %inner, label %outer.latch

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp ult i64 %i.next, 4
  br i1 %i.cmp, label %outer, label %exit

exit:
  ret void
}

