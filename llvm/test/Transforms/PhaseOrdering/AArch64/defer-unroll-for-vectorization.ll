; The pattern repeats 14 more times for the remaining outer iterations.
entry:
  br label %outer

outer:
  %y = phi i32 [ 0, %entry ], [ %y.next, %inner.exit ]
  %sum = phi i32 [ 0, %entry ], [ %sum.next, %inner.exit ]
  %p1.cur = phi ptr [ %p1, %entry ], [ %p1.next, %inner.exit ]
  %p2.cur = phi ptr [ %p2, %entry ], [ %p2.next, %inner.exit ]
  br label %inner

inner:
  %x = phi i32 [ 0, %outer ], [ %x.next, %inner ]
  %row = phi i32 [ %sum, %outer ], [ %row.next, %inner ]
  %x64 = sext i32 %x to i64
  %p1.x = getelementptr inbounds i8, ptr %p1.cur, i64 %x64
  %v1 = load i8, ptr %p1.x, align 1
  %v1.z = zext i8 %v1 to i32
  %p2.x = getelementptr inbounds i8, ptr %p2.cur, i64 %x64
  %v2 = load i8, ptr %p2.x, align 1
  %v2.z = zext i8 %v2 to i32
  %diff = sub nsw i32 %v1.z, %v2.z
  %abs = tail call i32 @llvm.abs.i32(i32 %diff, i1 true)
  %row.next = add i32 %row, %abs
  %x.next = add nuw nsw i32 %x, 1
  %x.cmp = icmp eq i32 %x.next, 16
  br i1 %x.cmp, label %inner.exit, label %inner

inner.exit:
  %sum.next = phi i32 [ %row.next, %inner ]
  %p1.idx = sext i32 %s_p1 to i64
  %p1.next = getelementptr inbounds i8, ptr %p1.cur, i64 %p1.idx
  %p2.idx = sext i32 %s_p2 to i64
  %p2.next = getelementptr inbounds i8, ptr %p2.cur, i64 %p2.idx
  %y.next = add nuw nsw i32 %y, 1
  %y.cmp = icmp eq i32 %y.next, 16
  br i1 %y.cmp, label %exit, label %outer

exit:
  ret i32 %sum.next
}

