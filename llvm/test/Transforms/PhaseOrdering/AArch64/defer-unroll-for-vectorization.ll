; CHECK-NEXT:    [[TMP21:%.*]] = tail call <16 x i16> @llvm.abs.v16i16(<16 x i16> [[TMP20]], i1 false)
; CHECK-NEXT:    [[TMP22:%.*]] = zext <16 x i16> [[TMP21]] to <16 x i32>
; CHECK-NEXT:    [[TMP23:%.*]] = tail call i32 @llvm.vector.reduce.add.v16i32(<16 x i32> [[TMP22]])
; CHECK-NEXT:    [[DGEP_2:%.*]] = getelementptr inbounds nuw i8, ptr [[DST]], i64 8
; CHECK-NEXT:    store i32 [[TMP23]], ptr [[DGEP_2]], align 4
; CHECK-NEXT:    [[AI_3:%.*]] = getelementptr inbounds nuw i8, ptr [[A]], i64 48
; CHECK-NEXT:    [[BI_3:%.*]] = getelementptr inbounds nuw i8, ptr [[B]], i64 48
; CHECK-NEXT:    [[TMP24:%.*]] = load <16 x i8>, ptr [[AI_3]], align 1
; CHECK-NEXT:    [[TMP25:%.*]] = zext <16 x i8> [[TMP24]] to <16 x i16>
; CHECK-NEXT:    [[TMP26:%.*]] = load <16 x i8>, ptr [[BI_3]], align 1
; CHECK-NEXT:    [[TMP27:%.*]] = zext <16 x i8> [[TMP26]] to <16 x i16>
; CHECK-NEXT:    [[TMP28:%.*]] = sub nsw <16 x i16> [[TMP25]], [[TMP27]]
; CHECK-NEXT:    [[TMP29:%.*]] = tail call <16 x i16> @llvm.abs.v16i16(<16 x i16> [[TMP28]], i1 false)
; CHECK-NEXT:    [[TMP30:%.*]] = zext <16 x i16> [[TMP29]] to <16 x i32>
; CHECK-NEXT:    [[TMP31:%.*]] = tail call i32 @llvm.vector.reduce.add.v16i32(<16 x i32> [[TMP30]])
; CHECK-NEXT:    [[DGEP_3:%.*]] = getelementptr inbounds nuw i8, ptr [[DST]], i64 12
; CHECK-NEXT:    store i32 [[TMP31]], ptr [[DGEP_3]], align 4
; CHECK-NEXT:    ret void
;
; The 4-iter outer must fully unroll, even though @inner_callee was
; deferred when processed standalone (its parent at that point was
; runtime, but here it ends up nested inside a TC=4 outer).
entry:
  br label %outer

outer:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  %ai = getelementptr inbounds [16 x i8], ptr %a, i64 %i, i64 0
  %bi = getelementptr inbounds [16 x i8], ptr %b, i64 %i, i64 0
  %sad = call i32 @inner_callee(ptr %ai, ptr %bi, i32 16)
  %dgep = getelementptr inbounds i32, ptr %dst, i64 %i
  store i32 %sad, ptr %dgep, align 4
  br label %outer.latch

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.cmp = icmp ult i64 %i.next, 4
  br i1 %i.cmp, label %outer, label %exit

exit:
  ret void
}

!0 = distinct !{!0, !1}
!1 = !{!"llvm.loop.vectorize.enable", i1 false}
