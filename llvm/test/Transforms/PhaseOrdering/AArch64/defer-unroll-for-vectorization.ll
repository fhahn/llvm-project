; CHECK-NEXT:    [[TMP19:%.*]] = add nsw <4 x i32> [[TMP18]], splat (i32 1)
; CHECK-NEXT:    store <4 x i32> [[TMP19]], ptr [[DST_GEP_6_3]], align 4
; CHECK-NEXT:    ret void
