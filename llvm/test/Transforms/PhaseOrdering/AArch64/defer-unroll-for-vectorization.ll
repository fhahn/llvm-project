; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -passes='default<O2>' -S < %s | FileCheck %s

; Verify that deferring full unrolling until after the vectorizer allows
; vectorization of small fixed-trip-count loops, while still preserving
; scalar optimizations enabled by full unrolling.

target triple = "arm64-apple-macosx"

; A loop with trip count 8 on arrays. With deferred unrolling, this is
; vectorized with VF=4 and unrolled 2x, producing 2 vector iterations.
define void @add_arrays(ptr noalias %dst, ptr noalias %a, ptr noalias %b) {
; CHECK-LABEL: @add_arrays(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[A:%.*]], align 4
; CHECK-NEXT:    [[WIDE_LOAD1:%.*]] = load <4 x i32>, ptr [[B:%.*]], align 4
; CHECK-NEXT:    [[TMP0:%.*]] = add nsw <4 x i32> [[WIDE_LOAD1]], [[WIDE_LOAD]]
; CHECK-NEXT:    store <4 x i32> [[TMP0]], ptr [[DST:%.*]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds nuw i8, ptr [[A]], i64 16
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr inbounds nuw i8, ptr [[B]], i64 16
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr inbounds nuw i8, ptr [[DST]], i64 16
; CHECK-NEXT:    [[WIDE_LOAD_1:%.*]] = load <4 x i32>, ptr [[TMP1]], align 4
; CHECK-NEXT:    [[WIDE_LOAD1_1:%.*]] = load <4 x i32>, ptr [[TMP2]], align 4
; CHECK-NEXT:    [[TMP4:%.*]] = add nsw <4 x i32> [[WIDE_LOAD1_1]], [[WIDE_LOAD_1]]
; CHECK-NEXT:    store <4 x i32> [[TMP4]], ptr [[TMP3]], align 4
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
  %gep.b = getelementptr inbounds i32, ptr %b, i64 %iv
  %gep.dst = getelementptr inbounds i32, ptr %dst, i64 %iv
  %va = load i32, ptr %gep.a, align 4
  %vb = load i32, ptr %gep.b, align 4
  %add = add nsw i32 %va, %vb
  store i32 %add, ptr %gep.dst, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp ult i64 %iv.next, 8
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; Same loop but with vectorization explicitly disabled. The loop should still
; be fully unrolled.
define void @add_arrays_no_vec(ptr noalias %dst, ptr noalias %a, ptr noalias %b) {
; CHECK-LABEL: @add_arrays_no_vec(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[A:%.*]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x i32>, ptr [[B:%.*]], align 4
; CHECK-NEXT:    [[TMP2:%.*]] = add nsw <4 x i32> [[TMP1]], [[TMP0]]
; CHECK-NEXT:    store <4 x i32> [[TMP2]], ptr [[DST:%.*]], align 4
; CHECK-NEXT:    [[GEP_A_4:%.*]] = getelementptr inbounds nuw i8, ptr [[A]], i64 16
; CHECK-NEXT:    [[GEP_B_4:%.*]] = getelementptr inbounds nuw i8, ptr [[B]], i64 16
; CHECK-NEXT:    [[GEP_DST_4:%.*]] = getelementptr inbounds nuw i8, ptr [[DST]], i64 16
; CHECK-NEXT:    [[TMP3:%.*]] = load <4 x i32>, ptr [[GEP_A_4]], align 4
; CHECK-NEXT:    [[TMP4:%.*]] = load <4 x i32>, ptr [[GEP_B_4]], align 4
; CHECK-NEXT:    [[TMP5:%.*]] = add nsw <4 x i32> [[TMP4]], [[TMP3]]
; CHECK-NEXT:    store <4 x i32> [[TMP5]], ptr [[GEP_DST_4]], align 4
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
  %gep.b = getelementptr inbounds i32, ptr %b, i64 %iv
  %gep.dst = getelementptr inbounds i32, ptr %dst, i64 %iv
  %va = load i32, ptr %gep.a, align 4
  %vb = load i32, ptr %gep.b, align 4
  %add = add nsw i32 %va, %vb
  store i32 %add, ptr %gep.dst, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp ult i64 %iv.next, 8
  br i1 %cmp, label %loop, label %exit, !llvm.loop !0

exit:
  ret void
}

; A loop with a true loop-carried dependency (recurrence) that the vectorizer
; cannot handle. Verify it still gets fully unrolled after the vectorizer.
define i32 @recurrence_loop(ptr %arr) {
; CHECK-LABEL: @recurrence_loop(
; CHECK-NEXT:  loop:
; CHECK-NEXT:    [[VAL:%.*]] = load i32, ptr [[ARR:%.*]], align 4
; CHECK-NEXT:    [[GEP_1:%.*]] = getelementptr inbounds nuw i8, ptr [[ARR]], i64 4
; CHECK-NEXT:    [[VAL_1:%.*]] = load i32, ptr [[GEP_1]], align 4
; CHECK-NEXT:    [[MUL1_1:%.*]] = add i32 [[VAL]], 1
; CHECK-NEXT:    [[NEXT_ACC_1:%.*]] = mul i32 [[MUL1_1]], [[VAL_1]]
; CHECK-NEXT:    [[GEP_2:%.*]] = getelementptr inbounds nuw i8, ptr [[ARR]], i64 8
; CHECK-NEXT:    [[VAL_2:%.*]] = load i32, ptr [[GEP_2]], align 4
; CHECK-NEXT:    [[MUL1_2:%.*]] = add i32 [[NEXT_ACC_1]], 1
; CHECK-NEXT:    [[NEXT_ACC_2:%.*]] = mul i32 [[MUL1_2]], [[VAL_2]]
; CHECK-NEXT:    [[GEP_3:%.*]] = getelementptr inbounds nuw i8, ptr [[ARR]], i64 12
; CHECK-NEXT:    [[VAL_3:%.*]] = load i32, ptr [[GEP_3]], align 4
; CHECK-NEXT:    [[MUL1_3:%.*]] = add i32 [[NEXT_ACC_2]], 1
; CHECK-NEXT:    [[NEXT_ACC_3:%.*]] = mul i32 [[MUL1_3]], [[VAL_3]]
; CHECK-NEXT:    ret i32 [[NEXT_ACC_3]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %next.acc, %loop ]
  %gep = getelementptr inbounds i32, ptr %arr, i64 %iv
  %val = load i32, ptr %gep, align 4
  %mul = mul nsw i32 %acc, %val
  %next.acc = add nsw i32 %mul, %val
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp ult i64 %iv.next, 4
  br i1 %cmp, label %loop, label %exit

exit:
  ret i32 %next.acc
}

; Verify that full unrolling + scalar optimizations (like DSE) still work
; when unrolling is deferred. The first loop stores zeros and the second
; overwrites them, so DSE should eliminate the dead stores.
define void @unroll_enables_dse(ptr noalias %dst) {
; CHECK-LABEL: @unroll_enables_dse(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    tail call void @llvm.memset.p0.i64(ptr noundef nonnull align 4 dereferenceable(16) [[DST:%.*]], i8 0, i64 16, i1 false)
; CHECK-NEXT:    store <4 x i32> <i32 1, i32 2, i32 3, i32 4>, ptr [[DST]], align 4
; CHECK-NEXT:    ret void
;
entry:
  br label %loop.init

loop.init:
  %iv0 = phi i64 [ 0, %entry ], [ %iv0.next, %loop.init ]
  %gep0 = getelementptr inbounds i32, ptr %dst, i64 %iv0
  store i32 0, ptr %gep0, align 4
  %iv0.next = add nuw nsw i64 %iv0, 1
  %cmp0 = icmp ult i64 %iv0.next, 4
  br i1 %cmp0, label %loop.init, label %mid

mid:
  br label %loop.overwrite

loop.overwrite:
  %iv1 = phi i64 [ 0, %mid ], [ %iv1.next, %loop.overwrite ]
  %gep1 = getelementptr inbounds i32, ptr %dst, i64 %iv1
  %iv1.trunc = trunc i64 %iv1 to i32
  %val = add nsw i32 %iv1.trunc, 1
  store i32 %val, ptr %gep1, align 4
  %iv1.next = add nuw nsw i64 %iv1, 1
  %cmp1 = icmp ult i64 %iv1.next, 4
  br i1 %cmp1, label %loop.overwrite, label %exit

exit:
  ret void
}

; Verify that a purely scalar loop (no strided memory accesses) is still
; fully unrolled early and not deferred. The structural heuristic should
; only defer loops with AddRec pointer accesses.
define i32 @scalar_loop_no_defer(i32 %x) {
; CHECK-LABEL: @scalar_loop_no_defer(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = add i32 [[X:%.*]], 12
; CHECK-NEXT:    ret i32 [[TMP0]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %acc = phi i32 [ %x, %entry ], [ %next, %loop ]
  %next = add nsw i32 %acc, 3
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp ult i64 %iv.next, 4
  br i1 %cmp, label %loop, label %exit

exit:
  ret i32 %next
}

!0 = distinct !{!0, !1}
!1 = !{!"llvm.loop.vectorize.enable", i1 false}
