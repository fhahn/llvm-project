; CHECK-NEXT:    [[PTR_NEXT_2:%.*]] = getelementptr i8, ptr [[THIS]], i64 12
; CHECK-NEXT:    [[PTR_NEXT_3:%.*]] = getelementptr i8, ptr [[THIS]], i64 16
