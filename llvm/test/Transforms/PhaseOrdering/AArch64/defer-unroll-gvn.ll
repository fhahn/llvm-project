entry:
  br label %outer

outer:
  br label %inner

inner:
  %ptr = phi ptr [ %this, %outer ], [ %ptr.next, %inner.latch ]
  %end = call ptr @get_end(ptr %this)
  %at.end = icmp eq ptr %ptr, %end
  br i1 %at.end, label %outer, label %check

check:
  %valid = call i1 @is_valid(ptr %ptr)
  br i1 %valid, label %body, label %outer

body:
  %v = call i32 @get_value(ptr %this)
  %is.zero = icmp eq i32 %v, 0
  br i1 %is.zero, label %exit, label %inner.latch

inner.latch:
  %ptr.next = getelementptr i8, ptr %ptr, i64 4
  br label %inner

exit:
  ret void
}

define i32 @get_value(ptr %this) {
; CHECK-LABEL: define i32 @get_value(
; CHECK-SAME: ptr nofree readonly captures(none) [[THIS:%.*]]) local_unnamed_addr #[[ATTR2:[0-9]+]] {
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[THIS]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  %v = load i32, ptr %this, align 4
  ret i32 %v
}

define ptr @get_end(ptr %this) {
; CHECK-LABEL: define ptr @get_end(
; CHECK-SAME: ptr nofree readnone captures(ret: address, provenance) [[THIS:%.*]]) local_unnamed_addr #[[ATTR3:[0-9]+]] {
; CHECK-NEXT:    [[END:%.*]] = getelementptr i8, ptr [[THIS]], i64 64
; CHECK-NEXT:    ret ptr [[END]]
;
  %end = getelementptr i8, ptr %this, i64 64
  ret ptr %end
}

define i1 @is_valid(ptr %this) {
; CHECK-LABEL: define i1 @is_valid(
; CHECK-SAME: ptr nofree readonly captures(none) [[THIS:%.*]]) local_unnamed_addr #[[ATTR2]] {
; CHECK-NEXT:    [[V:%.*]] = load i16, ptr [[THIS]], align 2
; CHECK-NEXT:    [[VALID:%.*]] = icmp ne i16 [[V]], 0
; CHECK-NEXT:    ret i1 [[VALID]]
;
  %v = load i16, ptr %this, align 2
  %valid = icmp ne i16 %v, 0
  ret i1 %valid
}

