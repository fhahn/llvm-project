entry:
  %count = alloca [27 x i32], align 4
  call void @llvm.lifetime.start.p0(ptr %count)
  br label %col.loop

col.loop:
  %apos = phi i32 [ 0, %entry ], [ %apos.next, %col.latch ]
  %spos = phi i32 [ 0, %entry ], [ %spos.next, %col.latch ]
  %col.cmp = icmp slt i32 %apos, %alen
  br i1 %col.cmp, label %clear.loop, label %exit

clear.loop:
  %x = phi i32 [ 0, %col.loop ], [ %x.next, %clear.loop ]
  %x.ext = sext i32 %x to i64
  %gep.clear = getelementptr inbounds [27 x i32], ptr %count, i64 0, i64 %x.ext
  store i32 0, ptr %gep.clear, align 4
  %x.next = add nsw i32 %x, 1
  %clear.cmp = icmp slt i32 %x.next, 27
  br i1 %clear.cmp, label %clear.loop, label %count.loop.ph

count.loop.ph:
  br label %count.loop

count.loop:
  %idx = phi i32 [ 0, %count.loop.ph ], [ %idx.next, %count.latch ]
  %count.cmp = icmp slt i32 %idx, %nseq
  br i1 %count.cmp, label %count.body, label %count.exit

count.body:
  %idx.ext = sext i32 %idx to i64
  %gep.seq = getelementptr inbounds ptr, ptr %aseq, i64 %idx.ext
  %seq = load ptr, ptr %gep.seq, align 8
  %apos.ext = sext i32 %apos to i64
  %gep.chr = getelementptr inbounds i8, ptr %seq, i64 %apos.ext
  %chr = load i8, ptr %gep.chr, align 1
  %chr.ext = sext i8 %chr to i32
  %sym = sub nsw i32 %chr.ext, 65
  %is.letter = icmp ult i32 %sym, 26
  br i1 %is.letter, label %count.letter, label %count.gap

count.letter:
  %sym.ext = zext i32 %sym to i64
  %gep.letter = getelementptr inbounds nuw [27 x i32], ptr %count, i64 0, i64 %sym.ext
  %c.letter = load i32, ptr %gep.letter, align 4
  %c.letter.inc = add nsw i32 %c.letter, 1
  store i32 %c.letter.inc, ptr %gep.letter, align 4
  br label %count.latch

count.gap:
  %gep.gap = getelementptr inbounds [27 x i32], ptr %count, i64 0, i64 26
  %c.gap = load i32, ptr %gep.gap, align 4
  %c.gap.inc = add nsw i32 %c.gap, 1
  store i32 %c.gap.inc, ptr %gep.gap, align 4
  br label %count.latch

count.latch:
  %idx.next = add nsw i32 %idx, 1
  br label %count.loop

count.exit:
  %gep.gaps = getelementptr inbounds [27 x i32], ptr %count, i64 0, i64 26
  %gaps = load i32, ptr %gep.gaps, align 4
  %gaps.fp = sitofp i32 %gaps to float
  %nseq.fp = sitofp i32 %nseq to float
  %frac = fdiv float %gaps.fp, %nseq.fp
  %frac.ext = fpext float %frac to double
  %few.gaps = fcmp ole double %frac.ext, 5.000000e-01
  br i1 %few.gaps, label %max.loop, label %col.latch

max.loop:
  %max = phi i32 [ -1, %count.exit ], [ %max.next, %max.latch ]
  %bestx = phi i32 [ -1, %count.exit ], [ %bestx.next, %max.latch ]
  %y = phi i32 [ 0, %count.exit ], [ %y.next, %max.latch ]
  %y.ext = sext i32 %y to i64
  %gep.max = getelementptr inbounds [27 x i32], ptr %count, i64 0, i64 %y.ext
  %c = load i32, ptr %gep.max, align 4
  %is.max = icmp sgt i32 %c, %max
  br i1 %is.max, label %new.max, label %max.latch

new.max:
  br label %max.latch

max.latch:
  %max.next = phi i32 [ %c, %new.max ], [ %max, %max.loop ]
  %bestx.next = phi i32 [ %y, %new.max ], [ %bestx, %max.loop ]
  %y.next = add nsw i32 %y, 1
  %max.cmp = icmp slt i32 %y.next, 26
  br i1 %max.cmp, label %max.loop, label %max.exit

max.exit:
  %res = add nsw i32 65, %bestx.next
  %res.trunc = trunc i32 %res to i8
  %spos.inc = add nsw i32 %spos, 1
  %spos.ext = sext i32 %spos to i64
  %gep.cs = getelementptr inbounds i8, ptr %cs, i64 %spos.ext
  store i8 %res.trunc, ptr %gep.cs, align 1
  br label %col.latch

col.latch:
  %spos.next = phi i32 [ %spos.inc, %max.exit ], [ %spos, %count.exit ]
  %apos.next = add nsw i32 %apos, 1
  br label %col.loop

exit:
  %spos.end = sext i32 %spos to i64
  %gep.end = getelementptr inbounds i8, ptr %cs, i64 %spos.end
  store i8 0, ptr %gep.end, align 1
  call void @llvm.lifetime.end.p0(ptr %count)
