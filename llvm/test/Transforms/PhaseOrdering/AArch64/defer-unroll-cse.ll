entry:
  br label %outer

outer:
  %r = phi i64 [ 0, %entry ], [ %r.next, %outer.latch ]
  %row = phi ptr [ %dst, %entry ], [ %row.next, %outer.latch ]
  br label %inner

inner:
  %c = phi i64 [ 0, %outer ], [ %c.next, %inner ]
  %gep = getelementptr inbounds i16, ptr %row, i64 %c
