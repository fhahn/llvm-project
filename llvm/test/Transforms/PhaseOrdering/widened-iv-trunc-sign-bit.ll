; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes="default<O3>" -S < %s | FileCheck %s

target datalayout = "n32:64"

; The result of @find is either 0 or a zero-extended i16, so the check in
; @caller is always true after inlining. IndVars widens %i to i64 and replaces
; %i.ext with a trunc of the wide IV, which must preserve enough information to
; fold the check.
define i1 @caller(ptr %a, i16 %n) {
; CHECK-LABEL: define noundef i1 @caller(
; CHECK-SAME: ptr nofree readonly captures(none) [[A:%.*]], i16 [[N:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[FIND_EXIT:.*:]]
; CHECK-NEXT:    ret i1 true
;
  %r = call i32 @find(ptr %a, i16 %n)
  %ok = icmp sgt i32 %r, -1
  ret i1 %ok
}

define i32 @find(ptr %a, i16 %n) {
; CHECK-LABEL: define range(i32 0, 65534) i32 @find(
; CHECK-SAME: ptr nofree readonly captures(none) [[A:%.*]], i16 [[N:%.*]]) local_unnamed_addr #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[SWITCH:%.*]] = icmp ult i16 [[N]], 2
; CHECK-NEXT:    br i1 [[SWITCH]], label %[[RET:.*]], label %[[BODY_PREHEADER:.*]]
; CHECK:       [[BODY_PREHEADER]]:
; CHECK-NEXT:    [[N_EXT:%.*]] = zext i16 [[N]] to i64
; CHECK-NEXT:    [[TMP0:%.*]] = add nsw i64 [[N_EXT]], -2
; CHECK-NEXT:    [[V5:%.*]] = load i8, ptr [[A]], align 1
; CHECK-NEXT:    [[FOUND6:%.*]] = icmp eq i8 [[V5]], 0
; CHECK-NEXT:    br i1 [[FOUND6]], label %[[RET]], label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[INDVARS_IV7:%.*]] = phi i64 [ [[INDVARS_IV_NEXT:%.*]], %[[BODY:.*]] ], [ 0, %[[BODY_PREHEADER]] ]
; CHECK-NEXT:    [[EXITCOND_NOT:%.*]] = icmp eq i64 [[INDVARS_IV7]], [[TMP0]]
; CHECK-NEXT:    br i1 [[EXITCOND_NOT]], label %[[RET]], label %[[BODY]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add nuw nsw i64 [[INDVARS_IV7]], 1
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr i8, ptr [[A]], i64 [[INDVARS_IV_NEXT]]
; CHECK-NEXT:    [[V:%.*]] = load i8, ptr [[GEP]], align 1
; CHECK-NEXT:    [[FOUND:%.*]] = icmp eq i8 [[V]], 0
; CHECK-NEXT:    br i1 [[FOUND]], label %[[BODY_RET_LOOPEXIT_CRIT_EDGE:.*]], label %[[LOOP]]
; CHECK:       [[BODY_RET_LOOPEXIT_CRIT_EDGE]]:
; CHECK-NEXT:    [[TMP1:%.*]] = trunc nuw nsw i64 [[INDVARS_IV_NEXT]] to i32
; CHECK-NEXT:    br label %[[RET]]
; CHECK:       [[RET]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ 0, %[[BODY_PREHEADER]] ], [ [[TMP1]], %[[BODY_RET_LOOPEXIT_CRIT_EDGE]] ], [ 0, %[[LOOP]] ]
; CHECK-NEXT:    ret i32 [[RES]]
;
entry:
  %n.zero = icmp eq i16 %n, 0
  br i1 %n.zero, label %ret, label %loop

loop:
  %i = phi i16 [ %i.next, %latch ], [ 0, %entry ]
  %i.ext = zext i16 %i to i32
  %n.ext = zext i16 %n to i32
  %bound = add i32 %n.ext, -1
  %c = icmp sgt i32 %bound, %i.ext
  br i1 %c, label %body, label %ret

body:
  %idx = zext i16 %i to i64
  %gep = getelementptr i8, ptr %a, i64 %idx
  %v = load i8, ptr %gep, align 1
  %found = icmp eq i8 %v, 0
  br i1 %found, label %ret, label %latch

latch:
  %i.next = add i16 %i, 1
  br label %loop

ret:
  %res = phi i32 [ 0, %entry ], [ 0, %loop ], [ %i.ext, %body ]
  ret i32 %res
}
