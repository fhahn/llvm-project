; RUN: opt -passes='default<O3>' -S %s | FileCheck %s

; Decreasing induction whose decrement is a checked ssub.with.overflow, as
; Swift's bounds/overflow-checked code emits. The `nsw` on the decrement only
; becomes available after SCCP lowers the overflow-guarded subtraction, which is
; after the first constraint-elimination pass in the pipeline. The redundant
; `count < iv` guard (iv only decreases from count) is therefore only provable
; by the constraint-elimination run scheduled after the loop pipeline; without
; it the guarding trap survives. See the reverse_iterate example in the Swift
; bounds-check corpus.

define i64 @reverse_iterate(i64 %count, ptr %p) {
; CHECK-LABEL: define i64 @reverse_iterate(
; CHECK-SAME: i64 [[COUNT:%.*]], ptr nofree readonly captures(none) [[P:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[NN:%.*]] = icmp sgt i64 [[COUNT]], -1
; CHECK-NEXT:    tail call void @llvm.assume(i1 [[NN]])
; CHECK-NEXT:    [[EZ:%.*]] = icmp eq i64 [[COUNT]], 0
; CHECK-NEXT:    br i1 [[EZ]], label %[[EXIT:.*]], label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[ACC:%.*]] = phi i64 [ [[ACC_NEXT:%.*]], %[[LOOP]] ], [ 0, %[[ENTRY]] ]
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[DEC:%.*]], %[[LOOP]] ], [ [[COUNT]], %[[ENTRY]] ]
; CHECK-NEXT:    [[DEC]] = add i64 [[IV]], -1
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw [8 x i8], ptr [[P]], i64 [[DEC]]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[GEP]], align 4
; CHECK-NEXT:    [[ACC_NEXT]] = add i64 [[V]], [[ACC]]
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[DEC]], 0
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[ACC_NEXT]], %[[LOOP]] ]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  %nn = icmp sgt i64 %count, -1
  tail call void @llvm.assume(i1 %nn)
  %ez = icmp eq i64 %count, 0
  br i1 %ez, label %exit, label %ph
ph:
  br label %loop
loop:
  %acc = phi i64 [ 0, %ph ], [ %acc.next, %latch ]
  %iv = phi i64 [ %count, %ph ], [ %dec, %latch ]
  %oob = icmp slt i64 %count, %iv
  br i1 %oob, label %trap, label %body
body:
  %so = tail call { i64, i1 } @llvm.ssub.with.overflow.i64(i64 %iv, i64 1)
  %dec = extractvalue { i64, i1 } %so, 0
  %ov = extractvalue { i64, i1 } %so, 1
  br i1 %ov, label %trap, label %body2
body2:
  %gep = getelementptr inbounds i64, ptr %p, i64 %dec
  %v = load i64, ptr %gep
  %acc.next = add i64 %acc, %v
  br label %latch
latch:
  %done = icmp eq i64 %dec, 0
  br i1 %done, label %exit, label %loop
exit:
  %r = phi i64 [ 0, %entry ], [ %acc.next, %latch ]
  ret i64 %r
trap:
  tail call void @llvm.trap()
  unreachable
}

declare void @llvm.assume(i1)
declare void @llvm.trap()
declare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)
