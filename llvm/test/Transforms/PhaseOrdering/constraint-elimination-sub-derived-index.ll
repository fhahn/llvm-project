; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: opt -passes='default<O3>' -S %s | FileCheck %s

; A palindrome-style loop accessing s[i] and s[count-1-i] for i in 0..<count/2.
; The bounds check on the decreasing derived index count-1-i and the checked
; subtraction's overflow flag are both redundant: constraint elimination proves
; count-1-i stays in [0, count) using the lshr bound (i < count/2 <= count) and
; the unsigned decomposition of the subtraction (count-1 u>= i). All traps should
; be removed end to end.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"

declare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)
declare void @llvm.trap()
declare void @llvm.assume(i1)

define i1 @is_palindrome(ptr %p, i64 %count) {
; CHECK-LABEL: define noundef i1 @is_palindrome(
; CHECK-SAME: ptr nofree readonly captures(none) [[P:%.*]], i64 [[COUNT:%.*]]) local_unnamed_addr #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[NN:%.*]] = icmp sgt i64 [[COUNT]], -1
; CHECK-NEXT:    tail call void @llvm.assume(i1 [[NN]])
; CHECK-NEXT:    [[HALF:%.*]] = lshr i64 [[COUNT]], 1
; CHECK-NEXT:    [[DONE2:%.*]] = icmp eq i64 [[HALF]], 0
; CHECK-NEXT:    br i1 [[DONE2]], label %[[COMMON_RET:.*]], label %[[BODY_PREHEADER:.*]]
; CHECK:       [[BODY_PREHEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr [8 x i8], ptr [[P]], i64 [[COUNT]]
; CHECK-NEXT:    br label %[[ACCESS:.*]]
; CHECK:       [[ACCESS]]:
; CHECK-NEXT:    [[TMP2:%.*]] = phi i64 [ [[I_NEXT:%.*]], %[[ACCESS]] ], [ 0, %[[BODY_PREHEADER]] ]
; CHECK-NEXT:    [[TMP1:%.*]] = xor i64 [[TMP2]], -1
; CHECK-NEXT:    [[ADDR_D:%.*]] = getelementptr inbounds nuw [8 x i8], ptr [[P]], i64 [[TMP2]]
; CHECK-NEXT:    [[ADDR_D1:%.*]] = getelementptr [8 x i8], ptr [[TMP0]], i64 [[TMP1]]
; CHECK-NEXT:    [[VI:%.*]] = load i64, ptr [[ADDR_D]], align 8
; CHECK-NEXT:    [[VD:%.*]] = load i64, ptr [[ADDR_D1]], align 8
; CHECK-NEXT:    [[EQ:%.*]] = icmp eq i64 [[VI]], [[VD]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[TMP2]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp ne i64 [[I_NEXT]], [[HALF]]
; CHECK-NEXT:    [[OR_COND_NOT:%.*]] = select i1 [[EQ]], i1 [[DONE]], i1 false
; CHECK-NEXT:    br i1 [[OR_COND_NOT]], label %[[ACCESS]], label %[[COMMON_RET]]
; CHECK:       [[COMMON_RET]]:
; CHECK-NEXT:    [[DONE_LCSSA:%.*]] = phi i1 [ true, %[[ENTRY]] ], [ [[EQ]], %[[ACCESS]] ]
; CHECK-NEXT:    ret i1 [[DONE_LCSSA]]
;
entry:
  %nn = icmp sge i64 %count, 0
  call void @llvm.assume(i1 %nn)
  %half = lshr i64 %count, 1
  %cm1 = add nsw i64 %count, -1
  br label %header
header:
  %i = phi i64 [ 0, %entry ], [ %i.next, %latch ]
  %done = icmp eq i64 %i, %half
  br i1 %done, label %ret.true, label %body
body:
  %s = call { i64, i1 } @llvm.ssub.with.overflow.i64(i64 %cm1, i64 %i)
  %d = extractvalue { i64, i1 } %s, 0
  %ov = extractvalue { i64, i1 } %s, 1
  %lo = icmp uge i64 %i, %count
  %hi = icmp uge i64 %d, %count
  %oob = or i1 %lo, %hi
  %bad = or i1 %oob, %ov
  br i1 %bad, label %trap, label %access
access:
  %addr.i = getelementptr inbounds i64, ptr %p, i64 %i
  %addr.d = getelementptr inbounds i64, ptr %p, i64 %d
  %vi = load i64, ptr %addr.i
  %vd = load i64, ptr %addr.d
  %eq = icmp eq i64 %vi, %vd
  br i1 %eq, label %latch, label %ret.false
latch:
  %i.next = add nuw nsw i64 %i, 1
  br label %header
ret.true:
  ret i1 true
ret.false:
  ret i1 false
trap:
  tail call void @llvm.trap()
  unreachable
}
