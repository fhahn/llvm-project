; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -O3 -S < %s | FileCheck %s

; End-to-end coverage for folding the value component of a *.with.overflow
; intrinsic. These only show up through pass interaction (inlining,
; SimplifyCFG, InstCombine), not from InstCombine alone.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

declare void @error_out_of_range()
declare void @error_negative()

; The value component is the wrapped sum, so it folds to %size, and the second
; bounds check - along with its whole error path - folds away.
;
; The two error paths call different functions on purpose: with a common
; callee SimplifyCFG merges the two branches into an `or` before InstCombine
; runs, and %v is used unconditionally.
define void @add_value_reassociates_with_sub(i64 %off, i64 %size) {
; CHECK-LABEL: define void @add_value_reassociates_with_sub(
; CHECK-SAME: i64 [[OFF:%.*]], i64 [[SIZE:%.*]]) local_unnamed_addr {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LEN:%.*]] = sub i64 [[SIZE]], [[OFF]]
; CHECK-NEXT:    [[WO:%.*]] = tail call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[OFF]], i64 [[LEN]])
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i64, i1 } [[WO]], 1
; CHECK-NEXT:    br i1 [[OV]], label %[[ERR_NEGATIVE:.*]], label %[[DONE:.*]]
; CHECK:       [[ERR_NEGATIVE]]:
; CHECK-NEXT:    tail call void @error_negative()
; CHECK-NEXT:    br label %[[DONE]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret void
;
entry:
  %len = sub i64 %size, %off
  %wo = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %off, i64 %len)
  %ov = extractvalue { i64, i1 } %wo, 1
  br i1 %ov, label %err.negative, label %ok

ok:
  %v = extractvalue { i64, i1 } %wo, 0
  %c = icmp sgt i64 %v, %size
  br i1 %c, label %err.range, label %done

err.negative:
  call void @error_negative()
  br label %done

err.range:
  call void @error_out_of_range()
  br label %done

done:
  ret void
}
