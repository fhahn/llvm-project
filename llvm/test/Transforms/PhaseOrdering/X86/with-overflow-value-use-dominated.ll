; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -O3 -S < %s | FileCheck %s

; End-to-end coverage for rewriting the value component of a *.with.overflow
; intrinsic to a plain no-wrap binop when every use is dominated by the
; no-overflow edge. These only show up through pass interaction (inlining,
; SimplifyCFG, InstCombine), not from InstCombine alone. See
; with-overflow-value-use-dominated-if-conversion.ll for the SimplifyCFG
; cost interaction.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

declare { i32, i1 } @llvm.sadd.with.overflow.i32(i32, i32)
declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)
declare { i64, i1 } @llvm.uadd.with.overflow.i64(i64, i64)
declare { i64, i1 } @llvm.umul.with.overflow.i64(i64, i64)

declare void @use(i64)
declare void @error_overflow() noreturn
declare void @error_out_of_range()
declare void @error_negative()

; The value component becomes a real add, so %off + (%size - %off)
; reassociates to %size and the second bounds check - along with its whole
; error path - folds away. This is reassociation of the binop; it does not
; depend on the no-wrap flag.
;
; The two error paths call different functions on purpose: with a common
; callee SimplifyCFG merges the two branches into an `or` before InstCombine
; runs, and the value use is no longer dominated by the no-overflow edge.
define void @add_value_reassociates_with_sub(i64 %off, i64 %size) {
; CHECK-LABEL: define void @add_value_reassociates_with_sub(
; CHECK-SAME: i64 [[OFF:%.*]], i64 [[SIZE:%.*]]) local_unnamed_addr {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LEN:%.*]] = sub i64 [[SIZE]], [[OFF]]
; CHECK-NEXT:    [[WO:%.*]] = tail call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[OFF]], i64 [[LEN]])
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i64, i1 } [[WO]], 1
; CHECK-NEXT:    br i1 [[OV]], label %[[ERR_NEGATIVE:.*]], label %[[DONE1:.*]]
; CHECK:       [[ERR_NEGATIVE]]:
; CHECK-NEXT:    tail call void @error_negative()
; CHECK-NEXT:    br label %[[DONE1]]
; CHECK:       [[DONE1]]:
; CHECK-NEXT:    ret void
;
entry:
  %len = sub i64 %size, %off
  %wo = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %off, i64 %len)
  %ov = extractvalue { i64, i1 } %wo, 1
  br i1 %ov, label %err.negative, label %ok

ok:
  %v = extractvalue { i64, i1 } %wo, 0
  %c = icmp sgt i64 %v, %size
  br i1 %c, label %err.range, label %done

err.negative:
  call void @error_negative()
  br label %done

err.range:
  call void @error_out_of_range()
  br label %done

done:
  ret void
}

; With the value use decoupled from the intrinsic, the overflow check of
; %x + 1 degenerates to a plain compare and the intrinsic dies entirely.
define i32 @add_one_check_folds_to_compare(i32 %x) {
; CHECK-LABEL: define range(i32 -2147483647, -2147483648) i32 @add_one_check_folds_to_compare(
; CHECK-SAME: i32 [[X:%.*]]) local_unnamed_addr {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[WO:%.*]] = tail call { i32, i1 } @llvm.sadd.with.overflow.i32(i32 [[X]], i32 1)
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i32, i1 } [[WO]], 1
; CHECK-NEXT:    br i1 [[OV]], label %[[ERR:.*]], label %[[OK:.*]]
; CHECK:       [[OK]]:
; CHECK-NEXT:    [[V:%.*]] = extractvalue { i32, i1 } [[WO]], 0
; CHECK-NEXT:    ret i32 [[V]]
; CHECK:       [[ERR]]:
; CHECK-NEXT:    tail call void @error_overflow()
; CHECK-NEXT:    unreachable
;
entry:
  %wo = call { i32, i1 } @llvm.sadd.with.overflow.i32(i32 %x, i32 1)
  %ov = extractvalue { i32, i1 } %wo, 1
  br i1 %ov, label %err, label %ok

ok:
  %v = extractvalue { i32, i1 } %wo, 0
  ret i32 %v

err:
  call void @error_overflow()
  unreachable
}

; FIXME: This should still fold to a single llvm.uadd.sat.i64.
; foldSaturatingBinop matches select(extractvalue(%wo, 1), -1,
; extractvalue(%wo, 0)); rewriting the value extractvalue breaks the match.
; The branch form only reaches InstCombine after @checked_add_helper is
; inlined, hence the full pipeline.
define internal i64 @checked_add_helper(i64 %a, i64 %b) {
entry:
  %res = alloca i64, align 8
  %wo = call { i64, i1 } @llvm.uadd.with.overflow.i64(i64 %a, i64 %b)
  %ov = extractvalue { i64, i1 } %wo, 1
  br i1 %ov, label %sat, label %ok

ok:
  %v = extractvalue { i64, i1 } %wo, 0
  store i64 %v, ptr %res, align 8
  br label %done

sat:
  store i64 -1, ptr %res, align 8
  br label %done

done:
  %l = load i64, ptr %res, align 8
  ret i64 %l
}

define i64 @saturating_add_idiom(i64 %a, i64 %b) {
; CHECK-LABEL: define i64 @saturating_add_idiom(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) local_unnamed_addr #[[ATTR2:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[RES_0_I:%.*]] = tail call i64 @llvm.uadd.sat.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    ret i64 [[RES_0_I]]
;
entry:
  %r = call i64 @checked_add_helper(i64 %a, i64 %b)
  ret i64 %r
}

; FIXME: The intrinsic stays live for its overflow bit, so the multiply is
; computed anyway; the rewritten value is a second, redundant computation
; that then gets re-expanded to select + shl.
define void @mul_value_recomputed(i64 %n, i1 %c) {
; CHECK-LABEL: define void @mul_value_recomputed(
; CHECK-SAME: i64 [[N:%.*]], i1 [[C:%.*]]) local_unnamed_addr {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[SZ:%.*]] = select i1 [[C]], i64 4, i64 1
; CHECK-NEXT:    [[WO:%.*]] = tail call { i64, i1 } @llvm.umul.with.overflow.i64(i64 [[N]], i64 [[SZ]])
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i64, i1 } [[WO]], 1
; CHECK-NEXT:    br i1 [[OV]], label %[[DONE:.*]], label %[[OK:.*]]
; CHECK:       [[OK]]:
; CHECK-NEXT:    [[V:%.*]] = extractvalue { i64, i1 } [[WO]], 0
; CHECK-NEXT:    tail call void @use(i64 [[V]])
; CHECK-NEXT:    br label %[[DONE]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret void
;
entry:
  %sz = select i1 %c, i64 4, i64 1
  %wo = call { i64, i1 } @llvm.umul.with.overflow.i64(i64 %n, i64 %sz)
  %ov = extractvalue { i64, i1 } %wo, 1
  br i1 %ov, label %done, label %ok

ok:
  %v = extractvalue { i64, i1 } %wo, 0
  call void @use(i64 %v)
  br label %done

done:
  ret void
}
