define internal i32 @find_recursive_ret(ptr %frame, i32 %depth) {
entry:
  br label %loop.header

loop.header:
  %f = phi ptr [ %frame, %entry ], [ %next, %loop.latch ]
  %d = phi i32 [ %depth, %entry ], [ %d.next, %loop.latch ]
  %f.is.null = icmp eq ptr %f, null
  br i1 %f.is.null, label %not.found, label %loop.body

loop.body:
  %num.args.addr = getelementptr i8, ptr %f, i64 8
  %num.args = load i32, ptr %num.args.addr, align 4
  %has.args = icmp ne i32 %num.args, 0
  %in.range = icmp slt i32 %d, 4
  %cont = select i1 %has.args, i1 %in.range, i1 false
  br i1 %cont, label %loop.check, label %not.found

loop.check:
  %recursive.addr = getelementptr i8, ptr %f, i64 12
  %recursive = load i32, ptr %recursive.addr, align 4
  %is.recursive = icmp ne i32 %recursive, 0
  br i1 %is.recursive, label %found, label %loop.latch

loop.latch:
  %next = load ptr, ptr %f, align 8
  %d.next = add nsw i32 %d, 1
  br label %loop.header

found:
  ret i32 1

not.found:
  ret i32 0
}

