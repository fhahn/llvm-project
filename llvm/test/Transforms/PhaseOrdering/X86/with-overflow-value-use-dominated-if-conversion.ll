; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='instcombine,simplifycfg' -S < %s | FileCheck %s

; FIXME: This should if-convert to a select, as it does without the
; extractvalue-to-binop rewrite. extractvalue is TCC_Free but the materialized
; mul is not, which pushes %ok over FoldTwoEntryPHINode's budget
; (two-entry-phi-node-folding-threshold, default 4 * TCC_Basic), so the diamond
; survives. Re-running with -two-entry-phi-node-folding-threshold=8 recovers
; the select.
;
; This needs a target with a non-trivial sdiv cost, hence the X86 triple.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)

define i64 @mul_value_blocks_if_conversion(i64 %a, i64 %b) {
; CHECK-LABEL: define i64 @mul_value_blocks_if_conversion(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[WO:%.*]] = call { i64, i1 } @llvm.smul.with.overflow.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i64, i1 } [[WO]], 1
; CHECK-NEXT:    [[V:%.*]] = extractvalue { i64, i1 } [[WO]], 0
; CHECK-NEXT:    [[S:%.*]] = sdiv i64 [[V]], 4
; CHECK-NEXT:    [[R:%.*]] = select i1 [[OV]], i64 0, i64 [[S]]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  %wo = call { i64, i1 } @llvm.smul.with.overflow.i64(i64 %a, i64 %b)
  %ov = extractvalue { i64, i1 } %wo, 1
  br i1 %ov, label %sat, label %ok

ok:
  %v = extractvalue { i64, i1 } %wo, 0
  %s = sdiv i64 %v, 4
  br label %join

sat:
  br label %join

join:
  %r = phi i64 [ %s, %ok ], [ 0, %sat ]
  ret i64 %r
}
