; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -passes='default<O3>' -S %s | FileCheck %s

; Search loop `for (i = 0; i < *n; i++) if (!match(i)) break;` followed by a
; loop whose only condition is the loop-invariant `i > 0`, which gets unswitched
; with a freeze. The freeze must not block folding `i > 0` on the exit edges:
; the exiting value %i.next cannot be poison on the latch exit edge, as it feeds
; the latch branch.

define void @search_loop_exit_value_unswitched(ptr %n, ptr %p) {
; CHECK-LABEL: @search_loop_exit_value_unswitched(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[BOUND1:%.*]] = load volatile i32, ptr [[N:%.*]], align 4
; CHECK-NEXT:    [[IN2:%.*]] = icmp sgt i32 [[BOUND1]], 0
; CHECK-NEXT:    br i1 [[IN2]], label [[BODY:%.*]], label [[WAIT_PREHEADER:%.*]]
; CHECK:       body:
; CHECK-NEXT:    [[I3:%.*]] = phi i32 [ [[I_NEXT:%.*]], [[LATCH:%.*]] ], [ 0, [[ENTRY:%.*]] ]
; CHECK-NEXT:    tail call void @use(i32 noundef [[I3]])
; CHECK-NEXT:    [[V:%.*]] = load volatile i32, ptr [[P:%.*]], align 4
; CHECK-NEXT:    [[MATCH:%.*]] = icmp eq i32 [[V]], 0
; CHECK-NEXT:    br i1 [[MATCH]], label [[LATCH]], label [[EXIT:%.*]]
; CHECK:       latch:
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I3]], 1
; CHECK-NEXT:    [[BOUND:%.*]] = load volatile i32, ptr [[N]], align 4
; CHECK-NEXT:    [[IN:%.*]] = icmp slt i32 [[I_NEXT]], [[BOUND]]
; CHECK-NEXT:    br i1 [[IN]], label [[BODY]], label [[RET:%.*]]
; CHECK:       exit:
; CHECK-NEXT:    [[DOTNOT:%.*]] = icmp eq i32 [[I3]], 0
; CHECK-NEXT:    br i1 [[DOTNOT]], label [[WAIT_PREHEADER]], label [[RET]]
; CHECK:       wait.preheader:
; CHECK-NEXT:    store volatile i32 0, ptr [[P]], align 4
; CHECK-NEXT:    unreachable
; CHECK:       ret:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %bound = load volatile i32, ptr %n, align 4
  %in = icmp slt i32 %i, %bound
  br i1 %in, label %body, label %exit

body:
  call void @use(i32 noundef %i)
  %v = load volatile i32, ptr %p, align 4
  %match = icmp eq i32 %v, 0
  br i1 %match, label %latch, label %exit

latch:
  %i.next = add i32 %i, 1
  br label %loop

exit:
  br label %wait

wait:
  %again = phi i1 [ false, %exit ], [ true, %wait.latch ]
  br i1 %again, label %fail, label %wait.latch

fail:
  store volatile i32 0, ptr %p, align 4
  unreachable

wait.latch:
  %pos = icmp sgt i32 %i, 0
  br i1 %pos, label %ret, label %wait

ret:
  ret void
}

declare void @use(i32)
