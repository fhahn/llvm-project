; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: opt -passes='default<O3>' -S %s | FileCheck %s

; A strided access loop (`for i in stride(from: 0, to: count, by: 2)`) whose
; index bound check `i < count` is redundant: the loop continues only while
; i + 2 < count, so i stays below count. Constraint elimination derives the
; bound from the inequality latch on the post-increment (which Swift emits as a
; checked add OR-ed with the overflow flag), removing the trap end to end.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"

declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)
declare void @llvm.trap()
declare void @llvm.assume(i1)

define i64 @even_index_sum(ptr %p, i64 %count) {
; CHECK-LABEL: define i64 @even_index_sum(
; CHECK-SAME: ptr nofree readonly captures(none) [[P:%.*]], i64 [[COUNT:%.*]]) local_unnamed_addr #[[ATTR2:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[NN:%.*]] = icmp sgt i64 [[COUNT]], -1
; CHECK-NEXT:    tail call void @llvm.assume(i1 [[NN]])
; CHECK-NEXT:    [[EZ:%.*]] = icmp eq i64 [[COUNT]], 0
; CHECK-NEXT:    br i1 [[EZ]], label %[[EXIT:.*]], label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[ACC:%.*]] = phi i64 [ [[ACC_NEXT:%.*]], %[[BODY]] ], [ 0, %[[ENTRY]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[I_NEXT:%.*]], %[[BODY]] ], [ 0, %[[ENTRY]] ]
; CHECK-NEXT:    [[A:%.*]] = getelementptr inbounds nuw [8 x i8], ptr [[P]], i64 [[I]]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[A]], align 8
; CHECK-NEXT:    [[ACC_NEXT]] = add i64 [[V]], [[ACC]]
; CHECK-NEXT:    [[S:%.*]] = tail call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[I]], i64 2)
; CHECK-NEXT:    [[I_NEXT]] = extractvalue { i64, i1 } [[S]], 0
; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i64, i1 } [[S]], 1
; CHECK-NEXT:    [[EXITC:%.*]] = icmp sge i64 [[I_NEXT]], [[COUNT]]
; CHECK-NEXT:    [[COND:%.*]] = or i1 [[OV]], [[EXITC]]
; CHECK-NEXT:    br i1 [[COND]], label %[[EXIT]], label %[[BODY]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[ACC_NEXT]], %[[BODY]] ]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  %nn = icmp sge i64 %count, 0
  call void @llvm.assume(i1 %nn)
  %ez = icmp eq i64 %count, 0
  br i1 %ez, label %exit, label %ph
ph:
  br label %h
h:
  %acc = phi i64 [ 0, %ph ], [ %acc.next, %latch ]
  %i = phi i64 [ 0, %ph ], [ %i.next, %latch ]
  %oob = icmp ult i64 %i, %count
  br i1 %oob, label %body, label %trap
body:
  %a = getelementptr inbounds i64, ptr %p, i64 %i
  %v = load i64, ptr %a
  %acc.next = add i64 %acc, %v
  br label %latch
latch:
  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %i, i64 2)
  %i.next = extractvalue { i64, i1 } %s, 0
  %ov = extractvalue { i64, i1 } %s, 1
  %exitc = icmp sge i64 %i.next, %count
  %cond = or i1 %ov, %exitc
  br i1 %cond, label %exit, label %h
exit:
  %r = phi i64 [ 0, %entry ], [ %acc.next, %latch ]
  ret i64 %r
trap:
  tail call void @llvm.trap()
  unreachable
}
