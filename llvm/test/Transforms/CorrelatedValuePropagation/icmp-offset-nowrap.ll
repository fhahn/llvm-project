; The symmetric direction: the condition is on %x and the queried value is the
; add. %x >=s 0 shifts to %inc in [1, INT_MAX + 1], which wraps around to
; INT_MIN; the nsw flag rules that value out. Note that the range of an
; 'add nuw nsw' on its own is only 'not 0' - the exact range is not
; representable - so the flags have to be applied to the shifted range here.
define i1 @phi_of_add_nuw_nsw(i32 %x) {
; CHECK-LABEL: define i1 @phi_of_add_nuw_nsw(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[NEG:%.*]] = icmp slt i32 [[X]], 0
; CHECK-NEXT:    [[INC:%.*]] = add nuw nsw i32 [[X]], 1
; CHECK-NEXT:    br i1 [[NEG]], label %[[ZERO:.*]], label %[[NONNEG:.*]]
; CHECK:       [[ZERO]]:
; CHECK-NEXT:    br label %[[JOIN:.*]]
; CHECK:       [[NONNEG]]:
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ 0, %[[ZERO]] ], [ [[INC]], %[[NONNEG]] ]
; CHECK-NEXT:    ret i1 false
;
entry:
  %neg = icmp slt i32 %x, 0
  %inc = add nuw nsw i32 %x, 1
  br i1 %neg, label %zero, label %nonneg

zero:
  br label %join

nonneg:
  br label %join

join:
  %v = phi i32 [ 0, %zero ], [ %inc, %nonneg ]
  %c = icmp slt i32 %v, 0
  ret i1 %c
}

