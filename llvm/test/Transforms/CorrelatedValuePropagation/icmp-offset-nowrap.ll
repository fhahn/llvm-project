; The refined range is only used when it is actually tighter: here the plain
; shift already excludes 4, while intersecting with the no-wrap region would
; have to drop that and exclude INT_MAX instead.
define i1 @clamp_ne_keeps_hole(i32 noundef %a) {
; CHECK-LABEL: define i1 @clamp_ne_keeps_hole(
; CHECK-SAME: i32 noundef [[A:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP:%.*]] = icmp sge i32 [[A]], 5
; CHECK-NEXT:    br i1 [[CMP]], label %[[GUARD:.*]], label %[[OUT:.*]]
; CHECK:       [[GUARD]]:
; CHECK-NEXT:    [[SEL_CMP:%.*]] = icmp eq i32 [[A]], 5
; CHECK-NEXT:    [[DEC:%.*]] = add nsw i32 [[A]], -1
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[SEL_CMP]], i32 5, i32 [[DEC]]
; CHECK-NEXT:    ret i1 false
; CHECK:       [[OUT]]:
; CHECK-NEXT:    ret i1 false
;
entry:
  %cmp = icmp sge i32 %a, 5
  br i1 %cmp, label %guard, label %out

guard:
  %sel_cmp = icmp eq i32 %a, 5
  %dec = add nsw i32 %a, -1
  %sel = select i1 %sel_cmp, i32 5, i32 %dec
  %res = icmp eq i32 %sel, 4
  ret i1 %res

out:
  ret i1 false
}
