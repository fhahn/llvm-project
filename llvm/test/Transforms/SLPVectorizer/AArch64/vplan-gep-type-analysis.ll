; RUN: opt -passes=slp-vectorizer -slp-use-vplan-codegen -S %s | FileCheck %s

; Verify that VPlan codegen handles select+GEP patterns without crashing.
; The GEP opcode must be handled in VPlan type analysis.

target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx11.2.0"

define void @gep_in_vplan_codegen(ptr %pf) {
; CHECK-LABEL: @gep_in_vplan_codegen(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = insertelement <2 x ptr> poison, ptr [[PF:%.*]], i32 0
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <2 x ptr> [[TMP0]], <2 x ptr> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr i8, <2 x ptr> [[TMP1]], <2 x i64> <i64 48, i64 60>
; CHECK-NEXT:    [[ARRAYIDX19:%.*]] = getelementptr i8, ptr [[PF]], i64 144
; CHECK-NEXT:    [[TMP3:%.*]] = select i1 true, <2 x ptr> zeroinitializer, <2 x ptr> [[TMP2]]
; CHECK-NEXT:    store <2 x ptr> [[TMP3]], ptr [[ARRAYIDX19]], align 8
; CHECK-NEXT:    ret void
;
entry:
  %tobool12.not = icmp eq i32 0, 0
  %vel = getelementptr i8, ptr %pf, i64 48
  %cond17 = select i1 %tobool12.not, ptr null, ptr %vel
  %arrayidx19 = getelementptr i8, ptr %pf, i64 144
  store ptr %cond17, ptr %arrayidx19, align 8
  %tobool21.not = icmp eq i32 0, 0
  %rot = getelementptr i8, ptr %pf, i64 60
  %cond26 = select i1 %tobool21.not, ptr null, ptr %rot
  %arrayidx28 = getelementptr i8, ptr %pf, i64 152
  store ptr %cond26, ptr %arrayidx28, align 8
  ret void
}
