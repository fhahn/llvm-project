; VPLAN:       bb1:
; VPLAN-NEXT:    [[E0:%.*]] = extractelement <2 x double> zeroinitializer, i64 0
; VPLAN-NEXT:    [[E1:%.*]] = extractelement <8 x double> zeroinitializer, i64 1
; VPLAN-NEXT:    [[TMP0:%.*]] = insertelement <2 x double> poison, double [[E0]], i32 0
