; A bundle extracting all elements of %v in order reuses %v directly, without
; generating any IR for the extracts themselves.
define void @extractelement_all_lanes_in_order(<4 x float> %v, ptr %dst) {
; CHECK-LABEL: define void @extractelement_all_lanes_in_order(
; CHECK-SAME: <4 x float> [[V:%.*]], ptr [[DST:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = fadd <4 x float> [[V]], splat (float 1.000000e+00)
; CHECK-NEXT:    store <4 x float> [[TMP0]], ptr [[DST]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %e.0 = extractelement <4 x float> %v, i32 0
  %e.1 = extractelement <4 x float> %v, i32 1
  %e.2 = extractelement <4 x float> %v, i32 2
  %e.3 = extractelement <4 x float> %v, i32 3
  %a.0 = fadd float %e.0, 1.0
  %a.1 = fadd float %e.1, 1.0
  %a.2 = fadd float %e.2, 1.0
  %a.3 = fadd float %e.3, 1.0
  store float %a.0, ptr %dst, align 4
  %dst.1 = getelementptr float, ptr %dst, i64 1
  store float %a.1, ptr %dst.1, align 4
  %dst.2 = getelementptr float, ptr %dst, i64 2
  store float %a.2, ptr %dst.2, align 4
  %dst.3 = getelementptr float, ptr %dst, i64 3
  store float %a.3, ptr %dst.3, align 4
  ret void
}

