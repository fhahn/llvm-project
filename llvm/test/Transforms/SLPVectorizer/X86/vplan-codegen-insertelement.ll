; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = insertelement <4 x float> poison, float [[A0]], i64 0
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <4 x float> [[TMP0]], float [[A1]], i64 1
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <4 x float> [[TMP1]], float [[A2]], i64 2
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <4 x float> [[TMP2]], float [[A3]], i64 3
; CHECK-NEXT:    [[TMP4:%.*]] = insertelement <4 x float> poison, float [[B0]], i64 0
; CHECK-NEXT:    [[TMP5:%.*]] = insertelement <4 x float> [[TMP4]], float [[B1]], i64 1
; CHECK-NEXT:    [[TMP6:%.*]] = insertelement <4 x float> [[TMP5]], float [[B2]], i64 2
; CHECK-NEXT:    [[TMP7:%.*]] = insertelement <4 x float> [[TMP6]], float [[B3]], i64 3
; CHECK-NEXT:    [[TMP8:%.*]] = fadd <4 x float> [[TMP3]], [[TMP7]]
; CHECK-NEXT:    ret <4 x float> [[TMP8]]
;
entry:
  %s0 = fadd float %a0, %b0
  %s1 = fadd float %a1, %b1
  %s2 = fadd float %a2, %b2
  %s3 = fadd float %a3, %b3
  %i0 = insertelement <4 x float> poison, float %s0, i32 0
  %i1 = insertelement <4 x float> %i0, float %s1, i32 1
