; CHECK-SAME: <4 x i8> [[P:%.*]], <4 x i8> [[Q:%.*]]) {
; CHECK-NEXT:    [[R:%.*]] = add <4 x i8> [[P]], [[Q]]
; CHECK-NEXT:    ret <4 x i8> [[R]]
