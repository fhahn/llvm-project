; whose flags must not change. The members' nsw is added to %A, making lane 0
; poison for %p = %q = <i8 100, i8 1, i8 2, i8 3>.
define <4 x i8> @nsw_on_existing_source(<4 x i8> %p, <4 x i8> %q) {
; CHECK-LABEL: define <4 x i8> @nsw_on_existing_source(
; CHECK-SAME: <4 x i8> [[P:%.*]], <4 x i8> [[Q:%.*]]) {
; CHECK-NEXT:    [[R:%.*]] = add nsw <4 x i8> [[P]], [[Q]]
; CHECK-NEXT:    ret <4 x i8> [[R]]
;
  %A = add <4 x i8> %p, %q
  %d = call { <2 x i8>, <2 x i8> } @llvm.vector.deinterleave2.v4i8(<4 x i8> %A)
  %a0 = extractvalue { <2 x i8>, <2 x i8> } %d, 0
  %a1 = extractvalue { <2 x i8>, <2 x i8> } %d, 1
  %u0 = add nsw <2 x i8> %a0, zeroinitializer
  %u1 = add nsw <2 x i8> %a1, zeroinitializer
  %r = call <4 x i8> @llvm.vector.interleave2.v4i8(<2 x i8> %u0, <2 x i8> %u1)
  ret <4 x i8> %r
}

