; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=indvars -S %s | FileCheck %s

; %r is {1,+,-2}<nsw> and the exit compares unsigned. %r crosses zero and
; becomes a large unsigned value, so the loop takes its backedge 43 times
; rather than stopping where %l and %r meet over the integers.

define i8 @ult_nsw_rhs_crosses_zero() {
; CHECK-LABEL: define i8 @ult_nsw_rhs_crosses_zero() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[L:%.*]] = phi i8 [ 0, %[[ENTRY]] ], [ [[L_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[R:%.*]] = phi i8 [ 1, %[[ENTRY]] ], [ [[R_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[L_NEXT]] = add nuw i8 [[L]], 4
; CHECK-NEXT:    [[R_NEXT]] = add nsw i8 [[R]], -2
; CHECK-NEXT:    [[EC:%.*]] = icmp ult i8 [[L]], [[R]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[L_LCSSA:%.*]] = phi i8 [ [[L]], %[[LOOP]] ]
; CHECK-NEXT:    ret i8 [[L_LCSSA]]
;
entry:
  br label %loop

loop:
  %l = phi i8 [ 0, %entry ], [ %l.next, %loop ]
  %r = phi i8 [ 1, %entry ], [ %r.next, %loop ]
  %l.next = add nuw i8 %l, 4
  %r.next = add nsw i8 %r, -2
  %ec = icmp ult i8 %l, %r
  br i1 %ec, label %loop, label %exit

exit:
  ret i8 %l
}
