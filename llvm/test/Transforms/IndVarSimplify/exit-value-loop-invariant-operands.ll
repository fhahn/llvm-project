; CHECK:       [[EXIT_2]]:
; CHECK-NEXT:    ret i64 [[TMP0]]
;
entry:
  %sum = add i64 %a, %n
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %q = mul nuw i64 %sum, 3
  %c = icmp eq i64 %iv, %k
