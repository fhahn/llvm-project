target datalayout = "e-m:e-i64:64-n32:64"

; The start of the inner IV is (160 * %outer.iv) | %off. Its SCEV contains the
; outer recurrence {(160 * %start)<u nuw>,+,160}<nuw>, whose start has a
; use-specific flag. The widened lshr has the same canonical SCEV as the
; extended narrow one and should be used.
define void @widen_lshr_use_flags_in_start(i32 %start, i32 %off, i32 %n, ptr %dst) {
; CHECK-LABEL: define void @widen_lshr_use_flags_in_start(
; CHECK-SAME: i32 [[START:%.*]], i32 [[OFF:%.*]], i32 [[N:%.*]], ptr [[DST:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = mul nuw i32 [[START]], 160
; CHECK-NEXT:    [[TMP1:%.*]] = add i32 [[OFF]], [[TMP0]]
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[INDVARS_IV:%.*]] = phi i32 [ [[INDVARS_IV_NEXT:%.*]], %[[OUTER_LATCH:.*]] ], [ [[TMP1]], %[[ENTRY]] ]
; CHECK-NEXT:    [[OUTER_IV:%.*]] = phi i32 [ [[START]], %[[ENTRY]] ], [ [[OUTER_IV_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    [[MUL:%.*]] = mul nuw i32 [[OUTER_IV]], 160
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[MUL]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[INNER_PREHEADER:.*]], label %[[OUTER_LATCH]]
; CHECK:       [[INNER_PREHEADER]]:
; CHECK-NEXT:    [[INDVARS_IV_LCSSA:%.*]] = phi i32 [ [[INDVARS_IV]], %[[OUTER_HEADER]] ]
; CHECK-NEXT:    [[TMP2:%.*]] = zext i32 [[INDVARS_IV_LCSSA]] to i64
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[INDVARS_IV1:%.*]] = phi i64 [ [[TMP2]], %[[INNER_PREHEADER]] ], [ [[INDVARS_IV_NEXT2:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[HALF_EXT:%.*]] = lshr i64 [[INDVARS_IV1]], 1
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr i8, ptr [[DST]], i64 [[HALF_EXT]]
; CHECK-NEXT:    store i8 0, ptr [[GEP]], align 1
; CHECK-NEXT:    [[INDVARS_IV_NEXT2]] = add nuw nsw i64 [[INDVARS_IV1]], 2
; CHECK-NEXT:    [[TMP4:%.*]] = trunc nuw i64 [[INDVARS_IV_NEXT2]] to i32
; CHECK-NEXT:    [[EC:%.*]] = icmp slt i32 [[TMP4]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[INNER]], label %[[EXIT:.*]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[OUTER_IV_NEXT]] = add nuw i32 [[OUTER_IV]], 1
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add i32 [[INDVARS_IV]], 160
; CHECK-NEXT:    br label %[[OUTER_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer.header

outer.header:
  %outer.iv = phi i32 [ %start, %entry ], [ %outer.iv.next, %outer.latch ]
  %mul = mul nuw i32 %outer.iv, 160
  %inner.start = or disjoint i32 %mul, %off
  %c = icmp slt i32 %mul, 0
  br i1 %c, label %inner, label %outer.latch

inner:
  %iv = phi i32 [ %inner.start, %outer.header ], [ %iv.next, %inner ]
  %half = lshr i32 %iv, 1
  %half.ext = zext i32 %half to i64
  %gep = getelementptr i8, ptr %dst, i64 %half.ext
  store i8 0, ptr %gep, align 1
  %iv.next = add nuw nsw i32 %iv, 2
  %ec = icmp slt i32 %iv.next, %n
  br i1 %ec, label %inner, label %exit

outer.latch:
  %outer.iv.next = add nuw i32 %outer.iv, 1
  br label %outer.header

exit:
  ret void
}
