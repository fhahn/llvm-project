; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='loop(indvars)' -S < %s | FileCheck %s
;
; Reduced from CTMark ClamAV/zlib_inflate.c. Probing the unrelated pointer
; guard fails to prove %inc < %limit, but strengthens the post-increment
; addrec from <nw> to <nuw>. Preserve the resulting widening of the exit
; comparison. The merge requires the dominator-tree walk; the early exit
; makes this a loop with multiple exits.
;
target datalayout = "e-m:e-p:64:64-i64:64-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define void @unsigned_exit(ptr %guard.ptr, i1 %choose, i32 %start, i32 %limit, ptr %out, i1 %stop) {
; CHECK-LABEL: define void @unsigned_exit(
; CHECK-SAME: ptr [[GUARD_PTR:%.*]], i1 [[CHOOSE:%.*]], i32 [[START:%.*]], i32 [[LIMIT:%.*]], ptr [[OUT:%.*]], i1 [[STOP:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[GUARD:%.*]] = icmp eq ptr [[GUARD_PTR]], null
; CHECK-NEXT:    br i1 [[GUARD]], label %[[EXIT:.*]], label %[[DISPATCH:.*]]
; CHECK:       [[DISPATCH]]:
; CHECK-NEXT:    br i1 [[CHOOSE]], label %[[MERGE:.*]], label %[[CHECK:.*]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    br label %[[CHECK]]
; CHECK:       [[CHECK]]:
; CHECK-NEXT:    [[ENTER:%.*]] = icmp ult i32 [[START]], [[LIMIT]]
; CHECK-NEXT:    br i1 [[ENTER]], label %[[LOOP_PREHEADER:.*]], label %[[EXIT]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = zext i32 [[START]] to i64
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[INDVARS_IV:%.*]] = phi i64 [ [[TMP0]], %[[LOOP_PREHEADER]] ], [ [[INDVARS_IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    br i1 [[STOP]], label %[[EXIT_LOOPEXIT:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add nuw nsw i64 [[INDVARS_IV]], 1
; CHECK-NEXT:    [[ADDR:%.*]] = getelementptr i8, ptr [[OUT]], i64 [[INDVARS_IV]]
; CHECK-NEXT:    store i8 0, ptr [[ADDR]], align 1
; CHECK-NEXT:    [[LFTR_WIDEIV:%.*]] = trunc i64 [[INDVARS_IV_NEXT]] to i32
; CHECK-NEXT:    [[EXITCOND:%.*]] = icmp ne i32 [[LFTR_WIDEIV]], [[LIMIT]]
; CHECK-NEXT:    br i1 [[EXITCOND]], label %[[LOOP]], label %[[EXIT_LOOPEXIT]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard = icmp eq ptr %guard.ptr, null
  br i1 %guard, label %exit, label %dispatch

dispatch:
  br i1 %choose, label %merge, label %check

merge:
  br label %check

check:
  %enter = icmp ult i32 %start, %limit
  br i1 %enter, label %loop, label %exit

loop:
  %iv = phi i32 [ %start, %check ], [ %inc, %latch ]
  br i1 %stop, label %exit, label %latch

latch:
  %inc = add nuw i32 %iv, 1
  %wide = zext i32 %iv to i64
  %addr = getelementptr i8, ptr %out, i64 %wide
  store i8 0, ptr %addr
  %continue = icmp ult i32 %inc, %limit
  br i1 %continue, label %loop, label %exit

exit:
  ret void
}
