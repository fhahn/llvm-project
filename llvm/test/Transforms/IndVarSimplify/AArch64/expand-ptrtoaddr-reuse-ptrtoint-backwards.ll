; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='indvars' -S %s | FileCheck %s

; When IndVarSimplify rewrites the exit value of a backward-counting loop via
; SCEVExpander, the expander materializes the offset addr(%bound) - addr(%start).
; For a pointer that has no reusable ptrtoint at the expansion point, the expander
; emits ptrtoaddr. That ptrtoaddr does not CSE with a later ptrtoint of the same
; pointer, so the pointer can end up converted by both opcodes. This is the
; IndVarSimplify-level trigger for the redundancy seen at -O2 (see the
; PhaseOrdering/X86 companion test).

target triple = "arm64-apple-macosx"

define i64 @f(ptr %start, ptr %bound) {
; CHECK-LABEL: define i64 @f(
; CHECK-SAME: ptr [[START:%.*]], ptr [[BOUND:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[START3:%.*]] = ptrtoint ptr [[START]] to i64
; CHECK-NEXT:    [[BOUND2:%.*]] = ptrtoint ptr [[BOUND]] to i64
; CHECK-NEXT:    [[TMP0:%.*]] = sub i64 [[BOUND2]], [[START3]]
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[START]], i64 [[TMP0]]
; CHECK-NEXT:    br label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[START]], %[[ENTRY]] ], [ [[PN:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[C:%.*]] = load i8, ptr [[P]], align 1
; CHECK-NEXT:    [[ISC:%.*]] = icmp slt i8 [[C]], -64
; CHECK-NEXT:    br i1 [[ISC]], label %[[LATCH]], label %[[EXIT_BYTE:.*]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[PN]] = getelementptr inbounds i8, ptr [[P]], i64 -1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq ptr [[PN]], [[BOUND]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT_BOUND:.*]], label %[[BODY]]
; CHECK:       [[EXIT_BYTE]]:
; CHECK-NEXT:    [[P_LCSSA:%.*]] = phi ptr [ [[P]], %[[BODY]] ]
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT_BOUND]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[FINAL:%.*]] = phi ptr [ [[P_LCSSA]], %[[EXIT_BYTE]] ], [ [[SCEVGEP]], %[[EXIT_BOUND]] ]
; CHECK-NEXT:    [[FI:%.*]] = ptrtoint ptr [[FINAL]] to i64
; CHECK-NEXT:    [[BI:%.*]] = ptrtoint ptr [[BOUND]] to i64
; CHECK-NEXT:    [[LEN:%.*]] = sub i64 [[FI]], [[BI]]
; CHECK-NEXT:    ret i64 [[LEN]]
;
entry:
  br label %body

body:
  %p = phi ptr [ %start, %entry ], [ %pn, %latch ]
  %c = load i8, ptr %p, align 1
  %isc = icmp slt i8 %c, -64
  br i1 %isc, label %latch, label %exit.byte

latch:
  %pn = getelementptr inbounds i8, ptr %p, i64 -1
  %done = icmp eq ptr %pn, %bound
  br i1 %done, label %exit.bound, label %body

exit.byte:
  br label %exit

exit.bound:
  br label %exit

exit:
  %final = phi ptr [ %p, %exit.byte ], [ %pn, %exit.bound ]
  %fi = ptrtoint ptr %final to i64
  %bi = ptrtoint ptr %bound to i64
  %len = sub i64 %fi, %bi
  ret i64 %len
}
