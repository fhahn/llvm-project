; Negative test: the unanalyzable exit is a normal exit, so it does not just
; shorten the loop -- it may fire before the symbolic upper bound is reached.
; Predicating the trap exit against that bound could turn a clean return into a
; trap, so nothing is rewritten even with -indvars-allow-reorder-traps.
define i64 @no_predicate_unanalyzable_normal_exit(ptr %a, i64 %limit) {
;
; CHECK-LABEL: define i64 @no_predicate_unanalyzable_normal_exit(
