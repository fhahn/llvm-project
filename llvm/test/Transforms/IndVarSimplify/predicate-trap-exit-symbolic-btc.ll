; CHECK-NEXT:    unreachable
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret i64 7
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %latch ]
  %oob = icmp eq i64 %i, %limit
  br i1 %oob, label %trap, label %body

body:
  %p = getelementptr i64, ptr %a, i64 %i
