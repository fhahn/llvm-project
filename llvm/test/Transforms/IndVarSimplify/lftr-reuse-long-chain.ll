; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=indvars -S %s | FileCheck %s

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

; The exit count is computed by %tc. Make sure LFTR reuses it instead of
; expanding the whole sum again.
define i64 @reuse_long_sum(i32 %a, i8 %x, i8 %y, ptr %p) {
; CHECK-LABEL: define i64 @reuse_long_sum(
; CHECK-SAME: i32 [[A:%.*]], i8 [[X:%.*]], i8 [[Y:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[L0:%.*]] = load i8, ptr [[P]], align 1
; CHECK-NEXT:    [[Z0:%.*]] = zext i8 [[L0]] to i32
; CHECK-NEXT:    [[ZX:%.*]] = zext i8 [[X]] to i32
; CHECK-NEXT:    [[ZY:%.*]] = zext i8 [[Y]] to i32
; CHECK-NEXT:    [[L1:%.*]] = load i8, ptr [[P]], align 1
; CHECK-NEXT:    [[Z1:%.*]] = zext i8 [[L1]] to i32
; CHECK-NEXT:    store volatile i32 0, ptr [[P]], align 4
; CHECK-NEXT:    [[TMP0:%.*]] = add i32 [[A]], [[Z0]]
; CHECK-NEXT:    [[TMP1:%.*]] = add i32 [[TMP0]], [[Z1]]
; CHECK-NEXT:    [[TMP2:%.*]] = add i32 [[TMP1]], [[ZY]]
; CHECK-NEXT:    [[TMP3:%.*]] = add i32 [[TMP2]], [[ZX]]
; CHECK-NEXT:    [[TMP4:%.*]] = add i32 [[TMP3]], 1
; CHECK-NEXT:    [[TMP5:%.*]] = zext i32 [[TMP4]] to i64
; CHECK-NEXT:    [[TMP6:%.*]] = add nuw nsw i64 [[TMP5]], 1
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[IV_NEXT:%.*]], %[[LOOP]] ], [ 0, %[[ENTRY]] ]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EXITCOND:%.*]] = icmp ne i64 [[IV_NEXT]], [[TMP6]]
; CHECK-NEXT:    br i1 [[EXITCOND]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i64 [ 0, %[[LOOP]] ]
; CHECK-NEXT:    ret i64 [[RES]]
;
entry:
  %l0 = load i8, ptr %p
  %a.0 = add i32 0, %a
  %z0 = zext i8 %l0 to i32
  %s0 = add i32 %a.0, %z0
  %zx = zext i8 %x to i32
  %s1 = add i32 %s0, %zx
  %zy = zext i8 %y to i32
  %s2 = add i32 %s1, %zy
  %l1 = load i8, ptr %p
  %z1 = zext i8 %l1 to i32
  %s3 = add i32 %s2, %z1
  %sum.inc = add i32 %s3, 1
  %tc = zext i32 %sum.inc to i64
  store volatile i32 0, ptr %p
  br label %loop

loop:
  %iv = phi i64 [ %iv.next, %loop ], [ 0, %entry ]
  %iv.next = add i64 %iv, 1
  %ec = icmp ult i64 %iv, %tc
  br i1 %ec, label %loop, label %exit

exit:
  %res = phi i64 [ 0, %loop ]
  ret i64 %res
}
