; Only the first loop's recurrence is inbounds; the second loop's pointer is
; advanced by a plain GEP, so no `nuw` may be inferred for its exit value.
define ptr @two_loops_only_first_inbounds(ptr %p, i64 %n) {
; CHECK-LABEL: define ptr @two_loops_only_first_inbounds(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP1:.*]]
; CHECK:       [[LOOP1]]:
; CHECK-NEXT:    br i1 true, label %[[BETWEEN:.*]], label %[[LOOP1]]
; CHECK:       [[BETWEEN]]:
; CHECK-NEXT:    br label %[[LOOP2:.*]]
; CHECK:       [[LOOP2]]:
; CHECK-NEXT:    br i1 true, label %[[EXIT:.*]], label %[[LOOP2]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = shl i64 [[N]], 1
; CHECK-NEXT:    [[SCEVGEP1:%.*]] = getelementptr i8, ptr [[P]], i64 [[TMP0]]
; CHECK-NEXT:    ret ptr [[SCEVGEP1]]
;
entry:
  br label %loop1

loop1:
  %ptr1 = phi ptr [ %p, %entry ], [ %inc1, %loop1 ]
  %iv1 = phi i64 [ 0, %entry ], [ %iv1.next, %loop1 ]
  %inc1 = getelementptr inbounds nuw i8, ptr %ptr1, i64 1
  %iv1.next = add nuw nsw i64 %iv1, 1
  %cond1 = icmp eq i64 %iv1.next, %n
  br i1 %cond1, label %between, label %loop1

between:
  br label %loop2

loop2:
  %ptr2 = phi ptr [ %inc1, %between ], [ %inc2, %loop2 ]
  %iv2 = phi i64 [ 0, %between ], [ %iv2.next, %loop2 ]
  %inc2 = getelementptr i8, ptr %ptr2, i64 1
  %iv2.next = add nuw nsw i64 %iv2, 1
  %cond2 = icmp eq i64 %iv2.next, %n
  br i1 %cond2, label %exit, label %loop2

exit:
  ret ptr %inc2
}

