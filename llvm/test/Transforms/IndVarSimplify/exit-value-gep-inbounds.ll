; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = mul i64 [[N]], [[STEP]]
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[P]], i64 [[TMP0]]
; CHECK-NEXT:    ret ptr [[SCEVGEP]]
;
entry:
