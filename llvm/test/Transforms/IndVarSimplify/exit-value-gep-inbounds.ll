; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='loop(indvars)' -verify-scev -S %s | FileCheck %s
;
; Verify that the use-specific no-wrap flags attached to cached at-scope
; expressions are tracked and invalidated correctly. Running indvars (which
; creates flagged at-scope entries) followed by loop-deletion (which forgets
; the now-dead loops) exercises the SCEV invalidation path; SCEV verification
; must not trip over stale flagged entries.
; RUN: opt -passes='loop-mssa(indvars,loop-deletion)' -verify-scev -disable-output %s

;------------------------------------------------------------------------------
; Category 1: use-specific NUW is preserved on the rewritten exit value.
;
; The pointer recurrence has a SCEVUnknown start (the base is indexed directly
; by the induction variable, so the offset relative to the base is 0). With a
; non-negative step, the closed form base + BTC*Step cannot unsigned-wrap
; relative to the base, so the exit-value GEP keeps `nuw`.
;------------------------------------------------------------------------------

define ptr @unknown_start_inbounds(ptr %p, i64 %n) {
; CHECK-LABEL: define ptr @unknown_start_inbounds(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    br i1 true, label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[N]], -1
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr nuw i8, ptr [[P]], i64 [[TMP0]]
; CHECK-NEXT:    ret ptr [[SCEVGEP]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %inc = getelementptr inbounds nuw i8, ptr %p, i64 %iv
  %iv.next = add nuw nsw i64 %iv, 1
  %cond = icmp eq i64 %iv.next, %n
  br i1 %cond, label %exit, label %loop

exit:
  ret ptr %inc
}

define ptr @unknown_start_nonneg_step(ptr %p, i64 %n, i32 %s) {
; CHECK-LABEL: define ptr @unknown_start_nonneg_step(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]], i32 [[S:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    br i1 true, label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[STEP:%.*]] = zext i32 [[S]] to i64
; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[N]], -1
; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[TMP0]], [[STEP]]
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr nuw i8, ptr [[P]], i64 [[TMP1]]
; CHECK-NEXT:    ret ptr [[SCEVGEP]]
;
entry:
  %step = zext i32 %s to i64
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %offset = mul nuw nsw i64 %iv, %step
  %inc = getelementptr inbounds nuw i8, ptr %p, i64 %offset
  %iv.next = add nuw nsw i64 %iv, 1
  %cond = icmp eq i64 %iv.next, %n
  br i1 %cond, label %exit, label %loop

exit:
  ret ptr %inc
}

;------------------------------------------------------------------------------
; A loop-invariant `nuw` GEP whose base SCEVUnknown is defined inside the loop.
; Its at-scope value is a flagged SCEVAddExpr ((iv-addrec) + %base)(u nuw).
; getSCEVAtScope drops the use-flags from such a non-AddRec expression, so the
; ValuesAtScopes cache stays keyed on the canonical SCEV and -verify-scev does
; not trip. The GEP stays in the loop and is not rewritten, so no `nuw` is
; materialized on a hoisted value.
define ptr @flagged_addexpr_at_scope_key() {
; CHECK-LABEL: define ptr @flagged_addexpr_at_scope_key() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[BASE:%.*]] = inttoptr i64 -1 to ptr
; CHECK-NEXT:    [[INC:%.*]] = getelementptr nuw i8, ptr [[BASE]], i64 [[IV]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[IV_NEXT]], 4
; CHECK-NEXT:    br i1 [[C]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[INC_LCSSA:%.*]] = phi ptr [ [[INC]], %[[LOOP]] ]
; CHECK-NEXT:    ret ptr [[INC_LCSSA]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %base = inttoptr i64 -1 to ptr
  %inc = getelementptr nuw i8, ptr %base, i64 %iv
  %iv.next = add nuw nsw i64 %iv, 1
  %c = icmp eq i64 %iv.next, 4
  br i1 %c, label %exit, label %loop

exit:
  ret ptr %inc
}

;------------------------------------------------------------------------------
; Category 2: the rewrite is sound, but the use-specific NUW could only be
; preserved if the SCEVAddExpr start were known not to unsigned-wrap relative
; to the base. The start has a known non-negative offset here, so preserving
; NUW would be valid, but SCEV cannot represent the start's no-wrap flag yet,
; so the flag is conservatively dropped. These should gain `nuw` once
; SCEVAddExpr starts carry a use-specific no-wrap flag.
; TODO: Restore `nuw` on the exit-value GEP for these cases.
;------------------------------------------------------------------------------

define ptr @pointer_advance_inbounds(ptr %p, i64 %n) {
; CHECK-LABEL: define ptr @pointer_advance_inbounds(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    br i1 true, label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[P]], i64 [[N]]
; CHECK-NEXT:    ret ptr [[SCEVGEP]]
;
entry:
  br label %loop

loop:
  %ptr = phi ptr [ %p, %entry ], [ %inc, %loop ]
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %inc = getelementptr inbounds nuw i8, ptr %ptr, i64 1
  %iv.next = add nuw nsw i64 %iv, 1
  %cond = icmp eq i64 %iv.next, %n
  br i1 %cond, label %exit, label %loop

exit:
  ret ptr %inc
}

