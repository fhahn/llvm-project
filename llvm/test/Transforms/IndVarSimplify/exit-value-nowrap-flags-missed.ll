; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -O3 -S < %s | FileCheck %s

; Missed optimisations in the IR the exit-value rewrite produces, checked at the
; IR level so that the flags are visible as instruction flags. Both flags below
; are valid; SCEV just does not attach them. See
; exit-value-nowrap-flags-missed.ll in Analysis/, and
; exit-value-nowrap-flags.ll for the shapes that do work.

; FIXME: %{{.*}} = mul i64 %{{.*}}, 24 should be "mul nuw": it is the
; (backedge-taken count * step) term of a nuw pointer recurrence's exit value,
; and only the sum around it gets a flag.
define ptr @exit_value_mul_drops_nuw(ptr %first, ptr %last) {
; CHECK-LABEL: @exit_value_mul_drops_nuw(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[C0:%.*]] = icmp ult ptr [[FIRST:%.*]], [[LAST:%.*]]
; CHECK-NEXT:    br i1 [[C0]], label [[LOOP_PREHEADER:%.*]], label [[COMMON_RET:%.*]]
; CHECK:       loop.preheader:
; CHECK-NEXT:    [[LAST1:%.*]] = ptrtoaddr ptr [[LAST]] to i64
; CHECK-NEXT:    [[FIRST2:%.*]] = ptrtoaddr ptr [[FIRST]] to i64
; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[FIRST2]], 24
; CHECK-NEXT:    [[UMAX:%.*]] = tail call i64 @llvm.umax.i64(i64 [[LAST1]], i64 [[TMP0]])
; CHECK-NEXT:    [[TMP1:%.*]] = add i64 [[UMAX]], -24
; CHECK-NEXT:    [[TMP2:%.*]] = icmp ne i64 [[TMP1]], [[FIRST2]]
; CHECK-NEXT:    [[UMIN:%.*]] = zext i1 [[TMP2]] to i64
; CHECK-NEXT:    [[TMP3:%.*]] = add i64 [[FIRST2]], [[UMIN]]
; CHECK-NEXT:    [[TMP4:%.*]] = sub i64 [[TMP1]], [[TMP3]]
; CHECK-NEXT:    [[TMP5:%.*]] = udiv i64 [[TMP4]], 24
; CHECK-NEXT:    [[TMP6:%.*]] = add nuw nsw i64 [[TMP5]], [[UMIN]]
; CHECK-NEXT:    [[TMP7:%.*]] = mul i64 [[TMP6]], 24
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr nuw i8, ptr [[FIRST]], i64 [[TMP7]]
; CHECK-NEXT:    br label [[COMMON_RET]]
; CHECK:       common.ret:
; CHECK-NEXT:    [[COMMON_RET_OP:%.*]] = phi ptr [ [[FIRST]], [[ENTRY:%.*]] ], [ [[SCEVGEP]], [[LOOP_PREHEADER]] ]
; CHECK-NEXT:    ret ptr [[COMMON_RET_OP]]
;
entry:
  %c0 = icmp ult ptr %first, %last
  br i1 %c0, label %loop, label %done

loop:
  %p = phi ptr [ %first, %entry ], [ %p.next, %loop ]
  %p.next = getelementptr inbounds nuw i8, ptr %p, i64 24
  %c = icmp ult ptr %p.next, %last
  br i1 %c, label %loop, label %exit

exit:
  %lc = phi ptr [ %p, %loop ]
  ret ptr %lc

done:
  ret ptr %first
}
