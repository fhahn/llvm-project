; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -O3 -S < %s | FileCheck %s

; Missed optimisations in the IR the exit-value rewrite produces, checked at the
; IR level because the SCEV printer only renders the flags of the outermost use,
; not those of an operand. Both flags below are valid; SCEV just does not carry
; them far enough. See exit-value-nowrap-flags-missed.ll in Analysis/, and
; exit-value-nowrap-flags.ll for the shapes that do work.

; FIXME: %{{.*}} = mul i64 %{{.*}}, 24 should be "mul nuw": it is the
; (backedge-taken count * step) term of a nuw pointer recurrence's exit value.
define ptr @exit_value_mul_drops_nuw(ptr %first, ptr %last) {
; CHECK-LABEL: @exit_value_mul_drops_nuw(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[C0:%.*]] = icmp ult ptr [[FIRST:%.*]], [[LAST:%.*]]
; CHECK-NEXT:    br i1 [[C0]], label [[LOOP_PREHEADER:%.*]], label [[COMMON_RET:%.*]]
; CHECK:       loop.preheader:
; CHECK-NEXT:    [[LAST1:%.*]] = ptrtoaddr ptr [[LAST]] to i64
; CHECK-NEXT:    [[FIRST2:%.*]] = ptrtoaddr ptr [[FIRST]] to i64
; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[FIRST2]], 24
; CHECK-NEXT:    [[UMAX:%.*]] = tail call i64 @llvm.umax.i64(i64 [[LAST1]], i64 [[TMP0]])
; CHECK-NEXT:    [[TMP1:%.*]] = add i64 [[UMAX]], -24
; CHECK-NEXT:    [[TMP2:%.*]] = icmp ne i64 [[TMP1]], [[FIRST2]]
; CHECK-NEXT:    [[UMIN:%.*]] = zext i1 [[TMP2]] to i64
; CHECK-NEXT:    [[TMP3:%.*]] = add i64 [[FIRST2]], [[UMIN]]
; CHECK-NEXT:    [[TMP4:%.*]] = sub i64 [[TMP1]], [[TMP3]]
; CHECK-NEXT:    [[TMP5:%.*]] = udiv i64 [[TMP4]], 24
; CHECK-NEXT:    [[TMP6:%.*]] = add nuw nsw i64 [[TMP5]], [[UMIN]]
; CHECK-NEXT:    [[TMP7:%.*]] = mul i64 [[TMP6]], 24
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr nuw i8, ptr [[FIRST]], i64 [[TMP7]]
; CHECK-NEXT:    br label [[COMMON_RET]]
; CHECK:       common.ret:
; CHECK-NEXT:    [[COMMON_RET_OP:%.*]] = phi ptr [ [[FIRST]], [[ENTRY:%.*]] ], [ [[SCEVGEP]], [[LOOP_PREHEADER]] ]
; CHECK-NEXT:    ret ptr [[COMMON_RET_OP]]
;
entry:
  %c0 = icmp ult ptr %first, %last
  br i1 %c0, label %loop, label %done

loop:
  %p = phi ptr [ %first, %entry ], [ %p.next, %loop ]
  %p.next = getelementptr inbounds nuw i8, ptr %p, i64 24
  %c = icmp ult ptr %p.next, %last
  br i1 %c, label %loop, label %exit

exit:
  %lc = phi ptr [ %p, %loop ]
  ret ptr %lc

done:
  ret ptr %first
}

; FIXME: the "add i64 %i.0.lcssa, 4" feeding the second loop's trip count should
; be "add nuw": %i.0 is a non-negative nsw recurrence starting at 0.
define i1 @exit_value_feeds_second_loop(i64 %depth, i64 %rows, i1 %c) {
; CHECK-LABEL: @exit_value_feeds_second_loop(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[SUB:%.*]] = sub i64 [[ROWS:%.*]], [[DEPTH:%.*]]
; CHECK-NEXT:    [[CMP154:%.*]] = icmp sgt i64 [[SUB]], 0
; CHECK-NEXT:    br i1 [[CMP154]], label [[LOOP1_BODY_LR_PH:%.*]], label [[LOOP2_PREHEADER:%.*]]
; CHECK:       loop1.body.lr.ph:
; CHECK-NEXT:    br i1 [[C:%.*]], label [[COMMON_RET:%.*]], label [[LOOP2_PREHEADER_THREAD:%.*]]
; CHECK:       loop2.preheader:
; CHECK-NEXT:    [[CMP366:%.*]] = icmp sgt i64 [[ROWS]], 0
; CHECK-NEXT:    br i1 [[CMP366]], label [[LOOP2_BODY_LR_PH:%.*]], label [[EXIT:%.*]]
; CHECK:       loop2.preheader.thread:
; CHECK-NEXT:    [[TMP0:%.*]] = xor i64 [[DEPTH]], -1
; CHECK-NEXT:    [[TMP1:%.*]] = add i64 [[ROWS]], [[TMP0]]
; CHECK-NEXT:    [[DOTFR:%.*]] = freeze i64 [[TMP1]]
; CHECK-NEXT:    [[TMP2:%.*]] = urem i64 [[DOTFR]], 6
; CHECK-NEXT:    [[TMP3:%.*]] = sub nuw i64 [[DOTFR]], [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = add nuw nsw i64 [[TMP3]], 6
; CHECK-NEXT:    [[CMP36610:%.*]] = icmp slt i64 [[TMP4]], [[ROWS]]
; CHECK-NEXT:    br i1 [[CMP36610]], label [[LOOP2_BODY_PREHEADER:%.*]], label [[EXIT]]
; CHECK:       loop2.body.lr.ph:
; CHECK-NEXT:    br i1 [[C]], label [[COMMON_RET]], label [[LOOP2_BODY_PREHEADER]]
; CHECK:       loop2.body.preheader:
; CHECK-NEXT:    [[I_0_LCSSA1113:%.*]] = phi i64 [ 0, [[LOOP2_BODY_LR_PH]] ], [ [[TMP4]], [[LOOP2_PREHEADER_THREAD]] ]
; CHECK-NEXT:    [[TMP5:%.*]] = add i64 [[I_0_LCSSA1113]], 4
; CHECK-NEXT:    [[SMAX:%.*]] = tail call i64 @llvm.smax.i64(i64 [[ROWS]], i64 [[TMP5]])
; CHECK-NEXT:    [[TMP6:%.*]] = xor i64 [[I_0_LCSSA1113]], -1
; CHECK-NEXT:    [[TMP7:%.*]] = add i64 [[SMAX]], [[TMP6]]
; CHECK-NEXT:    [[TMP8:%.*]] = and i64 [[TMP7]], -4
; CHECK-NEXT:    [[TMP9:%.*]] = add i64 [[I_0_LCSSA1113]], [[TMP8]]
; CHECK-NEXT:    [[TMP10:%.*]] = add i64 [[TMP9]], 4
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       common.ret:
; CHECK-NEXT:    [[COMMON_RET_OP:%.*]] = phi i1 [ [[CMP82:%.*]], [[EXIT]] ], [ false, [[LOOP2_BODY_LR_PH]] ], [ false, [[LOOP1_BODY_LR_PH]] ]
; CHECK-NEXT:    ret i1 [[COMMON_RET_OP]]
; CHECK:       exit:
; CHECK-NEXT:    [[I_1_LCSSA:%.*]] = phi i64 [ 0, [[LOOP2_PREHEADER]] ], [ [[TMP10]], [[LOOP2_BODY_PREHEADER]] ], [ [[TMP4]], [[LOOP2_PREHEADER_THREAD]] ]
; CHECK-NEXT:    [[CMP82]] = icmp slt i64 [[I_1_LCSSA]], [[DEPTH]]
; CHECK-NEXT:    br label [[COMMON_RET]]
;
entry:
  br label %loop1

loop1:
  %i.0 = phi i64 [ 0, %entry ], [ %add33, %loop1.latch ]
  %sub = sub i64 %rows, %depth
  %cmp15 = icmp slt i64 %i.0, %sub
  br i1 %cmp15, label %loop1.body, label %loop2

loop1.body:
  br i1 %c, label %ret, label %loop1.latch

loop1.latch:
  %add33 = add nsw i64 %i.0, 6
  br label %loop1

loop2:
  %i.1 = phi i64 [ %i.0, %loop1 ], [ %add59, %loop2.latch ]
  %cmp36 = icmp slt i64 %i.1, %rows
  br i1 %cmp36, label %loop2.body, label %exit

loop2.body:
  br i1 %c, label %ret, label %loop2.latch

loop2.latch:
  %add59 = add nsw i64 %i.1, 4
  br label %loop2

exit:
  %cmp82 = icmp slt i64 %i.1, %depth
  ret i1 %cmp82

ret:
  ret i1 false
}
