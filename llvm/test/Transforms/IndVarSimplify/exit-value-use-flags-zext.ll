; CHECK-NEXT:    [[INDVARS_IV:%.*]] = phi i9 [ [[INDVARS_IV_NEXT:%.*]], %[[OUTER_LATCH:.*]] ], [ 0, %[[ENTRY]] ]
; CHECK-NEXT:    [[OUTER_IV:%.*]] = phi i8 [ 0, %[[ENTRY]] ], [ [[OUTER_IV_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    [[IV_I10:%.*]] = phi i10 [ 0, %[[ENTRY]] ], [ [[IV_I10_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    [[IV_I32:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_I32_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    br i1 [[C]], label %[[INNER_PREHEADER:.*]], label %[[OUTER_LATCH]]
; CHECK:       [[INNER_PREHEADER]]:
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[INNER_IV:%.*]] = phi i8 [ [[INNER_IV_NEXT:%.*]], %[[INNER]] ], [ 0, %[[INNER_PREHEADER]] ]
; CHECK-NEXT:    [[UMIN:%.*]] = call i8 @llvm.umin.i8(i8 [[INNER_IV]], i8 [[A]])
; CHECK-NEXT:    [[ADD:%.*]] = add nuw i8 [[UMIN]], -128
; CHECK-NEXT:    [[DIV:%.*]] = udiv i8 1, [[ADD]]
; CHECK-NEXT:    [[INNER_IV_NEXT]] = add i8 [[INNER_IV]], 1
; CHECK-NEXT:    br i1 true, label %[[INNER_EXIT:.*]], label %[[INNER]]
; CHECK:       [[INNER_EXIT]]:
; CHECK-NEXT:    store i9 [[INDVARS_IV]], ptr [[P]], align 2
; CHECK-NEXT:    store i10 [[IV_I10]], ptr [[Q]], align 2
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[IV_I10_EXT:%.*]] = sext i10 [[IV_I10]] to i32
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[IV_I10_EXT]], [[IV_I32]]
; CHECK-NEXT:    [[IV_I10_NEXT]] = add nuw i10 [[IV_I10]], [[X_I10]]
; CHECK-NEXT:    [[IV_I32_NEXT]] = add nuw nsw i32 [[IV_I32]], [[X_I32]]
; CHECK-NEXT:    [[OUTER_IV_NEXT]] = add nuw nsw i8 [[OUTER_IV]], 1
; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp eq i8 [[OUTER_IV_NEXT]], 4
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add i9 [[INDVARS_IV]], [[TMP0]]
; CHECK-NEXT:    br i1 [[OUTER_EC]], label %[[EXIT:.*]], label %[[OUTER_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[CMP_LCSSA:%.*]] = phi i1 [ [[CMP]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    ret i1 [[CMP_LCSSA]]
;
entry:
  %x.i10 = zext i8 %x to i10
  %x.i32 = zext i8 %x to i32
  br label %outer.header

outer.header:
  %outer.iv = phi i8 [ 0, %entry ], [ %outer.iv.next, %outer.latch ]
  %iv.i10 = phi i10 [ 0, %entry ], [ %iv.i10.next, %outer.latch ]
  %iv.i32 = phi i32 [ 0, %entry ], [ %iv.i32.next, %outer.latch ]
  br i1 %c, label %inner, label %outer.latch

inner:
  %inner.iv = phi i8 [ 0, %outer.header ], [ %inner.iv.next, %inner ]
  %umin = call i8 @llvm.umin.i8(i8 %inner.iv, i8 %a)
  %add = add nuw i8 %umin, -128
  %div = udiv i8 1, %add
  %umin.x = call i8 @llvm.umin.i8(i8 %add, i8 %x)
  %mul = mul i8 %outer.iv, %umin.x
  %ext.1 = sext i8 %mul to i9
  %ext.2 = sext i8 %mul to i10
  %inner.iv.next = add i8 %inner.iv, 1
  %inner.ec = icmp eq i8 %inner.iv.next, 0
  br i1 %inner.ec, label %inner.exit, label %inner

inner.exit:
  %ext.1.lcssa = phi i9 [ %ext.1, %inner ]
  %ext.2.lcssa = phi i10 [ %ext.2, %inner ]
  store i9 %ext.1.lcssa, ptr %p
  store i10 %ext.2.lcssa, ptr %q
  br label %outer.latch

outer.latch:
  %iv.i10.ext = sext i10 %iv.i10 to i32
  %cmp = icmp eq i32 %iv.i10.ext, %iv.i32
  %iv.i10.next = add i10 %iv.i10, %x.i10
  %iv.i32.next = add i32 %iv.i32, %x.i32
  %outer.iv.next = add i8 %outer.iv, 1
  %outer.ec = icmp eq i8 %outer.iv.next, 4
  br i1 %outer.ec, label %exit, label %outer.header

