; As sext_addrec_at_scope_step_folds_with_use_nuw, with nsw of {%y,+,(1 +
; %umin.x)} shown from its range instead of the extended exit value.
define i1 @sext_addrec_at_scope_nsw_by_induction_step_folds_with_use_nuw(i8 noundef range(i8 -128, -124) %a, i8 noundef %x, i8 noundef range(i8 0, 51) %y, i1 noundef %c, ptr %p) {
; CHECK-LABEL: define i1 @sext_addrec_at_scope_nsw_by_induction_step_folds_with_use_nuw(
; CHECK-SAME: i8 noundef range(i8 -128, -124) [[A:%.*]], i8 noundef [[X:%.*]], i8 noundef range(i8 0, 51) [[Y:%.*]], i1 noundef [[C:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[X_I10:%.*]] = zext i8 [[X]] to i10
; CHECK-NEXT:    [[X_I32:%.*]] = zext i8 [[X]] to i32
; CHECK-NEXT:    [[Y_I10:%.*]] = zext i8 [[Y]] to i10
; CHECK-NEXT:    [[Y_I32:%.*]] = zext i8 [[Y]] to i32
; CHECK-NEXT:    [[STEP_I10:%.*]] = add i10 [[X_I10]], 1
; CHECK-NEXT:    [[STEP_I32:%.*]] = add i32 [[X_I32]], 1
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[OUTER_IV:%.*]] = phi i8 [ 0, %[[ENTRY]] ], [ [[OUTER_IV_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[IV_I10:%.*]] = phi i10 [ [[Y_I10]], %[[ENTRY]] ], [ [[IV_I10_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    [[IV_I32:%.*]] = phi i32 [ [[Y_I32]], %[[ENTRY]] ], [ [[IV_I32_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    br i1 [[C]], label %[[INNER_PREHEADER:.*]], label %[[OUTER_LATCH]]
; CHECK:       [[INNER_PREHEADER]]:
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[INNER_IV:%.*]] = phi i8 [ [[INNER_IV_NEXT:%.*]], %[[INNER]] ], [ 0, %[[INNER_PREHEADER]] ]
; CHECK-NEXT:    [[UMIN:%.*]] = call i8 @llvm.umin.i8(i8 [[INNER_IV]], i8 [[A]])
; CHECK-NEXT:    [[ADD:%.*]] = add nuw i8 [[UMIN]], -128
; CHECK-NEXT:    [[DIV:%.*]] = udiv i8 1, [[ADD]]
; CHECK-NEXT:    [[INNER_IV_NEXT]] = add i8 [[INNER_IV]], 1
; CHECK-NEXT:    br i1 true, label %[[INNER_EXIT:.*]], label %[[INNER]]
; CHECK:       [[INNER_EXIT]]:
; CHECK-NEXT:    store i10 [[IV_I10]], ptr [[P]], align 2
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[IV_I10_EXT:%.*]] = sext i10 [[IV_I10]] to i32
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[IV_I10_EXT]], [[IV_I32]]
; CHECK-NEXT:    [[IV_I10_NEXT]] = add i10 [[IV_I10]], [[STEP_I10]]
; CHECK-NEXT:    [[IV_I32_NEXT]] = add i32 [[IV_I32]], [[STEP_I32]]
; CHECK-NEXT:    [[OUTER_IV_NEXT]] = add nuw nsw i8 [[OUTER_IV]], 1
; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp eq i8 [[OUTER_IV_NEXT]], 8
; CHECK-NEXT:    br i1 [[OUTER_EC]], label %[[EXIT:.*]], label %[[OUTER_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[CMP_LCSSA:%.*]] = phi i1 [ [[CMP]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    ret i1 [[CMP_LCSSA]]
;
entry:
  %x.i10 = zext i8 %x to i10
  %x.i32 = zext i8 %x to i32
  %y.i10 = zext i8 %y to i10
  %y.i32 = zext i8 %y to i32
  %step.i10 = add i10 %x.i10, 1
  %step.i32 = add i32 %x.i32, 1
  br label %outer.header

outer.header:
  %outer.iv = phi i8 [ 0, %entry ], [ %outer.iv.next, %outer.latch ]
  %iv.i10 = phi i10 [ %y.i10, %entry ], [ %iv.i10.next, %outer.latch ]
  %iv.i32 = phi i32 [ %y.i32, %entry ], [ %iv.i32.next, %outer.latch ]
  br i1 %c, label %inner, label %outer.latch

inner:
  %inner.iv = phi i8 [ 0, %outer.header ], [ %inner.iv.next, %inner ]
  %umin = call i8 @llvm.umin.i8(i8 %inner.iv, i8 %a)
  %add = add nuw i8 %umin, -128
  %div = udiv i8 1, %add
  %umin.x = call i8 @llvm.umin.i8(i8 %add, i8 %x)
  %inc = add i8 %umin.x, 1
  %mul = mul i8 %outer.iv, %inc
  %add.iv = add i8 %mul, %y
  %ext = sext i8 %add.iv to i10
  %inner.iv.next = add i8 %inner.iv, 1
  %inner.ec = icmp eq i8 %inner.iv.next, 0
  br i1 %inner.ec, label %inner.exit, label %inner

inner.exit:
  %ext.lcssa = phi i10 [ %ext, %inner ]
  store i10 %ext.lcssa, ptr %p
  br label %outer.latch

outer.latch:
  %iv.i10.ext = sext i10 %iv.i10 to i32
  %cmp = icmp eq i32 %iv.i10.ext, %iv.i32
  %iv.i10.next = add i10 %iv.i10, %step.i10
  %iv.i32.next = add i32 %iv.i32, %step.i32
  %outer.iv.next = add i8 %outer.iv, 1
  %outer.ec = icmp eq i8 %outer.iv.next, 8
  br i1 %outer.ec, label %exit, label %outer.header

exit:
  %cmp.lcssa = phi i1 [ %cmp, %outer.latch ]
  ret i1 %cmp.lcssa
}
