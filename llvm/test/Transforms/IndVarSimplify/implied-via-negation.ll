; CHECK-NEXT:    [[C:%.*]] = icmp samesign ult i32 [[I]], 7
; CHECK-NEXT:    br i1 [[C]], label %[[LATCH]], label %[[EXIT:.*]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    store i1 true, ptr [[P]], align 1
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %j = phi i32 [ 8, %entry ], [ %j.next, %latch ]
