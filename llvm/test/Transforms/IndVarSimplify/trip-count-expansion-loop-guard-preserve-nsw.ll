define i32 @rewrite_flags_only_hold_under_guard_strengthen(i32 %a, i32 %start) {
; CHECK-LABEL: define i32 @rewrite_flags_only_hold_under_guard_strengthen(
; CHECK-SAME: i32 [[A:%.*]], i32 [[START:%.*]]) {
