; CHECK-NEXT:    [[GEP:%.*]] = getelementptr nusw [1 x [2 x i8]], ptr [[P]], i64 4611686018427387903, i64 [[Y]], i64 [[K]]
; CHECK-NEXT:    [[L:%.*]] = load i8, ptr [[GEP]], align 1
; CHECK-NEXT:    [[K_NEXT]] = shl i64 [[K]], 1
; CHECK-NEXT:    br i1 true, label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = shl nsw i64 [[Y]], 1
