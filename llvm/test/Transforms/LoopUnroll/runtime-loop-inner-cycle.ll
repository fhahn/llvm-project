; CHECK:       latch.epil:
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       cycle.b.epil:
; CHECK-NEXT:    br label [[CYCLE_A_EPIL]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
