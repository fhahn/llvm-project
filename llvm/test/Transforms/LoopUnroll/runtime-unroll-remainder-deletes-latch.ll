; CHECK-NEXT:    br label %[[INNER_EXIT_UNR_LCSSA:.*]]
; CHECK:       [[INNER_EXIT_UNR_LCSSA_LOOPEXIT1]]:
; CHECK-NEXT:    [[LC_PH_PH2:%.*]] = phi i32 [ [[X]], %[[INNER_HEADER_PROL]] ], [ [[X]], %[[INNER_HEADER_PROL_1]] ], [ [[X]], %[[INNER_HEADER_PROL_2]] ], [ [[X]], %[[INNER_HEADER_PROL_3]] ], [ [[X]], %[[INNER_HEADER_PROL_4]] ], [ [[X]], %[[INNER_HEADER_PROL_5]] ], [ [[X]], %[[INNER_HEADER_PROL_6]] ]
; CHECK-NEXT:    br label %[[INNER_EXIT_UNR_LCSSA]]
; CHECK:       [[INNER_EXIT_UNR_LCSSA]]:
; CHECK-NEXT:    [[LC_PH:%.*]] = phi i32 [ [[LC_PH_PH]], %[[INNER_EXIT_UNR_LCSSA_LOOPEXIT]] ], [ [[LC_PH_PH2]], %[[INNER_EXIT_UNR_LCSSA_LOOPEXIT1]] ]
; CHECK-NEXT:    br label %[[INNER_EXIT]]
; CHECK:       [[INNER_EXIT]]:
; CHECK-NEXT:    [[LC:%.*]] = phi i32 [ [[LC_UNR]], %[[INNER_HEADER_PROL_LOOPEXIT]] ], [ [[LC_PH]], %[[INNER_EXIT_UNR_LCSSA]] ]
; CHECK-NEXT:    [[T:%.*]] = add i32 [[LC]], [[ACC]]
; CHECK-NEXT:    [[ACC_NEXT]] = add i32 [[T]], [[J]]
; CHECK-NEXT:    [[J_NEXT]] = add i32 [[J]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp ult i32 [[J_NEXT]], 3
; CHECK-NEXT:    br i1 [[EC]], label %[[OUTER]], label %[[EXIT_LOOPEXIT:.*]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    [[ACC_NEXT_LCSSA:%.*]] = phi i32 [ [[ACC_NEXT]], %[[INNER_EXIT]] ]
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[ACC_NEXT_LCSSA]], %[[EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    ret i32 [[R]]
;
entry:
  %small = icmp ult i64 %n, 1000
  %x = trunc i64 %n to i32
  br i1 %small, label %outer, label %exit

outer:
  %j = phi i32 [ 0, %entry ], [ %j.next, %inner.exit ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %inner.exit ]
  %p = phi i32 [ %x, %entry ], [ %x, %inner.exit ]
  br label %inner.header

inner.header:
  %i = phi i64 [ 0, %outer ], [ %i.next, %inner.latch ]
  %gep = getelementptr i32, ptr %a, i64 %i
  %l = load i32, ptr %gep
  %add = add i32 %l, %j
  store i32 %add, ptr %gep
  %i.next = add i64 %i, 1
  %c.early = icmp ne i32 %add, 77
  br i1 %c.early, label %inner.latch, label %inner.exit

inner.latch:
  %c.latch = icmp ult i64 %i, %n
  br i1 %c.latch, label %inner.header, label %inner.exit

inner.exit:
  %lc = phi i32 [ %p, %inner.header ], [ %x, %inner.latch ]
  %t = add i32 %lc, %acc
  %acc.next = add i32 %t, %j
  %j.next = add i32 %j, 1
  %ec = icmp ult i32 %j.next, 3
  br i1 %ec, label %outer, label %exit

exit:
  %r = phi i32 [ 0, %entry ], [ %acc.next, %inner.exit ]
  ret i32 %r
}
