; CHECK-NEXT:    br label %[[INNER_EXIT_UNR_LCSSA]]
; CHECK:       [[INNER_EXIT_UNR_LCSSA]]:
; CHECK-NEXT:    [[LC_PH:%.*]] = phi i32 [ [[LC_PH_PH]], %[[INNER_EXIT_UNR_LCSSA_LOOPEXIT]] ], [ [[LC_PH_PH2]], %[[INNER_EXIT_UNR_LCSSA_LOOPEXIT1]] ]
; CHECK-NEXT:    br label %[[INNER_EXIT]]
; CHECK:       [[INNER_EXIT]]:
; CHECK-NEXT:    [[LC:%.*]] = phi i32 [ [[LC_UNR]], %[[INNER_HEADER_PROL_LOOPEXIT]] ], [ [[LC_PH]], %[[INNER_EXIT_UNR_LCSSA]] ]
; CHECK-NEXT:    br i1 [[C_OUTER]], label %[[OUTER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[LC_LCSSA:%.*]] = phi i32 [ [[LC]], %[[INNER_EXIT]] ]
; CHECK-NEXT:    ret i32 [[LC_LCSSA]]
;
entry:
  br label %outer

outer:
  %p = phi i32 [ %seed, %entry ], [ %seed, %inner.exit ]
  br label %inner.header

inner.header:
  %i = phi i32 [ 0, %outer ], [ %i.next, %inner.latch ]
  %i.next = add i32 %i, 1
  br i1 true, label %inner.latch, label %inner.exit

inner.latch:
  %c = icmp ult i32 %i, %n
  br i1 %c, label %inner.header, label %inner.exit

inner.exit:
  %lc = phi i32 [ %p, %inner.header ], [ %seed, %inner.latch ]
  br i1 %c.outer, label %outer, label %exit

exit:
  ret i32 %lc
}

