; The latch exit count (%n /u %divisor) is expanded in the preheader, but the
; udiv in the loop only executes if the early exit on %divisor == 0 is not
; taken. Make sure the expanded udiv cannot divide by zero.
define void @divisor_checked_by_early_exit(i32 %n, i32 %divisor) {
; CHECK-LABEL: define void @divisor_checked_by_early_exit(
; CHECK-SAME: i32 [[N:%.*]], i32 [[DIVISOR:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = call i32 @llvm.umax.i32(i32 [[DIVISOR]], i32 1)
; CHECK-NEXT:    [[TMP1:%.*]] = udiv i32 [[N]], [[TMP0]]
; CHECK-NEXT:    [[TMP2:%.*]] = add i32 [[TMP1]], 1
; CHECK-NEXT:    [[TMP3:%.*]] = freeze i32 [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = add i32 [[TMP3]], -1
; CHECK-NEXT:    [[XTRAITER:%.*]] = and i32 [[TMP3]], 3
; CHECK-NEXT:    [[TMP5:%.*]] = icmp ult i32 [[TMP4]], 3
; CHECK-NEXT:    br i1 [[TMP5]], label %[[LOOP_EPIL_PREHEADER:.*]], label %[[ENTRY_NEW:.*]]
; CHECK:       [[ENTRY_NEW]]:
; CHECK-NEXT:    [[UNROLL_ITER:%.*]] = sub i32 [[TMP3]], [[XTRAITER]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY_NEW]] ], [ [[NEXT_3:%.*]], %[[BODY_3:.*]] ]
; CHECK-NEXT:    [[NITER:%.*]] = phi i32 [ 0, %[[ENTRY_NEW]] ], [ [[NITER_NEXT_3:%.*]], %[[BODY_3]] ]
; CHECK-NEXT:    [[ZERO:%.*]] = icmp eq i32 [[DIVISOR]], 0
; CHECK-NEXT:    br i1 [[ZERO]], label %[[EXIT_EPILOG_LCSSA_LOOPEXIT:.*]], label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    br i1 false, label %[[EXIT_EPILOG_LCSSA_LOOPEXIT]], label %[[BODY_1:.*]]
; CHECK:       [[BODY_1]]:
; CHECK-NEXT:    br i1 false, label %[[EXIT_EPILOG_LCSSA_LOOPEXIT]], label %[[BODY_2:.*]]
; CHECK:       [[BODY_2]]:
; CHECK-NEXT:    br i1 false, label %[[EXIT_EPILOG_LCSSA_LOOPEXIT]], label %[[BODY_3]]
; CHECK:       [[BODY_3]]:
; CHECK-NEXT:    [[NEXT_3]] = add i32 [[I]], 4
; CHECK-NEXT:    [[NITER_NEXT_3]] = add i32 [[NITER]], 4
; CHECK-NEXT:    [[NITER_NCMP_3:%.*]] = icmp ne i32 [[NITER_NEXT_3]], [[UNROLL_ITER]]
; CHECK-NEXT:    br i1 [[NITER_NCMP_3]], label %[[LOOP]], label %[[EXIT_UNR_LCSSA:.*]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[EXIT_UNR_LCSSA]]:
; CHECK-NEXT:    [[I_UNR:%.*]] = phi i32 [ [[NEXT_3]], %[[BODY_3]] ]
; CHECK-NEXT:    [[LCMP_MOD:%.*]] = icmp ne i32 [[XTRAITER]], 0
; CHECK-NEXT:    br i1 [[LCMP_MOD]], label %[[LOOP_EPIL_PREHEADER]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_EPIL_PREHEADER]]:
; CHECK-NEXT:    [[I_EPIL_INIT:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_UNR]], %[[EXIT_UNR_LCSSA]] ]
; CHECK-NEXT:    [[LCMP_MOD1:%.*]] = icmp ne i32 [[XTRAITER]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[LCMP_MOD1]])
; CHECK-NEXT:    br label %[[LOOP_EPIL:.*]]
; CHECK:       [[LOOP_EPIL]]:
; CHECK-NEXT:    [[I_EPIL:%.*]] = phi i32 [ [[I_EPIL_INIT]], %[[LOOP_EPIL_PREHEADER]] ], [ [[NEXT_EPIL:%.*]], %[[BODY_EPIL:.*]] ]
; CHECK-NEXT:    [[EPIL_ITER:%.*]] = phi i32 [ 0, %[[LOOP_EPIL_PREHEADER]] ], [ [[EPIL_ITER_NEXT:%.*]], %[[BODY_EPIL]] ]
; CHECK-NEXT:    [[ZERO_EPIL:%.*]] = icmp eq i32 [[DIVISOR]], 0
; CHECK-NEXT:    br i1 [[ZERO_EPIL]], label %[[EXIT_EPILOG_LCSSA_LOOPEXIT2:.*]], label %[[BODY_EPIL]]
; CHECK:       [[BODY_EPIL]]:
; CHECK-NEXT:    [[NEXT_EPIL]] = add i32 [[I_EPIL]], 1
; CHECK-NEXT:    [[QUOTIENT_EPIL:%.*]] = udiv i32 [[N]], [[DIVISOR]]
; CHECK-NEXT:    [[MORE_EPIL:%.*]] = icmp ult i32 [[I_EPIL]], [[QUOTIENT_EPIL]]
; CHECK-NEXT:    [[EPIL_ITER_NEXT]] = add i32 [[EPIL_ITER]], 1
; CHECK-NEXT:    [[EPIL_ITER_CMP:%.*]] = icmp ne i32 [[EPIL_ITER_NEXT]], [[XTRAITER]]
; CHECK-NEXT:    br i1 [[EPIL_ITER_CMP]], label %[[LOOP_EPIL]], label %[[EXIT_EPILOG_LCSSA_LOOPEXIT2]], !llvm.loop [[LOOP2:![0-9]+]]
; CHECK:       [[EXIT_EPILOG_LCSSA_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT_EPILOG_LCSSA:.*]]
; CHECK:       [[EXIT_EPILOG_LCSSA_LOOPEXIT2]]:
; CHECK-NEXT:    br label %[[EXIT_EPILOG_LCSSA]]
; CHECK:       [[EXIT_EPILOG_LCSSA]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
