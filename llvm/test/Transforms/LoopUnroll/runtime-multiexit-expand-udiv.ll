entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %next, %body ]
  %zero = icmp eq i32 %divisor, 0
  br i1 %zero, label %exit, label %body

body:
  %next = add i32 %i, 1
  %quotient = udiv i32 %n, %divisor
  %more = icmp ult i32 %i, %quotient
  br i1 %more, label %loop, label %exit

exit:
  ret void
}

