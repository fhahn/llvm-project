}

; A marked loop already vectorized by LoopVectorize is not unrolled and loses
; the marker. The attribute is not added.
define void @marked_vectorized(ptr %dst) {
; CHECK-LABEL: define void @marked_vectorized(
; CHECK-SAME: ptr [[DST:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i8, ptr [[DST]], i64 [[IV]]
; CHECK-NEXT:    store <4 x i8> zeroinitializer, ptr [[GEP]], align 1
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 4
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], 16
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]], !llvm.loop [[LOOP1:![0-9]+]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep = getelementptr inbounds i8, ptr %dst, i64 %iv
  store <4 x i8> zeroinitializer, ptr %gep, align 1
  %iv.next = add nuw nsw i64 %iv, 4
  %ec = icmp eq i64 %iv.next, 16
  br i1 %ec, label %exit, label %loop, !llvm.loop !3

exit:
  ret void
}

