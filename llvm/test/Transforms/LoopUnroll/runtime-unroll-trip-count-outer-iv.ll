; CHECK-NEXT:    [[EPIL_ITER_CMP:%.*]] = icmp ne i8 [[EPIL_ITER_NEXT]], [[XTRAITER]]
; CHECK-NEXT:    br i1 [[EPIL_ITER_CMP]], label %[[INNER_EPIL]], label %[[OUTER_LATCH_EPILOG_LCSSA:.*]], !llvm.loop [[LOOP9:![0-9]+]]
; CHECK:       [[OUTER_LATCH_EPILOG_LCSSA]]:
