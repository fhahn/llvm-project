; CHECK-NEXT:    call void @__tysan_instrument_with_shadow_update(ptr [[A]], ptr null, i1 true, i64 4, i32 2)
; CHECK-NEXT:    store i32 0, ptr [[A]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  %v = load i32, ptr %a, align 4
  store i32 0, ptr %a, align 4
