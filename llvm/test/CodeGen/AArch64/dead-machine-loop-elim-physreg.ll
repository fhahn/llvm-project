; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=aarch64 < %s | FileCheck %s

; DeadMachineLoopElim removes read-only inner loops whose register defs do not
; escape. It runs pre-register-allocation, where physical-register liveness is
; not fully modelled: a loop can write a physical register that is read after
; the loop through a channel that plain register-operand liveness cannot see
; (e.g. llvm.write_register, or inline asm that references the register by name
; or clobbers it). Such loops must NOT be deleted.

declare void @llvm.write_register.i64(metadata, i64)
declare i64 @llvm.read_register.i64(metadata)

; The loop writes $x9 via llvm.write_register and it is read afterwards via
; llvm.read_register. The loop must be preserved.
define i64 @write_register_escapes(i64 %n) {
; CHECK-LABEL: write_register_escapes:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    mov x9, xzr
; CHECK-NEXT:  .LBB0_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    // fake_use: $x9
; CHECK-NEXT:    add x9, x9, #1
; CHECK-NEXT:    cmp x0, x9
; CHECK-NEXT:    b.ne .LBB0_1
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    mov x0, x9
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  call void @llvm.write_register.i64(metadata !0, i64 %iv)
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

exit:
  %r = call i64 @llvm.read_register.i64(metadata !0)
  ret i64 %r
}

; The loop contains inline asm that clobbers $x9, which is then read via inline
; asm after the loop. The inline asm output is consumed inside the loop so the
; loop is otherwise read-only, but $x9 escapes and the loop must be preserved.
define i64 @inline_asm_clobber_escapes(i64 %n) {
; CHECK-LABEL: inline_asm_clobber_escapes:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    mov x8, xzr
; CHECK-NEXT:  .LBB1_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    subs x0, x0, #1
; CHECK-NEXT:    //APP
; CHECK-NEXT:    add x8, x8, #1
; CHECK-NEXT:    mov x9, x8
; CHECK-NEXT:    //NO_APP
; CHECK-NEXT:    b.ne .LBB1_1
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    //APP
; CHECK-NEXT:    mov x0, x9
; CHECK-NEXT:    //NO_APP
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %acc = phi i64 [ 0, %entry ], [ %v, %loop ]
  %v = call i64 asm "add $0, $1, #1; mov x9, $0", "=r,r,~{x9}"(i64 %acc)
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

exit:
  %r = call i64 asm "mov $0, x9", "=r"()
  ret i64 %r
}

!0 = !{!"x9"}
