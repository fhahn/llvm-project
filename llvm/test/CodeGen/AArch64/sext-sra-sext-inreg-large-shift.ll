; CHECK-SD-NEXT:    // kill: def $w0 killed $w0 def $x0
; CHECK-SD-NEXT:    sbfiz x0, x0, #44, #16
; CHECK-SD-NEXT:    ret
;
; CHECK-GI-LABEL: sext_ashr_i16_20:
; CHECK-GI:       // %bb.0:
