; CHECK-GI-NEXT:    mov w8, w0
; CHECK-GI-NEXT:    sbfiz x0, x8, #44, #16
; CHECK-GI-NEXT:    ret
  %s = sext i16 %x to i32
  %sra = ashr i32 %s, 20
  %r = sext i32 %sra to i64
  ret i64 %r
}
