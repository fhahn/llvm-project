---
# Dead three-block inner loop: bb.1 -> bb.2 -> bb.3 form a loop with
# header bb.1. Two exiting blocks (bb.1 and bb.3) both exit to bb.4.
# No values escape.


name:            dead_three_block_loop
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr64common }
  - { id: 1, class: gpr64common }
  - { id: 2, class: gpr64common }
  - { id: 3, class: gpr32 }
  - { id: 4, class: gpr32 }
  - { id: 5, class: gpr32 }
  - { id: 6, class: gpr64common }
  - { id: 7, class: gpr64sp }
body:             |
  ; CHECK-LABEL: name: dead_three_block_loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64common = COPY $x0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr64common = COPY $x1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr64common = COPY $xzr
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   RET_ReallyLR
  ; bb.1 -> bb.2 -> bb.3 -> bb.1 with exits from bb.1 and bb.3 to bb.4.
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x0, $x1

    %0:gpr64common = COPY $x0
    %1:gpr64common = COPY $x1
    %6:gpr64common = COPY $xzr

  bb.1:
    successors: %bb.4(0x10000000), %bb.2(0x70000000)

    %2:gpr64common = PHI %6, %bb.0, %7, %bb.3
    %3:gpr32 = LDRBBroX %0, %2, 0, 0
    %4:gpr32 = LDRBBroX %1, %2, 0, 0
    %5:gpr32 = SUBSWrr %3, %4, implicit-def $nzcv
    Bcc 1, %bb.4, implicit $nzcv
    B %bb.2

  bb.2:
    successors: %bb.3(0x80000000)

    ; Intermediate block with no exit.
    %7:gpr64sp = ADDXri %2, 1, 0

  bb.3:
    successors: %bb.4(0x10000000), %bb.1(0x70000000)

    dead $xzr = SUBSXri %7, 3, 0, implicit-def $nzcv
    Bcc 1, %bb.1, implicit $nzcv
    B %bb.4

  bb.4:
    RET_ReallyLR

...
---
