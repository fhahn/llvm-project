# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=livevars %s -o - | FileCheck %s

# Adding kill operands to an instruction can reallocate its operand array.
# LiveVariables must not access the instruction's regmask operand through a
# stale reference afterwards.

---
name: regmask_kill_same_instr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $q8
    ; CHECK-LABEL: name: regmask_kill_same_instr
    ; CHECK: liveins: $q8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: KILL CustomRegMask($q8), implicit killed $q8
    ; CHECK-NEXT: RET_ReallyLR
    KILL CustomRegMask($q8), implicit $q8
    RET_ReallyLR
...
---
name: two_regmasks_kill_same_instr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $q1, $q8
    ; CHECK-LABEL: name: two_regmasks_kill_same_instr
    ; CHECK: liveins: $q1, $q8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: KILL CustomRegMask($q8), CustomRegMask(), implicit killed $q8, implicit killed $q1
    ; CHECK-NEXT: RET_ReallyLR
    KILL CustomRegMask($q8), CustomRegMask(), implicit $q8, implicit $q1
    RET_ReallyLR
...
