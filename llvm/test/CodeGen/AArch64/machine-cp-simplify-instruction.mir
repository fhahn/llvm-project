---
# The move the shift turns into can be forwarded into the store.
name: shift_by_zero_forwarded
body: |
  bb.0:
    liveins: $w1, $x3
    ; CHECK-LABEL: name: shift_by_zero_forwarded
    ; CHECK: liveins: $w1, $x3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $w0 = LSLVWr killed renamable $w1, $wzr
    ; CHECK-NEXT: STRWui killed renamable $w0, killed renamable $x3, 0
    ; CHECK-NEXT: RET_ReallyLR
    renamable $w2 = COPY $wzr
    renamable $w0 = LSLVWr killed renamable $w1, killed renamable $w2
    STRWui killed renamable $w0, killed renamable $x3, 0
    RET_ReallyLR
...
---
# A variable shift amount must not be simplified.
name: lslv_by_variable
body: |
  bb.0:
    liveins: $w1, $w2
    ; CHECK-LABEL: name: lslv_by_variable
    ; CHECK: liveins: $w1, $w2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $w0 = LSLVWr killed renamable $w1, killed renamable $w2
    ; CHECK-NEXT: RET_ReallyLR implicit killed $w0
    renamable $w0 = LSLVWr killed renamable $w1, killed renamable $w2
    RET_ReallyLR implicit killed $w0
...
---
# Shifting the zero register by a variable amount is not a move either.
name: lslv_of_zero
body: |
  bb.0:
    liveins: $w2
    ; CHECK-LABEL: name: lslv_of_zero
    ; CHECK: liveins: $w2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $w0 = LSLVWr $wzr, killed renamable $w2
    ; CHECK-NEXT: RET_ReallyLR implicit killed $w0
    renamable $w0 = LSLVWr $wzr, killed renamable $w2
    RET_ReallyLR implicit killed $w0
...
---
# The shift amount is redefined before the shift, so the zero must not be
# forwarded and no simplification may happen.
name: shift_amount_redefined
body: |
  bb.0:
    liveins: $w1
    ; CHECK-LABEL: name: shift_amount_redefined
    ; CHECK: liveins: $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $w2 = COPY $wzr
    ; CHECK-NEXT: renamable $w2 = SUBWri killed renamable $w2, 3, 0
    ; CHECK-NEXT: renamable $w0 = LSLVWr killed renamable $w1, killed renamable $w2
    ; CHECK-NEXT: RET_ReallyLR implicit killed $w0
    renamable $w2 = COPY $wzr
    renamable $w2 = SUBWri killed renamable $w2, 3, 0
    renamable $w0 = LSLVWr killed renamable $w1, killed renamable $w2
    RET_ReallyLR implicit killed $w0
...
---
# The moved value must keep its kill flag: $w1 is dead after the shift, but
# still live across the preceding instruction.
name: preserves_kill_flag
body: |
  bb.0:
    liveins: $w1, $x3
    ; CHECK-LABEL: name: preserves_kill_flag
    ; CHECK: liveins: $w1, $x3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: STRWui renamable $w1, renamable $x3, 0
    ; CHECK-NEXT: renamable $w0 = LSLVWr killed renamable $w1, $wzr
    ; CHECK-NEXT: RET_ReallyLR implicit killed $w0
    renamable $w2 = COPY $wzr
    STRWui renamable $w1, renamable $x3, 0
    renamable $w0 = LSLVWr killed renamable $w1, killed renamable $w2
    RET_ReallyLR implicit killed $w0
...
---
# An undef source operand must stay undef after the rewrite.
name: preserves_undef_flag
body: |
  bb.0:
    ; CHECK-LABEL: name: preserves_undef_flag
    ; CHECK: renamable $w0 = LSLVWr undef renamable $w1, $wzr
    ; CHECK-NEXT: RET_ReallyLR implicit killed $w0
    renamable $w2 = COPY $wzr
    renamable $w0 = LSLVWr undef renamable $w1, killed renamable $w2
    RET_ReallyLR implicit killed $w0
...
