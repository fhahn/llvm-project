# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=aarch64-none-linux-gnu -run-pass machine-cp -verify-machineinstrs -o - %s | FileCheck %s

# Once copy propagation has forwarded the zero register into the shift amount,
# the shift becomes a plain move and should be simplified so that it can be
# propagated in turn.

---
name: lslv_by_zero
body: |
  bb.0:
    liveins: $w1
    ; CHECK-LABEL: name: lslv_by_zero
    ; CHECK: liveins: $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $w0 = LSLVWr killed renamable $w1, $wzr
    ; CHECK-NEXT: RET_ReallyLR implicit killed $w0
    renamable $w2 = COPY $wzr
    renamable $w0 = LSLVWr killed renamable $w1, killed renamable $w2
    RET_ReallyLR implicit killed $w0
...
---
name: lsrv_by_zero
body: |
  bb.0:
    liveins: $w1
    ; CHECK-LABEL: name: lsrv_by_zero
    ; CHECK: liveins: $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $w0 = LSRVWr killed renamable $w1, $wzr
    ; CHECK-NEXT: RET_ReallyLR implicit killed $w0
    renamable $w2 = COPY $wzr
    renamable $w0 = LSRVWr killed renamable $w1, killed renamable $w2
    RET_ReallyLR implicit killed $w0
...
