name: lslv_by_zero_64
body: |
  bb.0:
    liveins: $x1
    ; CHECK-LABEL: name: lslv_by_zero_64
    ; CHECK: liveins: $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $x0 = LSLVXr killed renamable $x1, $xzr
    ; CHECK-NEXT: RET_ReallyLR implicit killed $x0
    renamable $x2 = COPY $xzr
    renamable $x0 = LSLVXr killed renamable $x1, killed renamable $x2
    RET_ReallyLR implicit killed $x0
