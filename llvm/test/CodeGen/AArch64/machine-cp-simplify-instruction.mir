    ; CHECK-LABEL: name: lsrv_by_zero_64
    ; CHECK: liveins: $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $x0 = LSRVXr killed renamable $x1, $xzr
    ; CHECK-NEXT: RET_ReallyLR implicit killed $x0
    renamable $x2 = COPY $xzr
