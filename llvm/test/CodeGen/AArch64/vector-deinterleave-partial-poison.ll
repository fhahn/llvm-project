; RUN: llc -mtriple=aarch64 -mattr=+sve < %s | FileCheck %s

; FIXME: Only the first operand of VECTOR_DEINTERLEAVE is undef, but all results
; are folded to undef. Lane 3 of result 0 is %v[9] = %c[1].
define void @deinterleave3_low_poison(ptr %in, ptr %out) {
; CHECK-LABEL: deinterleave3_low_poison:
; CHECK:       // %bb.0:
; CHECK-NEXT:    str xzr, [x1]
; CHECK-NEXT:    ret
  %b = load <4 x i32>, ptr %in
  %in.c = getelementptr i8, ptr %in, i64 16
  %c = load <4 x i32>, ptr %in.c
  %v = shufflevector <4 x i32> %b, <4 x i32> %c, <12 x i32> <i32 poison, i32 poison, i32 poison, i32 poison, i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  %d = call { <4 x i32>, <4 x i32>, <4 x i32> } @llvm.vector.deinterleave3.v12i32(<12 x i32> %v)
  %r = extractvalue { <4 x i32>, <4 x i32>, <4 x i32> } %d, 0
  %e = extractelement <4 x i32> %r, i64 3
  %z = zext i32 %e to i64
  store i64 %z, ptr %out
  ret void
}

; FIXME: The upper half of result 0 is the even lanes of %b, but it is folded to
; undef.
define <vscale x 4 x i32> @deinterleave2_low_poison_nxv8i32(<vscale x 4 x i32> %b) {
; CHECK-LABEL: deinterleave2_low_poison_nxv8i32:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ret
  %v = call <vscale x 8 x i32> @llvm.vector.insert.nxv8i32.nxv4i32(<vscale x 8 x i32> poison, <vscale x 4 x i32> %b, i64 4)
  %d = call { <vscale x 4 x i32>, <vscale x 4 x i32> } @llvm.vector.deinterleave2.nxv8i32(<vscale x 8 x i32> %v)
  %r = extractvalue { <vscale x 4 x i32>, <vscale x 4 x i32> } %d, 0
  ret <vscale x 4 x i32> %r
}
