# RUN: llc -mtriple=hexagon -run-pass=live-debug-values -verify-machineinstrs %s -o - | FileCheck %s

# The only DBG_VALUE in the function is inside a bundle. Its range must still
# be extended into the successor block.

# CHECK-LABEL: bb.0:
# CHECK:       BUNDLE
# CHECK-NEXT:    $r1 = A2_tfr $r0
# CHECK-NEXT:    DBG_VALUE $r0, $noreg, ![[VAR:[0-9]+]], !DIExpression()
# CHECK-LABEL: bb.1:
# CHECK-NOT:   A2_addi
# CHECK:       DBG_VALUE $r0, $noreg, ![[VAR]], !DIExpression()
# CHECK-NEXT:  A2_addi
--- |
  define i32 @foo(i32 %a) !dbg !5 {
    ret i32 %a, !dbg !10
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3, !4}
  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = !{i32 1, !"PIC Level", i32 2}
  !5 = distinct !DISubprogram(name: "foo", scope: !1, file: !1, line: 1, type: !6, isDefinition: true, unit: !0)
  !6 = !DISubroutineType(types: !7)
  !7 = !{null}
  !8 = !DILocalVariable(name: "x", scope: !5, file: !1, line: 1, type: !9)
  !9 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !10 = !DILocation(line: 1, column: 1, scope: !5)

...
---
name:            foo
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r0, $r31

    BUNDLE implicit-def $r1, implicit $r0, debug-location !10 {
      $r1 = A2_tfr $r0, debug-location !10
      DBG_VALUE $r0, $noreg, !8, !DIExpression(), debug-location !10
    }
    J2_jump %bb.1, implicit-def $pc, debug-location !10

  bb.1:
    liveins: $r0, $r31

    $r0 = A2_addi $r0, 1, debug-location !10
    PS_jmpret $r31, implicit-def dead $pc, implicit $r0, debug-location !10
...
