# RUN: llc -mtriple=x86_64-- -run-pass=machine-block-freq,machinelicm,machine-cse -print-machine-bfi -o /dev/null %s 2>&1 | FileCheck %s --check-prefixes=CHECK,LEGACY
# RUN: llc -mtriple=x86_64-- -passes='require<machine-block-freq>,machinelicm,print<machine-block-freq>' -o /dev/null %s 2>&1 | FileCheck %s
# MachineLICM splits the critical edge bb.0 -> bb.1 to create a preheader.
# Block frequencies after MachineLICM must match a fresh computation.

---
name: split_critical_edge
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi

    TEST32rr $edi, $edi, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $edi

    $edi = DEC32r killed $edi, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET64
...

# LEGACY:      block-frequency-info: split_critical_edge
# LEGACY-NEXT:  - BB0: float = 1.0,
# LEGACY-NEXT:  - BB1: float = 1.0,
# LEGACY-NEXT:  - BB2: float = 1.0,
# CHECK:       block-frequency-info: split_critical_edge
# CHECK-NEXT:  - BB0: float = 1.0,
# CHECK-NEXT:  - BB3: float = 0.5,
# CHECK-NEXT:  - BB1: float = 1.0,
# CHECK-NEXT:  - BB2: float = 1.0,
